ation group\">\n<span class=\"deco text-[11px] uppercase tracking-[0.38em] text-[#CFAB01]\" data-kid=\"2-4-3-1-1\" data-name=\"hero role text\">Interface designer</span>\n<span class=\"deco text-[11px] uppercase tracking-[0.3em] text-[#F0ECEC]/45\" data-kid=\"2-4-3-1-2\" data-name=\"hero location text\">Bengaluru, India</span>\n</div>\n<button aria-pressed=\"false\" class=\"flex items-center gap-4 border border-[#CFAB01]/35 px-5 py-3\" data-kid=\"2-4-3-2\" data-name=\"signal toggle button\" id=\"signal\" type=\"button\">\n<span class=\"deco text-[10px] uppercase tracking-[0.3em] text-[#CFAB01]\" data-kid=\"2-4-3-2-1\" data-name=\"signal button label\">Signal</span>\n<span class=\"relative block h-[2px] w-10 bg-[#F0ECEC]/20\" data-kid=\"2-4-3-2-2\" data-name=\"signal indicator track\">\n<span class=\"absolute left-0 top-0 block h-full w-[13px] bg-[#CFAB01]\" data-kid=\"2-4-3-2-2-1\" data-name=\"signal indicator bar\" id=\"signalBar\"></span>\n</span>\n<span class=\"deco text-[9px] uppercase tracking-[0.24em] text-[#F0ECEC]/45\" data-dynamic=\"true\" data-kid=\"2-4-3-2-3\" data-name=\"signal state text\" data-reason=\"text replaced by signal click handler\" id=\"signalState\">Off</span>\n</button>\n</div>\n</div>\n</header>\n<div class=\"relative overflow-hidden border-b border-[#CFAB01]/20 bg-[#160F16] py-7\" data-kid=\"3\" data-name=\"scrolling marquee band\" id=\"band\">\n<svg aria-hidden=\"true\" class=\"absolute inset-x-0 bottom-4 w-full\" data-dynamic=\"true\" data-kid=\"3-1\" data-name=\"marquee dashed underline line\" data-reason=\"strokeDashoffset animated by infinite gsap loop\" height=\"1\" preserveaspectratio=\"none\" viewbox=\"0 0 1280 1\">\n<line id=\"dash\" stroke=\"#CFAB01\" stroke-dasharray=\"3 13\" stroke-opacity=\"0.75\" stroke-width=\"1\" x1=\"0\" x2=\"1280\" y1=\"0.5\" y2=\"0.5\"></line>\n</svg>\n<div class=\"relative flex overflow-hidden\" data-kid=\"3-2\" data-name=\"marquee overflow container\">\n<div class=\"deco flex whitespace-nowrap text-[11px] uppercase tracking-[0.55em] text-[#F0ECEC]/30\" data-dynamic=\"true\" data-kid=\"3-2-1\" data-name=\"marquee scrolling text container\" data-reason=\"x position tied to scroll position by gsap scrub\" id=\"bandText\">\n<span class=\"px-8\" data-kid=\"3-2-1-1\" data-name=\"marquee name text\">Aarav Menon</span><span class=\"inline-block h-[6px] w-[6px] self-center bg-[#CFAB01]/60\" data-kid=\"3-2-1-2\" data-name=\"marquee diamond separator\" style=\"clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)\"></span>\n<span class=\"px-8\" data-kid=\"3-2-1-3\" data-name=\"marquee role text\">Interface designer</span><span class=\"inline-block h-[6px] w-[6px] self-center bg-[#CFAB01]/60\" data-kid=\"3-2-1-4\" data-name=\"marquee diamond separator\" style=\"clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)\"></span>\n<span class=\"px-10\" data-kid=\"3-2-1-5\" data-name=\"marquee name text\">Aarav Menon</span><span class=\"inline-block h-[6px] w-[6px] self-center bg-[#CFAB01]/60\" data-kid=\"3-2-1-6\" data-name=\"marquee diamond separator\" style=\"clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)\"></span>\n<span class=\"px-10\" data-kid=\"3-2-1-7\" data-name=\"marquee location text\">Bengaluru, India</span><span class=\"inline-block h-[6px] w-[6px] self-center bg-[#CFAB01]/60\" data-kid=\"3-2-1-8\" data-name=\"marquee diamond separator\" style=\"clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)\"></span>\n<span class=\"px-10\" data-kid=\"3-2-1-9\" data-name=\"marquee role text\">Interface designer</span><span class=\"inline-block h-[6px] w-[6px] self-center bg-[#CFAB01]/60\" data-kid=\"3-2-1-10\" data-name=\"marquee diamond separator\" style=\"clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)\"></span>\n<span class=\"px-10\" data-kid=\"3-2-1-11\" data-name=\"marquee name text\">Aarav Menon</span>\n</div>\n</div>\n</div>\n<section class=\"relative border-b border-[#CFAB01]/15\" data-kid=\"4\" data-name=\"about section\">\n<div class=\"mx-auto grid max-w-[1180px] items-start gap-16 px-10 py-24 md:grid-cols-[1.55fr_0.85fr]\" data-kid=\"4-1\" data-name=\"about section content grid\">\n<div data-kid=\"4-1-1\" data-name=\"about text container\">\n<h2 class=\"deco text-[34px] leading-none tracking-[0.02em]\" data-kid=\"4-1-1-1\" data-name=\"about section heading\">About</h2>\n<p class=\"serif dropcap mt-10 text-[23px] leading-[1.72] text-[#F0ECEC]/80\" data-kid=\"4-1-1-2\" data-name=\"about bio paragraph with drop cap\">I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.</p>\n</div>\n<div class=\"notch border border-[#CFAB01]/30 p-4\" data-kid=\"4-1-2\" data-name=\"notched monogram card\">\n<div class=\"notch flex flex-col items-center justify-center bg-[#141014] px-6 py-14\" data-kid=\"4-1-2-1\" data-name=\"notched inner monogram panel\">\n<span class=\"deco text-[58px] leading-none tracking-[0.04em] text-[#CFAB01]\" data-kid=\"4-1-2-1-1\" data-name=\"monogram initials text\">AM</span>\n<span class=\"mt-6 h-px w-16 bg-[#CFAB01]/40\" data-kid=\"4-1-2-1-2\" data-name=\"monogram divider line\"></span>\n<span class=\"deco mt-5 text-[9px] uppercase tracking-[0.32em] text-[#F0ECEC]/45\" data-kid=\"4-1-2-1-3\" data-name=\"since 2017 text\">Since 2017</span>\n</div>\n</div>\n</div>\n</section>\n<section class=\"relative overflow-hidden bg-[#8B109C]\" data-kid=\"5\" data-name=\"selected work section\" id=\"work\">\n<div class=\"pointer-events-none absolute inset-0\" data-kid=\"5-1\" data-name=\"radial gradient background overlay\" style=\"background:radial-gradient(130% 95% at 50% 0%, rgba(26,20,26,.15) 20%, rgba(26,20,26,.72) 100%)\"></div>\n<div class=\"relative mx-auto max-w-[1180px] px-10 pt-20\" data-kid=\"5-2\" data-name=\"work section header\">\n<div class=\"flex flex-wrap items-end justify-between gap-6\" data-kid=\"5-2-1\" data-name=\"work section header row\">\n<h2 class=\"deco text-[44px] leading-none tracking-[0.015em] text-[#F0ECEC]\" data-kid=\"5-2-1-1\" data-name=\"work section heading\">Selected work</h2>\n<span class=\"deco text-[10px] uppercase tracking-[0.3em] text-[#F0ECEC]/60\" data-kid=\"5-2-1-2\" data-name=\"project count text\">03 projects</span>\n</div>\n<div class=\"draw mt-7 h-px w-full bg-[#F0ECEC]/35\" data-dynamic=\"true\" data-kid=\"5-2-2\" data-name=\"work section divider line\" data-reason=\"scaleX width drawn in by scroll trigger\"></div>\n</div>\n<div class=\"relative pb-20 pt-12\" data-kid=\"5-3\" data-name=\"work section container\">\n<div class=\"rail flex snap-x snap-mandatory gap-6 overflow-x-auto px-[15%] pb-5\" data-kid=\"5-3-1\" data-name=\"horizontal scrollable project rail\" id=\"rail\">\n<article aria-selected=\"false\" class=\"tile relative w-[62%] shrink-0 snap-center\" data-kid=\"5-3-1-1\" data-name=\"project card for Kestrel design system\" role=\"button\" tabindex=\"0\">\n<div class=\"notch bg-[#F0ECEC]/30 p-px\" data-kid=\"5-3-1-1-1\" data-name=\"project card notched border\">\n<div class=\"notch relative flex h-[500px] flex-col overflow-hidden bg-[#6B0D77]\" data-kid=\"5-3-1-1-1-1\" data-name=\"project card inner panel\">\n<div class=\"relative h-[248px] shrink-0 overflow-hidden\" data-kid=\"5-3-1-1-1-1-1\" data-name=\"project image container\">\n<img alt=\"Art-deco city towers at night with searchlight beams over the river\" class=\"h-full w-full object-cover\" data-kid=\"5-3-1-1-1-1-1-1\" data-name=\"project image photograph\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/fb7206cc03a34e3cb5b32d8ec7c9df70.jpg\" style=\"filter:grayscale(.35) brightness(.72) contrast(1.05)\"/>\n<div class=\"absolute inset-0\" data-kid=\"5-3-1-1-1-1-1-2\" data-name=\"project image gradient overlay\" style=\"background:linear-gradient(180deg, rgba(107,13,119,.1) 0%, rgba(107,13,119,.92) 92%)\"></div>\n</div>\n<div class=\"plate mt-auto border-x border-t border-transparent px-8 pb-7 pt-6\" data-kid=\"5-3-1-1-1-1-2\" data-name=\"project card info plate\">\n<div class=\"flex items-baseline justify-between gap-4\" data-kid=\"5-3-1-1-1-1-2-1\" data-name=\"project meta row\">\n<span class=\"deco text-[9px] uppercase tracking-[0.3em] text-[#F0ECEC]/55\" data-kid=\"5-3-1-1-1-1-2-1-1\" data-name=\"project category label\">Design system</span>\n<span class=\"deco text-[10px] tracking-[0.2em] text-[#CFAB01]\" data-kid=\"5-3-1-1-1-1-2-1-2\" data-name=\"project year label\">2025</span>\n</div>\n<h3 class=\"deco mt-4 text-[34px] leading-none\" data-kid=\"5-3-1-1-1-1-2-2\" data-name=\"project title\">Kestrel</h3>\n<p class=\"serif mt-4 max-w-[46ch] text-[16px] leading-[1.6] text-[#F0ECEC]/72\" data-kid=\"5-3-1-1-1-1-2-3\" data-name=\"project description\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n<span class=\"deco mt-6 inline-flex items-center gap-3 text-[9px] uppercase tracking-[0.28em] text-[#CFAB01]\" data-kid=\"5-3-1-1-1-1-2-4\" data-name=\"view project link\">View project<span aria-hidden=\"true\" data-kid=\"5-3-1-1-1-1-2-4-1\" data-name=\"arrow icon\">→</span></span>\n</div>\n</div>\n</div>\n</article>\n<article aria-selected=\"false\" class=\"tile relative w-[62%] shrink-0 snap-center\" data-kid=\"5-3-1-2\" data-name=\"project card for Tide and Timber booking app\" role=\"button\" tabindex=\"0\">\n<div class=\"notch bg-[#F0ECEC]/30 p-px\" data-kid=\"5-3-1-2-1\" data-name=\"project card notched border\">\n<div class=\"notch flex h-[500px] flex-col overflow-hidden bg-[#6B0D77]\" data-kid=\"5-3-1-2-1-1\" data-name=\"project card inner panel\">\n<div class=\"relative h-[248px] shrink-0 overflow-hidden\" data-kid=\"5-3-1-2-1-1-1\" data-name=\"abstract visualization container\" style=\"background:repeating-linear-gradient(90deg, rgba(240,236,236,.16) 0 1px, transparent 1px 26px), repeating-linear-gradient(0deg, rgba(240,236,236,.16) 0 1px, transparent 1px 26px)\">\n<div class=\"absolute inset-0\" data-kid=\"5-3-1-2-1-1-1-1\" data-name=\"visualization gradie