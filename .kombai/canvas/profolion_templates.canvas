      "html": "<body class=\"min-h-screen bg-[#F4F1E8] text-[#0B1B3A] antialiased\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n    body { font-family: 'Instrument Sans', sans-serif; }\n    .rings { transition: transform 500ms cubic-bezier(.2,.8,.2,1); will-change: transform; }\n  </style>\n<div class=\"border-b border-[#0B1B3A]/15\" data-kid=\"1\" data-name=\"top bar container\">\n<div class=\"mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-3 px-7 py-3 font-mono text-[9px] uppercase tracking-[0.22em] text-[#6E7889]\" data-kid=\"1-1\" data-name=\"top bar inner layout\">\n<span class=\"text-[#0B1B3A]\" data-kid=\"1-1-1\" data-name=\"site owner name label\">Aarav Menon</span>\n<nav class=\"flex items-center gap-6\" data-kid=\"1-1-2\" data-name=\"top navigation menu\"><a data-kid=\"1-1-2-1\" data-name=\"work nav link\" href=\"#work\">Work</a><a data-kid=\"1-1-2-2\" data-name=\"experience nav link\" href=\"#experience\">Experience</a><a data-kid=\"1-1-2-3\" data-name=\"education nav link\" href=\"#education\">Education</a><a data-kid=\"1-1-2-4\" data-name=\"elsewhere nav link\" href=\"#elsewhere\">Elsewhere</a></nav>\n<span data-kid=\"1-1-3\" data-name=\"interface designer role label\">Interface designer</span>\n</div>\n</div>\n<section class=\"relative mx-auto max-w-[1200px] overflow-hidden px-7 pb-12 pt-12 md:pt-16\" data-kid=\"2\" data-name=\"hero section with decorative rings\" id=\"top\">\n<div aria-hidden=\"\" class=\"rings pointer-events-none absolute -right-16 top-4 hidden h-[520px] w-[520px] md:block\" data-dynamic=\"true\" data-kid=\"2-1\" data-name=\"decorative concentric rings container\" data-reason=\"rings transform overwritten on pointer move by parallax script\" id=\"rings\">\n<span class=\"absolute left-1/2 top-1/2 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#0B1B3A]/12\" data-kid=\"2-1-1\" data-name=\"outer thin ring\"></span>\n<span class=\"absolute left-1/2 top-1/2 h-[380px] w-[380px] -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-dashed border-[#C8102E]/30\" data-kid=\"2-1-2\" data-name=\"dashed red accent ring\"></span>\n<span class=\"absolute left-1/2 top-1/2 h-[260px] w-[260px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#0B1B3A]/16\" data-kid=\"2-1-3\" data-name=\"inner thin ring\"></span>\n</div>\n<div class=\"relative\" data-kid=\"2-2\" data-name=\"hero content container\">\n<p class=\"font-mono text-[10px] uppercase tracking-[0.28em] text-[#C8102E]\" data-kid=\"2-2-1\" data-name=\"hero eyebrow label\">Interface designer — Bengaluru</p>\n<h1 class=\"mt-4 uppercase leading-[0.78]\" data-kid=\"2-2-2\" data-name=\"hero name headline\" style=\"font-family:'Bebas Neue', sans-serif; font-size:clamp(4.2rem,12vw,9rem); letter-spacing:0.005em\">\n        Aarav<br data-kid=\"2-2-2-1\" data-name=\"line break in hero headline\"/><span class=\"text-[#C8102E]\" data-kid=\"2-2-2-2\" data-name=\"red surname accent in headline\">Menon</span>\n</h1>\n<div class=\"mt-8 grid gap-8 md:grid-cols-[1.05fr_0.95fr] md:items-end\" data-kid=\"2-2-3\" data-name=\"hero intro and actions grid\">\n<p class=\"max-w-[46ch] text-[15.5px] leading-[1.8] text-[#0B1B3A]/72\" data-kid=\"2-2-3-1\" data-name=\"hero intro paragraph\">\n          I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n        </p>\n<div class=\"flex items-center gap-4 md:justify-end\" data-kid=\"2-2-3-2\" data-name=\"hero action row\">\n<button aria-label=\"Mark this portfolio\" aria-pressed=\"false\" class=\"grid h-12 w-12 place-items-center rounded-full bg-[#C8102E] text-[12px] font-semibold text-[#F4F1E8]\" data-dynamic=\"true\" data-kid=\"2-2-3-2-1\" data-name=\"mark portfolio toggle button\" data-reason=\"background, color and box shadow toggled by click script\" id=\"mark\" type=\"button\">AM</button>\n<span class=\"h-px w-16 bg-[#0B1B3A]/25\" data-kid=\"2-2-3-2-2\" data-name=\"short divider line\"></span>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#6E7889]\" data-kid=\"2-2-3-2-3\" data-name=\"skills count label\">06 skills</span>\n</div>\n</div>\n</div>\n</section>\n<div class=\"bg-[#C8102E] text-[#0B1B3A]\" data-kid=\"3\" data-name=\"skills ticker bar\">\n<div class=\"mx-auto flex max-w-[1200px] flex-wrap items-center gap-x-7 gap-y-2 px-7 py-3.5\" data-kid=\"3-1\" data-name=\"skills tag row\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.24em] text-[#F4F1E8]/85\" data-kid=\"3-1-1\" data-name=\"skills section label\">Skills</span>\n<span class=\"text-[12px] font-medium\" data-kid=\"3-1-2\" data-name=\"design systems skill tag\">Design systems</span><span class=\"text-[12px] font-medium\" data-kid=\"3-1-3\" data-name=\"interaction design skill tag\">Interaction design</span><span class=\"text-[12px] font-medium\" data-kid=\"3-1-4\" data-name=\"prototyping skill tag\">Prototyping</span><span class=\"text-[12px] font-medium\" data-kid=\"3-1-5\" data-name=\"motion skill tag\">Motion</span><span class=\"text-[12px] font-medium\" data-kid=\"3-1-6\" data-name=\"type skill tag\">Type</span><span class=\"text-[12px] font-medium\" data-kid=\"3-1-7\" data-name=\"research skill tag\">Research</span>\n</div>\n</div>\n<section class=\"mx-auto max-w-[1200px] px-7 py-12\" data-kid=\"4\" data-name=\"selected work section\" id=\"work\">\n<div class=\"flex items-baseline justify-between border-b border-[#0B1B3A]/15 pb-3\" data-kid=\"4-1\" data-name=\"selected work heading row\">\n<h2 class=\"uppercase\" data-kid=\"4-1-1\" data-name=\"selected work heading\" style=\"font-family:'Bebas Neue', sans-serif; font-size:42px; letter-spacing:0.01em\">Selected work</h2>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#6E7889]\" data-kid=\"4-1-2\" data-name=\"project count label\">03 projects</span>\n</div>\n<article class=\"mt-6 grid gap-8 bg-[#0B1B3A] p-8 text-[#F4F1E8] md:grid-cols-[1.2fr_0.8fr] md:items-end\" data-kid=\"4-2\" data-name=\"featured project card\">\n<div data-kid=\"4-2-1\" data-name=\"featured project text column\">\n<div class=\"flex items-center justify-between\" data-kid=\"4-2-1-1\" data-name=\"featured project meta row\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.22em] text-[#F2C744]\" data-kid=\"4-2-1-1-1\" data-name=\"featured project category label\">Design system</span>\n<span class=\"font-mono text-[10px] text-[#8D9AAE]\" data-kid=\"4-2-1-1-2\" data-name=\"featured project year label\">2025</span>\n</div>\n<h3 class=\"mt-4 uppercase leading-[0.86]\" data-kid=\"4-2-1-2\" data-name=\"featured project title Kestrel\" style=\"font-family:'Bebas Neue', sans-serif; font-size:66px\">Kestrel</h3>\n<p class=\"mt-3 max-w-[48ch] text-[13.5px] leading-[1.8] text-[#F4F1E8]/72\" data-kid=\"4-2-1-3\" data-name=\"featured project description text\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n<a class=\"mt-5 inline-block border-b border-[#F2C744] pb-0.5 font-mono text-[9px] uppercase tracking-[0.2em] text-[#F2C744]\" data-kid=\"4-2-1-4\" data-name=\"featured project case study link\" href=\"#work\">Read case study</a>\n</div>\n<div class=\"grid grid-cols-3 gap-2 md:justify-self-end\" data-kid=\"4-2-2\" data-name=\"featured project stats grid\">\n<div class=\"border border-[#F4F1E8]/18 px-3 py-4\" data-kid=\"4-2-2-1\" data-name=\"teams stat box\"><p class=\"font-mono text-[8px] uppercase tracking-[0.18em] text-[#8D9AAE]\" data-kid=\"4-2-2-1-1\" data-name=\"teams stat label\">Teams</p><p class=\"mt-2 text-[22px] leading-none\" data-kid=\"4-2-2-1-2\" data-name=\"teams stat value\" style=\"font-family:'Bebas Neue', sans-serif\">04</p></div>\n<div class=\"border border-[#F4F1E8]/18 px-3 py-4\" data-kid=\"4-2-2-2\" data-name=\"components stat box\"><p class=\"font-mono text-[8px] uppercase tracking-[0.18em] text-[#8D9AAE]\" data-kid=\"4-2-2-2-1\" data-name=\"components stat label\">Components</p><p class=\"mt-2 text-[22px] leading-none\" data-kid=\"4-2-2-2-2\" data-name=\"components stat value\" style=\"font-family:'Bebas Neue', sans-serif\">240</p></div>\n<div class=\"border border-[#F4F1E8]/18 px-3 py-4\" data-kid=\"4-2-2-3\" data-name=\"year stat box\"><p class=\"font-mono text-[8px] uppercase tracking-[0.18em] text-[#8D9AAE]\" data-kid=\"4-2-2-3-1\" data-name=\"year stat label\">Year</p><p class=\"mt-2 text-[22px] leading-none\" data-kid=\"4-2-2-3-2\" data-name=\"year stat value\" style=\"font-family:'Bebas Neue', sans-serif\">25</p></div>\n</div>\n</article>\n<div class=\"mt-6 grid gap-px border-y border-[#0B1B3A]/15 md:grid-cols-2 md:divide-x md:divide-[#0B1B3A]/15\" data-kid=\"4-3\" data-name=\"project list grid\">\n<article class=\"py-7 md:pr-8\" data-kid=\"4-3-1\" data-name=\"booking app project card\">\n<div class=\"flex items-center justify-between\" data-kid=\"4-3-1-1\" data-name=\"booking app meta row\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#C8102E]\" data-kid=\"4-3-1-1-1\" data-name=\"booking app category label\">Booking app</span>\n<span class=\"font-mono text-[10px] text-[#6E7889]\" data-kid=\"4-3-1-1-2\" data-name=\"booking app year label\">2024</span>\n</div>\n<h3 class=\"mt-3 uppercase leading-[0.9]\" data-kid=\"4-3-1-2\" data-name=\"booking app title Tide and Timber\" style=\"font-family:'Bebas Neue', sans-serif; font-size:40px\">Tide &amp; Timber</h3>\n<p class=\"mt-2 max-w-[44ch] text-[13px] leading-[1.8] text-[#0B1B3A]/72\" data-kid=\"4-3-1-3\" data-name=\"booking app description text\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n<a class=\"mt-4 inline-flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.2em] text-[#0B1B3A]\" data-kid=\"4-3-1-4\" data-name=\"booking app case study link\" href=\"#work\">Read case study <span data-kid=\"4-3-1-4-1\" data-name=\"booking app external arrow icon\">↗</span></a>\n</article>\n<article class=\"py-7 md:pl-8\" data-kid=\"4-3-2\" data-name=\"editorial project card\">\n<div class=\"flex items-center justify-between\" data-kid=\"4-3-2-1\" data-name=\"editorial meta row\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#C8102E]\" data-kid=\"4-3-2-1-1\" data-name=\"editorial category label\">Editorial platform</span>\n<span class=\"font-mono text-[10px] text-[#6E7889]\" data-kid=\"4-3-2-1-2\" data-name=\"editorial year label\">2023</span>\n</div>\n<h3 class=\"mt-3 uppercase leading-[0.9]\" data-kid=\"4-3-2-2\" data-name=\"editorial title Loom Audio\" style=\"font-family:'Bebas Neue', sans-serif; font-size:40px\">Loom Audio</h3>\n<p class=\"mt-2 max-w-[44ch] text-[13px] leading-[1.8] text-[#0B1B3A]/72\" data-kid=\"4-3-2-3\" data-name=\"editorial description text\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n<a class=\"mt-4 inline-flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.2em] text-[#0B1B3A]\" data-kid=\"4-3-2-4\" data-name=\"editorial case study link\" href=\"#work\">Read case study <span data-kid=\"4-3-2-4-1\" data-name=\"editorial external arrow icon\">↗</span></a>\n</article>\n</div>\n</section>\n<section class=\"bg-[#0B1B3A] text-[#F4F1E8]\" data-kid=\"5\" data-name=\"experience section\" id=\"experience\">\n<div class=\"mx-auto max-w-[1200px] px-7 py-12\" data-kid=\"5-1\" data-name=\"experience inner container\">\n<div class=\"flex items-baseline justify-between border-b border-[#F4F1E8]/20 pb-3\" data-kid=\"5-1-1\" data-name=\"experience heading row\">\n<h2 class=\"uppercase\" data-kid=\"5-1-1-1\" data-name=\"experience heading\" style=\"font-family:'Bebas Neue', sans-serif; font-size:38px; letter-spacing:0.01em\">Experience</h2>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#8D9AAE]\" data-kid=\"5-1-1-2\" data-name=\"roles count label\">03 roles</span>\n</div>\n<div class=\"grid gap-8 pt-6 md:grid-cols-2\" data-kid=\"5-1-2\" data-name=\"experience role grid\">\n<div class=\"border-b border-[#F4F1E8]/12 pb-4\" data-kid=\"5-1-2-1\" data-name=\"fintrail role entry\">\n<div class=\"flex items-baseline justify-between gap-3\" data-kid=\"5-1-2-1-1\" data-name=\"fintrail company and date row\"><p class=\"uppercase\" data-kid=\"5-1-2-1-1-1\" data-name=\"fintrail company name\" style=\"font-family:'Bebas Neue', sans-serif; font-size:26px\">Fintrail</p><span class=\"font-mono text-[9px] uppercase tracking-[0.16em] text-[#8D9AAE]\" data-kid=\"5-1-2-1-1-2\" data-name=\"fintrail date range\">2022 — present</span></div>\n<p class=\"mt-1 text-[12.5px] text-[#F4F1E8]/72\" data-kid=\"5-1-2-1-2\" data-name=\"fintrail role description\">Senior product designer — payments, onboarding and the design system.</p>\n</div>\n<div class=\"border-b border-[#F4F1E8]/12 pb-4\" data-kid=\"5-1-2-2\" data-name=\"sundial studio role entry\">\n<div class=\"flex items-baseline justify-between gap-3\" data-kid=\"5-1-2-2-1\" data-name=\"sundial studio company and date row\"><p class=\"uppercase\" data-kid=\"5-1-2-2-1-1\" data-name=\"sundial studio company name\" style=\"font-family:'Bebas Neue', sans-serif; font-size:26px\">Sundial Studio</p><span class=\"font-mono text-[9px] uppercase tracking-[0.18em] text-[#8D9AAE]\" data-kid=\"5-1-2-2-1-2\" data-name=\"sundial studio date range\">2019 — 2022</span></div>\n<p class=\"mt-1 text-[12.5px] text-[#F4F1E8]/72\" data-kid=\"5-1-2-2-2\" data-name=\"sundial studio role description\">Product designer — booking and travel products for three clients.</p>\n</div>\n<div class=\"border-b border-[#F4F1E8]/12 pb-4\" data-kid=\"5-1-2-3\" data-name=\"pageturn press role entry\">\n<div class=\"flex items-baseline justify-between gap-3\" data-kid=\"5-1-2-3-1\" data-name=\"pageturn press company and date row\"><p class=\"uppercase\" data-kid=\"5-1-2-3-1-1\" data-name=\"pageturn press company name\" style=\"font-family:'Bebas Neue', sans-serif; font-size:26px\">Pageturn Press</p><span class=\"font-mono text-[10px] text-[#8D9AAE]\" data-kid=\"5-1-2-3-1-2\" data-name=\"pageturn press date range\">2017 — 2019</span></div>\n<p class=\"mt-1 text-[12.5px] text-[#F4F1E8]/72\" data-kid=\"5-1-2-3-2\" data-name=\"pageturn press role description\">Interface designer — digital editions of a 90-year-old imprint.</p>\n</div>\n</div>\n</div>\n</section>\n<div class=\"mx-auto grid max-w-[1200px] gap-10 px-7 py-12 md:grid-cols-2\" data-kid=\"6\" data-name=\"education and elsewhere two-column layout\">\n<section data-kid=\"6-1\" data-name=\"education section\" id=\"education\">\n<h2 class=\"uppercase\" data-kid=\"6-1-1\" data-name=\"education heading\" style=\"font-family:'Bebas Neue', sans-serif; font-size:32px; letter-spacing:0.01em\">Education</h2>\n<div class=\"mt-4 border-t border-[#0B1B3A]/15\" data-kid=\"6-1-2\" data-name=\"education entries list\">\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#0B1B3A]/12 py-3.5\" data-kid=\"6-1-2-1\" data-name=\"national institute entry row\">\n<div data-kid=\"6-1-2-1-1\" data-name=\"national institute school and field\"><p class=\"text-[14px] font-semibold\" data-kid=\"6-1-2-1-1-1\" data-name=\"national institute school name\">National Institute of Design</p><p class=\"text-[12px] text-[#6E7889]\" data-kid=\"6-1-2-1-1-2\" data-name=\"national institute field of study\">Interaction design</p></div>\n<span class=\"font-mono text-[10px] text-[#6E7889]\" data-kid=\"6-1-2-1-2\" data-name=\"national institute date range\">2015 — 2017</span>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#0B1B3A]/12 py-3.5\" data-kid=\"6-1-2-2\" data-name=\"srishti entry row\">\n<div data-kid=\"6-1-2-2-1\" data-name=\"srishti school and field\"><p class=\"text-[14px] font-semibold\" data-kid=\"6-1-2-2-1-1\" data-name=\"srishti school name\">Srishti Institute</p><p class=\"text-[12px] text-[#6E7889]\" data-kid=\"6-1-2-2-1-2\" data-name=\"srishti field of study\">Foundation studies</p></div>\n<span class=\"font-mono text-[10px] text-[#6E7889]\" data-kid=\"6-1-2-2-2\" data-name=\"srishti date range\">2013 — 2015</span>\n</div>\n</div>\n</section>\n<section data-kid=\"6-2\" data-name=\"elsewhere section\" id=\"elsewhere\">\n<h2 class=\"uppercase\" data-kid=\"6-2-1\" data-name=\"elsewhere heading\" style=\"font-family:'Bebas Neue', sans-serif; font-size:34px; letter-spacing:0.01em\">Elsewhere</h2>\n<div class=\"mt-4 grid grid-cols-2 gap-2\" data-kid=\"6-2-2\" data-name=\"elsewhere link grid\">\n<a class=\"flex items-center justify-between border border-[#0B1B3A]/16 px-4 py-3 text-[11px] font-semibold\" data-kid=\"6-2-2-1\" data-name=\"github link\" href=\"#elsewhere\">GitHub <span class=\"text-[#C8102E]\" data-kid=\"6-2-2-1-1\" data-name=\"github external arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#0B1B3A]/15 px-4 py-3 text-[11px] font-semibold\" data-kid=\"6-2-2-2\" data-name=\"dribbble link\" href=\"#elsewhere\">Dribbble <span class=\"text-[#C8102E]\" data-kid=\"6-2-2-2-1\" data-name=\"dribbble external arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#0B1B3A]/15 px-4 py-3 text-[11px] font-semibold\" data-kid=\"6-2-2-3\" data-name=\"linkedin link\" href=\"#elsewhere\">LinkedIn <span class=\"text-[#C8102E]\" data-kid=\"6-2-2-3-1\" data-name=\"linkedin external arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#0B1B3A]/15 px-4 py-3 text-[11px] font-semibold\" data-kid=\"6-2-2-4\" data-name=\"email link\" href=\"#elsewhere\">Email <span class=\"text-[#C8102E]\" data-kid=\"6-2-2-4-1\" data-name=\"email external arrow icon\">↗</span></a>\n</div>\n</section>\n</div>\n<footer class=\"border-t border-[#0B1B3A]/15\" data-kid=\"7\" data-name=\"site footer bar\">\n<div class=\"mx-auto flex max-w-[1200px] items-center justify-between px-7 py-5 font-mono text-[9px] uppercase tracking-[0.22em] text-[#6E7889]\" data-kid=\"7-1\" data-name=\"footer inner row\">\n<span data-kid=\"7-1-1\" data-name=\"footer owner name\">Aarav Menon</span><a data-kid=\"7-1-2\" data-name=\"back to top link\" href=\"#top\">Back to top</a>\n</div>\n</footer>\n<script>\n    const rings = document.getElementById('rings');\n    const hero = document.getElementById('top');\n    if (rings && hero) {\n      hero.addEventListener('pointermove', function (event) {\n        const rect = hero.getBoundingClientRect();\n        const px = (event.clientX - rect.left) / rect.width - 0.5;\n        const py = (event.clientY - rect.top) / rect.height - 0.5;\n        rings.style.transform = 'translate3d(' + (px * 34).toFixed(1) + 'px,' + (py * 26).toFixed(1) + 'px,0)';\n      });\n    }\n    const mark = document.getElementById('mark');\n    if (mark) {\n      mark.addEventListener('click', function () {\n        const on = mark.getAttribute('aria-pressed') === 'true';\n        mark.setAttribute('aria-pressed', on ? 'false' : 'true');\n        mark.style.background = on ? '#C8102E' : '#0B1B3A';\n        mark.style.color = '#F4F1E8';\n        mark.style.boxShadow = on ? 'none' : '0 0 0 1px #C8102E, 0 0 0 6px rgba(200,16,46,0.2)';\n      });\n    }\n  </script>\n</body>",
