    },
    "var_e0c673694364": {
      "type": "variant",
      "label": "Arc Reactor — Iron Man template",
      "parentId": "var_100ec6c3a362",
      "themeId": null,
      "rect": {
        "x": 2920,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<body class=\"bg-[#17170E] text-[#F5F5F1] antialiased\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Barlow:wght@300;400;500;600;700&display=swap');\n    body { font-family: Barlow, sans-serif; }\n    .mach { font-family: 'Chakra Petch', sans-serif; }\n    .plate { clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px)); }\n    .plate-sm { clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px)); }\n    .tabnum { font-variant-numeric: tabular-nums; }\n    .well { background: #141410; box-shadow: inset 0 2px 7px rgba(0, 0, 0, 0.9), inset 0 -1px 0 rgba(118, 220, 210, 0.16); }\n    .well-light { background: #E9EAE2; box-shadow: inset 0 2px 5px rgba(23, 23, 14, 0.09), inset 0 -1px 0 rgba(255, 255, 255, 0.8); }\n    .nav-glass { background: rgba(23, 23, 14, 0.88); backdrop-filter: blur(14px); }\n    .hull-grid { background-image: linear-gradient(rgba(25, 100, 126, 0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(25, 100, 126, 0.07) 1px, transparent 1px); background-size: 44px 44px; }\n    ::selection { background: #FFF44F; color: #17170E; }\n  </style>\n<nav class=\"nav-glass sticky top-0 z-50 border-b border-[#76DCD2]/20\" data-kid=\"1\" data-name=\"sticky glass top navigation\">\n<div class=\"mx-auto flex h-16 max-w-[1160px] items-center justify-between px-8\" data-kid=\"1-1\" data-name=\"nav bar inner layout container\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand logo group\">\n<span class=\"plate-sm grid h-9 w-9 place-items-center bg-[#FFF44F] text-[13px] font-bold text-[#17170E] mach\" data-kid=\"1-1-1-1\" data-name=\"brand monogram badge\">AM</span>\n<span class=\"mach text-[13px] font-semibold uppercase tracking-[0.16em]\" data-kid=\"1-1-1-2\" data-name=\"brand name label\">Aarav Menon</span>\n</div>\n<div class=\"mach hidden items-center gap-7 text-[10.5px] uppercase tracking-[0.18em] text-[#A9B2A6] md:flex\" data-kid=\"1-1-2\" data-name=\"primary nav link group\">\n<a class=\"hover:text-[#FFF44F]\" data-kid=\"1-1-2-1\" data-name=\"navigation link to selected work\" href=\"#work\">Selected work</a>\n<a class=\"hover:text-[#FFF44F]\" data-kid=\"1-1-2-2\" data-name=\"navigation link to experience\" href=\"#experience\">Experience</a>\n<a class=\"hover:text-[#FFF44F]\" data-kid=\"1-1-2-3\" data-name=\"navigation link to education\" href=\"#education\">Education</a>\n<a class=\"hover:text-[#FFF44F]\" data-kid=\"1-1-2-4\" data-name=\"navigation link to elsewhere\" href=\"#elsewhere\">Elsewhere</a>\n</div>\n<span class=\"mach flex items-center gap-2 rounded-full border border-[#76DCD2]/40 px-3.5 py-2 text-[10px] uppercase tracking-[0.16em] text-[#76DCD2]\" data-kid=\"1-1-3\" data-name=\"location status badge\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-[#3BE07A]\" data-kid=\"1-1-3-1\" data-name=\"available status dot indicator\"></span> Bengaluru, India\n      </span>\n</div>\n</nav>\n<!-- HERO -->\n<header class=\"hull-grid relative overflow-hidden bg-[#F5F5F1] text-[#17170E]\" data-kid=\"2\" data-name=\"hero section with hull grid background\" id=\"top\">\n<div class=\"absolute left-0 top-0 h-px w-full bg-[#19647E]/25\" data-kid=\"2-1\" data-name=\"hero top accent hairline\"></div>\n<div class=\"mx-auto grid max-w-[1160px] grid-cols-[1.12fr_0.88fr] gap-12 px-8 pb-10 pt-14\" data-kid=\"2-2\" data-name=\"hero two-column layout container\">\n<div class=\"flex flex-col\" data-kid=\"2-2-1\" data-name=\"hero left content column\">\n<div data-kid=\"2-2-1-1\" data-name=\"hero name and role block\" id=\"nameBlock\">\n<h1 class=\"mach text-[82px] font-bold uppercase leading-[0.86] tracking-[0.005em] text-[#17170E]\" data-kid=\"2-2-1-1-1\" data-name=\"hero headline with name\">\n            Aarav<br data-kid=\"2-2-1-1-1-1\" data-name=\"line break in headline text\"/>Menon\n          </h1>\n<p class=\"mach mt-4 min-h-[20px] text-[13px] uppercase tracking-[0.2em] text-[#19647E]\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2\" data-name=\"hero role subtitle with decode effect\" data-reason=\"text is re-typed from data-text by the decode script on load and on pointerenter\" data-text=\"Interface designer — Bengaluru, India\" id=\"decode\">Interface designer — Bengaluru, India</p>\n</div>\n<p class=\"mt-7 max-w-[38ch] text-[16.5px] leading-[1.7] text-[#3D4238]\" data-kid=\"2-2-1-2\" data-name=\"hero intro paragraph\">\n          I design booking, payment and publishing interfaces.\n        </p>\n<div class=\"mt-9 flex items-center gap-4\" data-kid=\"2-2-1-3\" data-name=\"hero actions row\">\n<button class=\"plate relative h-[52px] overflow-hidden bg-[#19647E] px-7 text-left\" data-kid=\"2-2-1-3-1\" data-name=\"hold-to-copy-email charge button\" id=\"charge\">\n<span class=\"absolute inset-0 origin-left bg-[#FFF44F]\" data-dynamic=\"true\" data-kid=\"2-2-1-3-1-1\" data-name=\"charge fill progress overlay\" data-reason=\"scaleX transform driven by pointer hold charge script\" id=\"chargeFill\" style=\"transform: scaleX(0)\"></span>\n<span class=\"relative flex items-center gap-3\" data-kid=\"2-2-1-3-1-2\" data-name=\"charge button label container\">\n<i class=\"bi bi-envelope text-[15px] text-[#76DCD2]\" data-kid=\"2-2-1-3-1-2-1\" data-name=\"envelope icon in charge button\"></i>\n<span class=\"mach text-[12.5px] font-semibold uppercase tracking-[0.14em] text-[#F5F5F1]\" data-dynamic=\"true\" data-kid=\"2-2-1-3-1-2-2\" data-name=\"charge button label text\" data-reason=\"text replaced with copied confirmation on commit, and color styled by script\" id=\"chargeLabel\">Hold to copy email</span>\n</span>\n</button>\n<a class=\"mach inline-flex items-center gap-2 text-[11.5px] uppercase tracking-[0.16em] text-[#19647E]\" data-kid=\"2-2-1-3-2\" data-name=\"see the work scroll link\" href=\"#work\">\n            See the work <i class=\"bi bi-arrow-down-right text-[13px]\" data-kid=\"2-2-1-3-2-1\" data-name=\"down-right arrow icon\"></i>\n</a>\n</div>\n<div class=\"mt-auto grid grid-cols-3 gap-3 pt-12\" data-kid=\"2-2-1-4\" data-name=\"hero stat wells row\">\n<div class=\"well-light rounded-[10px] px-4 py-3\" data-kid=\"2-2-1-4-1\" data-name=\"current company stat well\">\n<div class=\"mach text-[9px] uppercase tracking-[0.18em] text-[#7E8677]\" data-kid=\"2-2-1-4-1-1\" data-name=\"stat well label text\">Currently</div>\n<div class=\"mach mt-1 text-[13px] font-semibold\" data-kid=\"2-2-1-4-1-2\" data-name=\"stat well value text\">Fintrail</div>\n</div>\n<div class=\"well-light rounded-[10px] px-4 py-3\" data-kid=\"2-2-1-4-2\" data-name=\"years active stat well\">\n<div class=\"mach text-[9px] uppercase tracking-[0.18em] text-[#7E8677]\" data-kid=\"2-2-1-4-2-1\" data-name=\"stat well label text\">Since</div>\n<div class=\"mach tabnum mt-1 text-[13px] font-semibold\" data-kid=\"2-2-1-4-2-2\" data-name=\"stat well value text\">2017</div>\n</div>\n<div class=\"well-light rounded-[10px] px-4 py-3\" data-kid=\"2-2-1-4-3\" data-name=\"projects count stat well\">\n<div class=\"mach text-[9px] uppercase tracking-[0.18em] text-[#7E8677]\" data-kid=\"2-2-1-4-3-1\" data-name=\"stat well label text\">Projects</div>\n<div class=\"mach tabnum mt-1 text-[13px] font-semibold\" data-kid=\"2-2-1-4-3-2\" data-name=\"stat well value text\">03</div>\n</div>\n</div>\n</div>\n<div class=\"relative\" data-kid=\"2-2-2\" data-name=\"hero visor tilt container\" style=\"perspective: 1000px\">\n<div class=\"relative h-[452px] w-full overflow-hidden rounded-[24px] bg-[#0F0F0A] shadow-[0_20px_50px_-24px_rgba(23,23,14,0.6)]\" data-dynamic=\"true\" data-kid=\"2-2-2-1\" data-name=\"tilting visor with portrait and rings\" data-reason=\"rotationX/rotationY set by pointermove tilt script\" id=\"visor\">\n<img alt=\"Machined teal-anodised armour plate\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"2-2-2-1-1\" data-name=\"visor background plate image\" src=\"https://kombai-assets.b-cdn.net/generated_assets/25a8545c-6e51-4932-8e4b-baebb7211eab/ea7586e3d6f04c239dba8b18da8dd344.jpg\"/>\n<div class=\"absolute inset-0 bg-[#0B0B07]/58\" data-kid=\"2-2-2-1-2\" data-name=\"visor image dark tint overlay\"></div>\n<svg aria-hidden=\"true\" class=\"absolute inset-0 h-full w-full\" data-kid=\"2-2-2-1-3\" data-name=\"decorative orbital rings SVG\" viewbox=\"0 0 400 452\">\n<g transform=\"translate(200,226)\">\n<g id=\"ringA\">\n<circle fill=\"none\" opacity=\"0.95\" r=\"112\" stroke=\"#76DCD2\" stroke-dasharray=\"3 7\" stroke-width=\"1.2\"></circle>\n</g>\n<g id=\"ringB\">\n<circle fill=\"none\" opacity=\"0.85\" r=\"150\" stroke=\"#FFF44F\" stroke-dasharray=\"52 18\" stroke-width=\"1.6\"></circle>\n</g>\n<g id=\"ringC\" opacity=\"0.7\">\n<circle fill=\"none\" r=\"176\" stroke=\"#76DCD2\" stroke-dasharray=\"1 19\" stroke-width=\"0.8\"></circle>\n</g>\n<line opacity=\"0.6\" stroke=\"#FFF44F\" stroke-width=\"1\" x1=\"-172\" x2=\"-150\" y1=\"0\" y2=\"0\"></line>\n<line opacity=\"0.6\" stroke=\"#FFF44F\" stroke-width=\"1\" x1=\"150\" x2=\"172\" y1=\"0\" y2=\"0\"></line>\n<line opacity=\"0.6\" stroke=\"#FFF44F\" stroke-width=\"1\" x1=\"0\" x2=\"0\" y1=\"-196\" y2=\"-176\"></line>\n<line opacity=\"0.6\" stroke=\"#FFF44F\" stroke-width=\"1\" x1=\"0\" x2=\"0\" y1=\"176\" y2=\"196\"></line>\n</g>\n</svg>\n<div class=\"pointer-events-none absolute left-1/2 top-0 h-full w-px bg-[#76DCD2]/35\" data-dynamic=\"true\" data-kid=\"2-2-2-1-4\" data-name=\"vertical crosshair line\" data-reason=\"x position driven by pointermove script\" id=\"crossV\"></div>\n<div class=\"pointer-events-none absolute left-0 top-1/2 h-px w-full bg-[#76DCD2]/35\" data-dynamic=\"true\" data-kid=\"2-2-2-1-5\" data-name=\"horizontal crosshair line\" data-reason=\"y position driven by pointermove script\" id=\"crossH\"></div>\n<div class=\"absolute left-1/2 top-1/2 h-[138px] w-[138px] -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-full ring-2 ring-[#FFF44F]/80\" data-kid=\"2-2-2-1-6\" data-name=\"circular portrait ring container\">\n<img alt=\"Aarav Menon portrait\" class=\"h-full w-full object-cover\" data-kid=\"2-2-2-1-6-1\" data-name=\"portrait image\" src=\"https://i.pravatar.cc/320?u=aarav-menon\"/>\n</div>\n<div class=\"absolute bottom-4 left-4 flex items-center gap-2\" data-kid=\"2-2-2-1-7\" data-name=\"visor bottom-left role tag container\">\n<span class=\"plate-sm bg-[#17170E]/85 px-3 py-1.5 mach text-[9px] uppercase tracking-[0.16em] text-[#76DCD2]\" data-kid=\"2-2-2-1-7-1\" data-name=\"role tag label\">Interface designer</span>\n</div>\n<div class=\"absolute bottom-4 right-4 mach tabnum text-[9px] uppercase tracking-[0.16em] text-[#76DCD2]/75\" data-kid=\"2-2-2-1-8\" data-name=\"years active text badge\">2017 — 2025</div>\n</div>\n</div>\n</div>\n</header>\n<!-- ABOUT -->\n<section class=\"relative bg-[#19647E] text-[#F5F5F1]\" data-kid=\"3\" data-name=\"about section with teal background\">\n<div class=\"mx-auto grid max-w-[1160px] grid-cols-[0.82fr_1.18fr] gap-14 px-8 py-16\" data-kid=\"3-1\" data-name=\"two-column about layout container\">\n<div data-kid=\"3-1-1\" data-name=\"about left column with skill tags\">\n<h2 class=\"mach text-[34px] font-medium leading-none\" data-kid=\"3-1-1-1\" data-name=\"about section heading\">About</h2>\n<div class=\"mt-7 flex flex-wrap gap-2\" data-kid=\"3-1-1-2\" data-name=\"skill tag container\">\n<span class=\"rounded-full border border-[#76DCD2]/45 px-3.5 py-2 text-[11.5px] text-[#DDF3F6]\" data-kid=\"3-1-1-2-1\" data-name=\"skill tag: design systems\">Design systems</span>\n<span class=\"rounded-full border border-[#76DCD2]/40 px-3.5 py-2 text-[11.5px] text-[#EAF3F5]\" data-kid=\"3-1-1-2-2\" data-name=\"skill tag: interaction design\">Interaction design</span>\n<span class=\"rounded-full border border-[#76DCD2]/30 px-3.5 py-2 text-[11.5px] text-[#EAF3F5]\" data-kid=\"3-1-1-2-3\" data-name=\"skill tag: prototyping\">Prototyping</span>\n<span class=\"rounded-full border border-[#76DCD2]/28 px-3.5 py-2 text-[11.5px] text-[#EAF3F5]\" data-kid=\"3-1-1-2-4\" data-name=\"skill tag: motion\">Motion</span>\n<span class=\"rounded-full border border-[#76DCD2]/22 px-3.5 py-2 text-[11.5px] text-[#EAF3F5]\" data-kid=\"3-1-1-2-5\" data-name=\"skill tag: type\">Type</span>\n<span class=\"rounded-full border border-[#76DCD2]/18 px-3.5 py-2 text-[11.5px] text-[#EAF3F5]\" data-kid=\"3-1-1-2-6\" data-name=\"skill tag: research\">Research</span>\n</div>\n</div>\n<div class=\"border-l border-[#76DCD2]/25 pl-10\" data-kid=\"3-1-2\" data-name=\"about right column with copy and meta\">\n<p class=\"max-w-[54ch] text-[19px] leading-[1.65] text-[#F0F7F8]\" data-kid=\"3-1-2-1\" data-name=\"about body paragraph\">\n          I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n        </p>\n<div class=\"mt-8 grid grid-cols-3 gap-x-8 gap-y-4 border-t border-[#76DCD2]/25 pt-6\" data-kid=\"3-1-2-2\" data-name=\"about quick-facts grid\">\n<div data-kid=\"3-1-2-2-1\" data-name=\"current role quick fact\">\n<div class=\"mach text-[9px] uppercase tracking-[0.2em] text-[#A8D8E0]\" data-kid=\"3-1-2-2-1-1\" data-name=\"quick fact label\">Senior designer</div>\n<div class=\"mach mt-1 text-[13px]\" data-kid=\"3-1-2-2-1-2\" data-name=\"quick fact value\">Fintrail</div>\n</div>\n<div data-kid=\"3-1-2-2-2\" data-name=\"based in quick fact\">\n<div class=\"mach text-[9px] uppercase tracking-[0.2em] text-[#A8D8E0]\" data-kid=\"3-1-2-2-2-1\" data-name=\"quick fact label\">Based in</div>\n<div class=\"mach mt-1 text-[13px]\" data-kid=\"3-1-2-2-2-2\" data-name=\"quick fact value\">Bengaluru</div>\n</div>\n<div data-kid=\"3-1-2-2-3\" data-name=\"education quick fact\">\n<div class=\"mach text-[9px] uppercase tracking-[0.2em] text-[#A8D8E0]\" data-kid=\"3-1-2-2-3-1\" data-name=\"quick fact label\">Education</div>\n<div class=\"mach mt-1 text-[13px]\" data-kid=\"3-1-2-2-3-2\" data-name=\"quick fact value\">NID, 2017</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- WORK -->\n<section class=\"bg-[#17170E]\" data-kid=\"4\" data-name=\"work section\" id=\"work\">\n<div class=\"mx-auto max-w-[1160px] px-8 py-16\" data-kid=\"4-1\" data-name=\"work section content container\">\n<div class=\"flex items-end justify-between border-b border-[#76DCD2]/22 pb-4\" data-kid=\"4-1-1\" data-name=\"work section header row\">\n<h2 class=\"mach text-[34px] font-medium leading-none\" data-kid=\"4-1-1-1\" data-name=\"work section heading\">Selected work</h2>\n<span class=\"mach tabnum text-[10.5px] uppercase tracking-[0.18em] text-[#8C9A92]\" data-kid=\"4-1-1-2\" data-name=\"work project count badge\">03 projects</span>\n</div>\n<div class=\"mt-6 grid grid-cols-[1.32fr_1fr] gap-5\" data-kid=\"4-1-2\" data-name=\"work projects grid\">\n<article class=\"plate-anim relative\" data-dynamic=\"true\" data-kid=\"4-1-2-1\" data-name=\"featured project card: Kestrel\" data-reason=\"clip-path entrance animation via gsap scrollTrigger\">\n<span class=\"edge plate pointer-events-none absolute inset-0 border border-[#76DCD2]\" data-dynamic=\"true\" data-kid=\"4-1-2-1-1\" data-name=\"project card edge border overlay\" data-reason=\"opacity animated by gsap scrollTrigger\" style=\"opacity: 0\"></span>\n<div class=\"plate bg-[#76DCD2]/28 p-px\" data-kid=\"4-1-2-1-2\" data-name=\"project card outer plate frame\">\n<div class=\"plate overflow-hidden bg-[#1C1C14]\" data-kid=\"4-1-2-1-2-1\" data-name=\"project card inner plate\">\n<div class=\"relative h-[188px] overflow-hidden\" data-kid=\"4-1-2-1-2-1-1\" data-name=\"project card image container\">\n<img alt=\"Technical schematic of a machined shoulder assembly\" class=\"h-full w-full object-cover\" data-kid=\"4-1-2-1-2-1-1-1\" data-name=\"project card image\" src=\"https://kombai-assets.b-cdn.net/generated_assets/25a8545c-6e51-4932-8e4b-baebb7211eab/858e7dfd501d40bba37092f8fc67f5a3.jpg\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-[#1C1C14] via-transparent to-transparent\" data-kid=\"4-1-2-1-2-1-1-2\" data-name=\"image gradient fade overlay\"></div>\n<span class=\"mach absolute left-4 top-3 tabnum text-[10px] uppercase tracking-[0.2em] text-[#76DCD2]\" data-kid=\"4-1-2-1-2-1-1-3\" data-name=\"project index number badge\">01</span>\n</div>\n<div class=\"px-6 pb-6 pt-4\" data-kid=\"4-1-2-1-2-1-2\" data-name=\"project card content block\">\n<div class=\"flex items-baseline justify-between gap-4\" data-kid=\"4-1-2-1-2-1-2-1\" data-name=\"project title row\">\n<h3 class=\"mach text-[27px] font-medium leading-none text-[#F5F5F1]\" data-kid=\"4-1-2-1-2-1-2-1-1\" data-name=\"project title heading\">Kestrel</h3>\n<span class=\"mach tabnum text-[10.5px] uppercase tracking-[0.16em] text-[#8C9A92]\" data-kid=\"4-1-2-1-2-1-2-1-2\" data-name=\"project year label\">2025</span>\n</div>\n<div class=\"mach mt-2 text-[10.5px] uppercase tracking-[0.2em] text-[#F4D35E]\" data-kid=\"4-1-2-1-2-1-2-2\" data-name=\"project category label\">Design system</div>\n<p class=\"mt-4 max-w-[46ch] text-[13.5px] leading-[1.7] text-[#C4C7BB]\" data-kid=\"4-1-2-1-2-1-2-3\" data-name=\"project description text\">\n                  A 240-component library and the token pipeline behind it, adopted by four product teams.\n                </p>\n<a class=\"mt-5 inline-flex items-center gap-2 text-[12.5px] font-medium text-[#76DCD2] hover:text-[#FFF44F]\" data-kid=\"4-1-2-1-2-1-2-4\" data-name=\"read case study link\" href=\"#\">\n                  Read case study <i class=\"bi bi-arrow-right text-[12px]\" data-kid=\"4-1-2-1-2-1-2-4-1\" data-name=\"right arrow icon\"></i>\n</a>\n</div>\n</div>\n</div>\n</article>\n<div class=\"flex flex-col gap-5\" data-kid=\"4-1-2-2\" data-name=\"compact project cards column\">\n<article class=\"plate-anim relative\" data-dynamic=\"true\" data-kid=\"4-1-2-2-1\" data-name=\"compact project card: Tide &amp; Timber\" data-reason=\"clip-path entrance animation via gsap scrollTrigger\">\n<span class=\"edge plate pointer-events-none absolute inset-0 border border-[#76DCD2]\" data-dynamic=\"true\" data-kid=\"4-1-2-2-1-1\" data-name=\"project card edge border overlay\" data-reason=\"opacity animated by gsap scrollTrigger\" style=\"opacity: 0\"></span>\n<div class=\"plate bg-[#76DCD2]/24 p-px\" data-kid=\"4-1-2-2-1-2\" data-name=\"project card outer plate frame\">\n<div class=\"plate bg-[#1C1C14] px-5 py-5\" data-kid=\"4-1-2-2-1-2-1\" data-name=\"project card inner plate\">\n<div class=\"flex items-baseline justify-between gap-3\" data-kid=\"4-1-2-2-1-2-1-1\" data-name=\"project title row\">\n<h3 class=\"mach text-[21px] font-medium leading-none text-[#F5F5F1]\" data-kid=\"4-1-2-2-1-2-1-1-1\" data-name=\"project title heading\">Tide &amp; Timber</h3>\n<span class=\"mach tabnum text-[10px] uppercase tracking-[0.16em] text-[#8C9A92]\" data-kid=\"4-1-2-2-1-2-1-1-2\" data-name=\"project year label\">2024</span>\n</div>\n<div class=\"mach mt-2 text-[10px] uppercase tracking-[0.2em] text-[#F4D35E]\" data-kid=\"4-1-2-2-1-2-1-2\" data-name=\"project category label\">Booking app</div>\n<p class=\"mt-3 text-[13px] leading-[1.65] text-[#C4C7BB]\" data-kid=\"4-1-2-2-1-2-1-3\" data-name=\"project description text\">\n                  Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.\n                </p>\n<a class=\"mt-4 inline-flex items-center gap-2 text-[12px] font-medium text-[#76DCD2] hover:text-[#FFF44F]\" data-kid=\"4-1-2-2-1-2-1-4\" data-name=\"read case study link\" href=\"#\">\n                  Read case study <i class=\"bi bi-arrow-right text-[11px]\" data-kid=\"4-1-2-2-1-2-1-4-1\" data-name=\"right arrow icon\"></i>\n</a>\n</div>\n</div>\n</article>\n<article class=\"plate-anim relative\" data-dynamic=\"true\" data-kid=\"4-1-2-2-2\" data-name=\"compact project card: Loom Audio\" data-reason=\"clip-path entrance animation via gsap scrollTrigger\">\n<span class=\"edge plate pointer-events-none absolute inset-0 border border-[#76DCD2]\" data-dynamic=\"true\" data-kid=\"4-1-2-2-2-1\" data-name=\"project card edge border overlay\" data-reason=\"opacity animated by gsap scrollTrigger\" style=\"opacity: 0\"></span>\n<div class=\"plate bg-[#76DCD2]/22 p-px\" data-kid=\"4-1-2-2-2-2\" data-name=\"project card outer plate frame\">\n<div class=\"plate bg-[#1C1C14] px-5 py-5\" data-kid=\"4-1-2-2-2-2-1\" data-name=\"project card inner plate\">\n<div class=\"flex items-baseline justify-between gap-3\" data-kid=\"4-1-2-2-2-2-1-1\" data-name=\"project title row\">\n<h3 class=\"mach text-[21px] font-medium leading-none text-[#F5F5F1]\" data-kid=\"4-1-2-2-2-2-1-1-1\" data-name=\"project title heading\">Loom Audio</h3>\n<span class=\"mach tabnum text-[10px] uppercase tracking-[0.16em] text-[#8C9A92]\" data-kid=\"4-1-2-2-2-2-1-1-2\" data-name=\"project year label\">2023</span>\n</div>\n<div class=\"mach mt-2 text-[10px] uppercase tracking-[0.2em] text-[#F4D35E]\" data-kid=\"4-1-2-2-2-2-1-2\" data-name=\"project category label\">Editorial platform</div>\n<p class=\"mt-3 text-[13px] leading-[1.65] text-[#C4C7BB]\" data-kid=\"4-1-2-2-2-2-1-3\" data-name=\"project description text\">\n                  A reading surface for long-form audio transcripts, built for one-handed use.\n                </p>\n<a class=\"mt-4 inline-flex items-center gap-2 text-[12px] font-medium text-[#76DCD2] hover:text-[#FFF44F]\" data-kid=\"4-1-2-2-2-2-1-4\" data-name=\"read case study link\" href=\"#\">\n                  Read case study <i class=\"bi bi-arrow-right text-[11px]\" data-kid=\"4-1-2-2-2-2-1-4-1\" data-name=\"right arrow icon\"></i>\n</a>\n</div>\n</div>\n</article>\n</div>\n</div>\n</div>\n</section>\n<!-- EXPERIENCE -->\n<section class=\"relative overflow-x-clip bg-[#17170E] pb-14 pt-2\" data-kid=\"5\" data-name=\"experience section\" id=\"experience\">\n<div class=\"mx-auto max-w-[1160px] px-8\" data-kid=\"5-1\" data-name=\"experience section content container\">\n<div class=\"flex items-end justify-between border-b border-[#76DCD2]/22 pb-4\" data-kid=\"5-1-1\" data-name=\"experience section header row\">\n<h2 class=\"mach text-[34px] font-medium leading-none\" data-kid=\"5-1-1-1\" data-name=\"experience section heading\">Experience</h2>\n<span class=\"mach tabnum text-[10.5px] uppercase tracking-[0.18em] text-[#8C9A92]\" data-kid=\"5-1-1-2\" data-name=\"roles count badge\">03 roles</span>\n</div>\n<div class=\"py-9\" data-kid=\"5-1-2\" data-name=\"experience tilt container\">\n<div class=\"flex flex-col gap-3\" data-dynamic=\"true\" data-kid=\"5-1-2-1\" data-name=\"tilted experience roles grid\" data-reason=\"rotation and x/y offsets driven by pointermove script\" id=\"tiltGrid\" style=\"width: 104%; margin-left: -2%\">\n<div class=\"well flex items-center justify-between gap-6 rounded-[10px] px-6 py-5\" data-dynamic=\"true\" data-kid=\"5-1-2-1-1\" data-name=\"experience row: Fintrail\" data-reason=\"rotation transform set by gsap on load\" style=\"transform: rotate(5deg)\">\n<div class=\"flex items-baseline gap-5\" data-kid=\"5-1-2-1-1-1\" data-name=\"role details group\">\n<span class=\"mach tabnum text-[10px] uppercase tracking-[0.18em] text-[#F4D35E]\" data-kid=\"5-1-2-1-1-1-1\" data-name=\"role duration badge\">2022 —</span>\n<div data-kid=\"5-1-2-1-1-1-2\" data-name=\"role company and title\">\n<div class=\"mach text-[19px] font-medium text-[#F5F5F1]\" data-kid=\"5-1-2-1-1-1-2-1\" data-name=\"role company name\">Fintrail</div>\n<div class=\"text-[13px] text-[#9FB0A6]\" data-kid=\"5-1-2-1-1-1-2-2\" data-name=\"role job title text\">Senior product designer</div>\n</div>\n</div>\n<i class=\"bi bi-arrow-up-right text-[15px] text-[#76DCD2]\" data-kid=\"5-1-2-1-1-2\" data-name=\"external link up-right arrow icon\"></i>\n</div>\n<div class=\"well flex items-center justify-between gap-6 rounded-[10px] px-6 py-5\" data-dynamic=\"true\" data-kid=\"5-1-2-1-2\" data-name=\"experience row: Sundial Studio\" data-reason=\"rotation transform set by gsap on load\" style=\"transform: rotate(5deg)\">\n<div class=\"flex items-baseline gap-5\" data-kid=\"5-1-2-1-2-1\" data-name=\"role details group\">\n<span class=\"mach tabnum text-[10px] uppercase tracking-[0.18em] text-[#F4D35E]\" data-kid=\"5-1-2-1-2-1-1\" data-name=\"role duration badge\">2019 — 22</span>\n<div data-kid=\"5-1-2-1-2-1-2\" data-name=\"role company and title\">\n<div class=\"mach text-[19px] font-medium text-[#F5F5F1]\" data-kid=\"5-1-2-1-2-1-2-1\" data-name=\"role company name\">Sundial Studio</div>\n<div class=\"text-[13px] text-[#9FB0A6]\" data-kid=\"5-1-2-1-2-1-2-2\" data-name=\"role job title text\">Product designer</div>\n</div>\n</div>\n<i class=\"bi bi-arrow-up-right text-[15px] text-[#76DCD2]\" data-kid=\"5-1-2-1-2-2\" data-name=\"external link up-right arrow icon\"></i>\n</div>\n<div class=\"well flex items-center justify-between gap-6 rounded-[10px] px-6 py-5\" data-dynamic=\"true\" data-kid=\"5-1-2-1-3\" data-name=\"experience row: Pageturn Press\" data-reason=\"rotation transform set by gsap on load\" style=\"transform: rotate(5deg)\">\n<div class=\"flex items-baseline gap-5\" data-kid=\"5-1-2-1-3-1\" data-name=\"role details group\">\n<span class=\"mach tabnum text-[10px] uppercase tracking-[0.18em] text-[#F4D35E]\" data-kid=\"5-1-2-1-3-1-1\" data-name=\"role duration badge\">2017 — 19</span>\n<div data-kid=\"5-1-2-1-3-1-2\" data-name=\"role company and title\">\n<div class=\"mach text-[19px] font-medium text-[#F5F5F1]\" data-kid=\"5-1-2-1-3-1-2-1\" data-name=\"role company name\">Pageturn Press</div>\n<div class=\"text-[13px] text-[#9FB0A6]\" data-kid=\"5-1-2-1-3-1-2-2\" data-name=\"role job title text\">Interface designer</div>\n</div>\n</div>\n<i class=\"bi bi-arrow-up-right text-[15px] text-[#76DCD2]\" data-kid=\"5-1-2-1-3-2\" data-name=\"external link up-right arrow icon\"></i>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- EDUCATION + ELSEWHERE -->\n<section class=\"bg-[#F5F5F1] text-[#17170E]\" data-kid=\"6\" data-name=\"education and elsewhere section\" id=\"education\">\n<div class=\"mx-auto max-w-[1160px] px-8 py-16\" data-kid=\"6-1\" data-name=\"section content container\">\n<div class=\"grid grid-cols-[0.62fr_1.38fr] gap-12\" data-kid=\"6-1-1\" data-name=\"education two-column layout container\">\n<div data-kid=\"6-1-1-1\" data-name=\"education left heading column\">\n<h2 class=\"mach text-[34px] font-medium leading-none\" data-kid=\"6-1-1-1-1\" data-name=\"education section heading\">Education</h2>\n<div class=\"mach tabnum mt-4 text-[11px] uppercase tracking-[0.18em] text-[#19647E]\" data-kid=\"6-1-1-1-2\" data-name=\"education date range text\">2013 — 2017</div>\n</div>\n<div class=\"rounded-[24px] border border-[#19647E]/22 p-2\" data-kid=\"6-1-1-2\" data-name=\"education card outer frame\">\n<div class=\"well-light rounded-[18px] px-6 py-2\" data-kid=\"6-1-1-2-1\" data-name=\"education card inner well\">\n<div class=\"flex items-baseline justify-between gap-6 border-b border-[#17170E]/10 py-5\" data-kid=\"6-1-1-2-1-1\" data-name=\"education entry row: NID\">\n<div data-kid=\"6-1-1-2-1-1-1\" data-name=\"education institution and field\">\n<div class=\"mach text-[17px] font-medium\" data-kid=\"6-1-1-2-1-1-1-1\" data-name=\"education institution name\">National Institute of Design</div>\n<div class=\"mt-1 text-[13px] text-[#5C6156]\" data-kid=\"6-1-1-2-1-1-1-2\" data-name=\"education field of study\">Interaction design</div>\n</div>\n<span class=\"mach tabnum text-[10.5px] uppercase tracking-[0.16em] text-[#19647E]\" data-kid=\"6-1-1-2-1-1-2\" data-name=\"education date range for entry\">2015 — 2017</span>\n</div>\n<div class=\"flex items-baseline justify-between gap-6 py-5\" data-kid=\"6-1-1-2-1-2\" data-name=\"education entry row: Srishti\">\n<div data-kid=\"6-1-1-2-1-2-1\" data-name=\"education institution and field\">\n<div class=\"mach text-[17px] font-medium\" data-kid=\"6-1-1-2-1-2-1-1\" data-name=\"education institution name\">Srishti Institute</div>\n<div class=\"mt-1 text-[13px] text-[#5C6156]\" data-kid=\"6-1-1-2-1-2-1-2\" data-name=\"education field of study\">Foundation studies</div>\n</div>\n<span class=\"mach tabnum text-[10.5px] uppercase tracking-[0.16em] text-[#19647E]\" data-kid=\"6-1-1-2-1-2-2\" data-name=\"education date range for entry\">2013 — 2015</span>\n</div>\n</div>\n</div>\n</div>\n<div class=\"mt-14\" data-kid=\"6-1-2\" data-name=\"elsewhere section container\" id=\"elsewhere\">\n<div class=\"flex items-end justify-between border-b border-[#17170E]/12 pb-4\" data-kid=\"6-1-2-1\" data-name=\"elsewhere header row\">\n<h2 class=\"mach text-[34px] font-medium leading-none\" data-kid=\"6-1-2-1-1\" data-name=\"elsewhere section heading\">Elsewhere</h2>\n<span class=\"mach text-[10.5px] uppercase tracking-[0.18em] text-[#7E8677]\" data-kid=\"6-1-2-1-2\" data-name=\"elsewhere link count badge\">04 links</span>\n</div>\n<div class=\"mt-6 grid grid-cols-4 gap-3\" data-kid=\"6-1-2-2\" data-name=\"elsewhere links grid\">\n<a class=\"cluster plate bg-[#19647E]/20 p-px\" data-kid=\"6-1-2-2-1\" data-name=\"GitHub link tile with icon\" href=\"#\">\n<span class=\"plate flex items-center gap-3 bg-[#17170E] px-5 py-5 text-[#F5F5F1]\" data-kid=\"6-1-2-2-1-1\" data-name=\"GitHub tile face\">\n<i class=\"bi bi-github text-[18px]\" data-kid=\"6-1-2-2-1-1-1\" data-name=\"GitHub icon\"></i>\n<span class=\"mach text-[11.5px] uppercase tracking-[0.14em]\" data-kid=\"6-1-2-2-1-1-2\" data-name=\"GitHub tile label text\">GitHub</span>\n</span>\n</a>\n<a class=\"cluster plate bg-[#19647E]/20 p-px\" data-kid=\"6-1-2-2-2\" data-name=\"Dribbble link tile with icon\" href=\"#\">\n<span class=\"plate flex items-center gap-3 bg-[#17170E] px-5 py-5 text-[#F5F5F1]\" data-kid=\"6-1-2-2-2-1\" data-name=\"Dribbble tile face\">\n<i class=\"bi bi-dribbble text-[18px]\" data-kid=\"6-1-2-2-2-1-1\" data-name=\"Dribbble icon\"></i>\n<span class=\"mach text-[11.5px] uppercase tracking-[0.14em]\" data-kid=\"6-1-2-2-2-1-2\" data-name=\"Dribbble tile label text\">Dribbble</span>\n</span>\n</a>\n<a class=\"cluster plate bg-[#19647E]/20 p-px\" data-kid=\"6-1-2-2-3\" data-name=\"LinkedIn link tile with icon\" href=\"#\">\n<span class=\"plate flex items-center gap-3 bg-[#17170E] px-5 py-5 text-[#F5F5F1]\" data-kid=\"6-1-2-2-3-1\" data-name=\"LinkedIn tile face\">\n<i class=\"bi bi-linkedin text-[18px]\" data-kid=\"6-1-2-2-3-1-1\" data-name=\"LinkedIn icon\"></i>\n<span class=\"mach text-[11.5px] uppercase tracking-[0.14em]\" data-kid=\"6-1-2-2-3-1-2\" data-name=\"LinkedIn tile label text\">LinkedIn</span>\n</span>\n</a>\n<a class=\"cluster plate bg-[#19647E]/20 p-px\" data-kid=\"6-1-2-2-4\" data-name=\"Email link tile with icon\" href=\"#\">\n<span class=\"plate flex items-center gap-3 bg-[#17170E] px-5 py-5 text-[#F5F5F1]\" data-kid=\"6-1-2-2-4-1\" data-name=\"Email tile face\">\n<i class=\"bi bi-envelope text-[18px]\" data-kid=\"6-1-2-2-4-1-1\" data-name=\"Email envelope icon\"></i>\n<span class=\"mach text-[11.5px] uppercase tracking-[0.14em]\" data-kid=\"6-1-2-2-4-1-2\" data-name=\"Email tile label text\">Email</span>\n</span>\n</a>\n</div>\n</div>\n</div>\n</section>\n<footer class=\"border-t border-[#76DCD2]/20 bg-[#17170E]\" data-kid=\"7\" data-name=\"footer with back-to-top\">\n<div class=\"mx-auto flex max-w-[1160px] items-center justify-between px-8 py-6\" data-kid=\"7-1\" data-name=\"footer inner layout container\">\n<span class=\"mach text-[11px] uppercase tracking-[0.18em] text-[#8C9A92]\" data-kid=\"7-1-1\" data-name=\"footer copyright text\">Aarav Menon — Portfolio</span>\n<a class=\"mach inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.18em] text-[#76DCD2]\" data-kid=\"7-1-2\" data-name=\"back-to-top link\" href=\"#top\">Back to top <i class=\"bi bi-arrow-up text-[12px]\" data-kid=\"7-1-2-1\" data-name=\"up arrow icon\"></i></a>\n</div>\n</footer>\n<link data-kid=\"8\" data-name=\"external Bootstrap Icons stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n    /* rings */\n    gsap.to('#ringA', { rotation: 360, duration: 28, repeat: -1, ease: 'none', transformOrigin: '50% 50%' });\n    gsap.to('#ringB', { rotation: -360, duration: 44, repeat: -1, ease: 'none', transformOrigin: '50% 50%' });\n    gsap.to('#ringC', { rotation: 360, duration: 76, repeat: -1, ease: 'none', transformOrigin: '50% 50%' });\n\n    /* boot decode */\n    const roleEl = document.getElementById('decode');\n    const FINAL_TEXT = roleEl.dataset.text;\n    const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#%&';\n    function decode(el, text, dur) {\n      if (el.dataset.busy === '1') return;\n      el.dataset.busy = '1';\n      const start = performance.now();\n      function frame(now) {\n        const prog = Math.min(1, (now - start) / dur);\n        const shown = Math.floor(prog * text.length);\n        let out = '';\n        for (let i = 0; i < text.length; i++) {\n          if (i < shown) out += text[i];\n          else if (text[i] === ' ') out += ' ';\n          else out += GLYPHS[Math.floor(Math.random() * GLYPHS.length)];\n        }\n        el.textContent = out;\n        if (prog < 1) requestAnimationFrame(frame);\n        else { el.textContent = text; el.dataset.busy = '0'; }\n      }\n      requestAnimationFrame(frame);\n    }\n    decode(roleEl, FINAL_TEXT, 1200);\n    document.getElementById('nameBlock').addEventListener('pointerenter', () => decode(roleEl, FINAL_TEXT, 700));\n\n    /* visor tilt + crosshair */\n    const visor = document.getElementById('visor');\n    const crossV = document.getElementById('crossV');\n    const crossH = document.getElementById('crossH');\n    const tiltX = gsap.quickTo(visor, 'rotationX', { duration: 0.7, ease: 'power3' });\n    const tiltY = gsap.quickTo(visor, 'rotationY', { duration: 0.7, ease: 'power3' });\n    const cx = gsap.quickTo(crossV, 'x', { duration: 0.45, ease: 'power2' });\n    const cy = gsap.quickTo(crossH, 'y', { duration: 0.45, ease: 'power2' });\n    gsap.set(visor, { transformPerspective: 900 });\n\n    visor.addEventListener('pointermove', (e) => {\n      const r = visor.getBoundingClientRect();\n      const mx = e.clientX - r.left;\n      const my = e.clientY - r.top;\n      tiltX(-(my / r.height - 0.5) * 9);\n      tiltY((mx / r.width - 0.5) * 11);\n      cx(mx - r.width / 2);\n      cy(my - r.height / 2);\n    });\n    visor.addEventListener('pointerleave', () => {\n      tiltX(0);\n      tiltY(0);\n      cx(0);\n      cy(0);\n    });\n\n    /* hold to charge */\n    const chargeBtn = document.getElementById('charge');\n    const chargeFill = document.getElementById('chargeFill');\n    const chargeLabel = document.getElementById('chargeLabel');\n    let holding = false;\n    let committed = false;\n    let chargeStart = 0;\n    let progress = 0;\n    let raf = null;\n\n    function commitCharge() {\n      committed = true;\n      holding = false;\n      chargeLabel.textContent = 'aarav@menon.studio copied';\n      chargeLabel.style.color = '#17170E';\n      gsap.to(chargeFill, { scaleX: 1, duration: 0.1 });\n      try { navigator.clipboard.writeText('aarav@menon.studio'); } catch (err) {}\n      gsap.fromTo(chargeBtn, { opacity: 0.72 }, { opacity: 1, duration: 0.35, ease: 'power2.out' });\n    }\n\n    function tickCharge(now) {\n      if (!committed) {\n        if (holding) progress = Math.min(1, (now - chargeStart) / 900);\n        else progress = Math.max(0, progress - 0.055);\n        if (holding && progress >= 1) { commitCharge(); return; }\n        chargeFill.style.transform = 'scaleX(' + progress + ')';\n        if (holding || progress > 0) { raf = requestAnimationFrame(tickCharge); }\n        else { chargeFill.style.transform = 'scaleX(0)'; raf = null; }\n      }\n    }\n\n    chargeBtn.addEventListener('pointerdown', () => {\n      if (committed) return;\n      holding = true;\n      chargeStart = performance.now();\n      if (!raf) raf = requestAnimationFrame(tickCharge);\n    });\n    ['pointerup', 'pointerleave', 'pointercancel'].forEach((evt) => {\n      chargeBtn.addEventListener(evt, () => {\n        if (committed) return;\n        holding = false;\n        if (!raf) raf = requestAnimationFrame(tickCharge);\n      });\n    });\n\n    /* plates assemble */\n    gsap.utils.toArray('.plate-anim').forEach((el) => {\n      const edge = el.querySelector('.edge');\n      gsap.fromTo(el,\n        { clipPath: 'inset(0% 0% 100% 0%)' },\n        {\n          clipPath: 'inset(0% 0% 0% 0%)',\n          duration: 0.9,\n          ease: 'power3.out',\n          scrollTrigger: { trigger: el, start: 'top 90%' }\n        });\n      gsap.fromTo(edge,\n        { opacity: 0.9 },\n        {\n          opacity: 0,\n          duration: 0.8,\n          delay: 0.35,\n          ease: 'power1.out',\n          scrollTrigger: { trigger: el, start: 'top 90%' }\n        });\n    });\n\n    /* tilted experience grid follows pointer */\n    const expSection = document.getElementById('experience');\n    const tiltGrid = document.getElementById('tiltGrid');\n    gsap.set(tiltGrid, { rotation: -5 });\n    const shiftX = gsap.quickTo(tiltGrid, 'x', { duration: 0.9, ease: 'power3' });\n    const shiftY = gsap.quickTo(tiltGrid, 'y', { duration: 0.9, ease: 'power3' });\n    expSection.addEventListener('pointermove', (e) => {\n      const r = expSection.getBoundingClientRect();\n      shiftX(((e.clientX - r.left) / r.width - 0.5) * 26);\n      shiftY(((e.clientY - r.top) / r.height - 0.5) * 14);\n    });\n    expSection.addEventListener('pointerleave', () => { shiftX(0); shiftY(0); });\n\n    /* link cluster */\n    gsap.utils.toArray('.cluster').forEach((el) => {\n      const face = el.querySelector('span');\n      el.addEventListener('pointerenter', () => {\n        gsap.to(face, { backgroundColor: '#FFF44F', color: '#17170E', duration: 0.28, ease: 'power2.out' });\n      });\n      el.addEventListener('pointerleave', () => {\n        gsap.to(face, { backgroundColor: '#17170E', color: '#F5F5F1', duration: 0.28, ease: 'power2.out' });\n      });\n    });\n  </script>\n</body>",
