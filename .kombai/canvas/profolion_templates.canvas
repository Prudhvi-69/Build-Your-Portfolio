name=\"Fintrail date range\">2022 — present</span>\n<div data-kid=\"6-1-2-1-2\" data-name=\"Fintrail role block\">\n<h3 class=\"disp text-[25px] leading-none\" data-kid=\"6-1-2-1-2-1\" data-name=\"Fintrail company name\">Fintrail</h3>\n<p class=\"mt-2.5 text-[13.5px] leading-[1.75] text-[#6E4356]\" data-kid=\"6-1-2-1-2-2\" data-name=\"Fintrail role description\">Payments, onboarding and the design system.</p>\n</div>\n<span class=\"text-[12px] font-extrabold uppercase tracking-[0.14em] text-[#8E5570]\" data-kid=\"6-1-2-1-3\" data-name=\"Fintrail job title\">Senior product designer</span>\n</div>\n<div class=\"grid gap-4 py-7 md:grid-cols-[150px_1fr_auto] md:items-baseline md:gap-10\" data-kid=\"6-1-2-2\" data-name=\"Sundial Studio experience entry\">\n<span class=\"disp text-[13px] text-[#B01055]\" data-kid=\"6-1-2-2-1\" data-name=\"Sundial date range\">2019 — 2022</span>\n<div data-kid=\"6-1-2-2-2\" data-name=\"Sundial role block\">\n<h3 class=\"disp text-[25px] leading-none\" data-kid=\"6-1-2-2-2-1\" data-name=\"Sundial company name\">Sundial Studio</h3>\n<p class=\"mt-2.5 text-[13.5px] leading-[1.75] text-[#6E4356]\" data-kid=\"6-1-2-2-2-2\" data-name=\"Sundial role description\">Booking and travel products for three clients.</p>\n</div>\n<span class=\"text-[12px] font-extrabold uppercase tracking-[0.14em] text-[#8E5570]\" data-kid=\"6-1-2-2-3\" data-name=\"Sundial job title\">Product designer</span>\n</div>\n<div class=\"grid gap-4 py-7 md:grid-cols-[150px_1fr_auto] md:items-baseline md:gap-10\" data-kid=\"6-1-2-3\" data-name=\"Pageturn Press experience entry\">\n<span class=\"disp text-[13px] text-[#B01055]\" data-kid=\"6-1-2-3-1\" data-name=\"Pageturn date range\">2017 — 2019</span>\n<div data-kid=\"6-1-2-3-2\" data-name=\"Pageturn role block\">\n<h3 class=\"disp text-[25px] leading-none\" data-kid=\"6-1-2-3-2-1\" data-name=\"Pageturn company name\">Pageturn Press</h3>\n<p class=\"mt-2.5 text-[13.5px] leading-[1.75] text-[#6E4356]\" data-kid=\"6-1-2-3-2-2\" data-name=\"Pageturn role description\">Digital editions of a 90-year-old imprint.</p>\n</div>\n<span class=\"text-[12px] font-extrabold uppercase tracking-[0.14em] text-[#8E5570]\" data-kid=\"6-1-2-3-3\" data-name=\"Pageturn job title\">Interface designer</span>\n</div>\n</div>\n</div>\n</section>\n<section class=\"px-8 py-16\" data-kid=\"7\" data-name=\"education and elsewhere section\">\n<div class=\"mx-auto grid max-w-[1200px] gap-12 md:grid-cols-2\" data-kid=\"7-1\" data-name=\"two column education-and-links layout\">\n<div data-kid=\"7-1-1\" data-name=\"education column\" id=\"education\">\n<h2 class=\"disp text-[38px] leading-none\" data-kid=\"7-1-1-1\" data-name=\"education section title\">Education</h2>\n<div class=\"mt-6 divide-y divide-[#4A1330]/12 border-t border-[#4A1330]/12\" data-kid=\"7-1-1-2\" data-name=\"education entries list\">\n<div class=\"flex items-baseline justify-between gap-5 py-5\" data-kid=\"7-1-1-2-1\" data-name=\"NID education entry\">\n<div data-kid=\"7-1-1-2-1-1\" data-name=\"NID school block\">\n<h3 class=\"disp text-[20px] leading-none\" data-kid=\"7-1-1-2-1-1-1\" data-name=\"NID school name\">National Institute of Design</h3>\n<p class=\"mt-2 text-[12.5px] font-bold text-[#8E5570]\" data-kid=\"7-1-1-2-1-1-2\" data-name=\"NID program description\">Interaction design</p>\n</div>\n<span class=\"disp shrink-0 text-[12.5px] text-[#B01055]\" data-kid=\"7-1-1-2-1-2\" data-name=\"NID date range\">2015 — 2017</span>\n</div>\n<div class=\"flex items-baseline justify-between gap-5 py-5\" data-kid=\"7-1-1-2-2\" data-name=\"Srishti education entry\">\n<div data-kid=\"7-1-1-2-2-1\" data-name=\"Srishti school block\">\n<h3 class=\"disp text-[20px] leading-none\" data-kid=\"7-1-1-2-2-1-1\" data-name=\"Srishti school name\">Srishti Institute</h3>\n<p class=\"mt-2 text-[12.5px] font-bold text-[#8E5570]\" data-kid=\"7-1-1-2-2-1-2\" data-name=\"Srishti program description\">Foundation studies</p>\n</div>\n<span class=\"disp shrink-0 text-[12.5px] text-[#B01055]\" data-kid=\"7-1-1-2-2-2\" data-name=\"Srishti date range\">2013 — 2015</span>\n</div>\n</div>\n</div>\n<div data-kid=\"7-1-2\" data-name=\"elsewhere links column\" id=\"elsewhere\">\n<h2 class=\"disp text-[38px] leading-none\" data-kid=\"7-1-2-1\" data-name=\"elsewhere section title\">Elsewhere</h2>\n<div class=\"mt-6 grid grid-cols-2 gap-4\" data-kid=\"7-1-2-2\" data-name=\"links grid\">\n<a class=\"sticker flex items-center justify-between gap-3 rounded-[18px] bg-white px-5 py-4\" data-kid=\"7-1-2-2-1\" data-name=\"Github link card\" href=\"#elsewhere\">\n<span class=\"flex items-center gap-2.5 text-[13px] font-extrabold\" data-kid=\"7-1-2-2-1-1\" data-name=\"Github label group\"><i class=\"bi bi-github text-[15px]\" data-kid=\"7-1-2-2-1-1-1\" data-name=\"Github icon\"></i> GitHub</span>\n<i class=\"bi bi-arrow-up-right text-[12px] text-[#B01055]\" data-kid=\"7-1-2-2-1-2\" data-name=\"Github external arrow icon\"></i>\n</a>\n<a class=\"sticker flex items-center justify-between gap-3 rounded-[18px] bg-white px-5 py-4\" data-kid=\"7-1-2-2-2\" data-name=\"Dribbble link card\" href=\"#elsewhere\">\n<span class=\"flex items-center gap-2.5 text-[13px] font-extrabold\" data-kid=\"7-1-2-2-2-1\" data-name=\"Dribbble label group\"><i class=\"bi bi-dribbble text-[15px] text-[#FF3D8B]\" data-kid=\"7-1-2-2-2-1-1\" data-name=\"Dribbble icon\"></i> Dribbble</span>\n<i class=\"bi bi-arrow-up-right text-[12px] text-[#B01055]\" data-kid=\"7-1-2-2-2-2\" data-name=\"Dribbble external arrow icon\"></i>\n</a>\n<a class=\"sticker flex items-center justify-between gap-3 rounded-[18px] bg-white px-5 py-4\" data-kid=\"7-1-2-2-3\" data-name=\"LinkedIn link card\" href=\"#elsewhere\">\n<span class=\"flex items-center gap-2.5 text-[13px] font-extrabold\" data-kid=\"7-1-2-2-3-1\" data-name=\"LinkedIn label group\"><i class=\"bi bi-linkedin text-[15px] text-[#0A66C2]\" data-kid=\"7-1-2-2-3-1-1\" data-name=\"LinkedIn icon\"></i> LinkedIn</span>\n<i class=\"bi bi-arrow-up-right text-[12px] text-[#B01055]\" data-kid=\"7-1-2-2-3-2\" data-name=\"LinkedIn external arrow icon\"></i>\n</a>\n<a class=\"sticker flex items-center justify-between gap-3 rounded-[18px] bg-white px-5 py-4\" data-kid=\"7-1-2-2-4\" data-name=\"Email link card\" href=\"#elsewhere\">\n<span class=\"flex items-center gap-2.5 text-[13px] font-extrabold\" data-kid=\"7-1-2-2-4-1\" data-name=\"Email label group\"><i class=\"bi bi-envelope-fill text-[14px]\" data-kid=\"7-1-2-2-4-1-1\" data-name=\"Email envelope icon\"></i> Email</span>\n<i class=\"bi bi-arrow-up-right text-[12px] text-[#B01055]\" data-kid=\"7-1-2-2-4-2\" data-name=\"Email external arrow icon\"></i>\n</a>\n</div>\n</div>\n</div>\n</section>\n<footer class=\"border-t border-[#4A1330]/12 px-8 py-7\" data-kid=\"8\" data-name=\"site footer\">\n<div class=\"mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 text-[12px] font-bold text-[#8E5570]\" data-kid=\"8-1\" data-name=\"footer content row\">\n<span class=\"disp text-[13px] text-[#4A1330]\" data-kid=\"8-1-1\" data-name=\"footer brand and location\">Aarav Menon — Bengaluru</span>\n<span data-kid=\"8-1-2\" data-name=\"footer credit line\">Made with <a class=\"text-[#B01055]\" data-kid=\"8-1-2-1\" data-name=\"profolion tool attribution link\" href=\"#top\">profolion</a></span>\n<a class=\"inline-flex items-center gap-1.5 hover:text-[#4A1330]\" data-kid=\"8-1-3\" data-name=\"back to top link\" href=\"#top\">Back to top <i class=\"bi bi-arrow-up text-[11px]\" data-kid=\"8-1-3-1\" data-name=\"up arrow icon\"></i></a>\n</div>\n</footer>\n<link data-kid=\"9\" data-name=\"bootstrap icons stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/Draggable.min.js\"></script>\n<script>\n    gsap.registerPlugin(ScrollTrigger, Draggable);\n\n    /* 1. Rubber stamp leaves a permanent imprint */\n    const stampBtn = document.getElementById('stampBtn');\n    const imprint = document.getElementById('imprint');\n    stampBtn.addEventListener('click', () => {\n      const on = stampBtn.getAttribute('aria-pressed') === 'true';\n      if (!on) {\n        gsap.timeline()\n          .to(stampBtn, { scaleY: 0.76, scaleX: 1.07, duration: 0.13, ease: 'power2.in' })\n          .to(stampBtn, { scaleY: 1, scaleX: 1, duration: 0.6, ease: 'elastic.out(1, 0.42)' })\n          .fromTo(imprint,\n            { autoAlpha: 0, scale: 1.5, rotate: -18 },\n            { autoAlpha: 1, scale: 1, rotate: -7, duration: 0.42, ease: 'back.out(2.2)' }, 0.06);\n        stampBtn.setAttribute('aria-pressed', 'true');\n      } else {\n        gsap.to(imprint, { autoAlpha: 0, scale: 1.12, duration: 0.24, ease: 'power2.in' });\n        stampBtn.setAttribute('aria-pressed', 'false');\n      }\n    });\n\n    /* 2. Skill stickers lift, tilt with the drag and settle back */\n    document.querySelectorAll('#stickerSheet .sticker').forEach((el) => {\n      Draggable.create(el, {\n        type: 'x,y',\n        bounds: '#stickerSheet',\n        edgeResistance: 0.6,\n        cursor: 'grab',\n        activeCursor: 'grabbing',\n        onPress() {\n          gsap.to(el, { scale: 1.09, duration: 0.18, ease: 'power2.out' });\n          el.style.position = 'relative';\n          el.style.zIndex = '20';\n        },\n        onDrag() {\n          gsap.set(el, { rotation: gsap.utils.clamp(-10, 10, this.x * 0.22) });\n        },\n        onRelease() {\n          gsap.to(el, { rotation: 0, duration: 0.8, ease: 'elastic.out(1, 0.45)' });\n          gsap.to(el, { scale: 1, duration: 0.25, ease: 'power2.out' });\n          el.style.zIndex = '';\n        }\n      });\n    });\n\n    /* 3. The closet rail is draggable with inertia; the page still scrolls */\n    const wrap = document.getElementById('railWrap');\n    const rail = document.getElementById('rail');\n    const railDrag = Draggable.create(rail, {\n      type: 'x',\n      bounds: { minX: () => -(rail.scrollWidth - wrap.clientWidth), maxX: 0 },\n      inertia: true,\n      edgeResistance: 0.7,\n      cursor: 'grab',\n      activeCursor: 'grabbing'\n    })[0];\n\n    function nudge(dir) {\n      const max = -(rail.scrollWidth - wrap.clientWidth);\n      const target = gsap.utils.clamp(max, 0, railDrag.x - dir * 440);\n      gsap.to(rail, {\n        x: target,\n        duration: 0.65,\n        ease: 'power3.out',\n        onUpdate() { railDrag.update(true); }\n      });\n    }\n    document.getElementById('railNext').addEventListener('click', () => nudge(1));\n    document.getElementById('railPrev').addEventListener('click', () => nudge(-1));\n\n    /* 3b. Blister packs pop open on their left hinge */\n    document.querySelectorAll('.proj').forEach((card) => {\n      const cover = cover_(coverPanelOf(card));\n      function coverPanelOf(c) { return c.querySelector('.coverPanel'); }\n      card.querySelectorAll('.closeBtn').forEach((b) => b.addEventListener('click', () => shut()));\n\n      function open() {\n        card.classList.add('is-open');\n        cover.setAttribute('aria-expanded', 'true');\n        gsap.timeline()\n          .to(cover, { rotateY: -104, duration: 0.62, ease: 'power3.inOut' })\n          .set(cover, { autoAlpha: 0 });\n        gsap.fromTo(card.querySelector('.inner'), { y: 16 }, { y: 0, duration: 0.5, delay: 0.14, ease: 'power2.out' });\n      }\n      function shut() {\n        card.classList.remove('is-open');\n        cover.setAttribute('aria-expanded', 'false');\n        gsap.set(cover, { autoAlpha: 1 });\n        gsap.to(cover, { rotateY: 0, duration: 0.6, ease: 'power3.inOut' });\n      }\n      function cover_(c) { return c; }\n\n      cover.addEventListener('click', () => {\n        if (cover.getAttribute('aria-expanded') === 'true') shut(); else open();\n      });\n    });\n\n    /* 4. Dollhouse windows light up one by one */\n    ScrollTrigger.create({\n      trigger: '#dollhouse',\n      start: 'top 80%',\n      once: true,\n      onEnter() {\n        gsap.to('#dollhouse .win', { fill: '#FF3D8B', duration: 0.36, stagger: 0.14, ease: 'power1.out' });\n        gsap.to('#dollhouse .door', { fill: '#4A1330', duration: 0.4, delay: 0.3, ease: 'power1.out' });\n      }\n    });\n  </script>\n</body>",
