2\" stroke-opacity=\".7\"></path>\n</g>\n<circle cx=\"320\" cy=\"320\" r=\"276\" stroke=\"#D9A441\" stroke-dasharray=\"14 9\" stroke-opacity=\".3\"></circle>\n<circle cx=\"320\" cy=\"320\" r=\"248\" stroke=\"#0E1B2B\" stroke-dasharray=\"2 12\" stroke-opacity=\".18\"></circle>\n<g stroke=\"#D9A441\" stroke-opacity=\".9\">\n<path d=\"M320 4 V34 M320 24 L338 14 M320 24 L302 14\"></path>\n<path d=\"M636 320 H606 M616 320 L626 302 M616 320 L626 338\"></path>\n<path d=\"M320 636 V606 M320 616 L338 626 M320 616 L302 626\"></path>\n<path d=\"M4 320 H34 M24 320 L14 302 M24 320 L14 338\"></path>\n<path d=\"M106 106 L120 120 M112 118 L120 104 M112 118 L98 110\"></path>\n<path d=\"M534 106 L520 120 M528 118 L520 104 M528 118 L542 110\"></path>\n<path d=\"M106 534 L120 520 M112 522 L120 536 M112 522 L98 530\"></path>\n<path d=\"M534 534 L520 520 M528 522 L520 536 M528 522 L542 530\"></path>\n</g>\n</svg>\n</div>\n</div>\n<div class=\"relative z-10 mx-auto max-w-[1180px] px-8 pb-20 pt-16 text-center\" data-kid=\"2-2\" data-name=\"hero content\">\n<h1 class=\"deco text-[clamp(40px,8vw,100px)] uppercase leading-[0.92] tracking-[0.04em]\" data-kid=\"2-2-1\" data-name=\"owner name headline\">Aarav Menon</h1>\n<div class=\"mx-auto mt-7 flex items-center justify-center gap-3\" data-kid=\"2-2-2\" data-name=\"hero rule with glyph\">\n<span class=\"block h-px w-16 bg-[#D9A441]/70 sm:w-24\" data-kid=\"2-2-2-1\" data-name=\"left rule\"></span>\n<svg aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"2-2-2-2\" data-name=\"centre glyph icon\" fill=\"none\" viewbox=\"0 0 24 24\">\n<path d=\"M12 1 V23 M12 7 L20 3 M12 7 L4 3 M12 17 L20 21 M12 17 L4 21\" stroke=\"#D9A441\" stroke-width=\"1.2\"></path>\n</svg>\n<span class=\"block h-px w-16 bg-[#D9A441]/70 sm:w-24\" data-kid=\"2-2-2-3\" data-name=\"right rule\"></span>\n</div>\n<p class=\"mono mt-6 text-[10px] uppercase tracking-[0.44em] text-[#6A7889]\" data-kid=\"2-2-3\" data-name=\"role line\">Interface designer</p>\n<div class=\"mono mt-12 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-[9px] uppercase tracking-[0.26em] text-[#0E1B2B]/70\" data-kid=\"2-2-4\" data-name=\"social link row\">\n<a class=\"flex items-center gap-5 hover:text-[#0E1B2B]\" data-kid=\"2-2-4-1\" data-name=\"github link\" href=\"https://github.com\" rel=\"noreferrer\" target=\"_blank\">GitHub<span class=\"h-1 w-1 rotate-45 bg-[#D9A441]\" data-kid=\"2-2-4-1-1\" data-name=\"github link diamond dot\"></span></a>\n<a class=\"flex items-center gap-5 hover:text-[#0E1B2B]\" data-kid=\"2-2-4-2\" data-name=\"dribbble link\" href=\"https://dribbble.com\" rel=\"noreferrer\" target=\"_blank\">Dribbble<span class=\"h-1 w-1 rotate-45 bg-[#D9A441]\" data-kid=\"2-2-4-2-1\" data-name=\"dribbble link diamond dot\"></span></a>\n<a class=\"flex items-center gap-5 hover:text-[#0E1B2B]\" data-kid=\"2-2-4-3\" data-name=\"linkedin link\" href=\"https://linkedin.com\" rel=\"noreferrer\" target=\"_blank\">LinkedIn<span class=\"h-1 w-1 rotate-45 bg-[#D9A441]\" data-kid=\"2-2-4-3-1\" data-name=\"linkedin link diamond dot\"></span></a>\n<a class=\"flex items-center gap-5 hover:text-[#0E1B2B]\" data-kid=\"2-2-4-4\" data-name=\"email link\" href=\"mailto:hello@example.com\">Email</a>\n</div>\n</div>\n</section>\n<div class=\"relative overflow-hidden border-b border-[#0E1B2B]/10 bg-[#E1E8EF] py-4\" data-kid=\"3\" data-name=\"rune glyph band\">\n<svg aria-hidden=\"true\" class=\"h-full w-full\" data-kid=\"3-1\" data-name=\"repeating rune pattern\" height=\"26\" preserveaspectratio=\"none\" viewbox=\"0 0 1280 26\">\n<defs data-name=\"rune pattern definition\">\n<pattern data-name=\"rune pattern tile\" height=\"26\" id=\"runeTile\" patternunits=\"userSpaceOnUse\" width=\"78\">\n<path d=\"M10 4 V22 M10 9 L17 5 M10 9 L3 5 M10 16 L17 20 M10 16 L3 20\" fill=\"none\" stroke=\"#D9A441\" stroke-opacity=\".75\" stroke-width=\"1\"></path>\n<path d=\"M38 6 L48 20 M48 6 L38 20\" fill=\"none\" stroke=\"#0E1B2B\" stroke-opacity=\".22\" stroke-width=\"1\"></path>\n<rect fill=\"#D9A441\" height=\"3\" width=\"3\" x=\"60\" y=\"11\"></rect>\n<rect fill=\"#D9A441\" height=\"3\" transform=\"rotate(45 66 13)\" width=\"3\" x=\"66\" y=\"13\"></rect>\n</pattern>\n</defs>\n<rect data-name=\"rune pattern fill\" fill=\"url(#runeTile)\" height=\"26\" width=\"1280\"></rect>\n</svg>\n</div>\n<section class=\"border-b border-[#0E1B2B]/10 bg-[#E1E8EF]\" data-kid=\"4\" data-name=\"about section\" id=\"about\">\n<div class=\"mx-auto grid max-w-[1180px] items-start gap-12 px-8 py-20 md:grid-cols-[1.35fr_1fr]\" data-kid=\"4-1\" data-name=\"about content grid\">\n<div data-kid=\"4-1-1\" data-name=\"bio column\">\n<div class=\"flex items-center gap-4\" data-kid=\"4-1-1-1\" data-name=\"about heading row\">\n<span class=\"block h-px w-9 bg-[#D9A441]\" data-kid=\"4-1-1-1-1\" data-name=\"heading keyline\"></span>\n<h2 class=\"deco text-[34px] uppercase tracking-[0.08em]\" data-kid=\"4-1-1-1-2\" data-name=\"about heading\">About</h2>\n<span class=\"block h-px w-9 bg-[#D9A441]\" data-kid=\"4-1-1-1-3\" data-name=\"heading keyline\"></span>\n</div>\n<p class=\"serif dropcap mt-8 text-[21px] leading-[1.7] text-[#0E1B2B]/85\" data-kid=\"3-1-1\" data-name=\"bio paragraph\">I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.</p>\n</div>\n<div class=\"relative border border-[#D9A441]/45 bg-[#EDF1F5]/70 p-6\" data-kid=\"3-1-2\" data-name=\"skills engraved plate\">\n<div class=\"flex items-center justify-between gap-4 border-b border-[#D9A441]/35 pb-3\" data-kid=\"3-1-2-1\" data-name=\"skills plate header\">\n<span class=\"mono text-[10px] uppercase tracking-[0.3em] text-[#0E1B2B]\" data-kid=\"3-1-2-1-1\" data-name=\"skills label\">Skills</span>\n<svg class=\"h-4 w-3\" data-kid=\"3-1-2-1-2\" data-name=\"skills plate glyph icon\" fill=\"none\" viewbox=\"0 0 16 24\">\n<path d=\"M8 2 V22 M8 8 L14 4 M8 8 L2 4 M8 16 L14 20 M8 16 L2 20\" stroke=\"#D9A441\"></path>\n</svg>\n</div>\n<ul class=\"mt-5 grid grid-cols-2 gap-x-5 gap-y-3\" data-kid=\"3-1-2-2\" data-name=\"skills list\">\n<li class=\"flex items-center gap-2.5\" data-kid=\"3-1-2-2-1\" data-name=\"skill item\"><span class=\"h-1.5 w-1.5 shrink-0 rotate-45 bg-[#D9A441]\" data-kid=\"3-1-2-2-1-1\" data-name=\"skill bullet diamond\"></span><span class=\"text-[15px] leading-tight text-[#0E1B2B]/90\" data-kid=\"3-1-2-2-1-2\" data-name=\"skill name text\">Design systems</span></li>\n<li class=\"flex items-center gap-2.5\" data-kid=\"3-1-2-2-2\" data-name=\"skill item\"><span class=\"h-1.5 w-1.5 shrink-0 rotate-45 bg-[#D9A441]\" data-kid=\"3-1-2-2-2-1\" data-name=\"skill bullet diamond\"></span><span class=\"text-[15px] leading-tight text-[#0E1B2B]/90\" data-kid=\"3-1-2-2-2-2\" data-name=\"skill name text\">Interaction design</span></li>\n<li class=\"flex items-center gap-2.5\" data-kid=\"3-1-2-2-3\" data-name=\"skill item\"><span class=\"h-1.5 w-1.5 shrink-0 rotate-45 bg-[#D9A441]\" data-kid=\"3-1-2-2-3-1\" data-name=\"skill bullet diamond\"></span><span class=\"text-[15px] leading-tight text-[#0E1B2B]/90\" data-kid=\"3-1-2-2-3-2\" data-name=\"skill name text\">Prototyping</span></li>\n<li class=\"flex items-center gap-2.5\" data-kid=\"3-1-2-2-4\" data-name=\"skill item\"><span class=\"h-1.5 w-1.5 shrink-0 rotate-45 bg-[#D9A441]\" data-kid=\"3-1-2-2-4-1\" data-name=\"skill bullet diamond\"></span><span class=\"text-[15px] leading-tight text-[#0E1B2B]/90\" data-kid=\"3-1-2-2-4-2\" data-name=\"skill name text\">Motion</span></li>\n<li class=\"flex items-center gap-2.5\" data-kid=\"3-1-2-2-5\" data-name=\"skill item\"><span class=\"h-1.5 w-1.5 shrink-0 rotate-45 bg-[#D9A441]\" data-kid=\"3-1-2-2-5-1\" data-name=\"skill bullet diamond\"></span><span class=\"text-[15px] leading-tight text-[#0E1B2B]/90\" data-kid=\"3-1-2-2-5-2\" data-name=\"skill name text\">Type</span></li>\n<li class=\"flex items-center gap-2.5\" data-kid=\"3-1-2-2-6\" data-name=\"skill item\"><span class=\"h-1.5 w-1.5 shrink-0 rotate-45 bg-[#D9A441]\" data-kid=\"3-1-2-2-6-1\" data-name=\"skill bullet diamond\"></span><span class=\"text-[15px] leading-tight text-[#0E1B2B]/90\" data-kid=\"3-1-2-2-6-2\" data-name=\"skill name text\">Research</span></li>\n</ul>\n</div>\n</div>\n</section>\n<section class=\"border-b border-[#0E1B2B]/10\" data-kid=\"5\" data-name=\"work section\" id=\"work\">\n<div class=\"mx-auto max-w-[1180px] px-8 py-20\" data-kid=\"5-1\" data-name=\"work content\">\n<div class=\"flex flex-wrap items-end justify-between gap-5\" data-kid=\"5-1-1\" data-name=\"work heading row\">\n<div class=\"flex items-center gap-4\" data-kid=\"5-1-1-1\" data-name=\"work heading lockup\">\n<h2 class=\"deco text-[36px] uppercase tracking-[0.06em]\" data-kid=\"5-1-1-1-1\" data-name=\"work heading\">Selected work</h2>\n<span class=\"block h-px w-14 bg-[#D9A441]\" data-kid=\"5-1-1-1-2\" data-name=\"work heading keyline\"></span>\n</div>\n<span class=\"mono text-[10px] uppercase tracking-[0.28em] text-[#6A7889]\" data-kid=\"5-1-1-2\" data-name=\"project count\">03 projects</span>\n</div>\n<article class=\"plate tiltable mt-10 border border-[#D9A441]/45 p-8\" data-kid=\"5-1-2\" data-name=\"featured work plate for Kestrel\" data-tilt=\"\">\n<div class=\"grid gap-7 md:grid-cols-[86px_1fr_auto] md:items-center\" data-kid=\"5-1-2-1\" data-name=\"featured plate layout\">\n<div class=\"flex items-center gap-3 md:flex-col md:items-start\" data-kid=\"5-1-2-1-1\" data-name=\"plate index\">\n<svg aria-hidden=\"true\" class=\"h-6 w-4\" data-kid=\"5-1-2-1-1-1\" data-name=\"plate rune glyph icon\" fill=\"none\" viewbox=\"0 0 16 24\">\n<path d=\"M8 2 V22 M8 8 L14 4 M8 8 L2 4 M8 16 L14 20 M8 16 L2 20\" stroke=\"#D9A441\" stroke-width=\"1.1\"></path>\n</svg>\n<span class=\"mono text-[11px] tracking-[0.3em] text-[#0E1B2B]/55\" data-kid=\"5-1-2-1-1-2\" data-name=\"plate index number\">01</span>\n</div>\n<div data-kid=\"5-1-2-1-2\" data-name=\"plate body\">\n<h3 class=\"deco text-[34px] leading-none tracking-[0.02em]\" data-kid=\"5-1-2-1-2-1\" data-name=\"project title\">Kestrel</h3>\n<p class=\"serif mt-3 max-w-[52ch] text-[17px] leading-[1.6] text-[#0E1B2B]/72\" data-kid=\"5-1-2-1-2-2\" data-name=\"project description\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n</div>\n<div class=\"flex items-center gap-6 md:flex-col md:items-end md:gap-3\" data-kid=\"5-1-2-1-3\" data-name=\"plate meta\">\n<span class=\"mono text-[11px] tracking-[0.24em] text-[#0E1B2B]/60\" data-kid=\"5-1-2-1-3-1\" data-name=\"project year\">2025</span>\n<a class=\"mono border-b border-[#D9A441] pb-1 text-[9px] uppercase tracking-[0.26em] text-[#0E1B2B]\" data-kid=\"5-1-2-1-3-2\" data-name=\"read case study link\" href=\"#\">Read case study</a>\n</div>\n</div>\n</article>\n<div class=\"mt-6 grid gap-6 md:grid-cols-2\" data-kid=\"5-1-3\" data-name=\"paired work plates\">\n<article class=\"plate tiltable border border-[#D9A441]/35 p-7\" data-kid=\"5-1-3-1\" data-name=\"work plate for Tide and Timber\" data-tilt=\"\">\n<div class=\"flex items-start justify-between gap-4\" data-kid=\"5-1-3-1-1\" data-name=\"plate top row\">\n<span class=\"mono text-[10px] tracking-[0.3em] text-[#0E1B2B]/55\" data-kid=\"5-1-3-1-1-1\" data-name=\"plate index number\">02</span>\n<svg aria-hidden=\"true\" class=\"h-5 w-3.5\" data-kid=\"5-1-3-1-1-2\" data-name=\"plate rune glyph icon\" fill=\"none\" viewbox=\"0 0 16 24\">\n<path d=\"M8 2 V22 M8 8 L14 4 M8 8 L2 4 M8 16 L14 20 M8 16 L2 20\" stroke=\"#D9A441\"></path>\n</svg>\n</div>\n<h3 class=\"deco mt-5 text-[27px] leading-tight tracking-[0.02em]\" data-kid=\"5-1-3-1-2\" data-name=\"project title\">Tide &amp; Timber</h3>\n<p class=\"serif mt-3 text-[16px] leading-[1.6] text-[#0E1B2B]/72\" data-kid=\"5-1-3-1-3\" data-name=\"project description\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n<div class=\"mt-6 flex items-center justify-between gap-4 border-t border-[#0E1B2B]/12 pt-4\" data-kid=\"5-1-3-1-4\" data-name=\"plate footer row\">\n<span class=\"mono text-[10px] tracking-[0.24em] text-[#0E1B2B]/60\" data-kid=\"5-1-3-1-4-1\" data-name=\"project year\">2024</span>\n<a class=\"mono text-[9px] uppercase tracking-[0.26em] text-[#0E1B2B] hover:text-[#6A7889]\" data-kid=\"5-1-3-1-4-2\" data-name=\"read case study link\" href=\"#\">Read case study</a>\n</div>\n</article>\n<article class=\"plate tiltable border border-[#D9A441]/35 p-7\" data-kid=\"5-1-3-2\" data-name=\"work plate for Loom Audio\" data-tilt=\"\">\n<div class=\"flex items-start justify-between gap-4\" data-kid=\"5-1-3-2-1\" data-name=\"plate top row\">\n<span class=\"mono text-[10px] tracking-[0.3em] text-[#0E1B2B]/55\" data-kid=\"5-1-3-2-1-1\" data-name=\"plate index number\">03</span>\n<svg aria-hidden=\"true\" class=\"h-5 w-3.5\" data-kid=\"5-1-3-2-1-2\" data-name=\"plate rune glyph icon\" fill=\"none\" viewbox=\"0 0 16 24\">\n<path d=\"M8 2 V22 M8 8 L14 4 M8 8 L2 4 M8 16 L14 20 M8 16 L2 20\" stroke=\"#D9A441\"></path>\n</svg>\n</div>\n<h3 class=\"deco mt-5 text-[27px] leading-tight tracking-[0.02em]\" data-kid=\"5-1-3-2-2\" data-name=\"project title\">Loom Audio</h3>\n<p class=\"serif mt-3 text-[16px] leading-[1.6] text-[#0E1B2B]/72\" data-kid=\"5-1-3-2-3\" data-name=\"project description\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n<div class=\"mt-6 flex items-center justify-between gap-4 border-t border-[#0E1B2B]/12 pt-4\" data-kid=\"5-1-3-2-4\" data-name=\"plate footer row\">\n<span class=\"mono text-[10px] tracking-[0.24em] text-[#0E1B2B]/60\" data-kid=\"5-1-3-2-4-1\" data-name=\"project year\">2023</span>\n<a class=\"mono text-[9px] uppercase tracking-[0.26em] text-[#0E1B2B] hover:text-[#6A7889]\" data-kid=\"5-1-3-2-4-2\" data-name=\"read case study link\" href=\"#\">Read case study</a>\n</div>\n</article>\n</div>\n</div>\n</section>\n<section class=\"relative overflow-hidden bg-[#0E1B2B] text-[#EDF1F5]\" data-kid=\"6\" data-name=\"experience dark band\" id=\"experience\">\n<div class=\"pointer-events-none absolute inset-0\" data-kid=\"6-1\" data-name=\"icy light wash\" style=\"background:radial-gradient(75% 65% at 50% -10%, rgba(127,211,232,.18) 0%, rgba(127,211,232,0) 68%)\"></div>\n<div class=\"relative mx-auto max-w-[1180px] px-8 py-20\" data-kid=\"6-2\" data-name=\"experience content\">\n<div class=\"flex items-center justify-center gap-4\" data-kid=\"6-2-1\" data-name=\"experience heading row\">\n<span class=\"block h-px w-16 bg-[#D9A441]/70\" data-kid=\"6-2-1-1\" data-name=\"left keyline\"></span>\n<h2 class=\"deco text-[38px] uppercase tracking-[0.06em]\" data-kid=\"6-2-1-2\" data-name=\"experience heading\">Experience</h2>\n<span class=\"block h-px w-16 bg-[#D9A441]/70\" data-kid=\"6-2-1-3\" data-name=\"right keyline\"></span>\n</div>\n<div class=\"mt-12\" data-kid=\"6-2-2\" data-name=\"experience ledger\">\n<div class=\"grid items-baseline gap-3 border-t border-[#7FD3E8]/22 py-7 md:grid-cols-[150px_1fr_24px] md:gap-8\" data-kid=\"6-2-2-1\" data-name=\"Fintrail entry\">\n<span class=\"mono text-[10px] uppercase tracking-[0.26em] text-[#7FD3E8]/85\" data-kid=\"6-2-2-1-1\" data-name=\"Fintrail dates\">2022 — present</span>\n<div data-kid=\"6-2-2-1-2\" data-name=\"Fintrail role details\">\n<h3 class=\"deco text-[26px] leading-none tracking-[0.02em]\" data-kid=\"6-2-2-1-2-1\" data-name=\"Fintrail company\">Fintrail</h3>\n<p class=\"serif mt-2 text-[17px] text-[#8A9AA9]\" data-kid=\"6-2-2-1-2-2\" data-name=\"Fintrail role\">Senior product designer</p>\n</div>\n<svg aria-hidden=\"true\" class=\"hidden h-4 w-3 md:block\" data-kid=\"6-2-2-1-3\" data-name=\"row rune mark icon\" fill=\"none\" viewbox=\"0 0 16 24\">\n<path d=\"M8 2 V22 M8 8 L14 4 M8 8 L2 4\" stroke=\"#D9A441\" stroke-opacity=\".8\"></path>\n</svg>\n</div>\n<div class=\"grid items-baseline gap-3 border-t border-[#7FD3E8]/22 py-7 md:grid-cols-[150px_1fr_24px] md:gap-8\" data-kid=\"6-2-2-2\" data-name=\"Sundial Studio entry\">\n<span class=\"mono text-[10px] uppercase tracking-[0.26em] text-[#7FD3E8]/85\" data-kid=\"6-2-2-2-1\" data-name=\"Sundial Studio dates\">2019 — 2022</span>\n<div data-kid=\"6-2-2-2-2\" data-name=\"Sundial Studio role details\">\n<h3 class=\"deco text-[26px] leading-none tracking-[0.02em]\" data-kid=\"6-2-2-2-2-1\" data-name=\"Sundial Studio company\">Sundial Studio</h3>\n<p class=\"serif mt-2 text-[17px] text-[#8A9AA9]\" data-kid=\"6-2-2-2-2-2\" data-name=\"Sundial Studio role\">Product designer</p>\n</div>\n<svg aria-hidden=\"true\" class=\"hidden h-4 w-3 md:block\" data-kid=\"6-2-2-2-3\" data-name=\"row rune mark icon\" fill=\"none\" viewbox=\"0 0 16 24\">\n<path d=\"M8 2 V22 M8 8 L14 4 M8 8 L2 4\" stroke=\"#D9A441\" stroke-opacity=\".8\"></path>\n</svg>\n</div>\n<div class=\"grid items-baseline gap-3 border-y border-[#7FD3E8]/22 py-7 md:grid-cols-[150px_1fr_24px] md:gap-8\" data-kid=\"6-2-2-3\" data-name=\"Pageturn Press entry\">\n<span class=\"mono text-[10px] uppercase tracking-[0.26em] text-[#7FD3E8]/85\" data-kid=\"6-2-2-3-1\" data-name=\"Pageturn Press dates\">2017 — 2019</span>\n<div data-kid=\"6-2-2-3-2\" data-name=\"Pageturn Press role details\">\n<h3 class=\"deco text-[26px] leading-none tracking-[0.02em]\" data-kid=\"6-2-2-3-2-1\" data-name=\"Pageturn Press company\">Pageturn Press</h3>\n<p class=\"serif mt-2 text-[17px] text-[#8A9AA9]\" data-kid=\"6-2-2-3-2-2\" data-name=\"Pageturn Press role\">Interface designer</p>\n</div>\n<svg aria-hidden=\"true\" class=\"hidden h-4 w-3 md:block\" data-kid=\"6-2-2-3-3\" data-name=\"row rune mark icon\" fill=\"none\" viewbox=\"0 0 16 24\">\n<path d=\"M8 2 V22 M8 8 L14 4 M8 8 L2 4\" stroke=\"#D9A441\" stroke-opacity=\".8\"></path>\n</svg>\n</div>\n</div>\n</div>\n</section>\n<section class=\"border-b border-[#0E1B2B]/10\" data-kid=\"7\" data-name=\"education and elsewhere section\" id=\"education\">\n<div class=\"mx-auto max-w-[1180px] px-8 py-20\" data-kid=\"7-1\" data-name=\"education content\">\n<div class=\"flex items-center gap-4\" data-kid=\"7-1-1\" data-name=\"education heading row\">\n<span class=\"block h-px w-9 bg-[#D9A441]\" data-kid=\"7-1-1-1\" data-name=\"heading keyline\"></span>\n<h2 class=\"deco text-[34px] uppercase tracking-[0.08em]\" data-kid=\"7-1-1-2\" data-name=\"education heading\">Education</h2>\n<span class=\"block h-px w-9 bg-[#D9A441]\" data-kid=\"7-1-1-3\" data-name=\"heading keyline\"></span>\n</div>\n<div class=\"mt-9 grid gap-5 md:grid-cols-2\" data-kid=\"7-1-2\" data-name=\"rune cell grid\">\n<div class=\"tiltable relative border border-[#D9A441]/40 bg-[#E1E8EF] p-7\" data-kid=\"7-1-2-1\" data-name=\"education rune cell for NID\" data-tilt=\"\">\n<svg aria-hidden=\"true\" class=\"absolute right-5 top-5 h-4 w-3\" data-kid=\"7-1-2-1-1\" data-name=\"cell corner glyph icon\" fill=\"none\" viewbox=\"0 0 16 24\">\n<path d=\"M8 2 V22 M8 8 L14 4 M8 8 L2 4 M8 16 L14 20 M8 16 L2 20\" stroke=\"#D9A441\" stroke-opacity=\".8\"></path>\n</svg>\n<span class=\"mono text-[10px] uppercase tracking-[0.26em] text-[#6A7889]\" data-kid=\"7-1-2-1-2\" data-name=\"education dates\">2015 — 2017</span>\n<h3 class=\"deco mt-3 text-[21px] leading-tight tracking-[0.02em]\" data-kid=\"7-1-2-1-3\" data-name=\"institution name\">National Institute of Design</h3>\n<p class=\"serif mt-2 text-[16px] text-[#0E1B2B]/70\" data-kid=\"7-1-2-1-4\" data-name=\"field of study\">Interaction design</p>\n</div>\n<div class=\"tiltable relative border border-[#D9A441]/40 bg-[#E1E8EF] p-7\" data-kid=\"7-1-2-2\" data-name=\"education rune cell for Srishti\" data-tilt=\"\">\n<svg aria-hidden=\"true\" class=\"absolute right-5 top-5 h-4 w-3\" data-kid=\"7-1-2-2-1\" data-name=\"cell corner glyph icon\" fill=\"none\" viewbox=\"0 0 16 24\">\n<path d=\"M8 2 V22 M8 8 L14 4 M8 8 L2 4 M8 16 L14 20 M8 16 L2 20\" stroke=\"#D9A441\" stroke-opacity=\".8\"></path>\n</svg>\n<span class=\"mono text-[10px] uppercase tracking-[0.26em] text-[#6A7889]\" data-kid=\"7-1-2-2-2\" data-name=\"education dates\">2013 — 2015</span>\n<h3 class=\"deco mt-3 text-[21px] leading-tight tracking-[0.02em]\" data-kid=\"7-1-2-2-3\" data-name=\"institution name\">Srishti Institute</h3>\n<p class=\"serif mt-2 text-[16px] text-[#0E1B2B]/70\" data-kid=\"7-1-2-2-4\" data-name=\"field of study\">Foundation studies</p>\n</div>\n</div>\n<div class=\"mt-12 border-y border-[#D9A441]/40\" data-kid=\"7-1-3\" data-name=\"elsewhere row\" id=\"elsewhere\">\n<div class=\"flex flex-wrap items-center justify-between gap-x-8 gap-y-4 px-1 py-5\" data-kid=\"7-1-3-1\" data-name=\"elsewhere inner row\">\n<h2 class=\"deco text-[22px] uppercase tracking-[0.14em]\" data-kid=\"7-1-3-1-1\" data-name=\"elsewhere heading\">Elsewhere</h2>\n<div class=\"mono flex flex-wrap items-center gap-x-6 gap-y-2 text-[9px] uppercase tracking-[0.26em] text-[#0E1B2B]/70\" data-kid=\"7-1-3-1-2\" data-name=\"social links\">\n<a class=\"hover:text-[#0E1B2B]\" data-kid=\"7-1-3-1-2-1\" data-name=\"github link\" href=\"https://github.com\" rel=\"noreferrer\" target=\"_blank\">GitHub</a>\n<a class=\"hover:text-[#0E1B2B]\" data-kid=\"7-1-3-1-2-2\" data-name=\"dribbble link\" href=\"https://dribbble.com\" rel=\"noreferrer\" target=\"_blank\">Dribbble</a>\n<a class=\"hover:text-[#0E1B2B]\" data-kid=\"7-1-3-1-2-3\" data-name=\"linkedin link\" href=\"https://linkedin.com\" rel=\"noreferrer\" target=\"_blank\">LinkedIn</a>\n<a class=\"hover:text-[#0E1B2B]\" data-kid=\"7-1-3-1-2-4\" data-name=\"email link\" href=\"mailto:hello@example.com\">Email</a>\n</div>\n</div>\n</div>\n</div>\n</section>\n<footer class=\"bg-[#0E1B2B]\" data-kid=\"8\" data-name=\"footer bar\">\n<div class=\"mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-4 px-8 py-6\" data-kid=\"8-1\" data-name=\"footer inner row\">\n<span class=\"deco text-[10px] uppercase tracking-[0.38em] text-[#EDF1F5]/85\" data-kid=\"8-1-1\" data-name=\"footer name\">Aarav Menon</span>\n<a class=\"mono text-[9px] uppercase tracking-[0.3em] text-[#7FD3E8]\" data-kid=\"8-1-2\" data-name=\"back to top link\" href=\"#top\">Back to top</a>\n</div>\n</footer>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\n    (function () {\n      if (!window.gsap) return;\n      var gsap = window.gsap;\n      var cards = document.querySelectorAll('[data-tilt]');\n      Array.prototype.forEach.call(cards, function (card) {\n        var rotX = gsap.quickTo(card, 'rotationX', { duration: 0.45, ease: 'power3' });\n        var rotY = gsap.quickTo(card, 'rotationY', { duration: 0.45, ease: 'power3' });\n        var lift = gsap.quickTo(card, 'z', { duration: 0.45, ease: 'power3' });\n        gsap.set(card, { transformPerspective: 900 });\n        card.addEventListener('pointermove', function (event) {\n          var box = card.getBoundingClientRect();\n          var nx = (event.clientX - box.left) / box.width - 0.5;\n          var ny = (event.clientY - box.top) / box.height - 0.5;\n          rotY(nx * 7);\n          rotX(ny * -7);\n          lift(10);\n        });\n        card.addEventListener('pointerleave', function () {\n          rotX(0);\n          rotY(0);\n          lift(0);\n        });\n      });\n    })();\n  </script>\n</div>\n",
