      "html": "<body class=\"min-h-screen bg-[#FFE3F1] text-[#4A1330] antialiased\" id=\"top\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap');\n    body { font-family: 'Nunito', system-ui, sans-serif; }\n    .disp { font-family: 'Fredoka', system-ui, sans-serif; font-weight: 600; letter-spacing: -0.02em; }\n    .gin { background-image: repeating-linear-gradient(90deg, rgba(255,61,139,.14) 0 16px, transparent 16px 32px), repeating-linear-gradient(0deg, rgba(255,61,139,.14) 0 16px, transparent 16px 32px); }\n    .dots { background-image: radial-gradient(#FF3D8B 1.3px, transparent 1.4px); background-size: 17px 17px; }\n    .chrome { -webkit-background-clip: text; background-clip: text; color: transparent; background-image: linear-gradient(165deg, #FFFFFF 0%, #E2BCCE 13%, #6B5464 28%, #FBEDF3 42%, #4A1330 57%, #C79CB1 71%, #FFFFFF 86%); -webkit-text-stroke: 1px rgba(74,19,48,.26); }\n    .sticker { box-shadow: 0 0 0 4px #FFFFFF, 0 0 0 5px rgba(74,19,48,.10), 0 6px 14px rgba(74,19,48,.12); }\n    .proj .closeBtn { opacity: 0; pointer-events: none; }\n    .proj.is-open .closeBtn { opacity: 1; pointer-events: auto; }\n    .proj .coverPanel { backface-visibility: hidden; }\n  </style>\n<header class=\"relative z-20 border-b border-[#4A1330]/10 bg-white/75\" data-kid=\"1\" data-name=\"sticky site header bar\">\n<div class=\"mx-auto flex h-[68px] max-w-[1200px] items-center justify-between px-8\" data-kid=\"1-1\" data-name=\"header content row\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand lockup group\">\n<span class=\"sticker grid h-9 w-9 place-items-center rounded-[11px] bg-[#FF3D8B] text-[13px] font-extrabold tracking-[-0.02em] text-white\" data-kid=\"1-1-1-1\" data-name=\"brand monogram badge\">AM</span>\n<span class=\"disp text-[17px] leading-none\" data-kid=\"1-1-1-2\" data-name=\"site brand name\">Aarav Menon</span>\n</div>\n<nav class=\"hidden items-center gap-8 text-[12.5px] font-bold text-[#7A3555] md:flex\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n<a class=\"hover:text-[#4A1330]\" data-kid=\"1-1-2-1\" data-name=\"nav link to Work section\" href=\"#work\">Work</a>\n<a class=\"hover:text-[#4A1330]\" data-kid=\"1-1-2-2\" data-name=\"nav link to Experience section\" href=\"#experience\">Experience</a>\n<a class=\"hover:text-[#4A1330]\" data-kid=\"1-1-2-3\" data-name=\"nav link to Education section\" href=\"#education\">Education</a>\n<a class=\"hover:text-[#4A1330]\" data-kid=\"1-1-2-4\" data-name=\"nav link to Elsewhere section\" href=\"#elsewhere\">Elsewhere</a>\n</nav>\n<a class=\"inline-flex items-center gap-2 rounded-full bg-[#4A1330] px-5 py-2.5 text-[12px] font-extrabold text-[#FFE3F1]\" data-kid=\"1-1-3\" data-name=\"header email contact button\" href=\"#elsewhere\">\n<i class=\"bi bi-envelope-fill text-[11px]\" data-kid=\"1-1-3-1\" data-name=\"envelope icon\"></i> Email\n      </a>\n</div>\n</header>\n<section class=\"relative overflow-hidden px-8 pb-16 pt-14\" data-kid=\"2\" data-name=\"hero section\">\n<div class=\"pointer-events-none absolute -right-24 -top-16 h-[420px] w-[420px] rounded-full opacity-[0.55] gin\" data-kid=\"2-1\" data-name=\"decorative radial grid orb\" style=\"mask-image: radial-gradient(circle at 50% 50%, #000 30%, transparent 72%); -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 30%, transparent 72%);\"></div>\n<div class=\"pointer-events-none absolute inset-x-0 bottom-0 h-40 dots opacity-[0.18]\" data-kid=\"2-2\" data-name=\"decorative dot pattern strip\" style=\"mask-image: linear-gradient(to top, #000, transparent); -webkit-mask-image: linear-gradient(to top, #000, transparent);\"></div>\n<div class=\"relative mx-auto grid max-w-[1200px] items-center gap-14 md:grid-cols-[1.06fr_0.94fr]\" data-kid=\"2-3\" data-name=\"hero two-column layout\">\n<div data-kid=\"2-3-1\" data-name=\"hero text column\">\n<div class=\"mb-5 inline-flex items-center gap-2.5 text-[10.5px] font-extrabold uppercase tracking-[0.22em] text-[#B01055]\" data-kid=\"2-3-1-1\" data-name=\"role eyebrow label with dot\">\n<span class=\"h-2 w-2 rounded-full bg-[#FF3D8B]\" data-kid=\"2-3-1-1-1\" data-name=\"eyebrow accent dot\"></span> Interface designer — Bengaluru\n        </div>\n<h1 class=\"disp text-[86px] leading-[0.84] sm:text-[104px]\" data-kid=\"2-3-1-2\" data-name=\"hero name headline\">\n<span class=\"block text-[#4A1330]\" data-kid=\"2-3-1-2-1\" data-name=\"first name text\">Aarav</span>\n<span class=\"chrome block\" data-kid=\"2-3-1-2-2\" data-name=\"chrome gradient last name text\">Menon</span>\n</h1>\n<p class=\"mt-7 max-w-[44ch] text-[15.5px] leading-[1.8] text-[#6E4356]\" data-kid=\"2-3-1-3\" data-name=\"hero intro paragraph\">\n          I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n        </p>\n<div class=\"mt-8 flex flex-wrap items-center gap-3\" data-kid=\"2-3-1-4\" data-name=\"hero action button row\">\n<a class=\"inline-flex items-center gap-2.5 rounded-full bg-[#FF3D8B] px-7 py-4 text-[13.5px] font-extrabold text-white\" data-kid=\"2-3-1-4-1\" data-name=\"primary CTA button to work\" href=\"#work\" style=\"box-shadow:0 5px 0 #D01A6B\">\n            See the work <i class=\"bi bi-arrow-down-right text-[13px]\" data-kid=\"2-3-1-4-1-1\" data-name=\"diagonal arrow icon\"></i>\n</a>\n<a class=\"inline-flex items-center gap-2 rounded-full border-2 border-[#4A1330]/25 px-6 py-3.5 text-[13px] font-bold text-[#4A1330]\" data-kid=\"2-3-1-4-2\" data-name=\"secondary CTA button to experience\" href=\"#experience\">\n            Experience <i class=\"bi bi-arrow-right text-[12px]\" data-kid=\"2-3-1-4-2-1\" data-name=\"right arrow icon\"></i>\n</a>\n</div>\n</div>\n<div class=\"relative mx-auto w-full max-w-[400px]\" data-kid=\"2-3-2\" data-name=\"portrait ID card container\">\n<div class=\"rounded-[32px] bg-white p-3\" data-kid=\"2-3-2-1\" data-name=\"ID card outer shell\" style=\"box-shadow:0 0 0 1px rgba(74,19,48,.08), 0 28px 56px rgba(74,19,48,.16)\">\n<div class=\"relative overflow-hidden rounded-[24px] bg-[#FFD0E6]\" data-kid=\"2-3-2-1-1\" data-name=\"photo area panel\">\n<div class=\"pointer-events-none absolute inset-0 dots opacity-[0.22]\" data-kid=\"2-3-2-1-1-1\" data-name=\"photo background dot pattern\"></div>\n<div class=\"relative p-5\" data-kid=\"2-3-2-1-1-2\" data-name=\"card inner content area\">\n<div class=\"relative rounded-[20px] p-4\" data-kid=\"2-3-2-1-1-2-1\" data-name=\"portrait illustration frame\" style=\"background:rgba(255,255,255,.55); box-shadow: inset 0 0 0 1px rgba(255,255,255,.9), inset 0 -22px 34px rgba(255,61,139,.16)\">\n<svg aria-label=\"Illustrated portrait of Aarav Menon\" class=\"mx-auto block w-[190px]\" data-kid=\"2-3-2-1-1-2-1-1\" data-name=\"illustrated avatar portrait\" role=\"img\" viewbox=\"0 0 220 200\">\n<circle cx=\"110\" cy=\"98\" fill=\"#FFF6FA\" r=\"92\"></circle>\n<circle cx=\"110\" cy=\"98\" fill=\"none\" opacity=\"0.16\" r=\"92\" stroke=\"#4A1330\" stroke-width=\"2\"></circle>\n<path d=\"M44 200c0-34 29-56 66-56s66 22 66 56\" fill=\"#4A1330\"></path>\n<path d=\"M92 148h36l-4 22h-28z\" fill=\"#FFF6FA\"></path>\n<circle cx=\"110\" cy=\"88\" fill=\"#FFF6FA\" r=\"33\" stroke=\"#4A1330\" stroke-width=\"2.5\"></circle>\n<path d=\"M77 84c0-21 15-35 33-35s33 14 33 35c-8-11-19-16-33-16s-25 5-33 16Z\" fill=\"#4A1330\"></path>\n<rect fill=\"none\" height=\"13\" rx=\"5\" stroke=\"#FF3D8B\" stroke-width=\"2.6\" width=\"17\" x=\"89\" y=\"84\"></rect>\n<rect fill=\"none\" height=\"13\" rx=\"5\" stroke=\"#FF3D8B\" stroke-width=\"2.6\" width=\"17\" x=\"114\" y=\"84\"></rect>\n<path d=\"M106 90h8\" stroke=\"#FF3D8B\" stroke-width=\"2.5\"></path>\n<path d=\"M102 106c5 5 12 5 17 0\" fill=\"none\" stroke=\"#4A1330\" stroke-linecap=\"round\" stroke-width=\"2.4\"></path>\n</svg>\n</div>\n<div class=\"mt-4 rounded-[16px] bg-white px-4 py-3.5\" data-kid=\"2-3-2-1-1-2-2\" data-name=\"name and title card strip\">\n<div class=\"flex items-baseline justify-between gap-3\" data-kid=\"2-3-2-1-1-2-2-1\" data-name=\"name and portfolio label row\">\n<span class=\"disp text-[19px] leading-none\" data-kid=\"2-3-2-1-1-2-2-1-1\" data-name=\"displayed full name\">Aarav Menon</span>\n<span class=\"text-[9px] font-extrabold uppercase tracking-[0.16em] text-[#B01055]\" data-kid=\"2-3-2-1-1-2-2-1-2\" data-name=\"portfolio label\">Portfolio</span>\n</div>\n<div class=\"mt-2 flex items-center gap-3 text-[11px] font-bold text-[#8E5570]\" data-kid=\"2-3-2-1-1-2-2-2\" data-name=\"role and location row\">\n<span data-kid=\"2-3-2-1-1-2-2-2-1\" data-name=\"role text\">Interface designer</span>\n<span class=\"h-1 w-1 rounded-full bg-[#FF3D8B]\" data-kid=\"2-3-2-1-1-2-2-2-2\" data-name=\"role separator dot\"></span>\n<span data-kid=\"2-3-2-1-1-2-2-2-3\" data-name=\"location text\">Bengaluru</span>\n</div>\n</div>\n<div class=\"mt-3 grid grid-cols-3 gap-2\" data-kid=\"2-3-2-1-1-2-3\" data-name=\"stat tiles row\">\n<div class=\"rounded-[11px] bg-white/85 px-3 py-2\" data-kid=\"2-3-2-1-1-2-3-1\" data-name=\"projects stat tile\">\n<div class=\"disp text-[16px] leading-none\" data-kid=\"2-3-2-1-1-2-3-1-1\" data-name=\"projects count value\">03</div>\n<div class=\"mt-1 text-[8.5px] font-extrabold uppercase tracking-[0.12em] text-[#8E5570]\" data-kid=\"2-3-2-1-1-2-3-1-2\" data-name=\"projects stat label\">Projects</div>\n</div>\n<div class=\"rounded-[11px] bg-white/85 px-3 py-2\" data-kid=\"2-3-2-1-1-2-3-2\" data-name=\"roles stat tile\">\n<div class=\"disp text-[16px] leading-none\" data-kid=\"2-3-2-1-1-2-3-2-1\" data-name=\"roles count value\">03</div>\n<div class=\"mt-1 text-[8.5px] font-extrabold uppercase tracking-[0.12em] text-[#8E5570]\" data-kid=\"2-3-2-1-1-2-3-2-2\" data-name=\"roles stat label\">Roles</div>\n</div>\n<div class=\"rounded-[11px] bg-white/85 px-3 py-2\" data-kid=\"2-3-2-1-1-2-3-3\" data-name=\"degrees stat tile\">\n<div class=\"disp text-[16px] leading-none\" data-kid=\"2-3-2-1-1-2-3-3-1\" data-name=\"degrees count value\">02</div>\n<div class=\"mt-1 text-[8.5px] font-extrabold uppercase tracking-[0.12em] text-[#8E5570]\" data-kid=\"2-3-2-1-1-2-3-3-2\" data-name=\"degrees stat label\">Degrees</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"absolute -bottom-6 -left-5 grid h-[74px] w-[74px] place-items-center rounded-full text-[13px] font-extrabold text-[#4A1330]\" data-kid=\"2-3-2-2\" data-name=\"overlapping badge sticker\" style=\"background: conic-gradient(from 210deg, #FFFFFF, #E9D3DD, #FFFFFF, #B7A6B1, #FFFFFF, #E9D3DD, #FFFFFF); box-shadow: 0 10px 22px rgba(74,19,48,.22)\">\n<span class=\"grid h-[58px] w-[58px] place-items-center rounded-full bg-[#4A1330] text-[#FFD0E6]\" data-kid=\"2-3-2-2-1\" data-name=\"badge monogram\">AM</span>\n</div>\n</div>\n</div>\n</section>\n<div class=\"relative flex justify-center pb-4 pt-2\" data-kid=\"3\" data-name=\"dollhouse divider container\">\n<svg aria-hidden=\"true\" class=\"w-full max-w-[540px]\" data-dynamic=\"true\" data-kid=\"3-1\" data-name=\"dollhouse divider illustration\" data-reason=\"window and door fill colors set by ScrollTrigger script when scrolled into view\" id=\"dollhouse\" viewbox=\"0 0 520 176\">\n<rect fill=\"#FFFFFF\" height=\"36\" stroke=\"#4A1330\" stroke-linejoin=\"round\" stroke-width=\"2\" width=\"26\" x=\"356\" y=\"36\"></rect>\n<path d=\"M56 84 L260 20 L464 84\" fill=\"#FFFFFF\" stroke=\"#4A1330\" stroke-linejoin=\"round\" stroke-width=\"2.4\"></path>\n<rect fill=\"#FFFFFF\" height=\"76\" stroke=\"#4A1330\" stroke-linejoin=\"round\" stroke-width=\"2.4\" width=\"344\" x=\"88\" y=\"84\"></rect>\n<circle class=\"win\" cx=\"260\" cy=\"64\" fill=\"#FFFFFF\" r=\"12\" stroke=\"#4A1330\" stroke-width=\"2.2\"></circle>\n<rect class=\"win\" fill=\"#FFFFFF\" height=\"32\" rx=\"4\" stroke=\"#4A1330\" stroke-width=\"2.2\" width=\"36\" x=\"112\" y=\"106\"></rect>\n<rect class=\"win\" fill=\"#FFFFFF\" height=\"32\" rx=\"4\" stroke=\"#4A1330\" stroke-width=\"2.2\" width=\"36\" x=\"176\" y=\"106\"></rect>\n<rect class=\"win\" fill=\"#FFFFFF\" height=\"32\" rx=\"4\" stroke=\"#4A1330\" stroke-width=\"2.2\" width=\"36\" x=\"308\" y=\"106\"></rect>\n<rect class=\"win\" fill=\"#FFFFFF\" height=\"32\" rx=\"4\" stroke=\"#4A1330\" stroke-width=\"2.2\" width=\"36\" x=\"372\" y=\"106\"></rect>\n<path class=\"door\" d=\"M234 160v-26a26 26 0 0 1 52 0v26Z\" fill=\"#FFD0E6\" stroke=\"#4A1330\" stroke-width=\"2.2\"></path>\n<circle cx=\"274\" cy=\"146\" fill=\"#4A1330\" r=\"2.4\"></circle>\n</svg>\n</div>\n<section class=\"border-y border-[#4A1330]/10 bg-white px-8 py-16\" data-kid=\"4\" data-name=\"skills section\">\n<div class=\"mx-auto grid max-w-[1200px] items-start gap-12 md:grid-cols-[0.72fr_1.28fr]\" data-kid=\"4-1\" data-name=\"skills two-column layout\">\n<div data-kid=\"4-1-1\" data-name=\"skills info column\">\n<h2 class=\"disp text-[46px] leading-none\" data-kid=\"4-1-1-1\" data-name=\"skills section title\">Skills</h2>\n<div class=\"mt-6 space-y-3 border-t border-[#4A1330]/12 pt-5\" data-kid=\"4-1-1-2\" data-name=\"info detail list\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"4-1-1-2-1\" data-name=\"current role row\">\n<span class=\"text-[12.5px] font-bold text-[#8E5570]\" data-kid=\"4-1-1-2-1-1\" data-name=\"current role label\">Current role</span>\n<span class=\"disp text-[14px]\" data-kid=\"4-1-1-2-1-2\" data-name=\"current role value\">Fintrail, since 2022</span>\n</div>\n<div class=\"flex items-baseline justify-between\" data-kid=\"4-1-1-2-2\" data-name=\"based-in row\">\n<span class=\"text-[12.5px] font-bold text-[#8E5570]\" data-kid=\"4-1-1-2-2-1\" data-name=\"based-in label\">Based in</span>\n<span class=\"disp text-[14px]\" data-kid=\"4-1-1-2-2-2\" data-name=\"based-in value\">Bengaluru, IST</span>\n</div>\n<div class=\"flex items-baseline justify-between\" data-kid=\"4-1-1-2-3\" data-name=\"projects count row\">\n<span class=\"text-[12.5px] font-bold text-[#8E5570]\" data-kid=\"4-1-1-2-3-1\" data-name=\"projects count label\">Projects shown</span>\n<span class=\"disp text-[14px]\" data-kid=\"4-1-1-2-3-2\" data-name=\"projects count value\">03</span>\n</div>\n</div>\n</div>\n<div data-kid=\"4-1-2\" data-name=\"draggable sticker sheet and stamp area\">\n<div class=\"relative flex flex-wrap items-center gap-x-4 gap-y-5 pb-2\" data-kid=\"4-1-2-1\" data-name=\"draggable skill stickers container\" id=\"stickerSheet\">\n<span class=\"sticker disp cursor-grab rounded-full bg-[#FF3D8B] px-5 py-3 text-[15px] text-white select-none\" data-dynamic=\"true\" data-kid=\"4-1-2-1-1\" data-name=\"design systems skill sticker\" data-reason=\"position and rotation rewritten by Draggable interaction script\">Design systems</span>\n<span class=\"sticker disp cursor-grab rounded-full bg-[#FFD0E6] px-5 py-3 text-[15px] text-[#4A1330] select-none\" data-dynamic=\"true\" data-kid=\"4-1-2-1-2\" data-name=\"interaction design skill sticker\" data-reason=\"position and rotation rewritten by Draggable interaction script\">Interaction design</span>\n<span class=\"sticker disp cursor-grab rounded-full bg-[#FFB3D3] px-5 py-3 text-[15px] text-[#4A1330] select-none\" data-dynamic=\"true\" data-kid=\"4-1-2-1-3\" data-name=\"prototyping skill sticker\" data-reason=\"position and rotation rewritten by Draggable interaction script\">Prototyping</span>\n<span class=\"sticker disp cursor-grab rounded-full bg-[#4A1330] px-5 py-3 text-[15px] text-[#FFD0E6] select-none\" data-dynamic=\"true\" data-kid=\"4-1-2-1-4\" data-name=\"motion skill sticker\" data-reason=\"position and rotation rewritten by Draggable interaction script\">Motion</span>\n<span class=\"sticker disp cursor-grab rounded-full bg-[#FFD0E6] px-5 py-3 text-[15px] text-[#4A1330] select-none\" data-dynamic=\"true\" data-kid=\"4-1-2-1-5\" data-name=\"type skill sticker\" data-reason=\"position and rotation rewritten by Draggable interaction script\">Type</span>\n<span class=\"sticker disp cursor-grab rounded-full bg-[#FFB3D3] px-5 py-3 text-[15px] text-[#4A1330] select-none\" data-dynamic=\"true\" data-kid=\"4-1-2-1-6\" data-name=\"research skill sticker\" data-reason=\"position and rotation rewritten by Draggable interaction script\">Research</span>\n</div>\n<div class=\"mt-8 flex items-center gap-5\" data-kid=\"4-1-2-2\" data-name=\"availability stamp row\">\n<button aria-label=\"Stamp portfolio as available for work\" aria-pressed=\"false\" class=\"relative grid h-[100px] w-[100px] shrink-0 place-items-center rounded-full text-center\" data-kid=\"4-1-2-2-1\" data-name=\"availability rubber stamp button\" id=\"stampBtn\" style=\"background:linear-gradient(180deg,#FF6FA8,#E01E70); box-shadow:0 7px 0 #B01055, 0 12px 20px rgba(74,19,48,.22); transform-origin: 50% 100%\" type=\"button\">\n<span class=\"pointer-events-none absolute inset-[8px] rounded-full border border-white/70\" data-kid=\"4-1-2-2-1-1\" data-name=\"stamp inner ring\"></span>\n<span class=\"relative disp text-[10px] font-bold uppercase leading-[1.35] tracking-[0.06em] text-white\" data-kid=\"4-1-2-2-1-2\" data-name=\"stamp button label\">Available<br data-kid=\"4-1-2-2-1-2-1\" data-name=\"line break in stamp label\"/>for work</span>\n</button>\n<div class=\"relative h-[92px] flex-1\" data-kid=\"4-1-2-2-2\" data-name=\"stamp imprint area\">\n<div class=\"pointer-events-none absolute left-0 top-1 flex h-[78px] w-[300px] items-center justify-center rounded-[8px]\" data-dynamic=\"true\" data-kid=\"4-1-2-2-2-1\" data-name=\"impressed 'available for work' stamp\" data-reason=\"opacity and transform set by stamp click script (hidden until pressed)\" id=\"imprint\" style=\"opacity:0; border:3px solid #E01E70; color:#E01E70; transform: rotate(-7deg); background-image: radial-gradient(rgba(224,30,112,.18) 0.6px, transparent 0.7px); background-size: 3px 3px;\">\n<span class=\"disp text-[17px] font-bold uppercase tracking-[0.14em]\" data-kid=\"4-1-2-2-2-1-1\" data-name=\"imprint text\">Available for work</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"px-8 py-16\" data-kid=\"5\" data-name=\"selected work section\" id=\"work\">\n<div class=\"mx-auto max-w-[1200px]\" data-kid=\"5-1\" data-name=\"work section layout\">\n<div class=\"flex flex-wrap items-end justify-between gap-5\" data-kid=\"5-1-1\" data-name=\"work header row\">\n<h2 class=\"disp text-[46px] leading-none\" data-kid=\"5-1-1-1\" data-name=\"work section title\">Selected work</h2>\n<div class=\"flex items-center gap-2\" data-kid=\"5-1-1-2\" data-name=\"project carousel controls\">\n<span class=\"mr-2 text-[11px] font-bold uppercase tracking-[0.16em] text-[#8E5570]\" data-kid=\"5-1-1-2-1\" data-name=\"project count label\">03 projects</span>\n<button aria-label=\"Previous project\" class=\"grid h-10 w-10 place-items-center rounded-full bg-white text-[#4A1330]\" data-kid=\"5-1-1-2-2\" data-name=\"previous project button\" id=\"railPrev\" style=\"box-shadow:0 0 0 1px rgba(74,19,48,.12)\" type=\"button\">\n<i class=\"bi bi-arrow-left text-[13px]\" data-kid=\"5-1-1-2-2-1\" data-name=\"left arrow icon\"></i>\n</button>\n<button aria-label=\"Next project\" class=\"grid h-10 w-10 place-items-center rounded-full bg-[#4A1330] text-[#FFE3F1]\" data-kid=\"5-1-1-2-3\" data-name=\"next project button\" id=\"railNext\" type=\"button\">\n<i class=\"bi bi-arrow-right text-[13px]\" data-kid=\"5-1-1-2-3-1\" data-name=\"right arrow icon\"></i>\n</button>\n</div>\n</div>\n<div class=\"mt-8 overflow-hidden\" data-kid=\"5-1-2\" data-name=\"project carousel viewport\" id=\"railWrap\">\n<div class=\"flex w-max cursor-grab gap-6 pb-2\" data-dynamic=\"true\" data-kid=\"5-1-2-1\" data-name=\"draggable project rail track\" data-reason=\"rail track x position rewritten by Draggable and nudge buttons\" id=\"rail\" style=\"padding-right: 140px\">\n<article class=\"proj relative h-[352px] w-[540px] shrink-0\" data-kid=\"5-1-2-1-1\" data-name=\"Kestrel project card\" style=\"perspective: 1500px\