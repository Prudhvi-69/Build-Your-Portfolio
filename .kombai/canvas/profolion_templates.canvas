    "var_c72da1816899": {
      "type": "variant",
      "label": "Grand Line — One Piece template",
      "parentId": "var_100ec6c3a362",
      "themeId": null,
      "rect": {
        "x": 7060,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<body class=\"min-h-screen bg-[#F6EFDF] text-[#12232B] antialiased\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n    body { font-family: 'Space Grotesk', sans-serif; }\n    .poster { clip-path: polygon(0 2%, 97% 0, 100% 97%, 3% 100%); }\n    .log-scroll::-webkit-scrollbar { height: 0; }\n    .tilt { will-change: transform; transition: transform 260ms cubic-bezier(.2,.8,.2,1); }\n  </style>\n<header class=\"sticky top-0 z-30 border-b border-[#F6EFDF]/15 bg-[#0B2B3C]\" data-kid=\"1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[62px] max-w-[1180px] items-center justify-between px-7\" data-kid=\"1-1\" data-name=\"header content row\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"owner monogram home link\" href=\"#top\">\n<span class=\"grid h-8 w-8 place-items-center rounded-full border border-[#C8842B] font-semibold text-[#C8842B] text-[11px]\" data-kid=\"1-1-1-1\" data-name=\"AM monogram badge\">AM</span>\n<span class=\"text-[15px] font-semibold tracking-[-0.01em] text-[#F6EFDF]\" data-kid=\"1-1-1-2\" data-name=\"owner name logo text\">Aarav Menon</span>\n</a>\n<nav class=\"hidden items-center gap-7 text-[10px] uppercase tracking-[0.22em] text-[#8FA6AD] md:flex\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n<a data-kid=\"1-1-2-1\" data-name=\"plunder section nav link\" href=\"#work\">Plunder</a><a data-kid=\"1-1-2-2\" data-name=\"log section nav link\" href=\"#log\">Log</a><a data-kid=\"1-1-2-3\" data-name=\"port section nav link\" href=\"#port\">Port</a>\n</nav>\n<span class=\"text-[9px] uppercase tracking-[0.24em] text-[#8FA6AD]\" data-kid=\"1-1-3\" data-name=\"interface designer role label\">Interface designer</span>\n</div>\n</header>\n<section class=\"relative overflow-hidden bg-[#0B2B3C] text-[#F6EFDF]\" data-kid=\"2\" data-name=\"hero section with gradient background\" id=\"top\">\n<div aria-hidden=\"\" class=\"pointer-events-none absolute inset-0\" data-kid=\"2-1\" data-name=\"hero radial gradient glow overlay\" style=\"background-image:radial-gradient(60% 50% at 18% 8%, rgba(200,132,43,0.28), transparent 68%), radial-gradient(45% 40% at 86% 96%, rgba(143,166,173,0.18), transparent 72%)\"></div>\n<svg aria-hidden=\"\" class=\"pointer-events-none absolute right-[54px] top-[64px] hidden h-[190px] w-[190px] opacity-40 md:block\" data-dynamic=\"true\" data-kid=\"2-2\" data-name=\"decorative compass rose icon\" data-reason=\"transform rotation rewritten on every pointer move by compass script\" id=\"compass\" style=\"transform-origin:100px 100px\" viewbox=\"0 0 200 200\">\n<circle cx=\"100\" cy=\"100\" fill=\"none\" r=\"86\" stroke=\"#C8842B\" stroke-width=\"0.8\"></circle>\n<circle cx=\"100\" cy=\"100\" fill=\"none\" r=\"62\" stroke=\"#C8842B\" stroke-dasharray=\"2 7\" stroke-width=\"0.5\"></circle>\n<path d=\"M100 16 L110 92 L100 100 L90 92 Z\" fill=\"#C8842B\"></path>\n<path d=\"M100 184 L92 108 L100 100 L108 108 Z\" fill=\"#8FA6AD\" opacity=\"0.6\"></path>\n<path d=\"M16 100 L92 92 L100 100 L92 108 Z\" fill=\"#8FA6AD\" opacity=\"0.35\"></path>\n<path d=\"M184 100 L108 108 L100 100 L108 92 Z\" fill=\"#8FA6AD\" opacity=\"0.35\"></path>\n<text fill=\"#F6EFDF\" font-family=\"IBM Plex Mono, monospace\" font-size=\"9\" text-anchor=\"middle\" x=\"100\" y=\"46\">N</text>\n</svg>\n<div class=\"relative mx-auto max-w-[1180px] px-7 pb-24 pt-14 md:pb-28 md:pt-20\" data-kid=\"2-3\" data-name=\"hero content container\">\n<p class=\"text-[10px] uppercase tracking-[0.42em] text-[#8FA6AD]\" data-kid=\"2-3-1\" data-name=\"hero eyebrow tagline text\">Charting since 2017</p>\n<h1 class=\"mt-4 uppercase leading-[0.78]\" data-kid=\"2-3-2\" data-name=\"hero name headline\" style=\"font-family:'Bebas Neue', sans-serif; font-size:clamp(4.4rem,13vw,9.6rem); letter-spacing:0.01em\">Aarav<br data-kid=\"2-3-2-1\" data-name=\"headline line break\"/><span class=\"text-[#C8842B]\" data-kid=\"2-3-2-2\" data-name=\"hero surname accent text\">Menon</span></h1>\n<div class=\"mt-7 grid gap-8 md:grid-cols-[1.1fr_1fr] md:items-end\" data-kid=\"2-3-3\" data-name=\"hero intro and skills row\">\n<p class=\"max-w-[44ch] text-[15px] leading-[1.85] text-[#F6EFDF]/72\" data-kid=\"2-3-3-1\" data-name=\"hero bio paragraph\">\n          I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n        </p>\n<div class=\"flex flex-wrap gap-2\" data-kid=\"2-3-3-2\" data-name=\"skill tag list\">\n<span class=\"border border-[#F6EFDF]/22 px-3 py-1.5 text-[10px]\" data-kid=\"2-3-3-2-1\" data-name=\"design systems skill tag\">Design systems</span>\n<span class=\"border border-[#F6EFDF]/22 px-3 py-1.5 text-[10px]\" data-kid=\"2-3-3-2-2\" data-name=\"interaction design skill tag\">Interaction design</span>\n<span class=\"border border-[#F6EFDF]/22 px-3 py-1.5 text-[10px]\" data-kid=\"2-3-3-2-3\" data-name=\"prototyping skill tag\">Prototyping</span>\n<span class=\"border border-[#F6EFDF]/22 px-3 py-1.5 text-[10px]\" data-kid=\"2-3-3-2-4\" data-name=\"motion skill tag\">Motion</span>\n<span class=\"border border-[#F6EFDF]/22 px-3 py-1.5 text-[10px]\" data-kid=\"2-3-3-2-5\" data-name=\"type skill tag\">Type</span>\n<span class=\"border border-[#F6EFDF]/22 px-3 py-1.5 text-[10px]\" data-kid=\"2-3-3-2-6\" data-name=\"research skill tag\">Research</span>\n</div>\n</div>\n<div class=\"mt-10 grid gap-2 sm:grid-cols-3\" data-kid=\"2-3-4\" data-name=\"hero status stats row\">\n<div class=\"border border-[#C8842B]/40 bg-[#F6EFDF]/[0.04] px-4 py-3\" data-kid=\"2-3-4-1\" data-name=\"current role stat card\">\n<p class=\"text-[8px] uppercase tracking-[0.24em] text-[#8FA6AD]\" data-kid=\"2-3-4-1-1\" data-name=\"currently label\">Currently</p>\n<p class=\"mt-1 text-[13px] font-medium\" data-kid=\"2-3-4-1-2\" data-name=\"current role value text\">Fintrail — senior product designer</p>\n</div>\n<div class=\"border border-[#C8842B]/40 bg-[#F6EFDF]/[0.04] px-4 py-3\" data-kid=\"2-3-4-2\" data-name=\"projects count stat card\">\n<p class=\"text-[8px] uppercase tracking-[0.24em] text-[#8FA6AD]\" data-kid=\"2-3-4-2-1\" data-name=\"voyages logged label\">Voyages logged</p>\n<p class=\"mt-1 text-[13px] font-medium\" data-kid=\"2-3-4-2-2\" data-name=\"projects and roles count text\">03 projects · 03 roles</p>\n</div>\n<div class=\"border border-[#C8842B]/40 bg-[#F6EFDF]/[0.04] px-4 py-3\" data-kid=\"2-3-4-3\" data-name=\"location stat card\">\n<p class=\"text-[8px] uppercase tracking-[0.24em] text-[#8FA6AD]\" data-kid=\"2-3-4-3-1\" data-name=\"charted from label\">Charted from</p>\n<p class=\"mt-1 text-[13px] font-medium\" data-kid=\"2-3-4-3-2\" data-name=\"home city value text\">Bengaluru</p>\n</div>\n</div>\n</div>\n<svg aria-hidden=\"\" class=\"block h-[72px] w-full\" data-kid=\"2-4\" data-name=\"hero wave divider\" preserveaspectratio=\"none\" viewbox=\"0 0 1280 90\">\n<path d=\"M0 52 C 160 12, 300 78, 470 44 C 640 10, 780 72, 960 42 C 1100 18, 1200 52, 1280 34 L1280 90 L0 90 Z\" fill=\"#F6EFDF\" opacity=\"0.9\"></path>\n<path d=\"M0 68 C 200 34, 340 92, 520 62 C 700 32, 860 88, 1040 60 C 1160 42, 1220 66, 1280 52 L1280 90 L0 90 Z\" fill=\"#F6EFDF\"></path>\n</svg>\n</section>\n<section class=\"mx-auto max-w-[1180px] px-7 py-14\" data-kid=\"3\" data-name=\"plunder work section\" id=\"work\">\n<div class=\"flex items-baseline justify-between border-b border-[#12232B]/15 pb-3\" data-kid=\"3-1\" data-name=\"plunder section heading row\">\n<h2 class=\"uppercase\" data-kid=\"3-1-1\" data-name=\"plunder section title\" style=\"font-family:'Bebas Neue', sans-serif; font-size:44px; letter-spacing:0.02em\">Plunder</h2>\n<span class=\"font-mono text-[10px] tracking-[0.16em] text-[#7C7262]\" data-kid=\"3-1-2\" data-name=\"project count label\">03 projects</span>\n</div>\n<div class=\"mt-8 grid gap-5 md:grid-cols-[1.15fr_0.85fr] md:items-start\" data-kid=\"3-2\" data-name=\"project cards grid\">\n<article class=\"poster tilt bg-[#EFE4CC] p-8 md:min-h-[360px]\" data-kid=\"3-2-1\" data-name=\"featured kestrel project card\" data-tilt=\"\">\n<div class=\"flex items-center justify-between\" data-kid=\"3-2-1-1\" data-name=\"kestrel card category and year row\">\n<span class=\"text-[9px] uppercase tracking-[0.22em] text-[#7C7262]\" data-kid=\"3-2-1-1-1\" data-name=\"kestrel category label\">Design system</span>\n<span class=\"font-mono text-[10px] text-[#7C7262]\" data-kid=\"3-2-1-1-2\" data-name=\"kestrel year label\">2025</span>\n</div>\n<h3 class=\"mt-5 uppercase leading-[0.86]\" data-kid=\"3-2-1-2\" data-name=\"kestrel project title\" style=\"font-family:'Bebas Neue', sans-serif; font-size:64px\">Kestrel</h3>\n<p class=\"mt-3 max-w-[42ch] text-[13.5px] leading-[1.8] text-[#12232B]/75\" data-kid=\"3-2-1-3\" data-name=\"kestrel project description text\">\n          A 240-component library and the token pipeline behind it, adopted by four product teams.\n        </p>\n<div class=\"mt-7 flex items-center justify-between border-t border-[#12232B]/15 pt-4\" data-kid=\"3-2-1-4\" data-name=\"kestrel card footer row\">\n<a class=\"text-[10px] font-semibold uppercase tracking-[0.18em] text-[#C8842B]\" data-kid=\"3-2-1-4-1\" data-name=\"kestrel open chart link\" href=\"#work\">Open the chart</a>\n<svg class=\"h-7 w-7 opacity-70\" data-kid=\"3-2-1-4-2\" data-name=\"kestrel chart compass icon\" viewbox=\"0 0 40 40\"><circle cx=\"20\" cy=\"20\" fill=\"none\" r=\"17\" stroke=\"#12232B\" stroke-width=\"0.7\"></circle><path d=\"M20 8 L23 19 L20 20 L17 19 Z\" fill=\"#12232B\"></path><path d=\"M20 32 L17 21 L20 20 L23 21 Z\" fill=\"#12232B\" opacity=\"0.4\"></path></svg>\n</div>\n</article>\n<div class=\"flex flex-col gap-5\" data-kid=\"3-2-2\" data-name=\"secondary project cards column\">\n<article class=\"poster tilt bg-[#0B2B3C] p-6 text-[#F6EFDF]\" data-kid=\"3-2-2-1\" data-name=\"tide and timber project card\" data-tilt=\"\">\n<div class=\"flex items-center justify-between\" data-kid=\"3-2-2-1-1\" data-name=\"tide and timber category and year row\">\n<span class=\"text-[9px] uppercase tracking-[0.22em] text-[#8FA6AD]\" data-kid=\"3-2-2-1-1-1\" data-name=\"booking app category label\">Booking app</span>\n<span class=\"font-mono text-[10px] text-[#8FA6AD]\" data-kid=\"3-2-2-1-1-2\" data-name=\"tide and timber year label\">2024</span>\n</div>\n<h3 class=\"mt-3 uppercase\" data-kid=\"3-2-2-1-2\" data-name=\"tide and timber project title\" style=\"font-family:'Bebas Neue', sans-serif; font-size:38px\">Tide &amp; Timber</h3>\n<p class=\"mt-2 text-[12.5px] leading-[1.75] text-[#F6EFDF]/70\" data-kid=\"3-2-2-1-3\" data-name=\"tide and timber description text\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n<a class=\"mt-4 inline-block text-[9px] font-semibold uppercase tracking-[0.18em] text-[#C8842B]\" data-kid=\"3-2-2-1-4\" data-name=\"tide and timber open chart link\" href=\"#work\">Open the chart</a>\n</article>\n<article class=\"poster tilt bg-[#EFE4CC] p-6\" data-kid=\"3-2-2-2\" data-name=\"loom audio project card\" data-tilt=\"\">\n<div class=\"flex items-center justify-between\" data-kid=\"3-2-2-2-1\" data-name=\"loom audio category and year row\">\n<span class=\"text-[9px] uppercase tracking-[0.22em] text-[#7C7262]\" data-kid=\"3-2-2-2-1-1\" data-name=\"editorial platform category label\">Editorial platform</span>\n<span class=\"font-mono text-[10px] text-[#7C7262]\" data-kid=\"3-2-2-2-1-2\" data-name=\"loom audio year label\">2023</span>\n</div>\n<h3 class=\"mt-3 uppercase\" data-kid=\"3-2-2-2-2\" data-name=\"loom audio project title\" style=\"font-family:'Bebas Neue', sans-serif; font-size:38px\">Loom Audio</h3>\n<p class=\"mt-2 text-[12.5px] leading-[1.75] text-[#12232B]/72\" data-kid=\"3-2-2-2-3\" data-name=\"loom audio description text\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n<a class=\"mt-4 inline-block text-[9px] font-semibold uppercase tracking-[0.18em] text-[#C8842B]\" data-kid=\"3-2-2-2-4\" data-name=\"loom audio open chart link\" href=\"#work\">Open the chart</a>\n</article>\n</div>\n</div>\n</section>\n<section class=\"bg-[#0B2B3C] text-[#F6EFDF]\" data-kid=\"4\" data-name=\"ship's log experience section\" id=\"log\">\n<div class=\"mx-auto max-w-[1180px] px-7 py-14\" data-kid=\"4-1\" data-name=\"ship's log content container\">\n<div class=\"flex items-baseline justify-between border-b border-[#F6EFDF]/18 pb-3\" data-kid=\"4-1-1\" data-name=\"ship's log heading row\">\n<h2 class=\"uppercase\" data-kid=\"4-1-1-1\" data-name=\"ship's log section title\" style=\"font-family:'Bebas Neue', sans-serif; font-size:40px; letter-spacing:0.02em\">Ship's log</h2>\n<span class=\"font-mono text-[10px] text-[#8FA6AD]\" data-kid=\"4-1-1-2\" data-name=\"roles count label\">03 roles</span>\n</div>\n<div class=\"mt-2\" data-kid=\"4-1-2\" data-name=\"experience entries list\">\n<div class=\"grid gap-1 border-b border-[#F6EFDF]/10 py-5 md:grid-cols-[220px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-2-1\" data-name=\"fintrail experience row\">\n<span class=\"text-[19px] font-medium\" data-kid=\"4-1-2-1-1\" data-name=\"fintrail company name\">Fintrail</span>\n<span class=\"text-[12.5px] text-[#F6EFDF]/70\" data-kid=\"4-1-2-1-2\" data-name=\"fintrail role description\">Senior product designer — payments, onboarding and the design system.</span>\n<span class=\"font-mono text-[10px] text-[#8FA6AD]\" data-kid=\"4-1-2-1-3\" data-name=\"fintrail date range\">2022 — present</span>\n</div>\n<div class=\"grid gap-1 border-b border-[#F6EFDF]/10 py-5 md:grid-cols-[220px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-2-2\" data-name=\"sundial studio experience row\">\n<span class=\"text-[19px] font-medium\" data-kid=\"4-1-2-2-1\" data-name=\"sundial studio company name\">Sundial Studio</span>\n<span class=\"text-[12.5px] text-[#F6EFDF]/70\" data-kid=\"4-1-2-2-2\" data-name=\"sundial studio role description\">Product designer — booking and travel products for three clients.</span>\n<span class=\"font-mono text-[10px] text-[#8FA6AD]\" data-kid=\"4-1-2-2-3\" data-name=\"sundial studio date range\">2019 — 2022</span>\n</div>\n<div class=\"grid gap-1 border-b border-[#F6EFDF]/10 py-5 md:grid-cols-[220px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-2-3\" data-name=\"pageturn press experience row\">\n<span class=\"text-[19px] font-medium\" data-kid=\"4-1-2-3-1\" data-name=\"pageturn press company name\">Pageturn Press</span>\n<span class=\"text-[12.5px] text-[#F6EFDF]/70\" data-kid=\"4-1-2-3-2\" data-name=\"pageturn press role description\">Interface designer — digital editions of a 90-year-old imprint.</span>\n<span class=\"font-mono text-[10px] text-[#8FA6AD]\" data-kid=\"4-1-2-3-3\" data-name=\"pageturn press date range\">2017 — 2019</span>\n</div>\n</div>\n</div>\n</section>\n<div class=\"mx-auto grid max-w-[1180px] gap-10 px-7 py-14 md:grid-cols-2\" data-kid=\"5\" data-name=\"education and signals section\" id=\"port\">\n<section data-kid=\"5-1\" data-name=\"harbour education section\">\n<h2 class=\"uppercase\" data-kid=\"5-1-1\" data-name=\"harbour section title\" style=\"font-family:'Bebas Neue', sans-serif; font-size:34px; letter-spacing:0.02em\">Harbour</h2>\n<div class=\"mt-4\" data-kid=\"5-1-2\" data-name=\"education entries list\">\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#12232B]/12 py-3.5\" data-kid=\"5-1-2-1\" data-name=\"national institute education row\">\n<div data-kid=\"5-1-2-1-1\" data-name=\"national institute entry text group\"><p class=\"text-[14px] font-semibold\" data-kid=\"5-1-2-1-1-1\" data-name=\"national institute of design name\">National Institute of Design</p><p class=\"text-[12px] text-[#7C7262]\" data-kid=\"5-1-2-1-1-2\" data-name=\"interaction design degree label\">Interaction design</p></div>\n<span class=\"font-mono text-[10px] text-[#7C7262]\" data-kid=\"5-1-2-1-2\" data-name=\"national institute date range\">2015 — 2017</span>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#12232B]/12 py-3.5\" data-kid=\"5-1-2-2\" data-name=\"srishti institute education row\">\n<div data-kid=\"5-1-2-2-1\" data-name=\"srishti institute entry text group\"><p class=\"text-[14px] font-semibold\" data-kid=\"5-1-2-2-1-1\" data-name=\"srishti institute name\">Srishti Institute</p><p class=\"text-[12px] text-[#7C7262]\" data-kid=\"5-1-2-2-1-2\" data-name=\"foundation studies degree label\">Foundation studies</p></div>\n<span class=\"font-mono text-[10px] text-[#7C7262]\" data-kid=\"5-1-2-2-2\" data-name=\"srishti institute date range\">2013 — 2015</span>\n</div>\n</div>\n</section>\n<section data-kid=\"5-2\" data-name=\"signals social links section\">\n<h2 class=\"uppercase\" data-kid=\"5-2-1\" data-name=\"signals section title\" style=\"font-family:'Bebas Neue', sans-serif; font-size:34px; letter-spacing:0.02em\">Signals</h2>\n<div class=\"mt-4 grid grid-cols-2 gap-2\" data-kid=\"5-2-2\" data-name=\"social links grid\">\n<a class=\"flex items-center justify-between border border-[#12232B]/15 px-4 py-3 text-[11px] font-semibold\" data-kid=\"5-2-2-1\" data-name=\"github profile link\" href=\"#port\">GitHub <span class=\"text-[#C8842B]\" data-kid=\"5-2-2-1-1\" data-name=\"github external arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#12232B]/15 px-4 py-3 text-[11px] font-semibold\" data-kid=\"5-2-2-2\" data-name=\"dribbble profile link\" href=\"#port\">Dribbble <span class=\"text-[#C8842B]\" data-kid=\"5-2-2-2-1\" data-name=\"dribbble external arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#12232B]/15 px-4 py-3 text-[11px] font-semibold\" data-kid=\"5-2-2-3\" data-name=\"linkedin profile link\" href=\"#port\">LinkedIn <span class=\"text-[#C8842B]\" data-kid=\"5-2-2-3-1\" data-name=\"linkedin external arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#12232B]/15 px-4 py-3 text-[11px] font-semibold\" data-kid=\"5-2-2-4\" data-name=\"email contact link\" href=\"#port\">Email <span class=\"text-[#C8842B]\" data-kid=\"5-2-2-4-1\" data-name=\"email external arrow icon\">↗</span></a>\n</div>\n</section>\n</div>\n<footer class=\"border-t border-[#12232B]/12\" data-kid=\"6\" data-name=\"site footer bar\">\n<div class=\"mx-auto flex max-w-[1180px] items-center justify-between px-7 py-5 font-mono text-[9px] uppercase tracking-[0.22em] text-[#7C7262]\" data-kid=\"6-1\" data-name=\"footer content row\">\n<span data-kid=\"6-1-1\" data-name=\"footer copyright notice text\">Aarav Menon — interface designer</span><a data-kid=\"6-1-2\" data-name=\"back to top link\" href=\"#top\">Back to top</a>\n</div>\n</footer>\n<script>\n    const compass = document.getElementById('compass');\n    const hero = document.getElementById('top');\n    let angle = 0, target = 0, raf = 0;\n    function loop() {\n      angle += (target - angle) * 0.08;\n      if (compass) compass.style.transform = 'rotate(' + angle.toFixed(2) + 'deg)';\n      raf = requestAnimationFrame(loop);\n    }\n    if (hero && compass) {\n      hero.addEventListener('pointermove', function (event) {\n        const rect = hero.getBoundingClientRect();\n        target = ((event.clientX - rect.left) / rect.width - 0.5) * 46;\n      });\n      loop();\n    }\n    document.querySelectorAll('[data-tilt]').forEach(function (card) {\n      card.addEventListener('pointermove', function (event) {\n        const rect = card.getBoundingClientRect();\n        const px = (event.clientX - rect.left) / rect.width - 0.5;\n        const py = (event.clientY - rect.top) / rect.height - 0.5;\n        card.style.transform = 'perspective(900px) rotateX(' + (-py * 5).toFixed(2) + 'deg) rotateY(' + (px * 7).toFixed(2) + 'deg) translateY(-3px)';\n      });\n      card.addEventListener('pointerleave', function () { card.style.transform = ''; });\n    });\n  </script>\n</body>",
