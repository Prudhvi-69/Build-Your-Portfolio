    "var_82d95316a7aa": {
      "type": "variant",
      "label": "Iron Throne — Game of Thrones template",
      "parentId": "var_100ec6c3a362",
      "themeId": null,
      "rect": {
        "x": 9820,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<body class=\"min-h-screen bg-[#EDEAE4] text-[#0F1112] antialiased\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=IBM+Plex+Mono:wght@400;500&display=swap');\n    body { font-family: 'Fraunces', Georgia, serif; }\n    .stone {\n      background-image:\n        repeating-linear-gradient(90deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 7px),\n        repeating-linear-gradient(0deg, rgba(0,0,0,0.18) 0 1px, transparent 1px 9px),\n        radial-gradient(rgba(255,255,255,0.06) 0.5px, transparent 0.5px);\n      background-size: auto, auto, 5px 5px;\n    }\n    .tablet { transition: border-color 260ms ease; }\n    .tablet:hover { border-color: rgba(123,30,30,0.65); }\n    .imprint { box-shadow: 0 0 0 1px #7B1E1E, 0 0 0 7px rgba(123,30,30,0.16); }\n  </style>\n<header class=\"sticky top-0 z-30 border-b border-[#EDEAE4]/12 bg-[#0F1112]\" data-kid=\"1\" data-name=\"sticky page header bar\">\n<div class=\"mx-auto flex h-[60px] max-w-[1160px] items-center justify-between px-7\" data-kid=\"1-1\" data-name=\"header content row\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"site logo with monogram and name\" href=\"#top\">\n<span class=\"grid h-7 w-7 place-items-center rounded-full border border-[#9AA3A8]/60 text-[9px] tracking-[0.08em] text-[#9AA3A8]\" data-kid=\"1-1-1-1\" data-name=\"monogram circle icon\" style=\"font-family:'Cinzel', serif\">AM</span>\n<span class=\"text-[10px] uppercase tracking-[0.34em] text-[#EDEAE4]\" data-kid=\"1-1-1-2\" data-name=\"site name text\">Aarav Menon</span>\n</a>\n<nav class=\"hidden items-center gap-7 font-mono text-[9px] uppercase tracking-[0.24em] text-[#7B7E82] md:flex\" data-kid=\"1-1-2\" data-name=\"main navigation links\">\n<a data-kid=\"1-1-2-1\" data-name=\"navigation link to work\" href=\"#work\">Deeds</a><a data-kid=\"1-1-2-2\" data-name=\"navigation link to experience\" href=\"#experience\">Service</a><a data-kid=\"1-1-2-3\" data-name=\"navigation link to education\" href=\"#education\">Lineage</a><a data-kid=\"1-1-2-4\" data-name=\"navigation link to social links\" href=\"#elsewhere\">Halls</a>\n</nav>\n<span class=\"hidden font-mono text-[9px] uppercase tracking-[0.24em] text-[#7B7E82] sm:block\" data-kid=\"1-1-3\" data-name=\"role label in header\">Interface designer</span>\n</div>\n</header>\n<section class=\"stone relative overflow-hidden bg-[#0F1112] text-[#EDEAE4]\" data-kid=\"2\" data-name=\"hero section with textured background\" id=\"top\">\n<div class=\"relative mx-auto flex max-w-[1160px] flex-col items-center px-7 pb-20 pt-16 text-center\" data-kid=\"2-1\" data-name=\"hero content column\">\n<span class=\"block h-14 w-px bg-gradient-to-b from-transparent via-[#9AA3A8]/60 to-transparent\" data-kid=\"2-1-1\" data-name=\"vertical decorative line\"></span>\n<span class=\"mt-1 block h-1.5 w-1.5 rotate-45 border border-[#7B1E1E]\" data-kid=\"2-1-2\" data-name=\"decorative rotated diamond\"></span>\n<p class=\"mt-8 font-mono text-[9px] uppercase tracking-[0.5em] text-[#7B7E82]\" data-kid=\"2-1-3\" data-name=\"eyebrow role text\">Interface designer</p>\n<h1 class=\"mt-5 uppercase leading-none\" data-kid=\"2-1-4\" data-name=\"hero name headline\" style=\"font-family:'Cinzel', serif; font-size:clamp(2.6rem,6.4vw,4.9rem); letter-spacing:0.08em; font-weight:500\">\n        Aarav Menon\n      </h1>\n<div class=\"mt-6 flex w-full max-w-[520px] items-center gap-4\" data-kid=\"2-1-5\" data-name=\"decorative divider with center diamond\">\n<span class=\"h-px flex-1 bg-[#9AA3A8]/30\" data-kid=\"2-1-5-1\" data-name=\"left divider line\"></span>\n<span class=\"h-2 w-2 rotate-45 border border-[#7B1E1E]\" data-kid=\"2-1-5-2\" data-name=\"center diamond separator\"></span>\n<span class=\"h-px flex-1 bg-[#9AA3A8]/30\" data-kid=\"2-1-5-3\" data-name=\"right divider line\"></span>\n</div>\n<p class=\"mt-7 max-w-[56ch] text-[15px] leading-[1.95] text-[#EDEAE4]/70\" data-kid=\"2-1-6\" data-name=\"hero intro paragraph\">\n        I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n      </p>\n<div class=\"mt-9 flex flex-wrap items-center justify-center gap-3\" data-kid=\"2-1-7\" data-name=\"meta info row with seal button\">\n<button aria-label=\"Seal this portfolio\" aria-pressed=\"false\" class=\"flex h-14 w-14 items-center justify-center rounded-full border border-[#7B1E1E] text-[11px] tracking-[0.06em] text-[#EDEAE4]/90\" data-dynamic=\"true\" data-kid=\"2-1-7-1\" data-name=\"seal stamp toggle button\" data-reason=\"background and imprint class toggled by click handler\" id=\"seal\" style=\"font-family:'Cinzel', serif; font-size:12px\" type=\"button\">AM</button>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.24em] text-[#7B7E82]\" data-kid=\"2-1-7-2\" data-name=\"skill count label\">06 skills</span>\n<span class=\"h-3 w-px bg-[#9AA3A8]/30\" data-kid=\"2-1-7-3\" data-name=\"vertical separator divider\"></span>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.24em] text-[#7B7E82]\" data-kid=\"2-1-7-4\" data-name=\"location label\">Bengaluru</span>\n</div>\n<div class=\"mt-10 flex flex-wrap justify-center gap-2\" data-kid=\"2-1-8\" data-name=\"skill tags container\">\n<span class=\"border border-[#EDEAE4]/18 px-3 py-1.5 text-[10px] uppercase tracking-[0.14em] text-[#EDEAE4]/80\" data-kid=\"2-1-8-1\" data-name=\"skill tag - design systems\">Design systems</span>\n<span class=\"border border-[#EDEAE4]/18 px-3 py-1.5 text-[10px] uppercase tracking-[0.14em] text-[#EDEAE4]/80\" data-kid=\"2-1-8-2\" data-name=\"skill tag - interaction design\">Interaction design</span>\n<span class=\"border border-[#EDEAE4]/18 px-3 py-1.5 text-[10px] uppercase tracking-[0.14em] text-[#EDEAE4]/80\" data-kid=\"2-1-8-3\" data-name=\"skill tag - prototyping\">Prototyping</span>\n<span class=\"border border-[#EDEAE4]/18 px-3 py-1.5 text-[10px] uppercase tracking-[0.14em] text-[#EDEAE4]/80\" data-kid=\"2-1-8-4\" data-name=\"skill tag - motion\">Motion</span>\n<span class=\"border border-[#EDEAE4]/18 px-3 py-1.5 text-[10px] uppercase tracking-[0.14em] text-[#EDEAE4]/80\" data-kid=\"2-1-8-5\" data-name=\"skill tag - type\">Type</span>\n<span class=\"border border-[#EDEAE4]/18 px-3 py-1.5 text-[10px] uppercase tracking-[0.14em] text-[#EDEAE4]/80\" data-kid=\"2-1-8-6\" data-name=\"skill tag - research\">Research</span>\n</div>\n</div>\n</section>\n<section class=\"mx-auto max-w-[1160px] px-7 py-14\" data-kid=\"3\" data-name=\"projects section\" id=\"work\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"3-1\" data-name=\"section heading row\">\n<h2 class=\"uppercase\" data-kid=\"3-1-1\" data-name=\"section title Deeds\" style=\"font-family:'Cinzel', serif; font-size:30px; letter-spacing:0.1em\">Deeds</h2>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#6F7174]\" data-kid=\"3-1-2\" data-name=\"project count label\">03 projects</span>\n</div>\n<span class=\"mt-4 block h-px w-full bg-[#0F1112]/15\" data-kid=\"3-2\" data-name=\"section divider line\"></span>\n<div class=\"mx-auto mt-8 max-w-[760px] space-y-4\" data-kid=\"3-3\" data-name=\"projects list container\">\n<article class=\"tablet border border-[#0F1112]/16 bg-[#DFDCD5] px-7 py-6\" data-kid=\"3-3-1\" data-name=\"project card Kestrel\">\n<div class=\"flex items-baseline justify-between gap-4\" data-kid=\"3-3-1-1\" data-name=\"card category row\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.22em] text-[#7B1E1E]\" data-kid=\"3-3-1-1-1\" data-name=\"project category label\">Design system</span>\n<span class=\"font-mono text-[10px] text-[#6F7174]\" data-kid=\"3-3-1-1-2\" data-name=\"project year label\">2025</span>\n</div>\n<h3 class=\"mt-3 uppercase\" data-kid=\"3-3-1-2\" data-name=\"project title Kestrel\" style=\"font-family:'Cinzel', serif; font-size:28px; letter-spacing:0.06em\">Kestrel</h3>\n<p class=\"mt-2 max-w-[54ch] text-[13.5px] leading-[1.9] text-[#0F1112]/72\" data-kid=\"3-3-1-3\" data-name=\"project description\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n<div class=\"mt-5 flex items-center justify-between border-t border-[#0F1112]/12 pt-3\" data-kid=\"3-3-1-4\" data-name=\"card footer row\">\n<a class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#7B1E1E]\" data-kid=\"3-3-1-4-1\" data-name=\"view project link\" href=\"#work\">View project</a>\n<span class=\"h-1.5 w-1.5 rotate-45 border border-[#0F1112]/40\" data-kid=\"3-3-1-4-2\" data-name=\"decorative corner diamond\"></span>\n</div>\n</article>\n<article class=\"tablet border border-[#0F1112]/16 bg-[#DFDCD5] px-7 py-6\" data-kid=\"3-3-2\" data-name=\"project card Tide and Timber\">\n<div class=\"flex items-baseline justify-between gap-4\" data-kid=\"3-3-2-1\" data-name=\"card category row\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.22em] text-[#7B1E1E]\" data-kid=\"3-3-2-1-1\" data-name=\"project category label\">Booking app</span>\n<span class=\"font-mono text-[10px] text-[#6F7174]\" data-kid=\"3-3-2-1-2\" data-name=\"project year label\">2024</span>\n</div>\n<h3 class=\"mt-3 uppercase\" data-kid=\"3-3-2-2\" data-name=\"project title Tide and Timber\" style=\"font-family:'Cinzel', serif; font-size:26px; letter-spacing:0.06em\">Tide &amp; Timber</h3>\n<p class=\"mt-2 max-w-[54ch] text-[13.5px] leading-[1.9] text-[#0F1112]/72\" data-kid=\"3-3-2-3\" data-name=\"project description\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n<div class=\"mt-5 flex items-center justify-between border-t border-[#0F1112]/12 pt-3\" data-kid=\"3-3-2-4\" data-name=\"card footer row\">\n<a class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#7B1E1E]\" data-kid=\"3-3-2-4-1\" data-name=\"view project link\" href=\"#work\">View project</a>\n<span class=\"h-1.5 w-1.5 rotate-45 border border-[#0F1112]/40\" data-kid=\"3-3-2-4-2\" data-name=\"decorative corner diamond\"></span>\n</div>\n</article>\n<article class=\"tablet border border-[#0F1112]/16 bg-[#DFDCD5] px-7 py-6\" data-kid=\"3-3-3\" data-name=\"project card Loom Audio\">\n<div class=\"flex items-baseline justify-between gap-4\" data-kid=\"3-3-3-1\" data-name=\"card category row\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.22em] text-[#7B1E1E]\" data-kid=\"3-3-3-1-1\" data-name=\"project category label\">Editorial platform</span>\n<span class=\"font-mono text-[10px] text-[#6F7174]\" data-kid=\"3-3-3-1-2\" data-name=\"project year label\">2023</span>\n</div>\n<h3 class=\"mt-3 uppercase\" data-kid=\"3-3-3-2\" data-name=\"project title Loom Audio\" style=\"font-family:'Cinzel', serif; font-size:26px; letter-spacing:0.06em\">Loom Audio</h3>\n<p class=\"mt-2 max-w-[54ch] text-[13.5px] leading-[1.9] text-[#0F1112]/72\" data-kid=\"3-3-3-3\" data-name=\"project description\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n<div class=\"mt-5 flex items-center justify-between border-t border-[#0F1112]/12 pt-3\" data-kid=\"3-3-3-4\" data-name=\"card footer row\">\n<a class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#7B1E1E]\" data-kid=\"3-3-3-4-1\" data-name=\"view project link\" href=\"#work\">View project</a>\n<span class=\"h-1.5 w-1.5 rotate-45 border border-[#0F1112]/40\" data-kid=\"3-3-3-4-2\" data-name=\"decorative corner diamond\"></span>\n</div>\n</article>\n</div>\n</section>\n<section class=\"stone bg-[#0F1112] text-[#EDEAE4]\" data-kid=\"4\" data-name=\"experience section on dark background\" id=\"experience\">\n<div class=\"mx-auto max-w-[1160px] px-7 py-14\" data-kid=\"4-1\" data-name=\"experience content container\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"4-1-1\" data-name=\"section heading row\">\n<h2 class=\"uppercase\" data-kid=\"4-1-1-1\" data-name=\"section title Service\" style=\"font-family:'Cinzel', serif; font-size:28px; letter-spacing:0.1em\">Service</h2>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#7B7E82]\" data-kid=\"4-1-1-2\" data-name=\"role count label\">03 roles</span>\n</div>\n<span class=\"mt-4 block h-px w-full bg-[#9AA3A8]/25\" data-kid=\"4-1-2\" data-name=\"section divider line\"></span>\n<div class=\"mt-2\" data-kid=\"4-1-3\" data-name=\"job entries list\">\n<div class=\"grid gap-1 border-b border-[#EDEAE4]/10 py-5 md:grid-cols-[240px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-3-1\" data-name=\"role row Fintrail\">\n<span class=\"uppercase\" data-kid=\"4-1-3-1-1\" data-name=\"company name Fintrail\" style=\"font-family:'Cinzel', serif; font-size:18px; letter-spacing:0.06em\">Fintrail</span>\n<span class=\"text-[12.5px] text-[#EDEAE4]/70\" data-kid=\"4-1-3-1-2\" data-name=\"role description text\">Senior product designer — payments, onboarding and the design system.</span>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.16em] text-[#7B7E82]\" data-kid=\"4-1-3-1-3\" data-name=\"duration label\">2022 — present</span>\n</div>\n<div class=\"grid gap-1 border-b border-[#EDEAE4]/10 py-5 md:grid-cols-[240px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-3-2\" data-name=\"role row Sundial Studio\">\n<span class=\"uppercase\" data-kid=\"4-1-3-2-1\" data-name=\"company name Sundial Studio\" style=\"font-family:'Cinzel', serif; font-size:18px; letter-spacing:0.06em\">Sundial Studio</span>\n<span class=\"text-[12.5px] text-[#EDEAE4]/70\" data-kid=\"4-1-3-2-2\" data-name=\"role description text\">Product designer — booking and travel products for three clients.</span>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.16em] text-[#7B7E82]\" data-kid=\"4-1-3-2-3\" data-name=\"duration label\">2019 — 2022</span>\n</div>\n<div class=\"grid gap-1 border-b border-[#EDEAE4]/10 py-5 md:grid-cols-[240px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-3-3\" data-name=\"role row Pageturn Press\">\n<span class=\"uppercase\" data-kid=\"4-1-3-3-1\" data-name=\"company name Pageturn Press\" style=\"font-family:'Cinzel', serif; font-size:18px; letter-spacing:0.06em\">Pageturn Press</span>\n<span class=\"text-[12.5px] text-[#EDEAE4]/70\" data-kid=\"4-1-3-3-2\" data-name=\"role description text\">Interface designer — digital editions of a 90-year-old imprint.</span>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.16em] text-[#7B7E82]\" data-kid=\"4-1-3-3-3\" data-name=\"duration label\">2017 — 2019</span>\n</div>\n</div>\n</div>\n</section>\n<div class=\"mx-auto grid max-w-[1160px] gap-10 px-7 py-14 md:grid-cols-2\" data-kid=\"5\" data-name=\"two column education and socials grid\">\n<section data-kid=\"5-1\" data-name=\"education section\" id=\"education\">\n<h2 class=\"uppercase\" data-kid=\"5-1-1\" data-name=\"section title Lineage\" style=\"font-family:'Cinzel', serif; font-size:24px; letter-spacing:0.1em\">Lineage</h2>\n<div class=\"mt-4 border border-[#0F1112]/16 p-2\" data-kid=\"5-1-2\" data-name=\"education card outer border\">\n<div class=\"border border-[#0F1112]/12 p-4\" data-kid=\"5-1-2-1\" data-name=\"education card inner container\">\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#0F1112]/12 py-2.5\" data-kid=\"5-1-2-1-1\" data-name=\"education entry row NID\">\n<div data-kid=\"5-1-2-1-1-1\" data-name=\"school name and field wrapper\"><p class=\"text-[13.5px] font-semibold\" data-kid=\"5-1-2-1-1-1-1\" data-name=\"school name NID\">National Institute of Design</p><p class=\"text-[11.5px] text-[#6F7174]\" data-kid=\"5-1-2-1-1-1-2\" data-name=\"field of study\">Interaction design</p></div>\n<span class=\"font-mono text-[9px] text-[#6F7174]\" data-kid=\"5-1-2-1-1-2\" data-name=\"degree duration label\">2015 — 2017</span>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 py-2.5\" data-kid=\"5-1-2-1-2\" data-name=\"education entry row Srishti\">\n<div data-kid=\"5-1-2-1-2-1\" data-name=\"school name and field wrapper\"><p class=\"text-[13.5px] font-semibold\" data-kid=\"5-1-2-1-2-1-1\" data-name=\"school name Srishti\">Srishti Institute</p><p class=\"text-[11.5px] text-[#6F7174]\" data-kid=\"5-1-2-1-2-1-2\" data-name=\"field of study\">Foundation studies</p></div>\n<span class=\"font-mono text-[9px] text-[#6F7174]\" data-kid=\"5-1-2-1-2-2\" data-name=\"degree duration label\">2013 — 2015</span>\n</div>\n</div>\n</div>\n</section>\n<section data-kid=\"5-2\" data-name=\"social links section\" id=\"elsewhere\">\n<h2 class=\"uppercase\" data-kid=\"5-2-1\" data-name=\"section title Halls\" style=\"font-family:'Cinzel', serif; font-size:24px; letter-spacing:0.1em\">Halls</h2>\n<div class=\"mt-4 grid grid-cols-2 gap-2\" data-kid=\"5-2-2\" data-name=\"social links grid\">\n<a class=\"flex items-center justify-between border border-[#0F1112]/16 px-4 py-3 font-mono text-[9px] uppercase tracking-[0.18em]\" data-kid=\"5-2-2-1\" data-name=\"GitHub link card\" href=\"#elsewhere\">GitHub <span class=\"text-[#7B1E1E]\" data-kid=\"5-2-2-1-1\" data-name=\"external link arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#0F1112]/16 px-4 py-3 font-mono text-[9px] uppercase tracking-[0.18em]\" data-kid=\"5-2-2-2\" data-name=\"Dribbble link card\" href=\"#elsewhere\">Dribbble <span class=\"text-[#7B1E1E]\" data-kid=\"5-2-2-2-1\" data-name=\"external link arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#0F1112]/16 px-4 py-3 font-mono text-[9px] uppercase tracking-[0.18em]\" data-kid=\"5-2-2-3\" data-name=\"LinkedIn link card\" href=\"#elsewhere\">LinkedIn <span class=\"text-[#7B1E1E]\" data-kid=\"5-2-2-3-1\" data-name=\"external link arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#0F1112]/16 px-4 py-3 font-mono text-[9px] uppercase tracking-[0.18em]\" data-kid=\"5-2-2-4\" data-name=\"Email link card\" href=\"#elsewhere\">Email <span class=\"text-[#7B1E1E]\" data-kid=\"5-2-2-4-1\" data-name=\"external link arrow icon\">↗</span></a>\n</div>\n</section>\n</div>\n<footer class=\"border-t border-[#0F1112]/15\" data-kid=\"6\" data-name=\"page footer bar\">\n<div class=\"mx-auto flex max-w-[1160px] items-center justify-between px-7 py-5 font-mono text-[9px] uppercase tracking-[0.24em] text-[#6F7174]\" data-kid=\"6-1\" data-name=\"footer content row\">\n<span data-kid=\"6-1-1\" data-name=\"footer credit text\">Aarav Menon — interface designer</span><a data-kid=\"6-1-2\" data-name=\"back to top link\" href=\"#top\">Back to top</a>\n</div>\n</footer>\n<script>\n    const seal = document.getElementById('seal');\n    if (seal) {\n      seal.addEventListener('click', function () {\n        const on = seal.getAttribute('aria-pressed') === 'true';\n        seal.setAttribute('aria-pressed', on ? 'false' : 'true');\n        seal.classList.toggle('imprint', !on);\n        seal.style.background = on ? 'transparent' : 'rgba(123,30,30,0.22)';\n      });\n    }\n  </script>\n</body>",
