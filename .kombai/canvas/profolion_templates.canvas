      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Barlow:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  .ls-page { font-family: 'Barlow', 'Helvetica Neue', sans-serif; }\n  .ls-display { font-family: 'Cinzel', Georgia, serif; letter-spacing: 0.015em; line-height: 0.94; }\n  .ls-mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }\n  .ls-timber { background-image: repeating-linear-gradient(180deg, rgba(18,16,13,0.055) 0px, rgba(18,16,13,0.055) 1px, transparent 1px, transparent 8px); }\n  .ls-plate { transition: transform 260ms ease, background-color 260ms ease, border-color 260ms ease; }\n  .ls-plate:hover { transform: translateY(-3px); border-color: rgba(140,28,19,0.55); background-color: #EDE7DA; }\n  .ls-rune-link { transition: color 160ms ease; }\n  .ls-rune-link:hover { color: #8C1C13; }\n  @media (prefers-reduced-motion: reduce) {\n    .ls-plate, .ls-plate:hover { transition: none; transform: none; }\n    .ls-rune-link { transition: none; }\n  }\n</style>\n<div class=\"ls-page min-h-screen bg-[#EDE7DA] text-[#12100D] antialiased\" data-kid=\"2\" data-name=\"longship page layout\">\n<header class=\"sticky top-0 z-40 border-b border-[#12100D]/20 bg-[#EDE7DA]\" data-kid=\"2-1\" data-name=\"sticky top header bar\">\n<div class=\"mx-auto flex max-w-[1180px] items-center justify-between gap-6 px-6 py-4 lg:px-8\" data-kid=\"2-1-1\" data-name=\"header content row\">\n<a class=\"flex items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"owner identity link to top\" href=\"#top\">\n<span class=\"ls-display flex h-10 w-10 items-center justify-center border border-[#12100D]/40 bg-[#DED6C4] text-[13px] text-[#12100D]\" data-kid=\"2-1-1-1-1\" data-name=\"carved monogram block\">AM</span>\n<span class=\"flex flex-col leading-tight\" data-kid=\"2-1-1-1-2\" data-name=\"owner name group\">\n<span class=\"ls-display text-[15px] font-semibold tracking-[0.06em] text-[#12100D]\" data-kid=\"2-1-1-1-2-1\" data-name=\"owner name text\">Aarav Menon</span>\n</span>\n</a>\n<nav class=\"hidden items-center gap-7 md:flex\" data-kid=\"1-1-2\" data-name=\"section navigation\">\n<a class=\"ls-mono text-[10px] uppercase tracking-[0.28em] text-[#12100D]/70 ls-rune-link\" data-kid=\"2-1-1-2-1\" data-name=\"nav link work\" href=\"#work\">Work</a>\n<a class=\"ls-mono text-[10px] uppercase tracking-[0.28em] text-[#12100D]/70 ls-rune-link\" data-kid=\"2-1-1-2-2\" data-name=\"nav link experience\" href=\"#experience\">Experience</a>\n<a class=\"ls-mono text-[10px] uppercase tracking-[0.28em] text-[#12100D]/70 ls-rune-link\" data-kid=\"2-1-1-2-3\" data-name=\"nav link education\" href=\"#about\">Education</a>\n<a class=\"ls-mono text-[10px] uppercase tracking-[0.28em] text-[#12100D]/70 ls-rune-link\" data-kid=\"2-1-1-2-4\" data-name=\"nav link links\" href=\"#elsewhere\">Links</a>\n</nav>\n<a class=\"ls-mono border border-[#8C1C13] px-4 py-2 text-[10px] uppercase tracking-[0.22em] text-[#8C1C13]\" data-kid=\"2-1-1-3\" data-name=\"email contact button\" href=\"mailto:hello@example.com\">Email</a>\n</div>\n</header>\n<section data-kid=\"2-2\" data-name=\"hero section\" id=\"top\">\n<div class=\"border-b border-[#12100D]/15 bg-[#DED6C4] ls-timber\" data-kid=\"2-2-1\" data-name=\"hero label band\">\n<div class=\"mx-auto flex max-w-[1180px] items-center justify-between gap-6 px-6 py-3 lg:px-8\" data-kid=\"2-2-1-1\" data-name=\"label band content row\">\n<span class=\"ls-mono text-[10px] uppercase tracking-[0.34em] text-[#12100D]/70\" data-kid=\"2-2-1-1-1\" data-name=\"role label text\">Interface designer</span>\n<div aria-hidden=\"true\" class=\"flex items-center gap-2\" data-kid=\"2-2-1-1-2\" data-name=\"rune bead decorative row\">\n<span class=\"h-px w-10 bg-[#12100D]/25\" data-kid=\"2-2-1-1-2-1\" data-name=\"left lead-in line\"></span>\n<span class=\"h-[7px] w-[7px] rotate-45 border border-[#8C1C13]\" data-kid=\"2-2-1-1-2-2\" data-name=\"rune diamond bead\"></span>\n<span class=\"h-[7px] w-[7px] rotate-45 border border-[#8C1C13]\" data-kid=\"2-2-1-1-2-3\" data-name=\"rune diamond bead\"></span>\n<span class=\"h-[7px] w-[7px] rotate-45 border border-[#8C1C13]\" data-kid=\"2-2-1-1-2-4\" data-name=\"rune diamond bead\"></span>\n<span class=\"h-px w-10 bg-[#12100D]/25\" data-kid=\"2-2-1-1-2-5\" data-name=\"right trailing line\"></span>\n</div>\n</div>\n</div>\n<div class=\"border-b border-[#12100D]/15 bg-[#EDE7DA]\" data-kid=\"2-2-2\" data-name=\"name band first row\">\n<div class=\"mx-auto flex max-w-[1180px] items-end justify-between gap-8 px-6 py-8 lg:px-8 lg:py-10\" data-kid=\"2-2-2-1\" data-name=\"name band content row\">\n<h1 class=\"ls-display text-[54px] text-[#12100D] sm:text-[76px] lg:text-[92px]\" data-kid=\"2-2-2-1-1\" data-name=\"hero first name headline\">Aarav</h1>\n<div aria-hidden=\"true\" class=\"hidden items-end gap-3 sm:flex\" data-kid=\"2-2-2-1-2\" data-name=\"bars decorative motif\">\n<span class=\"block h-[46px] w-[6px] bg-[#8C1C13]\" data-kid=\"2-2-2-1-2-1\" data-name=\"tall red bar\"></span>\n<span class=\"block h-[30px] w-[6px] bg-[#12100D]/25\" data-kid=\"2-2-2-1-2-2\" data-name=\"short dark bar\"></span>\n<span class=\"block h-[16px] w-[6px] bg-[#12100D]/15\" data-kid=\"2-2-2-1-2-3\" data-name=\"smallest pale bar\"></span>\n</div>\n</div>\n</div>\n<div class=\"border-b border-[#12100D]/15 bg-[#8C1C13]\" data-kid=\"2-2-3\" data-name=\"name band surname row\">\n<div class=\"mx-auto flex max-w-[1180px] flex-col items-start justify-between gap-6 px-6 py-8 lg:flex-row lg:items-end lg:px-8 lg:py-10\" data-kid=\"2-2-3-1\" data-name=\"surname band content row\">\n<h2 class=\"ls-display text-[54px] text-[#EDE7DA] sm:text-[76px] lg:text-[92px]\" data-kid=\"2-2-3-1-1\" data-name=\"hero surname headline\">Menon</h2>\n<div class=\"grid grid-cols-2 gap-x-8 gap-y-2\" data-kid=\"2-2-3-1-2\" data-name=\"social link grid\">\n<a class=\"ls-mono flex items-center gap-1.5 text-[10px] uppercase tracking-[0.24em] text-[#EDE7DA]/90\" data-kid=\"2-2-3-1-2-1\" data-name=\"hero github link\" href=\"https://github.com\">GitHub <span aria-hidden=\"true\" data-kid=\"2-2-3-1-2-1-1\" data-name=\"external arrow glyph\">↗</span></a>\n<a class=\"ls-mono flex items-center gap-1.5 text-[10px] uppercase tracking-[0.24em] text-[#EDE7DA]/90\" data-kid=\"2-2-3-1-2-2\" data-name=\"hero dribbble link\" href=\"https://dribbble.com\">Dribbble <span aria-hidden=\"true\" data-kid=\"2-2-3-1-2-2-1\" data-name=\"external arrow glyph\">↗</span></a>\n<a class=\"ls-mono flex items-center gap-1.5 text-[10px] uppercase tracking-[0.24em] text-[#EDE7DA]/90\" data-kid=\"2-2-3-1-2-3\" data-name=\"hero linkedin link\" href=\"https://linkedin.com\">LinkedIn <span aria-hidden=\"true\" data-kid=\"2-2-3-1-2-3-1\" data-name=\"external arrow glyph\">↗</span></a>\n<a class=\"ls-mono flex items-center gap-1.5 text-[10px] uppercase tracking-[0.24em] text-[#EDE7DA]/90\" data-kid=\"2-2-3-1-2-4\" data-name=\"hero email link\" href=\"mailto:hello@example.com\">Email <span aria-hidden=\"true\" data-kid=\"2-2-3-1-2-4-1\" data-name=\"external arrow glyph\">↗</span></a>\n</div>\n</div>\n</div>\n<div class=\"border-b border-[#12100D]/15 bg-[#DED6C4]\" data-kid=\"2-2-4\" data-name=\"hero bio band\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-10 lg:px-8\" data-kid=\"2-2-4-1\" data-name=\"bio band container\">\n<p class=\"max-w-[74ch] text-[17px] leading-[1.75] text-[#12100D]/75\" data-kid=\"2-2-4-1-1\" data-name=\"hero intro bio paragraph\">I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.</p>\n</div>\n</div>\n<div class=\"bg-[#12100D]\" data-kid=\"2-2-5\" data-name=\"skills hud strip\">\n<div class=\"mx-auto grid max-w-[1180px] grid-cols-2 sm:grid-cols-3 lg:grid-cols-6\" data-kid=\"2-2-5-1\" data-name=\"skill rune cells\">\n<div class=\"border-b border-r border-[#8B8474]/25 px-5 py-4 sm:border-b-0\" data-kid=\"2-2-5-1-1\" data-name=\"skill cell design systems\" data-tilt=\"\">\n<span class=\"ls-mono text-[9px] tracking-[0.22em] text-[#C1732B]\" data-kid=\"2-2-5-1-1-1\" data-name=\"skill index number 01\">01</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDE7DA]\" data-kid=\"2-2-5-1-1-2\" data-name=\"skill label text\">Design systems</p>\n</div>\n<div class=\"border-b border-r border-[#8B8474]/25 px-5 py-4\" data-kid=\"2-2-5-1-2\" data-name=\"skill cell interaction design\" data-tilt=\"\">\n<span class=\"ls-mono text-[9px] tracking-[0.22em] text-[#C1732B]\" data-kid=\"2-2-5-1-2-1\" data-name=\"skill index number 02\">02</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDE7DA]\" data-kid=\"2-2-5-1-2-2\" data-name=\"skill label text\">Interaction design</p>\n</div>\n<div class=\"border-b border-r border-[#8B8474]/25 px-5 py-4\" data-kid=\"2-2-5-1-3\" data-name=\"skill cell prototyping\" data-tilt=\"\">\n<span class=\"ls-mono text-[9px] tracking-[0.22em] text-[#C1732B]\" data-kid=\"2-2-5-1-3-1\" data-name=\"skill index number 03\">03</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDE7DA]\" data-kid=\"2-2-5-1-3-2\" data-name=\"skill label text\">Prototyping</p>\n</div>\n<div class=\"border-b border-r border-[#8B8474]/25 px-5 py-4\" data-kid=\"2-2-5-1-4\" data-name=\"skill cell motion\" data-tilt=\"\">\n<span class=\"ls-mono text-[9px] tracking-[0.22em] text-[#C1732B]\" data-kid=\"2-2-5-1-4-1\" data-name=\"skill index number 04\">04</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDE7DA]\" data-kid=\"2-2-5-1-4-2\" data-name=\"skill label text\">Motion</p>\n</div>\n<div class=\"border-b border-r border-[#8B8474]/25 px-5 py-4\" data-kid=\"2-2-5-1-5\" data-name=\"skill cell type\" data-tilt=\"\">\n<span class=\"ls-mono text-[9px] tracking-[0.22em] text-[#C1732B]\" data-kid=\"2-2-5-1-5-1\" data-name=\"skill index number 05\">05</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDE7DA]\" data-kid=\"2-2-5-1-5-2\" data-name=\"skill label text\">Type</p>\n</div>\n<div class=\"px-5 py-4\" data-kid=\"2-2-5-1-6\" data-name=\"skill cell research\" data-tilt=\"\">\n<span class=\"ls-mono text-[9px] tracking-[0.22em] text-[#C1732B]\" data-kid=\"2-2-5-1-6-1\" data-name=\"skill index number 06\">06</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDE7DA]\" data-kid=\"2-2-5-1-6-2\" data-name=\"skill label text\">Research</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"border-b border-[#12100D]/15 bg-[#EDE7DA]\" data-kid=\"2-3\" data-name=\"summary ledger band\" id=\"about\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-12 lg:px-8\" data-kid=\"2-3-1\" data-name=\"summary content container\">\n<div class=\"flex items-center gap-3 border-b border-[#12100D]/15 pb-4\" data-kid=\"2-3-1-1\" data-name=\"section heading row\">\n<span class=\"h-[6px] w-[6px] rotate-45 bg-[#8C1C13]\" data-kid=\"2-3-1-1-1\" data-name=\"small diamond marker\"></span>\n<span class=\"ls-mono text-[10px] uppercase tracking-[0.3em] text-[#12100D]/70\" data-kid=\"2-3-1-1-2\" data-name=\"section label summary\">Summary</span>\n</div>\n<div class=\"mt-8 grid grid-cols-2 gap-x-10 gap-y-8 sm:grid-cols-4\" data-kid=\"2-3-1-2\" data-name=\"summary cells grid\">\n<div data-kid=\"2-3-1-2-1\" data-name=\"summary cell projects\">\n<p class=\"ls-display text-[36px] text-[#12100D]\" data-kid=\"2-3-1-2-1-1\" data-name=\"summary stat number\">03</p>\n<p class=\"ls-mono mt-1 text-[10px] uppercase tracking-[0.22em] text-[#12100D]/60\" data-kid=\"2-3-1-2-1-2\" data-name=\"summary stat label\">Projects</p>\n</div>\n<div data-kid=\"2-3-1-2-2\" data-name=\"summary cell skills\">\n<p class=\"ls-display text-[36px] text-[#12100D]\" data-kid=\"2-3-1-2-2-1\" data-name=\"summary stat number\">06</p>\n<p class=\"ls-mono mt-1 text-[10px] uppercase tracking-[0.22em] text-[#12100D]/60\" data-kid=\"2-3-1-2-2-2\" data-name=\"summary stat label\">Skills</p>\n</div>\n<div data-kid=\"2-3-1-2-3\" data-name=\"summary cell roles\">\n<p class=\"ls-display text-[36px] text-[#12100D]\" data-kid=\"2-3-1-2-3-1\" data-name=\"summary stat number\">03</p>\n<p class=\"ls-mono mt-1 text-[10px] uppercase tracking-[0.22em] text-[#12100D]/60\" data-kid=\"2-3-1-2-3-2\" data-name=\"summary stat label\">Roles</p>\n</div>\n<div data-kid=\"2-3-1-2-4\" data-name=\"summary cell study\">\n<p class=\"ls-display text-[36px] text-[#12100D]\" data-kid=\"2-3-1-2-4-1\" data-name=\"summary stat number\">02</p>\n<p class=\"ls-mono mt-1 text-[10px] uppercase tracking-[0.22em] text-[#12100D]/60\" data-kid=\"2-3-1-2-4-2\" data-name=\"summary stat label\">Study</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"bg-[#DED6C4]\" data-kid=\"2-4\" data-name=\"work section\" id=\"work\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-16 lg:px-8\" data-kid=\"2-4-1\" data-name=\"work section content\">\n<div class=\"flex flex-wrap items-end justify-between gap-4 border-b border-[#12100D]/25 pb-5\" data-kid=\"2-4-1-1\" data-name=\"work heading row\">\n<div class=\"flex items-baseline gap-4\" data-kid=\"2-4-1-1-1\" data-name=\"work heading block\">\n<h2 class=\"ls-display text-[24px] text-[#12100D] sm:text-[28px]\" data-kid=\"2-4-1-1-1-1\" data-name=\"work heading text\">Selected work</h2>\n<span class=\"ls-mono text-[10px] tracking-[0.2em] text-[#8C1C13]\" data-kid=\"2-4-1-1-1-2\" data-name=\"work count badge\">03</span>\n</div>\n<div aria-hidden=\"true\" class=\"flex items-center gap-2\" data-kid=\"2-4-1-1-2\" data-name=\"decorative rhombus row\">\n<span class=\"h-[6px] w-[6px] rotate-45 border border-[#12100D]/30\" data-kid=\"2-4-1-1-2-1\" data-name=\"small rhombus bead\"></span>\n<span class=\"h-[6px] w-[6px] rotate-45 border border-[#12100D]/30\" data-kid=\"2-4-1-1-2-2\" data-name=\"small rhombus bead\"></span>\n<span class=\"h-[6px] w-[6px] rotate-45 border border-[#8C1C13]\" data-kid=\"2-4-1-1-2-3\" data-name=\"small red rhombus bead\"></span>\n</div>\n</div>\n<div class=\"mt-8 space-y-4\" data-kid=\"2-4-1-2\" data-name=\"work plate stack\">\n<article class=\"ls-plate border border-[#12100D]/20 bg-[#EDE7DA]\" data-kid=\"2-4-1-2-1\" data-name=\"work card kestrel\" data-tilt=\"\">\n<div class=\"grid gap-4 p-6 md:grid-cols-[86px_1fr_180px] md:items-center md:gap-8\" data-kid=\"2-4-1-2-1-1\" data-name=\"card content row\">\n<span class=\"ls-display text-[34px] text-[#8C1C13]\" data-kid=\"2-4-1-2-1-1-1\" data-name=\"card index number\">01</span>\n<div data-kid=\"2-4-1-2-1-1-2\" data-name=\"card title and description block\">\n<h3 class=\"ls-display text-[21px] text-[#12100D]\" data-kid=\"2-4-1-2-1-1-2-1\" data-name=\"card project title\">Kestrel</h3>\n<p class=\"mt-2 max-w-[58ch] text-[14px] leading-[1.65] text-[#12100D]/70\" data-kid=\"2-4-1-2-1-1-2-2\" data-name=\"card description text\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n</div>\n<div class=\"flex items-center justify-between gap-3 md:flex-col md:items-end md:justify-center\" data-kid=\"2-4-1-2-1-1-3\" data-name=\"card meta and link row\">\n<span class=\"ls-mono text-[10px] tracking-[0.2em] text-[#12100D]/60\" data-kid=\"2-4-1-2-1-1-3-1\" data-name=\"card year label\">2025</span>\n<a class=\"ls-mono text-[10px] uppercase tracking-[0.2em] text-[#8C1C13]\" data-kid=\"2-4-1-2-1-1-3-2\" data-name=\"case study link\" href=\"#work\">Read case study <span aria-hidden=\"true\" data-kid=\"2-4-1-2-1-1-3-2-1\" data-name=\"arrow glyph\">→</span></a>\n</div>\n</div>\n</article>\n<article class=\"ls-plate border border-[#12100D]/20 bg-[#EDE7DA]\" data-kid=\"2-4-1-2-2\" data-name=\"work card tide and timber\" data-tilt=\"\">\n<div class=\"grid gap-4 p-6 md:grid-cols-[86px_1fr_180px] md:items-center md:gap-8\" data-kid=\"2-4-1-2-2-1\" data-name=\"card content row\">\n<span class=\"ls-display text-[34px] text-[#8C1C13]\" data-kid=\"2-4-1-2-2-1-1\" data-name=\"card index number\">02</span>\n<div data-kid=\"2-4-1-2-2-1-2\" data-name=\"card title and description block\">\n<h3 class=\"ls-display text-[21px] text-[#12100D]\" data-kid=\"2-4-1-2-2-1-2-1\" data-name=\"card project title\">Tide &amp; Timber</h3>\n<p class=\"mt-2 max-w-[58ch] text-[14px] leading-[1.65] text-[#12100D]/70\" data-kid=\"2-4-1-2-2-1-2-2\" data-name=\"card description text\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n</div>\n<div class=\"flex items-center justify-between gap-3 md:flex-col md:items-end md:justify-center\" data-kid=\"2-4-1-2-2-1-3\" data-name=\"card meta and link row\">\n<span class=\"ls-mono text-[10px] tracking-[0.2em] text-[#12100D]/60\" data-kid=\"2-4-1-2-2-1-3-1\" data-name=\"card year label\">2024</span>\n<a class=\"ls-mono text-[10px] uppercase tracking-[0.2em] text-[#8C1C13]\" data-kid=\"2-4-1-2-2-1-3-2\" data-name=\"case study link\" href=\"#work\">Read case study <span aria-hidden=\"true\" data-kid=\"2-4-1-2-2-1-3-2-1\" data-name=\"arrow glyph\">→</span></a>\n</div>\n</div>\n</article>\n<article class=\"ls-plate border border-[#12100D]/20 bg-[#EDE7DA]\" data-kid=\"2-4-1-2-3\" data-name=\"work card loom audio\" data-tilt=\"\">\n<div class=\"grid gap-4 p-6 md:grid-cols-[86px_1fr_180px] md:items-center md:gap-8\" data-kid=\"2-4-1-2-3-1\" data-name=\"card content row\">\n<span class=\"ls-display text-[34px] text-[#8C1C13]\" data-kid=\"2-4-1-2-3-1-1\" data-name=\"card index number\">03</span>\n<div data-kid=\"2-4-1-2-3-1-2\" data-name=\"card title and description block\">\n<h3 class=\"ls-display text-[21px] text-[#12100D]\" data-kid=\"2-4-1-2-3-1-2-1\" data-name=\"card project title\">Loom Audio</h3>\n<p class=\"mt-2 max-w-[58ch] text-[14px] leading-[1.65] text-[#12100D]/70\" data-kid=\"2-4-1-2-3-1-2-2\" data-name=\"card description text\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n</div>\n<div class=\"flex items-center justify-between gap-3 md:flex-col md:items-end md:justify-center\" data-kid=\"2-4-1-2-3-1-3\" data-name=\"card meta and link row\">\n<span class=\"ls-mono text-[10px] tracking-[0.2em] text-[#12100D]/60\" data-kid=\"2-4-1-2-3-1-3-1\" data-name=\"card year label\">2023</span>\n<a class=\"ls-mono text-[10px] uppercase tracking-[0.2em] text-[#8C1C13]\" data-kid=\"2-4-1-2-3-1-3-2\" data-name=\"case study link\" href=\"#work\">Read case study <span aria-hidden=\"true\" data-kid=\"2-4-1-2-3-1-3-2-1\" data-name=\"arrow glyph\">→</span></a>\n</div>\n</div>\n</article>\n</div>\n</div>\n</section>\n<section class=\"bg-[#12100D]\" data-kid=\"2-5\" data-name=\"experience section\" id=\"experience\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-16 lg:px-8\" data-kid=\"2-5-1\" data-name=\"experience content container\">\n<div class=\"flex items-baseline gap-4 border-b border-[#8B8474]/30 pb-5\" data-kid=\"2-5-1-1\" data-name=\"experience heading row\">\n<h2 class=\"ls-display text-[24px] text-[#EDE7DA] sm:text-[28px]\" data-kid=\"2-5-1-1-1\" data-name=\"experience heading text\">Experience</h2>\n<span class=\"ls-mono text-[10px] tracking-[0.2em] text-[#C1732B]\" data-kid=\"2-5-1-1-2\" data-name=\"experience count badge\">03</span>\n</div>\n<div class=\"mt-10 border-l border-[#C1732B]/35 pl-8\" data-kid=\"2-5-1-2\" data-name=\"rune rail timeline\">\n<div class=\"relative pb-10\" data-kid=\"2-5-1-2-1\" data-name=\"experience entry fintrail\">\n<span aria-hidden=\"true\" class=\"absolute -left-[41px] top-2 h-[9px] w-[9px] rotate-45 border border-[#C1732B] bg-[#12100D]\" data-kid=\"2-5-1-2-1-1\" data-name=\"rune rail node marker\"></span>\n<span class=\"ls-mono text-[10px] uppercase tracking-[0.22em] text-[#C1732B]\" data-kid=\"2-5-1-2-1-2\" data-name=\"entry year range\">2022 — present</span>\n<h3 class=\"ls-display mt-2 text-[19px] text-[#EDE7DA]\" data-kid=\"2-5-1-2-1-3\" data-name=\"entry company name\">Fintrail</h3>\n<p class=\"mt-1 text-[14px] text-[#8B8474]\" data-kid=\"2-5-1-2-1-4\" data-name=\"entry role title\">Senior product designer</p>\n</div>\n<div class=\"relative pb-10\" data-kid=\"2-5-1-2-2\" data-name=\"experience entry sundial studio\">\n<span aria-hidden=\"true\" class=\"absolute -left-[41px]