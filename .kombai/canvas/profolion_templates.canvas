      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  .eo-page { font-family: 'Space Grotesk', 'Helvetica Neue', sans-serif; }\n  .eo-display { font-family: 'Archivo Black', 'Helvetica Neue', sans-serif; letter-spacing: -0.042em; line-height: 0.86; }\n  .eo-mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }\n  .eo-chamfer { clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px)); }\n  .eo-chamfer-sm { clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px)); }\n  .eo-construct { filter: drop-shadow(0 0 26px rgba(47, 184, 99, 0.36)); }\n  .eo-grid { background-image: linear-gradient(rgba(47,184,99,0.075) 1px, transparent 1px), linear-gradient(90deg, rgba(47,184,99,0.075) 1px, transparent 1px); background-size: 48px 48px; }\n  .eo-plate { transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 300ms ease, background-color 300ms ease; }\n  .eo-plate:hover { transform: translateY(-4px); border-color: rgba(47,184,99,0.6); background-color: rgba(47,184,99,0.09); }\n  .eo-spin { animation: eo-spin 56s linear infinite; transform-origin: 160px 160px; }\n  @keyframes eo-spin { to { transform: rotate(360deg); } }\n  .eo-rule { position: relative; }\n  .eo-rule::after { content: \"\"; position: absolute; left: 0; bottom: -3px; height: 1px; width: 0; background: #3BE07A; transition: width 220ms ease; }\n  .eo-rule:hover::after { width: 100%; }\n  @media (prefers-reduced-motion: reduce) {\n    .eo-spin { animation: none; }\n    .eo-plate, .eo-plate:hover { transition: none; transform: none; }\n    .eo-rule::after { transition: none; }\n  }\n</style>\n<div class=\"eo-page min-h-screen bg-[#EDF5EF] text-[#05100A] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"sticky top-0 z-40 border-b border-[#2FB863]/25 bg-[#050A08]\" data-kid=\"1-1\" data-name=\"site header bar with sticky positioning\">\n<div class=\"mx-auto flex h-16 max-w-[1160px] items-center justify-between gap-5 px-5 lg:px-8\" data-kid=\"1-1-1\" data-name=\"header content row\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"owner identity link\" href=\"#top\">\n<span class=\"eo-chamfer-sm eo-mono grid h-9 w-9 place-items-center border border-[#2FB863]/55 bg-[#2FB863]/10 text-[11px] font-medium tracking-[0.1em] text-[#3BE07A]\" data-kid=\"1-1-1-1-1\" data-name=\"AM monogram plate\">AM</span>\n<span class=\"flex flex-col leading-tight\" data-kid=\"1-1-1-1-4\" data-name=\"owner identity text block\">\n<span class=\"text-[15px] font-semibold tracking-[-0.01em] text-[#EDF5EF]\" data-kid=\"1-1-1-1-2\" data-name=\"owner name\">Aarav Menon</span>\n<span class=\"eo-mono text-[9px] uppercase tracking-[0.28em] text-[#7C8F84]\" data-kid=\"1-1-1-1-3\" data-name=\"role micro label\">Interface designer</span>\n</span>\n</a>\n<nav aria-label=\"Sections\" class=\"hidden items-center gap-8 md:flex\" data-kid=\"1-1-1-2\" data-name=\"section navigation\">\n<a class=\"eo-mono text-[10px] uppercase tracking-[0.26em] text-[#7C8F84] transition-colors duration-200 hover:text-[#3BE07A]\" data-kid=\"1-1-1-2-1\" data-name=\"work nav link\" href=\"#work\">Work</a>\n<a class=\"eo-mono text-[10px] uppercase tracking-[0.26em] text-[#7C8F84] transition-colors duration-200 hover:text-[#3BE07A]\" data-kid=\"1-1-1-2-2\" data-name=\"experience nav link\" href=\"#experience\">Experience</a>\n<a class=\"eo-mono text-[10px] uppercase tracking-[0.26em] text-[#7C8F84] transition-colors duration-200 hover:text-[#3BE07A]\" data-kid=\"1-1-1-2-3\" data-name=\"education nav link\" href=\"#education\">Education</a>\n<a class=\"eo-mono text-[10px] uppercase tracking-[0.26em] text-[#7C8F84] transition-colors duration-200 hover:text-[#3BE07A]\" data-kid=\"1-1-1-2-4\" data-name=\"links nav link\" href=\"#elsewhere\">Links</a>\n</nav>\n<a class=\"eo-chamfer-sm eo-mono bg-[#2FB863] px-4 py-2 text-[10px] font-medium uppercase tracking-[0.2em] text-[#05100A]\" data-kid=\"1-1-1-3\" data-name=\"email contact button\" href=\"mailto:hello@example.com\">Email</a>\n</div>\n</header>\n<section class=\"relative overflow-hidden bg-[#050A08] text-[#EDF5EF]\" data-kid=\"1-2\" data-name=\"hero section with dark background\" id=\"top\">\n<div class=\"eo-grid pointer-events-none absolute inset-0 opacity-70\" data-kid=\"1-2-1\" data-name=\"construct grid backdrop\"></div>\n<div class=\"pointer-events-none absolute -right-32 top-1/2 h-[560px] w-[560px] -translate-y-1/2 rounded-full bg-[#2FB863]/10 blur-[120px]\" data-kid=\"1-2-2\" data-name=\"emerald blurred glow orb\"></div>\n<div class=\"relative mx-auto max-w-[1160px] px-5 pb-14 pt-14 lg:px-8 lg:pb-16 lg:pt-20\" data-kid=\"1-2-3\" data-name=\"hero content wrapper\">\n<div class=\"grid items-center gap-12 lg:grid-cols-[1.28fr_0.72fr] lg:gap-10\" data-kid=\"1-2-3-1\" data-name=\"hero two-column grid\">\n<div data-kid=\"1-2-3-1-1\" data-name=\"hero text column\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-1-1\" data-name=\"role label row\">\n<span class=\"h-[6px] w-[6px] bg-[#2FB863]\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"signal square indicator\"></span>\n<span class=\"eo-mono text-[10px] uppercase tracking-[0.34em] text-[#3BE07A]\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"role micro label text\">Interface designer</span>\n</div>\n<h1 class=\"eo-display mt-6 text-[50px] sm:text-[68px] lg:text-[82px]\" data-kid=\"1-2-3-1-1-2\" data-name=\"hero name headline\">\n<span class=\"block text-[#EDF5EF]\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"first name display line\">Aarav</span>\n<span class=\"block text-[#2FB863]\" data-kid=\"1-2-3-1-1-2-2\" data-name=\"last name display line\">Menon</span>\n</h1>\n<p class=\"mt-7 max-w-[46ch] text-[15px] leading-[1.72] text-[#7C8F84]\" data-kid=\"1-2-3-1-1-3\" data-name=\"bio paragraph\">I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.</p>\n<div class=\"mt-8 flex flex-wrap gap-2\" data-kid=\"1-2-3-1-1-4\" data-name=\"social link row\">\n<a class=\"eo-chamfer-sm eo-mono flex items-center gap-2 border border-[#2FB863]/30 bg-[#2FB863]/[0.06] px-3 py-2 text-[10px] uppercase tracking-[0.18em] text-[#EDF5EF]\" data-kid=\"1-2-3-1-1-4-1\" data-name=\"GitHub link chip\" href=\"https://github.com\">GitHub <span class=\"text-[#3BE07A]\" data-kid=\"1-2-3-1-1-4-1-1\" data-name=\"external link arrow icon\">↗</span></a>\n<a class=\"eo-chamfer-sm eo-mono flex items-center gap-2 border border-[#2FB863]/30 bg-[#2FB863]/[0.06] px-3 py-2 text-[10px] uppercase tracking-[0.18em] text-[#EDF5EF]\" data-kid=\"1-2-3-1-1-4-2\" data-name=\"Dribbble link chip\" href=\"https://dribbble.com\">Dribbble <span class=\"text-[#3BE07A]\" data-kid=\"1-2-3-1-1-4-2-1\" data-name=\"external link arrow icon\">↗</span></a>\n<a class=\"eo-chamfer-sm eo-mono flex items-center gap-2 border border-[#2FB863]/30 bg-[#2FB863]/[0.06] px-3 py-2 text-[10px] uppercase tracking-[0.18em] text-[#EDF5EF]\" data-kid=\"1-2-3-1-1-4-3\" data-name=\"LinkedIn link chip\" href=\"https://linkedin.com\">LinkedIn <span class=\"text-[#3BE07A]\" data-kid=\"1-2-3-1-1-4-3-1\" data-name=\"external link arrow icon\">↗</span></a>\n<a class=\"eo-chamfer-sm eo-mono flex items-center gap-2 border border-[#2FB863]/30 bg-[#2FB863]/[0.06] px-3 py-2 text-[10px] uppercase tracking-[0.18em] text-[#EDF5EF]\" data-kid=\"1-2-3-1-1-4-4\" data-name=\"email link chip\" href=\"mailto:hello@example.com\">Email <span class=\"text-[#3BE07A]\" data-kid=\"1-2-3-1-1-4-4-1\" data-name=\"external link arrow icon\">↗</span></a>\n</div>\n</div>\n<div class=\"mx-auto w-full max-w-[352px]\" data-kid=\"1-2-3-1-2\" data-name=\"construct decorative panel\">\n<div class=\"eo-chamfer relative border border-[#2FB863]/30 bg-[#050A08]/60 p-5\" data-kid=\"1-2-3-1-2-1\" data-name=\"glowing construct plate\">\n<div class=\"relative flex items-center justify-center\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"concentric ring construct\">\n<svg aria-hidden=\"true\" class=\"eo-construct h-[280px] w-[280px]\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"radial core emblem ring\" viewbox=\"0 0 320 320\">\n<defs>\n<radialgradient cx=\"50%\" cy=\"50%\" id=\"eoCore\" r=\"50%\">\n<stop offset=\"0%\" stop-color=\"#2FB863\" stop-opacity=\"0.42\"></stop>\n<stop offset=\"62%\" stop-color=\"#2FB863\" stop-opacity=\"0.07\"></stop>\n<stop offset=\"100%\" stop-color=\"#2FB863\" stop-opacity=\"0\"></stop>\n</radialgradient>\n</defs>\n<circle cx=\"160\" cy=\"160\" fill=\"url(#eoCore)\" r=\"152\"></circle>\n<circle cx=\"160\" cy=\"160\" fill=\"none\" r=\"146\" stroke=\"#2FB863\" stroke-opacity=\"0.2\"></circle>\n<g class=\"eo-spin\">\n<circle cx=\"160\" cy=\"160\" fill=\"none\" r=\"124\" stroke=\"#2FB863\" stroke-dasharray=\"2 10\" stroke-opacity=\"0.48\"></circle>\n<circle cx=\"160\" cy=\"28\" fill=\"#3BE07A\" r=\"3\"></circle>\n</g>\n<circle cx=\"160\" cy=\"160\" fill=\"none\" r=\"94\" stroke=\"#2FB863\" stroke-opacity=\"0.26\"></circle>\n<path d=\"M160 14 A146 146 0 0 1 262 84\" fill=\"none\" stroke=\"#3BE07A\" stroke-opacity=\"0.8\" stroke-width=\"2\"></path>\n<path d=\"M160 306 A146 146 0 0 1 58 236\" fill=\"none\" stroke=\"#3BE07A\" stroke-opacity=\"0.45\" stroke-width=\"2\"></path>\n<line stroke=\"#3BE07A\" stroke-width=\"1.5\" x1=\"160\" x2=\"160\" y1=\"14\" y2=\"40\"></line>\n<line stroke=\"#3BE07A\" stroke-opacity=\"0.6\" stroke-width=\"1.5\" x1=\"160\" x2=\"160\" y1=\"280\" y2=\"306\"></line>\n<line stroke=\"#3BE07A\" stroke-opacity=\"0.6\" stroke-width=\"1.5\" x1=\"14\" x2=\"40\" y1=\"160\" y2=\"160\"></line>\n<line stroke=\"#3BE07A\" stroke-opacity=\"0.6\" stroke-width=\"1.5\" x1=\"280\" x2=\"306\" y1=\"160\" y2=\"160\"></line>\n<circle cx=\"160\" cy=\"160\" fill=\"#050A08\" r=\"56\" stroke=\"#2FB863\" stroke-opacity=\"0.62\" stroke-width=\"1.5\"></circle>\n</svg>\n<div class=\"absolute inset-0 flex flex-col items-center justify-center\" data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"construct center monogram readout\">\n<span class=\"eo-display text-[26px] text-[#3BE07A]\" data-kid=\"1-2-3-1-2-1-1-2-1\" data-name=\"monogram initials\">AM</span>\n<span class=\"eo-mono mt-2 text-[8px] uppercase tracking-[0.3em] text-[#7C8F84]\" data-kid=\"1-2-3-1-2-1-1-2-2\" data-name=\"portfolio label\">Portfolio</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"relative border-t border-[#2FB863]/20\" data-kid=\"1-2-4\" data-name=\"skills rail section\">\n<div class=\"mx-auto grid max-w-[1160px] grid-cols-2 sm:grid-cols-3 lg:grid-cols-6\" data-kid=\"1-2-4-1\" data-name=\"skill cells grid\">\n<div class=\"border-b border-r border-[#2FB863]/15 px-5 py-4 sm:border-b-0\" data-kid=\"1-2-4-1-1\" data-magnet=\"\" data-name=\"design systems skill cell\">\n<span class=\"eo-mono text-[9px] tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-2-4-1-1-1\" data-name=\"skill cell number\">01</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDF5EF]\" data-kid=\"1-2-4-1-1-2\" data-name=\"skill cell label\">Design systems</p>\n</div>\n<div class=\"border-b border-r border-[#2FB863]/15 px-5 py-4 sm:border-b-0\" data-kid=\"1-2-4-1-2\" data-magnet=\"\" data-name=\"interaction design skill cell\">\n<span class=\"eo-mono text-[9px] tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-2-4-1-2-1\" data-name=\"skill cell number\">02</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDF5EF]\" data-kid=\"1-2-4-1-2-2\" data-name=\"skill cell label\">Interaction design</p>\n</div>\n<div class=\"border-b border-r border-[#2FB863]/15 px-5 py-4 sm:border-b-0\" data-kid=\"1-2-4-1-3\" data-magnet=\"\" data-name=\"prototyping skill cell\">\n<span class=\"eo-mono text-[9px] tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-2-4-1-3-1\" data-name=\"skill cell number\">03</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDF5EF]\" data-kid=\"1-2-4-1-3-2\" data-name=\"skill cell label\">Prototyping</p>\n</div>\n<div class=\"border-b border-r border-[#2FB863]/15 px-5 py-4 sm:border-b-0\" data-kid=\"1-2-4-1-4\" data-magnet=\"\" data-name=\"motion skill cell\">\n<span class=\"eo-mono text-[9px] tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-2-4-1-4-1\" data-name=\"skill cell number\">04</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDF5EF]\" data-kid=\"1-2-4-1-4-2\" data-name=\"skill cell label\">Motion</p>\n</div>\n<div class=\"border-b border-r border-[#2FB863]/15 px-5 py-4 sm:border-b-0\" data-kid=\"1-2-4-1-5\" data-magnet=\"\" data-name=\"type skill cell\">\n<span class=\"eo-mono text-[9px] tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-2-4-1-5-1\" data-name=\"skill cell number\">05</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDF5EF]\" data-kid=\"1-2-4-1-5-2\" data-name=\"skill cell label\">Type</p>\n</div>\n<div class=\"px-5 py-4\" data-kid=\"1-2-4-1-6\" data-magnet=\"\" data-name=\"research skill cell\">\n<span class=\"eo-mono text-[9px] tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-2-4-1-6-1\" data-name=\"skill cell number\">06</span>\n<p class=\"mt-1 text-[13px] font-medium text-[#EDF5EF]\" data-kid=\"1-2-4-1-6-2\" data-name=\"skill cell label\">Research</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"border-b border-[#05100A]/10 bg-[#EDF5EF]\" data-kid=\"1-3\" data-name=\"summary band with light background\">\n<div class=\"mx-auto max-w-[1160px] px-5 py-12 lg:px-8\" data-kid=\"1-3-1\" data-name=\"summary content wrapper\">\n<div class=\"flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between\" data-kid=\"1-3-1-1\" data-name=\"summary layout row\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1-1\" data-name=\"summary label group\">\n<span class=\"h-px w-8 bg-[#2FB863]\" data-kid=\"1-3-1-1-1-1\" data-name=\"summary accent rule\"></span>\n<span class=\"eo-mono text-[10px] uppercase tracking-[0.3em] text-[#5F7267]\" data-kid=\"1-3-1-1-1-2\" data-name=\"summary section label\">Summary</span>\n</div>\n<div class=\"grid grid-cols-2 gap-x-10 gap-y-7 sm:grid-cols-4\" data-kid=\"1-3-1-1-2\" data-name=\"summary readout cells grid\">\n<div data-kid=\"1-3-1-1-2-1\" data-name=\"projects count cell\">\n<p class=\"eo-display text-[38px] text-[#05100A]\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"projects count number\">03</p>\n<p class=\"eo-mono mt-1 text-[10px] uppercase tracking-[0.22em] text-[#5F7267]\" data-kid=\"1-3-1-1-2-1-2\" data-name=\"projects count label\">Projects</p>\n</div>\n<div data-kid=\"1-3-1-1-2-2\" data-name=\"skills count cell\">\n<p class=\"eo-display text-[40px] text-[#05100A]\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"skills count number\">06</p>\n<p class=\"eo-mono mt-1 text-[10px] uppercase tracking-[0.22em] text-[#5F7267]\" data-kid=\"1-3-1-1-2-2-2\" data-name=\"skills count label\">Skills</p>\n</div>\n<div data-kid=\"1-3-1-1-2-3\" data-name=\"roles count cell\">\n<p class=\"eo-display text-[38px] text-[#05100A]\" data-kid=\"1-3-1-1-2-3-1\" data-name=\"roles count number\">03</p>\n<p class=\"eo-mono mt-1 text-[10px] uppercase tracking-[0.22em] text-[#5F7267]\" data-kid=\"1-3-1-1-2-3-2\" data-name=\"roles count label\">Roles</p>\n</div>\n<div data-kid=\"1-3-1-1-2-4\" data-name=\"study count cell\">\n<p class=\"eo-display text-[38px] text-[#05100A]\" data-kid=\"1-3-1-1-2-4-1\" data-name=\"study count number\">02</p>\n<p class=\"eo-mono mt-1 text-[10px] uppercase tracking-[0.22em] text-[#5F7267]\" data-kid=\"1-3-1-1-2-4-2\" data-name=\"study count label\">Study</p>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"bg-[#050A08] text-[#EDF5EF]\" data-kid=\"1-4\" data-name=\"work section with dark background\" id=\"work\">\n<div class=\"mx-auto max-w-[1160px] px-5 py-16 lg:px-8\" data-kid=\"1-4-1\" data-name=\"work section content wrapper\">\n<div class=\"flex items-end justify-between gap-6 border-b border-[#2FB863]/25 pb-5\" data-kid=\"1-4-1-1\" data-name=\"work section heading row\">\n<div class=\"flex items-baseline gap-4\" data-kid=\"1-4-1-1-1\" data-name=\"work heading group\">\n<h2 class=\"eo-display text-[26px] sm:text-[30px]\" data-kid=\"1-4-1-1-1-1\" data-name=\"work section title\">Selected work</h2>\n<span class=\"eo-mono text-[10px] tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-4-1-1-1-2\" data-name=\"work section count\">03</span>\n</div>\n<span class=\"eo-mono hidden text-[10px] uppercase tracking-[0.26em] text-[#7C8F84] sm:block\" data-kid=\"1-4-1-1-2\" data-name=\"work section eyebrow label\">Case studies</span>\n</div>\n<div class=\"mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3\" data-kid=\"1-4-1-2\" data-name=\"work plate grid\">\n<article class=\"eo-plate eo-chamfer flex flex-col border border-[#2FB863]/25 bg-[#2FB863]/[0.04] p-6\" data-kid=\"1-4-1-2-1\" data-magnet=\"\" data-name=\"Kestrel case study card\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-4-1-2-1-1\" data-name=\"card meta row\">\n<span class=\"eo-mono text-[10px] tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-4-1-2-1-1-1\" data-name=\"card number\">01</span>\n<span class=\"eo-mono text-[10px] text-[#7C8F84]\" data-kid=\"1-4-1-2-1-1-2\" data-name=\"card year\">2025</span>\n</div>\n<h3 class=\"mt-6 text-[19px] font-semibold leading-snug text-[#EDF5EF]\" data-kid=\"1-4-1-2-1-2\" data-name=\"card title\">Kestrel</h3>\n<p class=\"mt-3 flex-1 text-[13px] leading-[1.7] text-[#7C8F84]\" data-kid=\"1-4-1-2-1-3\" data-name=\"card description\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n<a class=\"eo-mono mt-6 flex items-center justify-between border-t border-[#2FB863]/20 pt-4 text-[10px] uppercase tracking-[0.18em] text-[#3BE07A]\" data-kid=\"1-4-1-2-1-4\" data-name=\"card case study link\" href=\"#work\">Read case study <span data-kid=\"1-4-1-2-1-4-1\" data-name=\"external link arrow icon\">↗</span></a>\n</article>\n<article class=\"eo-plate eo-chamfer flex flex-col border border-[#2FB863]/25 bg-[#2FB863]/[0.04] p-6\" data-kid=\"1-4-1-2-2\" data-magnet=\"\" data-name=\"Tide &amp; Timber case study card\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-4-1-2-2-1\" data-name=\"card meta row\">\n<span class=\"eo-mono text-[10px] tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"card number\">02</span>\n<span class=\"eo-mono text-[10px] text-[#7C8F84]\" data-kid=\"1-4-1-2-2-1-2\" data-name=\"card year\">2024</span>\n</div>\n<h3 class=\"mt-6 text-[19px] font-semibold leading-snug text-[#EDF5EF]\" data-kid=\"1-4-1-2-2-2\" data-name=\"card title\">Tide &amp; Timber</h3>\n<p class=\"mt-3 flex-1 text-[13px] leading-[1.65] text-[#7C8F84]\" data-kid=\"1-4-1-2-2-3\" data-name=\"card description\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n<a class=\"eo-mono mt-6 flex items-center justify-between border-t border-[#2FB863]/20 pt-4 text-[10px] uppercase tracking-[0.18em] text-[#3BE07A]\" data-kid=\"1-4-1-2-2-4\" data-name=\"card case study link\" href=\"#work\">Read case study <span data-kid=\"1-4-1-2-2-4-1\" data-name=\"external link arrow icon\">↗</span></a>\n</article>\n<article class=\"eo-plate eo-chamfer flex flex-col border border-[#2FB863]/25 bg-[#2FB863]/[0.04] p-6 md:col-span-2 lg:col-span-1\" data-kid=\"1-4-1-2-3\" data-magnet=\"\" data-name=\"Loom Audio case study card\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-4-1-2-3-1\" data-name=\"card meta row\">\n<span class=\"eo-mono text-[10px] tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-4-1-2-3-1-1\" data-name=\"card number\">03</span>\n<span class=\"eo-mono text-[10px] text-[#7C8F84]\" data-kid=\"1-4-1-2-3-1-2\" data-name=\"card year\">2023</span>\n</div>\n<h3 class=\"mt-6 text-[19px] font-semibold leading-snug text-[#EDF5EF]\" data-kid=\"1-4-1-2-3-2\" data-name=\"card title\">Loom Audio</h3>\n<p class=\"mt-3 flex-1 text-[13px] leading-[1.7] text-[#7C8F84]\" data-kid=\"1-4-1-2-3-3\" data-name=\"card description\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n<a class=\"eo-mono mt-6 flex items-center justify-between border-t border-[#2FB863]/20 pt-4 text-[10px] uppercase tracking-[0.18em] text-[#3BE07A]\" data-kid=\"1-4-1-2-3-4\" data-name=\"card case study link\" href=\"#work\">Read case study <span data-kid=\"1-4-1-2-3-4-1\" data-name=\"external link arrow icon\">↗</span></a>\n</article>\n</div>\n</div>\n</section>\n<section class=\"border-t border-[#2FB863]/20 bg-[#050A08] text-[#EDF5EF]\" data-kid=\"1-5\" data-name=\"experience section with dark background\" id=\"experience\">\n<div class=\"mx-auto max-w-[1160px] px-5 py-16 lg:px-8\" data-kid=\"1-5-1\" data-name=\"experience section content wrapper\">\n<div class=\"flex items-baseline gap-4 border-b border-[#2FB863]/25 pb-5\" data-kid=\"1-5-1-1\" data-name=\"experience section heading row\">\n<h2 class=\"eo-display text-[26px] sm:text-[30px]\" data-kid=\"1-5-1-1-1\" data-name=\"experience section title\">Experience</h2>\n<span class=\"eo-mono text-[10px] tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-5-1-1-2\" data-name=\"experience section count\">03</span>\n</div>\n<div class=\"divide-y divide-[#2FB863]/12\" data-kid=\"1-5-1-2\" data-name=\"experience entries list\">\n<div class=\"grid gap-2 py-6 md:grid-cols-[190px_1fr] md:items-baseline md:gap-8\" data-kid=\"1-5-1-2-1\" data-name=\"Fintrail experience entry\">\n<span class=\"eo-mono text-[10px] uppercase tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-5-1-2-1-1\" data-name=\"entry date range\">2022 — present</span>\n<div data-kid=\"1-5-1-2-1-2\" data-name=\"entry company block\">\n<h3 class=\"text-[17px] font-semibold text-[#EDF5EF]\" data-kid=\"1-5-1-2-1-2-1\" data-name=\"company name\">Fintrail</h3>\n<p class=\"mt-1 text-[13px] text-[#7C8F84]\" data-kid=\"1-5-1-2-1-2-2\" data-name=\"role title\">Senior product designer</p>\n</div>\n</div>\n<div class=\"grid gap-2 py-6 md:grid-cols-[190px_1fr] md:items-baseline md:gap-8\" data-kid=\"1-5-1-2-2\" data-name=\"Sundial Studio experience entry\">\n<span class=\"eo-mono text-[10px] uppercase tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-5-1-2-2-1\" data-name=\"entry date range\">2019 — 2022</span>\n<div data-kid=\"1-5-1-2-2-2\" data-name=\"entry company block\">\n<h3 class=\"text-[17px] font-semibold text-[#EDF5EF]\" data-kid=\"1-5-1-2-2-2-1\" data-name=\"company name\">Sundial Studio</h3>\n<p class=\"mt-1 text-[13px] text-[#7C8F84]\" data-kid=\"1-5-1-2-2-2-2\" data-name=\"role title\">Product designer</p>\n</div>\n</div>\n<div class=\"grid gap-2 py-6 md:grid-cols-[190px_1fr] md:items-baseline md:gap-8\" data-kid=\"1-5-1-2-3\" data-name=\"Pageturn Press experience entry\">\n<span class=\"eo-mono text-[10px] uppercase tracking-[0.2em] text-[#3BE07A]\" data-kid=\"1-5-1-2-3-1\" data-name=\"entry date range\">2017 — 2019</span>\n<div data-kid=\"1-5-1-2-3-2\" data-name=\"entry company block\">\n<h3 class=\"text-[17px] font-semibold text-[#EDF5EF]\" data-kid=\"1-5-1-2-3-2-1\" data-name=\"company name\">Pageturn Press</h3>\n<p class=\"mt-1 text-[13px] text-[#7C8F84]\" data-kid=\"1-5-1-2-3-2-2\" data-name=\"role title\">Interface designer</p>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"bg-[#EDF5EF]\" data-kid=\"1-7\" data-name=\"combined education and elsewhere section\" id=\"education\">\n<div class=\"mx-auto grid max-w-[1160px] gap-12 px-5 py-16 lg:grid-cols-2 lg:gap-20 lg:px-8\" data-kid=\"1-6-1\" data-name=\"closing two-column split grid\">\n<div data-kid=\"1-6-1-1\" data-name=\"education column\">\n<div class=\"flex items-baseline gap-4 border-b border-[#05100A]/15 pb-4\" data-kid=\"1-6-1-1-1\" data-name=\"education heading row\">\n<h2 class=\"eo-display text-[22px] text-[#05100A]\" data-kid=\"1-6-1-1-1-1\" data-name=\"education section title\">Education</h2>\n<span class=\"eo-mono text-[10px] tracking-[0.2em] text-[#5F7267]\" data-kid=\"1-6-1-1-1-2\" data-name=\"education section count\">02</span>\n</div>\n<div class=\"mt-6 space-y-6\" data-kid=\"1-6-1-1-2\" data-name=\"education entries\">\n<div data-kid=\"1-6-1-1-2-1\" data-name=\"National Institute of Design entry\">\n<div class=\"flex flex-wrap items-baseline justify-between gap-2\" data-kid=\"1-6-1-1-2-1-1\" data-name=\"school header row\">\n<h3 class=\"text-[16px] font-semibold text-[#05100A]\" data-kid=\"1-6-1-1-2-1-1-1\" data-name=\"school name\">National Institute of Design</h3>\n<span class=\"eo-mono text-[10px] uppercase tracking-[0.2em] text-[#5F7267]\" data-kid=\"1-6-1-1-2-1-1-2\" data-name=\"school date range\">2015 — 2017</span>\n</div>\n<p class=\"mt-1 text-[13px] text-[#5F7267]\" data-kid=\"1-6-1-1-2-1-2\" data-name=\"major of study\">Interaction design</p>\n</div>\n<div data-kid=\"1-6-1-1-2-2\" data-name=\"Srishti Institute entry\">\n<div class=\"flex flex-wrap items-baseline justify-between gap-2\" data-kid=\"1-6-1-1-2-2-1\" data-name=\"school header row\">\n<h3 class=\"text-[16px] font-semibold text-[#05100A]\" data-kid=\"1-6-1-1-2-2-1-1\" data-name=\"school name\">Srishti Institute</h3>\n<span class=\"eo-mono text-[10px] uppercase tracking-[0.2em] text-[#5F7267]\" data-kid=\"1-6-1-1-2-2-1-2\" data-name=\"school date range\">2013 — 2015</span>\n</div>\n<p class=\"mt-1 text-[13px] text-[#5F7267]\" data-kid=\"1-6-1-1-2-2-2\" data-name=\"major of study\">Foundation studies</p>\n</div>\n</div>\n</div>\n<div data-kid=\"1-6-1-2\" data-name=\"elsewhere column\" id=\"elsewhere\">\n<div class=\"flex items-baseline gap-4 border-b border-[#05100A]/15 pb-4\" data-kid=\"1-6-1-2-1\" data-name=\"elsewhere heading row\">\n<h2 class=\"eo-display text-[22px] text-[#05100A]\" data-kid=\"1-6-1-2-1-1\" data-name=\"elsewhere section title\">Elsewhere</h2>\n<span class=\"eo-mono text-[10px] tracking-[0.2em] text-[#5F7267]\" data-kid=\"1-6-1-2-1-2\" data-name=\"elsewhere section count\">04</span>\n</div>\n<div class=\"mt-6 divide-y divide-[#05100A]/10\" data-kid=\"1-6-1-2-2\" data-name=\"social link list\">\n<a class=\"group flex items-center justify-between gap-4 py-3\" data-