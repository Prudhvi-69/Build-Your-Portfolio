      "html": "<body class=\"min-h-screen bg-[#f5f5ee] font-sans text-[#19352e] antialiased\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Yuji+Syuku&family=Shippori+Mincho:wght@400;500;600;700&family=Chakra+Petch:wght@400;500;600;700&family=Barlow:wght@300;400;500;600&family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:wght@300;400;500;600&family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600&family=Fredoka:wght@400;500;600&family=Nunito:wght@400;500;600;700&display=swap');\n    body { font-family: Arial, Helvetica, sans-serif; }\n    .serif-display { font-family: Georgia, \"Times New Roman\", serif; font-weight: 400; letter-spacing: -0.05em; }\n    #worlds { scrollbar-width: none; }\n    #worlds::-webkit-scrollbar { width: 0; height: 0; }\n    .row-on { background: #164e42 !important; color: #f7f6ef !important; }\n    .row-on .row-world { color: #cfe98a !important; }\n    .stamp { animation: stamp 420ms cubic-bezier(.2,1.4,.4,1) both; }\n    @keyframes stamp { 0% { transform: scale(1.14) rotate(-3deg); } 60% { transform: scale(.97) rotate(1deg); } 100% { transform: scale(1) rotate(0); } }\n  </style>\n<nav class=\"w-full border-b border-[#19352e]/12 bg-[#f5f5ee]/92 backdrop-blur-xl\" data-kid=\"1\" data-name=\"main navigation bar\">\n<div class=\"mx-auto flex h-[76px] max-w-[1392px] items-center justify-between px-6\" data-kid=\"1-1\" data-name=\"navigation content container\">\n<div class=\"flex items-center gap-9\" data-kid=\"1-1-1\" data-name=\"brand and nav links group\">\n<span class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo lockup\">\n<span class=\"grid h-[34px] w-[34px] place-items-center rounded-[11px] bg-[#164e42] text-[19px] font-extrabold tracking-[-0.08em] text-[#d7ff70]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logomark square with monogram\">p.</span>\n<span class=\"text-[20px] font-bold tracking-[-0.06em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark text\">profolion<span class=\"text-[#749454]\" data-kid=\"1-1-1-1-2-1\" data-name=\"wordmark period accent\">.</span></span>\n</span>\n<div class=\"hidden items-center gap-8 text-[13px] font-medium text-[#68756c] md:flex\" data-kid=\"1-1-1-2\" data-name=\"primary navigation links\">\n<span data-kid=\"1-1-1-2-1\" data-name=\"How it works nav link\">How it works</span>\n<span class=\"font-semibold text-[#19352e]\" data-kid=\"1-1-1-2-2\" data-name=\"Templates nav link (active)\">Templates</span>\n<span data-kid=\"1-1-1-2-3\" data-name=\"Why Profolion nav link\">Why Profolion</span>\n</div>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-2\" data-name=\"nav actions group\">\n<span class=\"rounded-full border border-[#dedfd5] bg-[#fffefa] px-4 py-2.5 text-[12px] font-semibold text-[#35544a]\" data-kid=\"1-1-2-1\" data-name=\"dashboard link pill\">Dashboard</span>\n<span class=\"inline-flex items-center gap-2 rounded-full bg-[#164e42] px-5 py-3 text-[13px] font-semibold text-[#f7f6ef]\" data-kid=\"1-1-2-2\" data-name=\"My studio call-to-action button\">\n          My studio <i class=\"bi bi-arrow-up-right text-[13px]\" data-kid=\"1-1-2-2-1\" data-name=\"diagonal arrow icon\"></i>\n</span>\n</div>\n</div>\n</nav>\n<main class=\"mx-auto max-w-[1392px] px-6 py-6\" data-kid=\"2\" data-name=\"main content area\">\n<div class=\"flex h-12 items-end justify-between gap-6\" data-kid=\"2-1\" data-name=\"page header bar\">\n<div class=\"flex items-baseline gap-4\" data-kid=\"2-1-1\" data-name=\"page title group\">\n<h1 class=\"serif-display text-[36px] leading-none\" data-kid=\"2-1-1-1\" data-name=\"page headline (Templates)\">Templates</h1>\n<span class=\"pb-1 font-mono text-[11px] text-[#7b877c]\" data-dynamic=\"true\" data-kid=\"2-1-1-2\" data-name=\"total templates count label\" data-reason=\"text set by paintList script from T.length\" id=\"countLabel\">22 templates</span>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"2-1-2\" data-name=\"header actions group\">\n<div class=\"flex h-10 w-[300px] items-center gap-2.5 rounded-full border border-[#dedfd5] bg-[#fffefa] px-4\" data-kid=\"2-1-2-1\" data-name=\"search input field container\">\n<i class=\"bi bi-search text-[13px] text-[#879186]\" data-kid=\"2-1-2-1-1\" data-name=\"search icon\"></i>\n<input aria-label=\"Search templates\" class=\"w-full bg-transparent text-[12.5px] outline-none placeholder:text-[#a3aca1]\" data-kid=\"2-1-2-1-2\" data-name=\"search input\" id=\"q\" placeholder=\"Search name or world\" type=\"text\"/>\n</div>\n<span class=\"inline-flex h-10 items-center gap-2 rounded-full border border-[#dedfd5] px-4 text-[12px] font-semibold text-[#35544a]\" data-kid=\"2-1-2-2\" data-name=\"back to editor button\">\n<i class=\"bi bi-arrow-left text-[13px]\" data-kid=\"2-1-2-2-1\" data-name=\"back arrow icon\"></i> Back to editor\n        </span>\n</div>\n</div>\n<div class=\"mt-4 grid h-[700px] grid-cols-[248px_1fr] gap-4\" data-kid=\"2-2\" data-name=\"main templates browser grid\">\n<aside class=\"flex min-h-0 flex-col overflow-hidden rounded-[16px] border border-[#dedfd5] bg-[#fffefa]\" data-kid=\"2-2-1\" data-name=\"template list sidebar\">\n<div class=\"grid grid-cols-4 gap-1 border-b border-[#eceae1] p-1.5\" data-kid=\"2-2-1-1\" data-name=\"family filter buttons row\">\n<button class=\"fam rounded-[9px] bg-[#164e42] py-2 text-[10px] font-bold text-[#f7f6ef]\" data-family=\"all\" data-kid=\"2-2-1-1-1\" data-name=\"All filter button (active)\">All</button>\n<button class=\"fam rounded-[9px] py-2 text-[10px] font-bold text-[#68756c]\" data-family=\"anime\" data-kid=\"2-2-1-1-2\" data-name=\"Anime filter button\">Anime</button>\n<button class=\"fam rounded-[9px] py-2 text-[10px] font-bold text-[#68756c]\" data-family=\"comics\" data-kid=\"2-2-1-1-3\" data-name=\"Comics filter button\">Comics</button>\n<button class=\"fam rounded-[9px] py-2 text-[10px] font-bold text-[#68756c]\" data-family=\"worlds\" data-kid=\"2-2-1-1-4\" data-name=\"Worlds filter button\">Worlds</button>\n</div>\n<div class=\"min-h-0 flex-1 overflow-y-auto px-1.5 py-1.5\" data-dynamic=\"true\" data-kid=\"2-2-1-2\" data-name=\"template list container\" data-reason=\"children rendered by paintList script from T data\" id=\"worlds\"></div>\n<div class=\"flex items-center justify-between border-t border-[#eceae1] px-3 py-2.5\" data-kid=\"2-2-1-3\" data-name=\"sidebar footer row\">\n<span class=\"font-mono text-[10px] text-[#93a094]\" data-dynamic=\"true\" data-kid=\"2-2-1-3-1\" data-name=\"shown count label\" data-reason=\"text set by paintList script from filtered list length\" id=\"footerCount\">22 shown</span>\n<span class=\"font-mono text-[10px] text-[#93a094]\" data-kid=\"2-2-1-3-2\" data-name=\"sort order label\">A–Z</span>\n</div>\n</aside>\n<section class=\"flex min-h-0 flex-col overflow-hidden rounded-[16px] border border-[#dedfd5] bg-[#fffefa]\" data-kid=\"2-2-2\" data-name=\"template preview card\">\n<div class=\"flex h-[56px] shrink-0 items-center justify-between gap-4 border-b border-[#eceae1] px-5\" data-kid=\"2-2-2-1\" data-name=\"preview toolbar\">\n<div class=\"flex items-baseline gap-3\" data-kid=\"2-2-2-1-1\" data-name=\"selected template name group\">\n<span class=\"serif-display text-[21px] leading-none\" data-dynamic=\"true\" data-kid=\"2-2-2-1-1-1\" data-name=\"selected template name display\" data-reason=\"text replaced by select script on template change\" id=\"toolbarName\">Konoha Ink</span>\n<span class=\"rounded-full bg-[#e9eee5] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[#4f6c54]\" data-dynamic=\"true\" data-kid=\"2-2-2-1-1-2\" data-name=\"selected template world badge\" data-reason=\"text replaced by select script on template change\" id=\"toolbarWorld\">Naruto</span>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"2-2-2-1-2\" data-name=\"preview toolbar actions\">\n<button aria-pressed=\"true\" class=\"flex h-8 items-center gap-2 rounded-full border border-[#dedfd5] px-3 text-[11px] font-semibold text-[#35544a]\" data-kid=\"2-2-2-1-2-1\" data-name=\"motion toggle button\" id=\"motion\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-[#76a568]\" data-dynamic=\"true\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"motion status indicator dot\" data-reason=\"background color toggled by script on click\" id=\"motionDot\"></span> Motion\n            </button>\n<span class=\"inline-flex h-8 items-center gap-1.5 rounded-full bg-[#eef2e9] px-3 text-[11px] font-semibold text-[#35544a]\" data-kid=\"2-2-2-1-2-2\" data-name=\"open preview button\">\n<i class=\"bi bi-arrows-fullscreen text-[11px]\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"fullscreen expand icon\"></i> Open preview\n            </span>\n</div>\n</div>\n<div class=\"relative min-h-0 flex-1 bg-[#e7eae2] p-3\" data-kid=\"2-2-2-2\" data-name=\"preview stage area\">\n<div class=\"h-full w-full overflow-hidden rounded-[10px] ring-1 ring-[#19352e]/10\" data-dynamic=\"true\" data-kid=\"2-2-2-2-1\" data-name=\"template render preview canvas\" data-reason=\"innerHTML replaced by select script with active template markup\" id=\"stage\"></div>\n</div>\n<div class=\"flex h-[72px] shrink-0 items-center justify-between gap-4 border-t border-[#eceae1] px-5\" data-kid=\"2-2-2-3\" data-name=\"preview footer action bar\">\n<div class=\"flex items-center gap-3\" data-kid=\"2-2-2-3-1\" data-name=\"portfolio target selector group\">\n<div class=\"flex h-10 items-center gap-2 rounded-[10px] border border-[#dedfd5] bg-[#fffefa] px-3\" data-kid=\"2-2-2-3-1-1\" data-name=\"portfolio dropdown selector\">\n<i class=\"bi bi-globe2 text-[12px] text-[#879186]\" data-kid=\"2-2-2-3-1-1-1\" data-name=\"globe icon\"></i>\n<span class=\"text-[12px] font-semibold\" data-kid=\"2-2-2-3-1-1-2\" data-name=\"selected portfolio name label\">Aarav Menon — Portfolio</span>\n<i class=\"bi bi-chevron-down text-[10px] text-[#879186]\" data-kid=\"2-2-2-3-1-1-3\" data-name=\"dropdown chevron icon\"></i>\n</div>\n<span class=\"text-[11px] text-[#879186]\" data-kid=\"2-2-2-3-1-2\" data-name=\"applying-to helper text\">Applying to this portfolio</span>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"2-2-2-3-2\" data-name=\"apply actions group\">\n<span class=\"font-mono text-[11px] text-[#879186]\" data-dynamic=\"true\" data-kid=\"2-2-2-3-2-1\" data-name=\"template slug label (file name)\" data-reason=\"text replaced by select script from template id\" id=\"slipName\">konoha-ink</span>\n<button class=\"inline-flex h-11 items-center gap-2 rounded-full bg-[#164e42] px-6 text-[13px] font-semibold text-[#f7f6ef]\" data-kid=\"2-2-2-3-2-2\" data-name=\"use template button\" id=\"use\">\n<span data-dynamic=\"true\" data-kid=\"2-2-2-3-2-2-1\" data-name=\"use template button label\" data-reason=\"text replaced by select script on template change / by click handler\" id=\"useLabel\">Use template</span>\n<i class=\"bi bi-check2 text-[14px]\" data-kid=\"2-2-2-3-2-2-2\" data-name=\"checkmark icon\" id=\"useIcon\"></i>\n</button>\n</div>\n</div>\n</section>\n</div>\n</main>\n<link data-kid=\"3\" data-name=\"bootstrap icons stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\" rel=\"stylesheet\"/>\n<script>\n    const P = {\n      first: 'Aarav', last: 'Menon', role: 'Interface designer', city: 'Bengaluru',\n      bio: 'Interface designer working on booking, payments and publishing products. Eight years in, most of it spent making dense screens feel calm.',\n      projects: [\n        { t: 'Kestrel', k: 'Design system', y: '2025' },\n        { t: 'Tide & Timber', k: 'Booking app', y: '2024' },\n        { t: 'Loom Audio', k: 'Editorial', y: '2023' }\n      ],\n      skills: ['Design systems', 'Interaction design', 'Prototyping', 'Type'],\n      roles: [\n        { t: 'Fintrail', k: 'Senior product designer', y: '2022 —' },\n        { t: 'Sundial Studio', k: 'Product designer', y: '2019 — 22' },\n        { t: 'Pageturn Press', k: 'Interface designer', y: '2017 — 19' }\n      ]\n    };\n\n    const PAIRS = {\n      ink:  { d: \"'Yuji Syuku', serif\", b: \"'Shippori Mincho', serif\", caps: '0.24em' },\n      tech: { d: \"'Chakra Petch', sans-serif\", b: \"'Barlow', sans-serif\", caps: '0.16em' },\n      deco: { d: \"'Cinzel', serif\", b: \"'Cormorant Garamond', serif\", caps: '0.2em' },\n      bold: { d: \"'Bebas Neue', sans-serif\", b: '\"Space Grotesk\", sans-serif', caps: '0.16em' },\n      soft: { d: 'Fredoka, sans-serif', b: 'Nunito, sans-serif', caps: '0.1em' }\n    };\n\n    const T = [\n      { id:'konoha-ink', name:'Konoha Ink', world:'Naruto', family: 'anime', arch: 'ink', pair: 'ink', p: { paper:'#F9F4F3', ink:'#1D1312', muted:'#8A7A73', accent:'#94110A', accentInk:'#F9F4F3', surface:'#F2E9E4', dark:'#1D1312', darkInk:'#EFEFAC', darkMuted:'#B5A78F' } },\n      { id:'soul-reaper', name:'Soul Reaper', world:'Bleach', family: 'anime', arch: 'editorial', pair: 'ink', p: { paper:'#F3F5F7', ink:'#141A1F', muted:'#7C8A93', accent:'#2F6F8F', accentInk:'#FFFFFF', surface:'#E7EDF1', dark:'#0E1116', darkInk:'#EAF2F7', darkMuted:'#8FA1AC' } },\n      { id:'grand-line', name:'Grand Line', world:'One Piece', family: 'anime', arch: 'bold', pair: 'bold', p: { paper:'#F6EFDF', ink:'#12232B', muted:'#7C7262', accent:'#C8842B', accentInk:'#12232B', surface:'#EFE4CC', dark:'#0B2B3C', darkInk:'#F6EFDF', darkMuted:'#8FA6AD' } },\n      { id:'cursed-energy', name:'Cursed Energy', world:'Jujutsu Kaisen', family: 'anime', arch: 'hud', pair: 'tech', p: { paper:'#E8E4F2', ink:'#0B0B10', muted:'#6E6A80', accent:'#5B48C7', accentInk:'#FFFFFF', surface:'#DCD6EE', dark:'#0B0B10', darkInk:'#D9FF4B', darkMuted:'#8B87A3' } },\n      { id:'breath-of-flame', name:'Breath of Flame', world:'Demon Slayer', family: 'anime', arch: 'bold', pair: 'bold', p: { paper:'#F7EFE6', ink:'#141014', muted:'#7E7069', accent:'#D8462F', accentInk:'#FFF6EC', surface:'#F0E1D5', dark:'#141014', darkInk:'#F2C744', darkMuted:'#A29289' } },\n      { id:'arc-reactor', name:'Arc Reactor', world:'Iron Man', family: 'comics', arch: 'hud', pair: 'tech', p: { paper:'#F5F5F1', ink:'#17170E', muted:'#6D7A78', accent:'#19647E', accentInk:'#FFF44F', surface:'#E6EDE9', dark:'#17170E', darkInk:'#76DCD2', darkMuted:'#8B9186' } },\n      { id:'star-shield', name:'Star Shield', world:'Captain America', family: 'comics', arch: 'editorial', pair: 'deco', p: { paper:'#F1EDE3', ink:'#12233A', muted:'#6C7787', accent:'#B01427', accentInk:'#FFFFFF', surface:'#E5DED0', dark:'#12233A', darkInk:'#F1EDE3', darkMuted:'#93A1B0' } },\n      { id:'thunder-rune', name:'Thunder Rune', world:'Thor', family: 'comics', arch: 'deco', pair: 'deco', p: { paper:'#EDF1F5', ink:'#0E1B2B', muted:'#6A7889', accent:'#D9A441', accentInk:'#0E1B2B', surface:'#E1E8EF', dark:'#0E1B2B', darkInk:'#7FD3E8', darkMuted:'#8A9AA9' } },\n      { id:'web-slinger', name:'Web Slinger', world:'Spider-Man', family: 'comics', arch: 'bold', pair: 'bold', p: { paper:'#F5F1E8', ink:'#14161B', muted:'#6F7278', accent:'#C4161C', accentInk:'#FFFDF6', surface:'#E9E2D4', dark:'#1B4FA0', darkInk:'#F5F1E8', darkMuted:'#B9C5DD' } },\n      { id:'gotham-nocturne', name:'Gotham Nocturne', world:'Batman', family: 'comics', arch: 'deco', pair: 'deco', p: { paper:'#F0ECEC', ink:'#0D0D12', muted:'#7A7580', accent:'#CFAB01', accentInk:'#0D0D12', surface:'#E2DDE2', dark:'#0D0D12', darkInk:'#F0ECEC', darkMuted:'#8E8894' } },\n      { id:'last-son', name:'Last Son', world:'Superman', family: 'comics', arch: 'editorial', pair: 'bold', p: { paper:'#F4F1E8', ink:'#0B1B3A', muted:'#6E7889', accent:'#C8102E', accentInk:'#FFFFFF', surface:'#E6E2D6', dark:'#0B1B3A', darkInk:'#F2C744', darkMuted:'#8D9AAE' } },\n      { id:'amazonia', name:'Amazonia', world:'Wonder Woman', family: 'comics', arch: 'deco', pair: 'deco', p: { paper:'#F6F0E6', ink:'#14100E', muted:'#7A6E62', accent:'#A8232F', accentInk:'#FFF6EC', surface:'#EBE0CE', dark:'#14100E', darkInk:'#C9A227', darkMuted:'#8E8175' } },\n      { id:'emerald-oath', name:'Emerald Oath', world:'Green Lantern', family: 'comics', arch: 'hud', pair: 'bold', p: { paper:'#EDF5EF', ink:'#05100A', muted:'#5F7267', accent:'#2FB863', accentInk:'#05100A', surface:'#DDEDE2', dark:'#050A08', darkInk:'#3BE07A', darkMuted:'#7C8F84' } },\n      { id:'scarlet-speed', name:'Scarlet Speed', world:'The Flash', family: 'comics', arch: 'bold', pair: 'bold', p: { paper:'#F7F2E9', ink:'#B3121C', muted:'#7E6A63', accent:'#F5C518', accentInk:'#B3121C', surface:'#EFE3D4', dark:'#B3121C', darkInk:'#F5C518', darkMuted:'#F0C9BC' } },\n      { id:'alpine-meadow', name:'Alpine Meadow', world:'Heidi', family: 'worlds', arch: 'soft', pair: 'soft', p: { paper:'#F4EEDC', ink:'#3C3A2A', muted:'#84795F', accent:'#6E9B57', accentInk:'#FFFDF4', surface:'#E9E1CB', dark:'#3C3A2A', darkInk:'#F4EEDC', darkMuted:'#B0A78D' } },\n      { id:'owl-post', name:'Owl Post', world:'Harry Potter', family: 'worlds', arch: 'deco', pair: 'deco', p: { paper:'#F6EFDD', ink:'#14100F', muted:'#7C7160', accent:'#7A2230', accentInk:'#F6EFDD', surface:'#EAE0CB', dark:'#14100F', darkInk:'#B08D3F', darkMuted:'#8B8071' } },\n      { id:'iron-throne', name:'Iron Throne', world:'Game of Thrones', family: 'worlds', arch: 'editorial', pair: 'deco', p: { paper:'#EDEAE4', ink:'#0F1112', muted:'#6F7174', accent:'#7B1E1E', accentInk:'#EDEAE4', surface:'#DFDCD5', dark:'#0F1112', darkInk:'#9AA3A8', darkMuted:'#7B7E82' } },\n      { id:'dream-house', name:'Dream House', world:'Barbie', family: 'worlds', arch: 'soft', pair: 'soft', p: { paper:'#FFE3F1', ink:'#4A1330', muted:'#9B4E76', accent:'#FF3D8B', accentInk:'#FFFFFF', surface:'#FFD0E6', dark:'#4A1330', darkInk:'#FFC2E0', darkMuted:'#D08BAC' } },\n      { id:'deep-field', name:'Deep Field', world:'Space', family: 'worlds', arch: 'hud', pair: 'tech', p: { paper:'#F0F2F7', ink:'#05070F', muted:'#6B7385', accent:'#3F6FE0', accentInk:'#FFFFFF', surface:'#E1E5EE', dark:'#05070F', darkInk:'#7FB2FF', darkMuted:'#7C869C' } },\n      { id:'abyss-light', name:'Abyss Light', world:'Ocean', family: 'worlds', arch: 'soft', pair: 'soft', p: { paper:'#E6F2F2', ink:'#04121A', muted:'#5C7378', accent:'#17888F', accentInk:'#E6F2F2', surface:'#D3E7E8', dark:'#04121A', darkInk:'#4FD6C8', darkMuted:'#7C9599' } },\n      { id:'vinland-coast', name:'Vinland Coast', world:'Vinland Saga', family: 'worlds', arch: 'editorial', pair: 'bold', p: { paper:'#F0ECE4', ink:'#101519', muted:'#6D7176', accent:'#C77B33', accentInk:'#101519', surface:'#E4DED3', dark:'#101519', darkInk:'#E9DFC9', darkMuted:'#8A8D8F' } },\n      { id:'longship', name:'Longship', world:'Vikings', family: 'worlds', arch: 'hud', pair: 'deco', p: { paper:'#EDE7DA', ink:'#12100D', muted:'#77705F', accent:'#8C1C13', accentInk:'#EDE7DA', surface:'#DED6C4', dark:'#12100D', darkInk:'#C1732B', darkMuted:'#8B8474' } }\n    ];\n\n    const ARCH = {\n      ink: (t, pair, p) => `\n        <div class=\"flex h-full\" style=\"background:${p.paper};color:${p.ink};font-family:${pair.b}\">\n          <div class=\"relative flex w-[47%] flex-col justify-between p-8\" style=\"background:${p.dark};color:${p.darkInk}\">\n            <div class=\"flex items-center justify-between\" style=\"font-size:9px;letter-spacing:${pair.caps};text-transform:uppercase;color:${p.darkMuted}\">\n              <span>${P.city}</span><span>${t.world}</span>\n            </div>\n            <div>\n              <h1 style=\"font-family:${pair.d};font-size:70px;line-height:0.9;margin:0\">${P.first}<br />${P.last}</h1>\n              <div class=\"mt-6 flex items-center gap-4\">\n                <span class=\"grid h-12 w-12 place-items-center\" style=\"background:${p.accent};color:${p.accentInk};font-size:11px;letter-spacing:0.06em;border-radius:2px\">AM</span>\n                <span style=\"font-size:11px;line-height:1.7;color:${p.darkMuted}\">${P.role}<br />${P.skills[0]}</span>\n              </div>\n            </div>\n            <div class=\"flex items-end gap-4\">\n              <img src=\"https://kombai-assets.b-cdn.net/generated_assets/163f8105e6df4614bea53a0f08eea69d.jpg\" alt=\"Portrait of Aarav Menon rendered in ink wash\" decoding=\"async\" loading=\"lazy\" class=\"h-[104px] w-[84px] shrink-0 object-cover\" style=\"border-radius:1px;filter:contrast(1.06)\" />\n              <p style=\"margin:0;font-size:10.5px;line-height:1.9;color:${p.darkMuted};max-width:23ch\">${P.bio}</p>\n            </div>\n          </div>\n          <div class=\"flex flex-1 flex-col p-8\">\n            <div class=\"flex items-baseline justify-between\" style=\"border-bottom:1px solid ${p.ink}26;padding-bottom:7px\">\n              <span style=\"font-family:${pair.d};font-size:17px\">Selected work</span>\n              <span style=\"font-size:9px;letter-spacing:0.18em;color:${p.muted}\">2023 — 2025</span>\n            </div>\n            ${P.projects.map((pr, i) => `\n              <div class=\"flex items-baseline gap-3\" style=\"padding:12px 0;border-bottom:1px solid ${p.ink}12\">\n                <span style=\"font-size:9px;color:${p.muted};width:14px\">0${i + 1}</span>\n                <span style=\"font-family:${pair.d};font-size:20px;flex:1\">${pr.t}</span>\n                <span style=\"font-size:10px;color:${p.muted}\">${pr.k}</span>\n                <span style=\"font-size:9px;color:${p.muted}\">${pr.y}</span>\n              </div>`).join('')}\n            <div class=\"mt-6 flex items-baseline justify-between\" style=\"border-bottom:1px solid ${p.ink}26;padding-bottom:7px\">\n              <span style=\"font-family:${pair.d};font-size:15px\">Experience</span>\n              <span style=\"font-size:9px;letter-spacing:0.18em;color:${p.muted}\">0${P.roles.length}</span>\n            </div>\n            ${P.roles.map((r) => `\n              <div class=\"flex items-baseline justify-between gap-3\" style=\"padding:9px 0;border-bottom:1px solid ${p.ink}10\">\n                <span style=\"font-size:11px;font-weight:600\">${r.t}</span>\n                <span style=\"font-size:10px;color:${p.muted};flex:1;padding-left:10px\">${r.k}</span>\n                <span style=\"font-size:9px;color:${p.muted}\">${r.y}</span>\n              </div>`).join('')}\n            <div class=\"mt-auto flex flex-wrap gap-2\" style=\"padding-top:14px\">\n              ${P.skills.map((s) => `<span style=\"font-size:9px;padding:4px 8px;border:1px solid ${p.accent}66;color:${p.accent}\">${s}</span>`).join('')}\n            </div>\n          </div>\n        </div>`,\n\n      editorial: (t, pair, p) => `\n        <div class=\"flex h-full flex-col\" style=\"background:${p.paper};color:${p.ink};font-family:${pair.b}\">\n          <div class=\"flex items-center justify-between px-8 py-3\" style=\"font-size:9px;letter-spacing:${pair.caps};text-transform:uppercase;color:${p.muted};border-bottom:1px solid ${p.ink}1f\">\n            <span>${P.first} ${P.last}</span><span>${t.world}</span><span>${P.city}</span>\n          </div>\n          <div class=\"flex items-end justify-between gap-10 px-8 pt-8\">\n            <h1 style=\"font-family:${pair.d};font-size:74px;line-height:0.84;margin:0;letter-spacing:0.01em\">${P.first.toUpperCase()}<br /><span style=\"color:${p.accent}\">${P.last.toUpperCase()}</span></h1>\n            <div style=\"max-width:30ch;padding-bottom:10px\">\n              <div style=\"font-size:9px;letter-spacing:${pair.caps};text-transform:uppercase;color:${p.accent}\">${P.role}</div>\n              <p style=\"margin:8px 0 0;font-size:11px;line-height:1.85;color:${p.muted}\">${P.bio}</p>\n            </div>\n          </div>\n          <div class=\"mt-auto grid grid-cols-3\" style=\"border-top:1px solid ${p.ink}1f\">\n            ${P.projects.map((pr, i) => `\n              <div style=\"padding:16px 20px;border-right:${i < 2 ? '1px solid ' + p.ink + '12' : 'none'}\">\n                <div style=\"font-size:9px;letter-spacing:0.16em;text-transform:uppercase;color:${p.muted}\">${pr.k}</div>\n                <div style=\"font-family:${pair.d};font-size:23px;margin-top:5px\">${pr.t}</div>\n                <div style=\"font-size:10px;color:${p.muted};margin-top:3px\">${pr.y}</div>\n              </div>`).join('')}\n          </div>\n          <div class=\"flex items-center gap-3 px-8 py-3\" style=\"background:${p.dark};color:${p.darkInk}\">\n            <span style=\"font-size:9px;letter-spacing:0.2em;text-transform:uppercase;opacity:0.65\">Skills</span>\n            ${P.skills.map((s) => `<span style=\"font-size:10px;opacity:.9\">${s}</span>`).join('<span style=\"opacity:0.35\">/</span>')}\n          </div>\n        </div>`,\n\n      hud: (t, pair, p) => `\n        <div class=\"relative flex h-full flex-col p-7\" style=\"background:${p.dark};color:${p.darkInk};font-family:${pair.b}\">\n          <div class=\"flex items-start justify-between\">\n            <div>\n              <div style=\"font-size:9px;letter-spacing:${pair.caps};color:${p.darkMuted}\">${t.world} &nbsp;/&nbsp; ${P.city}</div>\n              <h1 style=\"font-family:${pair.d};font-size:38px;line-height:1;margin:9px 0 6px;letter-spacing:0.03em\">${P.first.toUpperCase()} ${P.last.toUpperCase()}</h1>\n              <div style=\"font-size:11px;letter-spacing:0.14em;color:${p.accent};font-family:${pair.d}\">${P.role.toUpperCase()}</div>\n            </div>\n            <div class=\"flex flex-col items-end gap-2\">\n              <div class=\"grid h-12 w-12 place-items-center rounded-full\" style=\"border:1px solid ${p.accent}88;color:${p.accent};font-size:10px;font-family:${pair.d}\">AM</div>\n              <div class=\"flex gap-1\">\n                ${[0, 1, 2, 3].map((i) => `<span style=\"width:14px;height:2px;background:${i < 3 ? p.accent : p.darkMuted};opacity:${i < 3 ? 1 : 0.5}\"></span>`).join('')}\n              </div>\n            </div>\n          </div>\n          <div class=\"mt-6 grid flex-1 grid-cols-[1.35fr_1fr] gap-2.5\">\n            <div class=\"grid grid-rows-2 gap-2.5\">\n              ${P.projects.slice(0, 2).map((pr) => `\n                <div class=\"flex flex-col justify-between\" style=\"background:${p.darkInk}0d;border:1px solid ${p.accent}33;padding:14px;clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px))\">\n                  <span style=\"font-size:9px;letter-spacing:0.16em;text-transform:uppercase;color:${p.darkMuted}\">${pr.k}</span>\n                  <span style=\"font-family:${pair.d};font-size:21px\">${pr.t}</span>\n                  <span style=\"font-size:9px;color:${p.darkMuted}\">${pr.y}</span>\n                </div>`).join('')}\n            </div>\n            <div class=\"flex flex-col gap-2.5\">\n              ${P.projects.slice(2).map((pr) => `\n                <div class=\"flex flex-col justify-between\" style=\"background:${p.accent};color:${p.accentInk};padding:14px;flex:1;clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px))\">\n                  <span style=\"font-size:9px;letter-spacing:0.16em;text-transform:uppercase;opacity:.7\">${pr.k}</span>\n                  <span style=\"font-family:${pair.d};font-size:20px\">${pr.t}</span>\n                </div>`).join('')}\n              <div class=\"flex flex-wrap gap-1.5\" style=\"flex:1;align-content:flex-start;padding-top:2px\">\n                ${P.skills.map((s) => `<span style=\"font-size:9px;padding:3px 7px;border:1px solid ${p.darkMuted}66;color:${p.darkMuted}\">${s}</span>`).join('')}\n              </div>\n            </div>\n          </div>\n        </div>`,\n\n      deco: (t, pair, p) => `\n        <div class=\"flex h-full flex-col items-center justify-center px-10\" style=\"background:${p.dark};color:${p.darkInk};font-family:${pair.b};text-align:center\">\n          <div class=\"grid h-14 w-14 place-items-center rounded-full\" style=\"border:1px solid ${p.accent};color:${p.accent};font-family:${pair.d};font-size:13px;letter-spacing:0.08em\">AM</div>\n          <div class=\"mt-4\" style=\"font-size:9px;letter-spacing:0.42em;text-transform:uppercase;color:${p.darkMuted}\">${t.world}</div>\n          <h1 style=\"font-family:${pair.d};font-size:52px;line-height:1;margin:12px 0 0;letter-spacing:0.06em\">${P.first.toUpperCase()} ${P.last.toUpperCase()}</h1>\n          <div class=\"flex w-full max-w-[520px] items-center gap-3\" style=\"margin-top:16px\">\n            <span style=\"height:1px;flex:1;background:${p.accent}66\"></span>\n            <span style=\"font-size:10px;letter-spacing:0.22em;text-transform:uppercase;color:${p.accent}\">${P.role}</span>\n            <span style=\"height:1px;flex:1;background:${p.accent}66\"></span>\n          </div>\n          <div class=\"mt-7 w-full max-w-[560px]\">\n            ${P.projects.map((pr) => `\n              <div class=\"flex items-baseline justify-between\" style=\"padding:9px 0;border-bottom:1px solid ${p.darkInk}14\">\n                <span style=\"font-family:${pair.d};font-size:16px;letter-spacing:0.04em\">${pr.t}</span>\n                <span style=\"font-size:10px;color:${p.darkMuted}\">${pr.k}</span>\n                <span style=\"font-size:9px;letter-spacing:0.14em;color:${p.accent}\">${pr.y}</span>\n              </div>`).join('')}\n          </div>\n          <div class=\"mt-5 flex items-center gap-3\" style=\"font-size:9px;letter-spacing:0.2em;text-transform:uppercase;color:${p.darkMuted}\">\n            ${P.skills.map((s) => `<span>${s}</span>`).join('<span style=\"opacity:.4\">◆</span>')}\n          </div>\n        </div>`,\n\n      bold: (t, pair, p) => `\n        <div class=\"flex h-full flex-col\" style=\"background:${p.paper};color:${p.ink};font-family:${pair.b}\">\n          <div class=\"relative flex-1 px-8 pt-7\" style=\"background:${p.accent};color:${p.accentInk}\">\n            <div class=\"flex items-center justify-between\" style=\"font-size:9px;letter-spacing:0.24em;text-transform:uppercase;opacity:.75\">\n              <span>${t.world}</span><span>${P.city}</span>\n            </div>\n            <h1 style=\"font-family:${pair.d};font-size:96px;line-height:0.78;margin:14px 0 0;letter-spacing:0.01em\">${P.first.toUpperCase()}<br />${P.last.toUpperCase()}</h1>\n            <div class=\"absolute bottom-6 right-8\" style=\"font-size:10px;letter-spacing:0.2em;text-transform:uppercase;opacity:.8\">${P.role}</div>\n          </div>\n          <div class=\"grid\" style=\"grid-template-columns:1.5fr 1fr\">\n            <div class=\"px-8 py-5\">\n              ${P.projects.map((pr, i) => `\n                <div class=\"flex items-baseline gap-3\" style=\"padding:8px 0;border-bottom:1px solid ${p.ink}16\">\n                  <span style=\"font-family:${pair.d};font-size:12px;color:${p.muted};width:18px\">0${i + 1}</span>\n                  <span style=\"font-family:${pair.d};font-size:22px;flex:1;line-height:1.1\">${pr.t}</span>\n                  <span style=\"font-size:10px;color:${p.muted}\">${pr.y}</span>\n                </div>`).join('')}\n            </div>\n            <div class=\"px-6 py-5\" style=\"background:${p.dark};color:${p.darkInk}\">\n              <p style=\"margin:0;font-size:10.5px;line-height:1.8;opacity:.85\">${P.bio}</p>\n              <div class=\"mt-4 flex flex-wrap gap-1.5\">\n                ${P.skills.map((s) => `<span style=\"font-size:9px;padding:3px 7px;border:1px solid ${p.darkInk}55\">${s}</span>`).join('')}\n              </div>\n            </div>\n          </div>\n        </div>`,\n\n      soft: (t, pair, p) => `\n        <div class=\"flex h-full flex-col gap-3 p-5\" style=\"background:${p.paper};color:${p.ink};font-family:${pair.b}\">\n          <div class=\"flex items-center gap-4 rounded-[22px] px-6 py-5\" style=\"background:${p.surface}\">\n            <span class=\"h-14 w-14 shrink-0 rounded-full\" style=\"background:${p.accent}\"></span>\n            <div>\n              <h1 style=\"font-family:${pair.d};font-size:36px;line-height:1;margin:0\">${P.first} ${P.last}</h1>\n              <p style=\"margin:5px 0 0;font-size:11px;color:${p.muted}\">${P.role} · ${P.city}</p>\n            </div>\n            <span class=\"ml-auto rounded-full px-3 py-1.5\" style=\"background:${p.ink};color:${p.paper};font-size:9px;letter-spacing:0.1em\">AVAILABLE</span>\n          </div>\n          <div class=\"grid flex-1 grid-cols-3 gap-3\">\n            ${P.projects.map((pr, i) => `\n              <div class=\"flex flex-col justify-between rounded-[18px] p-4\" style=\"background:${i === 0 ? p.accent : p.surface};color:${i === 0 ? p.accentInk : p.ink}\">\n                <span style=\"font-size:9px;opacity:.72\">${pr.k}</span>\n                <span style=\"font-family:${pair.d};font-size:20px;line-height:1.08\">${pr.t}</span>\n                <span style=\"font-size:10px;opacity:.72\">${pr.y}</span>\n              </div>`).join('')}\n          </div>\n          <div class=\"flex flex-wrap items-center gap-2\">\n            ${P.skills.map((s) => `<span class=\"rounded-full px-3 py-1.5\" style=\"background:${p.surface};font-size:10px\">${s}</span>`).join('')}\n          </div>\n        </div>`\n    };\n\n    const dest = { paper:'#F9F4F3', ink:'#1D1312', muted:'#8A7A73', accent:'#94110A', accentInk:'#F9F4F3', surface:'#F2E9E4', dark:'#1D1312', darkInk:'#EFEFAC', darkMuted:'#B5A78F' };\n    let family = 'all';\n    let activeId = T[0].id;\n    let query = '';\n\n    const worldsEl = document.getElementById('worlds');\n    const stage = document.getElementById('stage');\n\n    function rowHtml(t) {\n      const pair = PAIRS[t.pair] || PAIRS.ink;\n      return `\n        <button data-id=\"${t.id}\" class=\"row flex w-full items-center gap-2.5 rounded-[10px] px-2 py-[7px] text-left\">\n          <span class=\"h-[24px] w-[24px] shrink-0 rounded-[6px] ring-1 ring-black/10\" style=\"background:linear-gradient(135deg,${t.p.accent} 0 44%, ${t.p.dark} 44% 72%, ${t.p.paper} 72%)\"></span>\n          <span class=\"min-w-0 flex-1\">\n            <span class=\"block truncate text-[12px] font-semibold leading-[1.25]\">${t.name}</span>\n            <span class=\"row-world block truncate text-[9px] uppercase tracking-[0.13em] text-[#98a298]\">${t.world}</span>\n          </span>\n        </button>`;\n    }\n\n    function visible() {\n      return T.filter((t) => (family === 'all' || t.family === family) &&\n        (!query || (t.name + ' ' + t.world).toLowerCase().includes(query)));\n    }\n\n    function paintList() {\n      const list = visible();\n      worldsEl.innerHTML = list.map(rowHtml).join('');\n      worldsEl.querySelectorAll('.row').forEach((row) => {\n        row.addEventListener('click', () => select(row.dataset.id));\n        if (row.dataset.id === activeId) row.classList.add('row-on');\n      });\n      document.getElementById('countLabel').textContent = T.length + ' templates';\n      document.getElementById('footerCount').textContent = list.length + ' shown';\n      if (!list.some((t) => t.id === activeId) && list.length) select(list[0].id);\n    }\n\n    function select(id) {\n      activeId = id;\n      const t = T.find((x) => x.id === id);\n      worldsEl.querySelectorAll('.row').forEach((r) => r.classList.toggle('row-on', r.dataset.id === id));\n      stage.innerHTML = (ARCH[t.arch] || ARCH.ink)(t, PAIRS[t.pair] || PAIRS.ink, t.p);\n      document.getElementById('toolbarName').textContent = t.name;\n      document.getElementById('toolbarWorld').textContent = t.world;\n      document.getElementById('slipName').textContent = t.id;\n      const useBtn = document.getElementById('use');\n      document.getElementById('useLabel').textContent = 'Use template';\n      useBtn.style.background = '#164e42';\n      useBtn.style.color = '#f7f6ef';\n      const row = worldsEl.querySelector(`.row[data-id=\"${id}\"]`);\n      if (row) row.scrollIntoView({ block: 'nearest' });\n    }\n\n    worldsEl.addEventListener('keydown', (e) => {\n      const list = visible();\n      const i = list.findIndex((t) => t.id === activeId);\n      if (e.key === 'ArrowDown' && i < list.length - 1) { e.preventDefault(); select(list[i + 1].id); }\n      if (e.key === 'ArrowUp' && i > 0) { e.preventDefault(); select(list[i - 1].id); }\n    });\n\n    document.getElementById('q').addEventListener('input', (e) => {\n      query = e.target.value.trim().toLowerCase();\n      paintList();\n    });\n\n    document.querySelectorAll('.fam').forEach((btn) => {\n      btn.addEventListener('click', () => {\n        family = btn.dataset.family;\n        document.querySelectorAll('.fam').forEach((b) => {\n          const on = b === btn;\n          b.style.background = on ? '#164e42' : 'transparent';\n          b.style.color = on ? '#f7f6ef' : '#68756c';\n        });\n        paintList();\n      });\n    });\n\n    document.getElementById('motion').addEventListener('click', () => {\n      const dot = document.getElementById('motionDot');\n      const on = dot.style.background !== 'rgb(201, 209, 199)';\n      dot.style.background = on ? '#c9d1c7' : '#76a568';\n      document.getElementById('motion').style.background = on ? '#f5f5ee' : '#eef2e9';\n    });\n\n    document.getElementById('use').addEventListener('click', () => {\n      const t = T.find((x) => x.id === activeId);\n      const btn = document.getElementById('use');\n      document.getElementById('useLabel').textContent = 'Applied: ' + t.name;\n      btn.style.background = '#d7ff70';\n      btn.style.color = '#19352e';\n      btn.classList.remove('stamp');\n      void btn.offsetWidth;\n      btn.classList.add('stamp');\n    });\n\n    paintList();\n    select(activeId);\n  </script>\n</body>",
      "comments": [],
      "created": "2026-10-28T17:13:51.266800+00:00",
      "modified": "2026-10-28T17:22:38.090871+00:00",
      "id": "var_100ec6c3a362",
      "contentHeight": 1000
    },
    "var_bfb2989e1d06": {
      "type": "variant",
      "label": "Konoha Ink — Naruto template",
      "parentId": "var_100ec6c3a362",
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<body class=\"min-h-screen bg-[#F9F4F3] text-[#1D1312] antialiased\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700;800&display=swap');\n\n    :root {\n      --paper: #F9F4F3;\n      --ink: #1D1312;\n      --custard: #EFEFAC;\n      --oxblood: #94110A;\n      --chestnut: #902923;\n      --muted: #8A7A73;\n      --hair: rgba(29, 19, 18, 0.16);\n    }\n\n    body {\n      font-family: 'Shippori Mincho', Georgia, serif;\n      background: var(--paper);\n      color: var(--ink);\n    }\n    .brush-face { font-family: 'Shippori Mincho', Georgia, serif; font-weight: 800; letter-spacing: 0.005em; }\n    .hero-name { font-size: 118px; line-height: 0.88; letter-spacing: -0.012em; }\n\n    .vellum {\n      background-color: #FFFCF7;\n      background-image:\n        radial-gradient(rgba(29, 19, 18, 0.055) 0.6px, transparent 0.7px),\n        radial-gradient(rgba(144, 41, 35, 0.05) 0.5px, transparent 0.7px);\n      background-size: 7px 7px, 11px 11px;\n      background-position: 0 0, 3px 4px;\n    }\n    .grain-dark {\n      background-image:\n        radial-gradient(rgba(239, 239, 172, 0.07) 0.6px, transparent 0.8px);\n      background-size: 6px 6px;\n    }\n\n    .notch {\n      clip-path: polygon(0 0, 100% 0, 100% 100%, 22px 100%, 22px calc(100% - 22px), 0 calc(100% - 22px));\n    }\n    .well {\n      box-shadow: inset 0 4px 22px rgba(0, 0, 0, 0.62), inset 0 0 0 1px rgba(239, 239, 172, 0.26);\n    }\n    .well > .well-ring {\n      box-shadow: inset 0 0 0 1px rgba(239, 239, 172, 0.30);\n    }\n    .torn-edge {\n      clip-path: polygon(0 100%, 0 42%, 3% 72%, 6% 30%, 9% 64%, 12% 24%, 15% 68%, 18% 36%, 21% 76%, 24% 28%, 27% 58%, 30% 20%, 33% 70%, 36% 34%, 39% 62%, 42% 22%, 45% 72%, 48% 38%, 51% 60%, 54% 26%, 57% 66%, 60% 30%, 63% 74%, 66% 34%, 69% 58%, 72% 24%, 75% 68%, 78% 32%, 81% 62%, 84% 22%, 87% 72%, 90% 36%, 93% 60%, 96% 26%, 100% 66%, 100% 100%);\n    }\n\n    .seal-btn { cursor: pointer; }\n    .seal-btn:focus-visible { outline: 2px solid var(--custard); outline-offset: 6px; }\n\n    .inkdot {\n      position: absolute;\n      border-radius: 999px;\n      background: var(--custard);\n      pointer-events: none;\n      mix-blend-mode: screen;\n    }\n\n    .leaf-head { border-bottom: 1px solid var(--hair); }\n    .hover-row:hover .arrow { transform: translate(3px, -3px); }\n    .arrow { transition: transform 220ms cubic-bezier(.2,0,0,1); }\n    .skill-seal { transition: color 180ms linear, background-color 180ms linear; }\n    .skill-seal:hover { background: var(--oxblood); color: var(--custard); }\n  </style>\n<!-- top bar -->\n<header class=\"border-b border-[#1D1312]/12 bg-[#F9F4F3]\" data-kid=\"1\" data-name=\"page header bar\">\n<div class=\"mx-auto flex h-[64px] max-w-[1180px] items-center justify-between px-10\" data-kid=\"1-1\" data-name=\"header layout container\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand lockup container\">\n<span class=\"brush-face grid h-[30px] w-[30px] place-items-center bg-[#94110A] text-[13px] text-[#EFEFAC]\" data-kid=\"1-1-1-1\" data-name=\"Aarav Menon monogram badge\">AM</span>\n<span class=\"text-[14px] tracking-[0.02em]\" data-kid=\"1-1-1-2\" data-name=\"brand name label\">Aarav Menon</span>\n</div>\n<nav class=\"flex items-center gap-8 text-[12px] tracking-[0.08em] text-[#8A7A73]\" data-kid=\"1-1-2\" data-name=\"main navigation\">\n<a class=\"hover:text-[#1D1312]\" data-kid=\"1-1-2-1\" data-name=\"navigation link to Work\" href=\"#work\">Work</a>\n<a class=\"hover:text-[#1D1312]\" data-kid=\"1-1-2-2\" data-name=\"navigation link to Experience\" href=\"#experience\">Experience</a>\n<a class=\"hover:text-[#1D1312]\" data-kid=\"1-1-2-3\" data-name=\"navigation link to Education\" href=\"#education\">Education</a>\n<a class=\"hover:text-[#1D1312]\" data-kid=\"1-1-2-4\" data-name=\"navigation link to Elsewhere\" href=\"#elsewhere\">Elsewhere</a>\n</nav>\n<div class=\"flex items-center gap-2 text-[10px] uppercase tracking-[0.18em] text-[#8A7A73]\" data-kid=\"1-1-3\" data-name=\"availability status indicator\">\n<span class=\"h-[6px] w-[6px] rounded-full bg-[#7C9A5A]\" data-kid=\"1-1-3-1\" data-name=\"availability status dot\"></span> Available for work\n      </div>\n</div>\n</header>\n<!-- hero -->\n<section class=\"relative overflow-hidden bg-[#1D1312] grain-dark\" data-kid=\"2\" data-name=\"hero section with dark ink-wash background\" id=\"top\">\n<div class=\"pointer-events-none absolute inset-0\" data-dynamic=\"true\" data-kid=\"2-1\" data-name=\"ink-wash gradient background layer\" data-reason=\"clip-path is set by GSAP fromTo on load with a fixed inset end value that overrides the authored background container\" id=\"inkwash\" style=\"background:\n      radial-gradient(84% 66% at 24% 30%, rgba(0,0,0,0.44), transparent 62%),\n      radial-gradient(62% 52% at 82% 16%, rgba(239,239,172,0.038), transparent 66%),\n      radial-gradient(72% 58% at 70% 90%, rgba(0,0,0,0.40), transparent 64%),\n      radial-gradient(46% 38% at 10% 82%, rgba(144,41,35,0.035), transparent 72%),\n      radial-gradient(52% 44% at 44% 56%, rgba(29,19,18,0.55), transparent 70%),\n      radial-gradient(38% 32% at 34% 12%, rgba(144,41,35,0.028), transparent 74%),\n      linear-gradient(180deg, #241715 0%, #1D1312 58%, #150E0D 100%);\"></div>\n<div class=\"pointer-events-none absolute inset-0\" data-dynamic=\"true\" data-kid=\"2-2\" data-name=\"hero pointer ink particle trail layer\" data-reason=\"child inkdot spans are dynamically injected and removed by pointermove script\" id=\"herotrail\"></div>\n<div class=\"relative mx-auto max-w-[1180px] px-10 pb-11 pt-20\" data-kid=\"2-3\" data-name=\"hero content wrapper\">\n<div class=\"grid items-start gap-16\" data-kid=\"2-3-1\" data-name=\"hero two-column grid\" style=\"grid-template-columns:minmax(0,1fr) 292px;\">\n<div data-kid=\"2-3-1-1\" data-name=\"hero left text column\">\n<h1 class=\"hero-name brush-face block text-[#F9F4F3]\" data-dynamic=\"true\" data-kid=\"2-3-1-1-1\" data-name=\"hero name headline\" data-reason=\"transform (yPercent) is reinitialized by parallax ScrollTrigger scrub tied to scroll position\" id=\"heroname\">\n<span class=\"block\" data-dynamic=\"true\" data-kid=\"2-3-1-1-1-1\" data-name=\"hero first name line\" data-reason=\"text element is masked by entrance autoAlpha/yPercent keyframe animation run by script on load\">Aarav</span>\n<span class=\"block\" data-dynamic=\"true\" data-kid=\"2-3-1-1-1-2\" data-name=\"hero surname line\" data-reason=\"text element is masked by entrance autoAlpha/yPercent keyframe animation run by script on load\">Menon</span>\n</h1>\n<div class=\"mt-8 flex items-baseline gap-4 text-[12px] tracking-[0.16em] text-[#EFEFAC]/70\" data-dynamic=\"true\" data-hero-fade=\"\" data-kid=\"2-3-1-1-2\" data-name=\"hero role and location row\" data-reason=\"row is masked by entrance autoAlpha/y fade run by script on load\">\n<span class=\"uppercase\" data-kid=\"2-3-1-1-2-1\" data-name=\"hero role label\">Interface designer</span>\n<span class=\"h-[1px] w-10 bg-[#EFEFAC]/30\" data-kid=\"2-3-1-1-2-2\" data-name=\"role-to-location divider line\"></span>\n<span class=\"uppercase\" data-kid=\"2-3-1-1-2-3\" data-name=\"hero location label\">Bengaluru</span>\n</div>\n<p class=\"mt-7 max-w-[46ch] text-[15px] leading-[1.95] text-[#F9F4F3]/62\" data-dynamic=\"true\" data-hero-fade=\"\" data-kid=\"2-3-1-1-3\" data-name=\"hero bio paragraph\" data-reason=\"paragraph is masked by entrance autoAlpha/y fade run by script on load\">\n            I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n          </p>\n<div class=\"mt-12 flex items-center gap-5\" data-kid=\"2-3-1-1-4\" data-name=\"seal CTA row\">\n<button aria-label=\"Stamp the portfolio seal\" aria-pressed=\"false\" class=\"seal-btn relative grid h-[86px] w-[86px] place-items-center bg-[#94110A] text-[#EFEFAC]\" data-dynamic=\"true\" data-kid=\"2-3-1-1-4-1\" data-name=\"portfolio stamp seal button\" data-reason=\"border-radius style, box-shadow, and aria-pressed attribute are reinitialized by click handler script\" id=\"seal\" type=\"button\">\n<span class=\"pointer-events-none absolute inset-0 border border-[#EFEFAC]/0\" data-dynamic=\"true\" data-kid=\"2-3-1-1-4-1-1\" data-name=\"seal press ring outline\" data-reason=\"border-color is reinitialized to a JS-computed value on seal click\" id=\"sealRing\"></span>\n<span class=\"brush-face\" data-kid=\"2-3-1-1-4-1-2\" data-name=\"seal initials label\" style=\"font-size:26px; line-height:1;\">AM</span>\n<span class=\"pointer-events-none absolute inset-0 border border-[#EFEFAC] opacity-0\" data-dynamic=\"true\" data-kid=\"2-3-1-1-4-1-3\" data-name=\"seal press ripple outline\" data-reason=\"scale and opacity are reinitialized to fresh JS values on seal click\" id=\"ripple\"></span>\n</button>\n<div class=\"flex h-[86px] items-center gap-4\" data-kid=\"2-3-1-1-4-2\" data-name=\"portfolio caption column\">\n<span class=\"h-[52px] w-[1px] bg-[#EFEFAC]/30\" data-kid=\"2-3-1-1-4-2-1\" data-name=\"seal-to-caption divider line\"></span>\n<span class=\"text-[9px] uppercase tracking-[0.32em] text-[#EFEFAC]/60\" data-kid=\"2-3-1-1-4-2-2\" data-name=\"vertical portfolio caption\" style=\"writing-mode:vertical-rl;\">Portfolio</span>\n</div>\n</div>\n</div>\n<div class=\"relative\" data-kid=\"2-3-1-2\" data-name=\"hero portrait column\">\n<div class=\"absolute -left-[10px] -top-[10px] h-full w-full border border-[#EFEFAC]/18\" data-kid=\"2-3-1-2-1\" data-name=\"portrait offset frame border\"></div>\n<div class=\"well relative h-[368px] w-full overflow-hidden bg-[#0F0A09]\" data-kid=\"2-3-1-2-2\" data-name=\"portrait image well\">\n<img alt=\"Ink-wash portrait of Aarav Menon, original artwork\" class=\"h-full w-full object-cover\" data-kid=\"2-3-1-2-2-1\" data-name=\"ink-wash portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/163f8105e6df4614bea53a0f08eea69d.jpg\" style=\"filter:contrast(1.06) saturate(0.9);\"/>\n<div class=\"well-ring pointer-events-none absolute inset-0 z-20\" data-kid=\"2-3-1-2-2-3\" data-name=\"portrait well hairline frame\"></div>\n<div class=\"pointer-events-none absolute inset-0\" data-kid=\"2-3-1-2-2-2\" data-name=\"portrait bottom vignette overlay\" style=\"background:linear-gradient(180deg, rgba(29,19,18,0.18) 0%, rgba(29,19,18,0.55) 100%);\"></div>\n</div>\n<div class=\"mt-4 flex items-baseline justify-between text-[10px] uppercase tracking-[0.18em] text-[#EFEFAC]/45\" data-kid=\"2-3-1-2-3\" data-name=\"portrait caption bar\">\n<span data-kid=\"2-3-1-2-3-1\" data-name=\"portrait name caption\">Aarav Menon</span><span data-kid=\"2-3-1-2-3-2\" data-name=\"portrait year caption\">2026</span>\n</div>\n</div>\n</div>\n</div>\n<div class=\"pointer-events-none absolute inset-x-0 bottom-0 h-[22px] bg-[#F9F4F3] torn-edge\" data-kid=\"2-4\" data-name=\"torn top edge for next section\"></div>\n</section>\n<!-- biography + skills -->\n<section class=\"mx-auto max-w-[1180px] px-10 pt-16\" data-kid=\"3\" data-name=\"bio and skills section\">\n<div class=\"grid gap-14\" data-kid=\"3-1\" data-name=\"bio skills grid\" style=\"grid-template-columns:minmax(0,1.15fr) minmax(0,0.85fr);\">\n<div data-kid=\"3-1-1\" data-name=\"bio left column\">\n<p class=\"text-[19px] leading-[1.85] text-[#1D1312]\" data-kid=\"3-1-1-1\" data-name=\"bio lead paragraph\">\n          Eight years of product work, most of it on booking and payment flows where a wrong tap costs someone a trip.\n        </p>\n<p class=\"mt-6 text-[14px] leading-[1.95] text-[#6E5F58]\" data-kid=\"3-1-1-2\" data-name=\"bio detail paragraph\">\n          I started on digital editions of a ninety-year-old imprint and never lost the habit of setting type carefully. These days I build design systems for teams of four to forty, and I still write the interaction specs myself.\n        </p>\n<a class=\"arrow-group mt-8 inline-flex items-center gap-2 border-b border-[#94110A] pb-1 text-[12px] tracking-[0.12em] uppercase text-[#94110A]\" data-kid=\"3-1-1-3\" data-name=\"selected work anchor link\" href=\"#work\">\n          Selected work <span class=\"arrow\" data-kid=\"3-1-1-3-1\" data-name=\"link arrow icon\">↗</span>\n</a>\n</div>\n<div class=\"pt-1\" data-kid=\"3-1-2\" data-name=\"skills right column\">\n<h2 class=\"text-[11px] uppercase tracking-[0.26em] text-[#8A7A73]\" data-kid=\"3-1-2-1\" data-name=\"skills section heading\">Skills</h2>\n<ul class=\"mt-5 flex flex-wrap gap-[7px]\" data-kid=\"3-1-2-2\" data-name=\"skills tag list\">\n<li class=\"skill-seal border border-[#94110A]/45 px-[10px] py-[6px] text-[11px] tracking-[0.08em] text-[#1D1312]\" data-kid=\"3-1-2-2-1\" data-name=\"skills tag Design systems\">Design systems</li>\n<li class=\"skill-seal border border-[#94110A]/45 px-[10px] py-[6px] text-[11px] tracking-[0.08em] text-[#1D1312]\" data-kid=\"3-1-2-2-2\" data-name=\"skills tag Interaction design\">Interaction design</li>\n<li class=\"skill-seal border border-[#94110A]/45 px-[10px] py-[6px] text-[11px] tracking-[0.08em] text-[#1D1312]\" data-kid=\"3-1-2-2-3\" data-name=\"skills tag Prototyping\">Prototyping</li>\n<li class=\"skill-seal border border-[#94110A]/45 px-[10px] py-[6px] text-[11px] tracking-[0.08em] text-[#1D1312]\" data-kid=\"3-1-2-2-4\" data-name=\"skills tag Motion\">Motion</li>\n<li class=\"skill-seal border border-[#94110A]/45 px-[10px] py-[6px] text-[11px] tracking-[0.08em] text-[#1D1312]\" data-kid=\"3-1-2-2-5\" data-name=\"skills tag Type\">Type</li>\n<li class=\"skill-seal border border-[#94110A]/45 px-[10px] py-[6px] text-[11px] tracking-[0.08em] text-[#1D1312]\" data-kid=\"3-1-2-2-6\" data-name=\"skills tag Research\">Research</li>\n</ul>\n<div class=\"mt-8 border-t border-[#1D1312]/12 pt-5 text-[11px] leading-[1.9] text-[#8A7A73]\" data-kid=\"3-1-2-3\" data-name=\"current role footer\">\n          Fintrail · Senior product designer<br data-kid=\"3-1-2-3-1\" data-name=\"line break\"/>\n          Bengaluru, IST\n        </div>\n</div>\n</div>\n</section>\n<!-- selected work -->\n<section class=\"mx-auto max-w-[1180px] px-10 pt-20\" data-kid=\"4\" data-name=\"selected work section\" id=\"work\">\n<div class=\"flex items-end justify-between\" data-kid=\"4-1\" data-name=\"work section header\">\n<div data-kid=\"4-1-1\" data-name=\"work title group\">\n<h2 class=\"brush-face text-[34px] leading-none text-[#1D1312]\" data-kid=\"4-1-1-1\" data-name=\"work section heading\">Selected work</h2>\n<svg aria-hidden=\"true\" class=\"brush-underline mt-2 block\" data-kid=\"4-1-1-2\" data-name=\"brush underline divider\" fill=\"none\" height=\"12\" viewbox=\"0 0 224 12\" width=\"224\">\n<path d=\"M2 8C36 2 74 10 118 5C158 1 190 7 222 4\" stroke=\"#94110A\" stroke-linecap=\"round\" stroke-width=\"3\"></path>\n</svg>\n</div>\n<span class=\"pb-1 text-[11px] tracking-[0.16em] uppercase text-[#8A7A73]\" data-kid=\"4-1-2\" data-name=\"work year range caption\">2023 — 2025</span>\n</div>\n<div class=\"mt-10 space-y-7\" data-kid=\"4-2\" data-name=\"work project list\">\n<!-- Kestrel -->\n<article class=\"leaf-wrap\" data-dynamic=\"true\" data-kid=\"4-2-1\" data-name=\"Kestrel project card\" data-reason=\"clipPath is set to inset and re-animated by a scroll trigger unrolling effect\" style=\"overflow:hidden;\">\n<div class=\"vellum notch grid gap-10 border border-[#1D1312]/14 p-8\" data-kid=\"4-2-1-1\" data-name=\"Kestrel card body\" style=\"grid-template-columns:minmax(0,1.08fr) minmax(0,0.92fr);\">\n<div class=\"flex flex-col justify-between\" data-kid=\"4-2-1-1-1\" data-name=\"Kestrel text column\">\n<div data-kid=\"4-2-1-1-1-1\" data-name=\"Kestrel title group\">\n<div class=\"leaf-head flex items-baseline justify-between pb-3 text-[10px] uppercase tracking-[0.18em] text-[#8A7A73]\" data-kid=\"4-2-1-1-1-1-1\" data-name=\"Kestrel meta row\">\n<span data-kid=\"4-2-1-1-1-1-1-1\" data-name=\"Kestrel category label\">Design system</span><span data-kid=\"4-2-1-1-1-1-1-2\" data-name=\"Kestrel year label\">2025</span>\n</div>\n<h3 class=\"mt-6 text-[38px] leading-[1.06] text-[#1D1312]\" data-kid=\"4-2-1-1-1-1-2\" data-name=\"Kestrel project heading\">Kestrel</h3>\n<p class=\"mt-4 max-w-[42ch] text-[13.5px] leading-[1.9] text-[#6E5F58]\" data-kid=\"4-2-1-1-1-1-3\" data-name=\"Kestrel project description\">\n                A 240-component library and the token pipeline behind it, adopted by four product teams.\n              </p>\n</div>\n<a class=\"hover-row mt-8 inline-flex w-fit items-center gap-2 text-[11px] uppercase tracking-[0.14em] text-[#94110A]\" data-kid=\"4-2-1-1-1-2\" data-name=\"view Kestrel project link\" href=\"#\">\n              View project <span class=\"arrow\" data-kid=\"4-2-1-1-1-2-1\" data-name=\"project link arrow icon\">↗</span>\n</a>\n</div>\n<div class=\"relative min-h-[300px]\" data-kid=\"4-2-1-1-2\" data-name=\"Kestrel image frame\">\n<div class=\"pointer-events-none absolute inset-0 z-10 border border-[#1D1312]/12\" data-kid=\"4-2-1-1-2-1\" data-name=\"Kestrel image border overlay\"></div>\n<img alt=\"Ukiyo-e style landscape print, original artwork\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"4-2-1-1-2-2\" data-name=\"Kestrel project artwork\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/ba55f2638a78421eb64e2f6ebace0b3e.jpg\" style=\"filter:saturate(0.92);\"/>\n</div>\n</div>\n</article>\n<!-- Tide & Timber -->\n<article class=\"leaf-wrap\" data-dynamic=\"true\" data-kid=\"4-2-2\" data-name=\"Tide and Timber project card\" data-reason=\"clipPath is set to inset and re-animated by a scroll trigger unrolling effect\" style=\"overflow:hidden;\">\n<div class=\"vellum notch grid gap-10 border border-[#1D1312]/14 p-8\" data-kid=\"4-2-2-1\" data-name=\"Tide and Timber card body\" style=\"grid-template-columns:minmax(0,1fr) 190px;\">\n<div data-kid=\"4-2-2-1-1\" data-name=\"Tide and Timber text column\">\n<div class=\"leaf-head flex items-baseline justify-between pb-3 text-[10px] uppercase tracking-[0.18em] text-[#8A7A73]\" data-kid=\"4-2-2-1-1-1\" data-name=\"Tide and Timber meta row\">\n<span data-kid=\"4-2-2-1-1-1-1\" data-name=\"Tide and Timber category label\">Booking app</span><span data-kid=\"4-2-2-1-1-1-2\" data-name=\"Tide and Timber year label\">2024</span>\n</div>\n<h3 class=\"mt-6 text-[38px] leading-[1.06] text-[#1D1312]\" data-kid=\"4-2-2-1-1-2\" data-name=\"Tide and Timber project heading\">Tide &amp; Timber</h3>\n<p class=\"mt-4 max-w-[54ch] text-[13.5px] leading-[1.9] text-[#6E5F58]\" data-kid=\"4-2-2-1-1-3\" data-name=\"Tide and Timber project description\">\n              Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.\n            </p>\n<a class=\"hover-row mt-8 inline-flex w-fit items-center gap-2 text-[11px] uppercase tracking-[0.14em] text-[#94110A]\" data-kid=\"4-2-2-1-1-4\" data-name=\"view Tide and Timber project link\" href=\"#\">\n              View project <span class=\"arrow\" data-kid=\"4-2-2-1-1-4-1\" data-name=\"project link arrow icon\">↗</span>\n</a>\n</div>\n<div class=\"flex flex-col items-center justify-center gap-4\" data-kid=\"4-2-2-1-2\" data-name=\"cabin diagram group\">\n<div class=\"grid grid-cols-4 gap-[7px]\" data-kid=\"4-2-2-1-2-1\" data-name=\"cabin grid\">\n<span class=\"h-[16px] w-[20px] border border-[#1D1312]/30\" data-kid=\"4-2-2-1-2-1-1\" data-name=\"cabin grid empty cell\"></span>\n<span class=\"h-[16px] w-[20px] border border-[#1D1312]/30 bg-[#94110A]/75\" data-kid=\"4-2-2-1-2-1-2\" data-name=\"cabin grid booked cell\"></span>\n<span class=\"h-[16px] w-[20px] border border-[#1D1312]/30\" data-kid=\"4-2-2-1-2-1-3\" data-name=\"cabin grid empty cell\"></span>\n<span class=\"h-[16px] w-[20px] border border-[#1D1312]/30\" data-kid=\"4-2-2-1-2-1-4\" data-name=\"cabin grid empty cell\"></span>\n<span class=\"h-[16px] w-[20px] border border-[#1D1312]/30\" data-kid=\"4-2-2-1-2-1-5\" data-name=\"cabin grid empty cell\"></span>\n<span class=\"h-[16px] w-[20px] border border-[#1D1312]/30\" data-kid=\"4-2-2-1-2-1-6\" data-name=\"cabin grid empty cell\"></span>\n<span class=\"h-[16px] w-[20px] border border-[#1D1312]/30 bg-[#94110A]/75\" data-kid=\"4-2-2-1-2-1-7\" data-name=\"cabin grid booked cell\"></span>\n<span class=\"h-[16px] w-[20px] border border-dashed border-[#1D1312]/40\" data-kid=\"4-2-2-1-2-1-8\" data-name=\"cabin grid unavailable cell\"></span>\n<span class=\"h-[16px] w-[20px] border border-[#1D1312]/30\" data-kid=\"4-2-2-1-2-1-9\" data-name=\"cabin grid empty cell\"></span>\n<span class=\"h-[16px] w-[20px] border border-[#1D1312]/30\" data-kid=\"4-2-2-1-2-1-10\" data-name=\"cabin grid empty cell\"></span>\n<span class=\"h-[16px] w-[20px] border border-[#1D1312]/30 bg-[#94110A]/75\" data-kid=\"4-2-2-1-2-1-11\" data-name=\"cabin grid booked cell\"></span>\n<span class=\"h-[16px] w-[20px] border border-[#1D1312]/30\" data-kid=\"4-2-2-1-2-1-12\" data-name=\"cabin grid empty cell\"></span>\n</div>\n<div class=\"flex w-full items-center justify-between text-[8px] uppercase tracking-[0.16em] text-[#8A7A73]\" data-kid=\"4-2-2-1-2-2\" data-name=\"cabin diagram legend\">\n<span data-kid=\"4-2-2-1-2-2-1\" data-name=\"legend deck label\">Deck B</span><span data-kid=\"4-2-2-1-2-2-2\" data-name=\"legend cabin count label\">12 cabins</span>\n</div>\n</div>\n</div>\n</article>\n<!-- Loom Audio -->\n<article class=\"leaf-wrap\" data-dynamic=\"true\" data-kid=\"4-2-3\" data-name=\"Loom Audio project card\" data-reason=\"clipPath is set to inset and re-animated by a scroll trigger unrolling effect\" style=\"overflow:hidden;\">\n<div class=\"vellum notch grid gap-10 border border-[#1D1312]/14 p-8\" data-kid=\"4-2-3-1\" data-name=\"Loom Audio card body\" style=\"grid-template-columns:minmax(0,1fr) 220px;\">\n<div data-kid=\"4-2-3-1-1\" data-name=\"Loom Audio text column\">\n<div class=\"leaf-head flex items-baseline justify-between pb-3 text-[10px] uppercase tracking-[0.18em] text-[#8A7A73]\" data-kid=\"4-2-3-1-1-1\" data-name=\"Loom Audio meta row\">\n<span data-kid=\"4-2-3-1-1-1-1\" data-name=\"Loom Audio category label\">Editorial platform</span><span data-kid=\"4-2-3-1-1-1-2\" data-name=\"Loom Audio year label\">2023</span>\n</div>\n<h3 class=\"mt-6 text-[38px] leading-[1.06] text-[#1D1312]\" data-kid=\"4-2-3-1-1-2\" data-name=\"Loom Audio project heading\">Loom Audio</h3>\n<p class=\"mt-4 max-w-[54ch] text-[13.5px] leading-[1.9] text-[#6E5F58]\" data-kid=\"4-2-3-1-1-3\" data-name=\"Loom Audio project description\">\n              A reading surface for long-form audio transcripts, built for one-handed use.\n            </p>\n<a class=\"hover-row mt-8 inline-flex w-fit items-center gap-2 text-[11px] uppercase tracking-[0.14em] text-[#94110A]\" data-kid=\"4-2-3-1-1-4\" data-name=\"view Loom Audio project link\" href=\"#\">\n              View project <span class=\"arrow\" data-kid=\"4-2-3-1-1-4-1\" data-name=\"project link arrow icon\">↗</span>\n</a>\n</div>\n<div aria-hidden=\"true\" class=\"flex flex-col justify-center gap-[5px]\" data-kid=\"4-2-3-1-2\" data-name=\"transcript line diagram\">\n<span class=\"h-[2px] w-full bg-[#1D1312]/18\" data-kid=\"4-2-3-1-2-1\" data-name=\"transcript text line\"></span>\n<span class=\"h-[2px] w-[86%] bg-[#1D1312]/18\" data-kid=\"4-2-3-1-2-2\" data-name=\"transcript text line\"></span>\n<span class=\"h-[2px] w-[94%] bg-[#1D1312]/22\" data-kid=\"4-2-3-1-2-3\" data-name=\"transcript text line\"></span>\n<span class=\"h-[2px] w-[72%] bg-[#1D1312]/18\" data-kid=\"4-2-3-1-2-4\" data-name=\"transcript text line\"></span>\n<span class=\"h-[2px] w-[88%] bg-[#94110A]/40\" data-kid=\"4-2-3-1-2-5\" data-name=\"transcript highlighted line\"></span>\n<span class=\"h-[2px] w-[54%] bg-[#1D1312]/18\" data-kid=\"4-2-3-1-2-6\" data-name=\"transcript text line\"></span>\n</div>\n</div>\n</article>\n</div>\n</section>\n<!-- experience -->\n<section class=\"mt-24 bg-[#1D1312] grain-dark\" data-kid=\"5\" data-name=\"experience section\" id=\"experience\">\n<div class=\"mx-auto max-w-[1180px] px-10 py-20\" data-kid=\"5-1\" data-name=\"experience section container\">\n<div class=\"flex items-end justify-between\" data-kid=\"5-1-1\" data-name=\"experience section header\">\n<div data-kid=\"5-1-1-1\" data-name=\"experience title group\">\n<h2 class=\"brush-face text-[34px] leading-none text-[#F9F4F3]\" data-kid=\"5-1-1-1-1\" data-name=\"experience section heading\">Experience</h2>\n<svg aria-hidden=\"true\" class=\"brush-underline mt-2 block\" data-kid=\"5-1-1-1-2\" data-name=\"brush underline divider\" fill=\"none\" height=\"12\" viewbox=\"0 0 196 12\" width=\"196\">\n<path d=\"M2 8C32 3 66 10 104 5C138 2 168 7 194 4\" stroke=\"#902923\" stroke-linecap=\"round\" stroke-width=\"3\"></path>\n</svg>\n</div>\n<span class=\"pb-1 text-[11px] tracking-[0.16em] uppercase text-[#EFEFAC]/45\" data-kid=\"5-1-1-2\" data-name=\"experience year range caption\">2017 — present</span>\n</div>\n<div class=\"mt-12\" data-kid=\"5-1-2\" data-name=\"experience rows container\">\n<div class=\"grid items-baseline gap-8 border-t border-[#EFEFAC]/16 py-8\" data-kid=\"5-1-2-1\" data-name=\"Fintrail experience row\" style=\"grid-template-columns:230px minmax(0,1fr) 130px;\">\n<h3 class=\"text-[22px] leading-tight text-[#F9F4F3]\" data-kid=\"5-1-2-1-1\" data-name=\"Fintrail company name\">Fintrail</h3>\n<div data-kid=\"5-1-2-1-2\" data-name=\"Fintrail role details container\">\n<div class=\"text-[12px] uppercase tracking-[0.14em] text-[#EFEFAC]/65\" data-kid=\"5-1-2-1-2-1\" data-name=\"Fintrail role title\">Senior product designer</div>\n<p class=\"mt-2 text-[13px] leading-[1.9] text-[#F9F4F3]/55\" data-kid=\"5-1-2-1-2-2\" data-name=\"Fintrail role description\">Payments, onboarding and the design system.</p>\n</div>\n<span class=\"text-right text-[11px] tracking-[0.12em] text-[#EFEFAC]/45\" data-kid=\"5-1-2-1-3\" data-name=\"Fintrail date range\">2022 — present</span>\n</div>\n<div class=\"grid items-baseline gap-8 border-t border-[#EFEFAC]/16 py-8\" data-kid=\"5-1-2-2\" data-name=\"Sundial Studio experience row\" style=\"grid-template-columns:230px minmax(0,1fr) 130px;\">\n<h3 class=\"text-[22px] leading-tight text-[#F9F4F3]\" data-kid=\"5-1-2-2-1\" data-name=\"Sundial Studio company name\">Sundial Studio</h3>\n<div data-kid=\"5-1-2-2-2\" data-name=\"Sundial Studio role details container\">\n<div class=\"text-[12px] uppercase tracking-[0.14em] text-[#EFEFAC]/65\" data-kid=\"5-1-2-2-2-1\" data-name=\"Sundial Studio role title\">Product designer</div>\n<p class=\"mt-2 text-[13px] leading-[1.9] text-[#F9F4F3]/55\" data-kid=\"5-1-2-2-2-2\" data-name=\"Sundial Studio role description\">Booking and travel products for three clients.</p>\n</div>\n<span class=\"text-right text-[11px] tracking-[0.12em] text-[#EFEFAC]/45\" data-kid=\"5-1-2-2-3\" data-name=\"Sundial Studio date range\">2019 — 2022</span>\n</div>\n<div class=\"grid items-baseline gap-8 border-y border-[#EFEFAC]/16 py-8\" data-kid=\"5-1-2-3\" data-name=\"Pageturn Press experience row\" style=\"grid-template-columns:230px minmax(0,1fr) 130px;\">\n<h3 class=\"text-[22px] leading-tight text-[#F9F4F3]\" data-kid=\"5-1-2-3-1\" data-name=\"Pageturn Press company name\">Pageturn Press</h3>\n<div data-kid=\"5-1-2-3-2\" data-name=\"Pageturn Press role details container\">\n<div class=\"text-[12px] uppercase tracking-[0.14em] text-[#EFEFAC]/65\" data-kid=\"5-1-2-3-2-1\" data-name=\"Pageturn Press role title\">Interface designer</div>\n<p class=\"mt-2 text-[13px] leading-[1.9] text-[#F9F4F3]/55\" data-kid=\"5-1-2-3-2-2\" data-name=\"Pageturn Press role description\">Digital editions of a 90-year-old imprint.</p>\n</div>\n<span class=\"text-right text-[11px] tracking-[0.12em] text-[#EFEFAC]/45\" data-kid=\"5-1-2-3-3\" data-name=\"Pageturn Press date range\">2017 — 2019</span>\n</div>\n</div>\n</div>\n</section>\n<!-- education + elsewhere -->\n<section class=\"mx-auto max-w-[1180px] px-10 py-20\" data-kid=\"6\" data-name=\"education and elsewhere section\" id=\"education\">\n<div class=\"grid gap-16\" data-kid=\"6-1\" data-name=\"education elsewhere grid\" style=\"grid-template-columns:minmax(0,1fr) 300px;\">\n<div data-kid=\"6-1-1\" data-name=\"education column\">\n<h2 class=\"brush-face text-[28px] leading-none text-[#1D1312]\" data-kid=\"6-1-1-1\" data-name=\"education section heading\">Education</h2>\n<div class=\"mt-8\" data-kid=\"6-1-1-2\" data-name=\"education rows container\">\n<div class=\"flex items-baseline justify-between border-t border-[#1D1312]/14 py-5\" data-kid=\"6-1-1-2-1\" data-name=\"National Institute of Design row\">\n<div data-kid=\"6-1-1-2-1-1\" data-name=\"NID school name container\">\n<h3 class=\"text-[17px] text-[#1D1312]\" data-kid=\"6-1-1-2-1-1-1\" data-name=\"National Institute of Design name\">National Institute of Design</h3>\n<p class=\"mt-1 text-[12px] text-[#8A7A73]\" data-kid=\"6-1-1-2-1-1-2\" data-name=\"NID field of study\">Interaction design</p>\n</div>\n<span class=\"text-[11px] tracking-[0.12em] text-[#8A7A73]\" data-kid=\"6-1-1-2-1-2\" data-name=\"NID years\">2015 — 2017</span>\n</div>\n<div class=\"flex items-baseline justify-between border-y border-[#1D1312]/14 py-5\" data-kid=\"6-1-1-2-2\" data-name=\"Srishti Institute row\">\n<div data-kid=\"6-1-1-2-2-1\" data-name=\"Srishti school name container\">\n<h3 class=\"text-[17px] text-[#1D1312]\" data-kid=\"6-1-1-2-2-1-1\" data-name=\"Srishti Institute name\">Srishti Institute</h3>\n<p class=\"mt-1 text-[12px] text-[#8A7A73]\" data-kid=\"6-1-1-2-2-1-2\" data-name=\"Srishti field of study\">Foundation studies</p>\n</div>\n<span class=\"text-[11px] tracking-[0.12em] text-[#8A7A73]\" data-kid=\"6-1-1-2-2-2\" data-name=\"Srishti years\">2013 — 2015</span>\n</div>\n</div>\n</div>\n<div data-kid=\"6-1-2\" data-name=\"elsewhere column\" id=\"elsewhere\">\n<h2 class=\"brush-face text-[28px] leading-none text-[#1D1312]\" data-kid=\"6-1-2-1\" data-name=\"elsewhere section heading\">Elsewhere</h2>\n<ul class=\"mt-8\" data-kid=\"6-1-2-2\" data-name=\"elsewhere list\">\n<li data-kid=\"6-1-2-2-1\" data-name=\"GitHub list item\"><a class=\"hover-row flex items-center justify-between border-t border-[#1D1312]/14 py-4 text-[13px] text-[#1D1312]\" data-kid=\"6-1-2-2-1-1\" data-name=\"GitHub profile link\" href=\"#\">GitHub <span class=\"arrow text-[#94110A]\" data-kid=\"6-1-2-2-1-1-1\" data-name=\"GitHub link arrow icon\">↗</span></a></li>\n<li data-kid=\"6-1-2-2-2\" data-name=\"Dribbble list item\"><a class=\"hover-row flex items-center justify-between border-t border-[#1D1312]/14 py-4 text-[13px] text-[#1D1312]\" data-kid=\"6-1-2-2-2-1\" data-name=\"Dribbble profile link\" href=\"#\">Dribbble <span class=\"arrow text-[#94110A]\" data-kid=\"6-1-2-2-2-1-1\" data-name=\"Dribbble link arrow icon\">↗</span></a></li>\n<li data-kid=\"6-1-2-2-3\" data-name=\"LinkedIn list item\"><a class=\"hover-row flex items-center justify-between border-t border-[#1D1312]/14 py-4 text-[13px] text-[#1D1312]\" data-kid=\"6-1-2-2-3-1\" data-name=\"LinkedIn profile link\" href=\"#\">LinkedIn <span class=\"arrow text-[#94110A]\" data-kid=\"6-1-2-2-3-1-1\" data-name=\"LinkedIn link arrow icon\">↗</span></a></li>\n<li data-kid=\"6-1-2-2-4\" data-name=\"Email list item\"><a class=\"hover-row flex items-center justify-between border-y border-[#1D1312]/14 py-4 text-[13px] text-[#1D1312]\" data-kid=\"6-1-2-2-4-1\" data-name=\"contact email link\" href=\"#\">Email <span class=\"arrow text-[#94110A]\" data-kid=\"6-1-2-2-4-1-1\" data-name=\"Email link arrow icon\">↗</span></a></li>\n</ul>\n</div>\n</div>\n</section>\n<footer class=\"border-t border-[#1D1312]/12\" data-kid=\"7\" data-name=\"page footer\">\n<div class=\"mx-auto flex max-w-[1180px] items-center justify-between px-10 py-7 text-[11px] tracking-[0.1em] text-[#8A7A73]\" data-kid=\"7-1\" data-name=\"footer layout container\">\n<span data-kid=\"7-1-1\" data-name=\"footer location tag\">Aarav Menon — Bengaluru</span>\n<span class=\"flex items-center gap-2\" data-kid=\"7-1-2\" data-name=\"footer studio brand wrapper\"><span class=\"brush-face grid h-[22px] w-[22px] place-items-center bg-[#94110A] text-[9px] text-[#EFEFAC]\" data-kid=\"7-1-2-1\" data-name=\"Konoha Ink monogram badge\">AM</span> Konoha Ink</span>\n<a class=\"hover:text-[#1D1312]\" data-kid=\"7-1-3\" data-name=\"back to top link\" href=\"#top\">Back to top ↑</a>\n</div>\n</footer>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n    /* 1. ink wash uncovered by a soft edge on load */\n    gsap.fromTo('#inkwash',\n      { clipPath: 'inset(0 100% 0 0)' },\n      { clipPath: 'inset(0 0% 0 0)', duration: 1.25, ease: 'power2.inOut' }\n    );\n\n    gsap.fromTo('#heroname span',\n      { yPercent: 18, autoAlpha: 0 },\n      { yPercent: 0, autoAlpha: 1, duration: 1.1, ease: 'power3.out', stagger: 0.12, delay: 0.35 }\n    );\n\n    gsap.fromTo('[data-hero-fade]',\n      { y: 16, autoAlpha: 0 },\n      { y: 0, autoAlpha: 1, duration: 0.9, ease: 'power2.out', stagger: 0.1, delay: 0.6 }\n    );\n\n    /* 2. hanko seal — press, ripple, permanent ring */\n    const seal = document.getElementById('seal');\n    const ring = document.getElementById('sealRing');\n    const ripple = document.getElementById('ripple');\n    let stamped = false;\n\n    seal.addEventListener('click', () => {\n      stamped = !stamped;\n      seal.setAttribute('aria-pressed', String(stamped));\n      gsap.timeline()\n        .to(seal, { scaleY: 0.7, scaleX: 1.1, rotate: -5, duration: 0.11, ease: 'power2.in' })\n        .to(seal, { scaleY: 1, scaleX: 1, rotate: 0, duration: 0.55, ease: 'elastic.out(1, 0.42)' });\n\n      gsap.fromTo(ripple,\n        { scale: 0.7, opacity: 0.85 },\n        { scale: 2.6, opacity: 0, duration: 0.9, ease: 'power2.out' }\n      );\n\n      gsap.to(ring, {\n        borderColor: stamped ? 'rgba(239,239,172,0.9)' : 'rgba(239,239,172,0)',\n        duration: 0.35,\n        ease: 'power1.out'\n      });\n      gsap.to(seal, { boxShadow: stamped ? '0 0 0 6px rgba(239,239,172,0.14)' : '0 0 0 0 rgba(239,239,172,0)', duration: 0.4 });\n    });\n\n    /* 3. brush underlines drawn on first view */\n    document.querySelectorAll('.brush-underline path').forEach((path) => {\n      const len = path.getTotalLength();\n      gsap.set(path, { strokeDasharray: len, strokeDashoffset: len });\n      ScrollTrigger.create({\n        trigger: path,\n        start: 'top 88%',\n        once: true,\n        onEnter: () => gsap.to(path, { strokeDashoffset: 0, duration: 1.05, ease: 'power2.out' })\n      });\n    });\n\n    /* 4. project leaves unroll from their top edge */\n    gsap.utils.toArray('.leaf-wrap').forEach((wrap, i) => {\n      gsap.set(wrap, { clipPath: 'inset(0 0 100% 0)' });\n      ScrollTrigger.create({\n        trigger: wrap,\n        start: 'top 88%',\n        once: true,\n        onEnter: () => gsap.to(wrap, {\n          clipPath: 'inset(0 0 0% 0)',\n          duration: 1.05,\n          delay: (i % 3) * 0.08,\n          ease: 'power3.out'\n        })\n      });\n    });\n\n    /* 5. ink trail in the hero */\n    const trail = document.getElementById('herotrail');\n    const hero = document.getElementById('top');\n    let particles = [];\n    let last = 0;\n\n    hero.addEventListener('pointermove', (e) => {\n      const now = performance.now();\n      if (now - last < 34) return;\n      last = now;\n      if (particles.length > 40) return;\n\n      const rect = hero.getBoundingClientRect();\n      const dot = document.createElement('span');\n      const size = 4 + Math.random() * 7;\n      dot.className = 'inkdot';\n      dot.style.width = size + 'px';\n      dot.style.height = size + 'px';\n      dot.style.left = (e.clientX - rect.left) + 'px';\n      dot.style.top = (e.clientY - rect.top) + 'px';\n      dot.style.opacity = '0.5';\n      trail.appendChild(dot);\n      particles.push(dot);\n\n      gsap.to(dot, {\n        opacity: 0,\n        scale: 0.25,\n        x: (Math.random() - 0.5) * 26,\n        y: 10 + Math.random() * 22,\n        duration: 1.15,\n        ease: 'power1.out',\n        onComplete: () => {\n          dot.remove();\n          particles = particles.filter((p) => p !== dot);\n        }\n      });\n    });\n\n    /* portrait drifts slightly against the scroll */\n    gsap.to('#heroname', {\n      yPercent: -6,\n      ease: 'none',\n      scrollTrigger: { trigger: '#top', start: 'top top', end: 'bottom top', scrub: true }\n    });\n  </script>\n</body>",
      "comments": [],
      "created": "2026-10-28T17:14:57.544090+00:00",
      "modified": "2026-10-28T17:19:14.475153+00:00",
