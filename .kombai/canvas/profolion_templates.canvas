      "html": "<body class=\"min-h-screen bg-[#0B0B10] text-[#EDEBF5] antialiased\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Barlow:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n    body { font-family: 'Barlow', sans-serif; }\n    .plate { background: rgba(217,255,75,0.03); border: 1px solid rgba(217,255,75,0.16); }\n    .plate:hover { border-color: rgba(217,255,75,0.5); }\n    .spin-a { animation: spin 44s linear infinite; }\n    .spin-b { animation: spin 68s linear infinite reverse; }\n    @keyframes spin { to { transform: rotate(360deg); } }\n    .scan { animation: scan 5.5s cubic-bezier(.4,0,.6,1) infinite; }\n    @keyframes scan { 0%,100% { transform: translateY(-46px); opacity: 0; } 12% { opacity: .9; } 88% { opacity: .9; } 50% { transform: translateY(46px); } }\n    @media (prefers-reduced-motion: reduce) { .spin-a, .spin-b, .scan { animation: none; } }\n  </style>\n<header class=\"sticky top-0 z-30 border-b border-[#D9FF4B]/20 bg-[#0B0B10]/92 backdrop-blur\" data-kid=\"1\" data-name=\"sticky site header with backdrop blur\">\n<div class=\"mx-auto flex h-[60px] max-w-[1200px] items-center justify-between px-7\" data-kid=\"1-1\" data-name=\"header layout bar\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"logo and name link\" href=\"#top\">\n<span class=\"grid h-7 w-7 place-items-center border border-[#D9FF4B] text-[10px] text-[#D9FF4B]\" data-kid=\"1-1-1-1\" data-name=\"logo monogram badge\" style=\"font-family:'Chakra Petch', sans-serif\">AM</span>\n<span class=\"text-[11px] font-semibold uppercase tracking-[0.26em] text-[#EDEBF5]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\" style=\"font-family:'Chakra Petch', sans-serif\">Aarav Menon</span>\n</a>\n<nav class=\"hidden items-center gap-7 font-mono text-[9px] uppercase tracking-[0.22em] text-[#8B87A3] md:flex\" data-kid=\"1-1-2\" data-name=\"primary section navigation\">\n<a data-kid=\"1-1-2-1\" data-name=\"nav link to Work section\" href=\"#work\">Work</a><a data-kid=\"1-1-2-2\" data-name=\"nav link to Experience section\" href=\"#experience\">Experience</a><a data-kid=\"1-1-2-3\" data-name=\"nav link to Education section\" href=\"#education\">Education</a><a data-kid=\"1-1-2-4\" data-name=\"nav link to Links section\" href=\"#elsewhere\">Links</a>\n</nav>\n<span class=\"flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.18em] text-[#D9FF4B]\" data-kid=\"1-1-3\" data-name=\"portfolio availability status badge\"><span class=\"h-1.5 w-1.5 bg-[#D9FF4B]\" data-kid=\"1-1-3-1\" data-name=\"pulsing status indicator dot\"></span>Open</span>\n</div>\n</header>\n<section class=\"relative overflow-hidden\" data-kid=\"2\" data-name=\"hero section\" id=\"top\">\n<div aria-hidden=\"\" class=\"pointer-events-none absolute inset-0\" data-kid=\"2-1\" data-name=\"decorative grid background overlay\" style=\"background-image:linear-gradient(rgba(217,255,75,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(217,255,75,0.06) 1px, transparent 1px); background-size:64px 64px\"></div>\n<div class=\"relative mx-auto grid max-w-[1200px] items-center gap-12 px-7 py-14 md:grid-cols-[1.15fr_0.85fr] md:py-20\" data-kid=\"2-2\" data-name=\"hero content grid\">\n<div data-kid=\"2-2-1\" data-name=\"hero text column\">\n<p class=\"font-mono text-[9px] uppercase tracking-[0.34em] text-[#8B87A3]\" data-kid=\"2-2-1-1\" data-name=\"role label kicker\">Interface designer</p>\n<h1 class=\"mt-4 uppercase leading-[0.86] text-[#D9FF4B]\" data-kid=\"2-2-1-2\" data-name=\"hero headline name\" style=\"font-family:'Chakra Petch', sans-serif; font-size:clamp(3rem,7.5vw,5.6rem); font-weight:700; letter-spacing:-0.01em\">\n          Aarav<br data-kid=\"2-2-1-2-1\" data-name=\"line break in name\"/>Menon\n        </h1>\n<p class=\"mt-5 max-w-[44ch] text-[15px] leading-[1.75] text-[#EDEBF5]/72\" data-kid=\"2-2-1-3\" data-name=\"hero tagline paragraph\">\n          I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n        </p>\n<div class=\"mt-7 flex flex-wrap gap-2\" data-kid=\"2-2-1-4\" data-name=\"skill tag container\">\n<span class=\"border border-[#5B48C7] bg-[#5B48C7]/15 px-3 py-1.5 text-[10px] text-[#EDEBF5]\" data-kid=\"2-2-1-4-1\" data-name=\"design systems skill tag\">Design systems</span>\n<span class=\"border border-[#EDEBF5]/18 px-3 py-1.5 text-[10px] text-[#EDEBF5]/85\" data-kid=\"2-2-1-4-2\" data-name=\"interaction design skill tag\">Interaction design</span>\n<span class=\"border border-[#EDEBF5]/18 px-3 py-1.5 text-[10px] text-[#EDEBF5]/85\" data-kid=\"2-2-1-4-3\" data-name=\"prototyping skill tag\">Prototyping</span>\n<span class=\"border border-[#EDEBF5]/18 px-3 py-1.5 text-[10px] text-[#EDEBF5]/85\" data-kid=\"2-2-1-4-4\" data-name=\"motion skill tag\">Motion</span>\n<span class=\"border border-[#EDEBF5]/18 px-3 py-1.5 text-[10px] text-[#EDEBF5]/85\" data-kid=\"2-2-1-4-5\" data-name=\"type skill tag\">Type</span>\n<span class=\"border border-[#EDEBF5]/18 px-3 py-1.5 text-[10px] text-[#EDEBF5]/85\" data-kid=\"2-2-1-4-6\" data-name=\"research skill tag\">Research</span>\n</div>\n<div class=\"mt-8 grid grid-cols-3 gap-2\" data-kid=\"2-2-1-5\" data-name=\"stat mini-cards grid\">\n<div class=\"border border-[#D9FF4B]/25 px-3.5 py-3\" data-kid=\"2-2-1-5-1\" data-name=\"current role stat card\">\n<p class=\"font-mono text-[8px] uppercase tracking-[0.18em] text-[#8B87A3]\" data-kid=\"2-2-1-5-1-1\" data-name=\"currently stat label\">Currently</p>\n<p class=\"mt-1.5 truncate text-[12px] font-semibold text-[#EDEBF5]\" data-kid=\"2-2-1-5-1-2\" data-name=\"current company name value\">Fintrail</p>\n</div>\n<div class=\"border border-[#D9FF4B]/25 px-3.5 py-3\" data-kid=\"2-2-1-5-2\" data-name=\"projects stat card\">\n<p class=\"font-mono text-[8px] uppercase tracking-[0.18em] text-[#8B87A3]\" data-kid=\"2-2-1-5-2-1\" data-name=\"projects stat label\">Projects</p>\n<p class=\"mt-1.5 text-[12px] font-semibold text-[#EDEBF5]\" data-kid=\"2-2-1-5-2-2\" data-name=\"projects count value\">03</p>\n</div>\n<div class=\"border border-[#D9FF4B]/25 px-3.5 py-3\" data-kid=\"2-2-1-5-3\" data-name=\"skills stat card\">\n<p class=\"font-mono text-[8px] uppercase tracking-[0.18em] text-[#8B87A3]\" data-kid=\"2-2-1-5-3-1\" data-name=\"skills stat label\">Skills</p>\n<p class=\"mt-1.5 text-[12px] font-semibold text-[#EDEBF5]\" data-kid=\"2-2-1-5-3-2\" data-name=\"skills count value\">06</p>\n</div>\n</div>\n</div>\n<div class=\"relative mx-auto aspect-square w-full max-w-[400px]\" data-kid=\"2-2-2\" data-name=\"decorative emblemed portrait panel\">\n<div class=\"absolute inset-0 border border-[#D9FF4B]/20\" data-kid=\"2-2-2-1\" data-name=\"portrait panel border frame\"></div>\n<div class=\"absolute left-0 top-0 h-5 w-5 border-l-2 border-t-2 border-[#D9FF4B]\" data-kid=\"2-2-2-2\" data-name=\"top-left corner bracket\"></div>\n<div class=\"absolute right-0 top-0 h-5 w-5 border-r-2 border-t-2 border-[#D9FF4B]\" data-kid=\"2-2-2-3\" data-name=\"top-right corner bracket\"></div>\n<div class=\"absolute bottom-0 left-0 h-5 w-5 border-b-2 border-l-2 border-[#D9FF4B]\" data-kid=\"2-2-2-4\" data-name=\"bottom-left corner bracket\"></div>\n<div class=\"absolute bottom-0 right-0 h-5 w-5 border-b-2 border-r-2 border-[#D9FF4B]\" data-kid=\"2-2-2-5\" data-name=\"bottom-right corner bracket\"></div>\n<svg aria-hidden=\"\" class=\"spin-a absolute inset-0 h-full w-full\" data-kid=\"2-2-2-6\" data-name=\"rotating dashed ring animation\" viewbox=\"0 0 400 400\">\n<circle cx=\"200\" cy=\"200\" fill=\"none\" opacity=\"0.6\" r=\"150\" stroke=\"#D9FF4B\" stroke-dasharray=\"3 12\" stroke-width=\"1\"></circle>\n</svg>\n<svg aria-hidden=\"\" class=\"spin-b absolute inset-0 h-full w-full\" data-kid=\"2-2-2-7\" data-name=\"counter-rotating arc ring\" viewbox=\"0 0 400 400\">\n<circle cx=\"200\" cy=\"200\" fill=\"none\" opacity=\"0.9\" r=\"112\" stroke=\"#5B48C7\" stroke-dasharray=\"56 200\" stroke-width=\"1.5\"></circle>\n</svg>\n<div class=\"absolute inset-0 grid place-items-center\" data-kid=\"2-2-2-8\" data-name=\"monogram center container\">\n<div class=\"grid h-[118px] w-[118px] place-items-center border border-[#D9FF4B]/60 bg-[#0B0B10] text-[34px] font-bold text-[#D9FF4B]\" data-kid=\"2-2-2-8-1\" data-name=\"monogram initials badge\" style=\"font-family:'Chakra Petch', sans-serif\">AM</div>\n</div>\n<div class=\"scan absolute inset-x-0 top-1/2 h-px bg-[#D9FF4B] opacity-70\" data-kid=\"2-2-2-9\" data-name=\"scanline effect bar\"></div>\n<div class=\"absolute inset-x-0 bottom-0 flex items-center justify-between border-t border-[#D9FF4B]/20 px-4 py-2.5 font-mono text-[8px] uppercase tracking-[0.2em] text-[#8B87A3]\" data-kid=\"2-2-2-10\" data-name=\"panel footer info bar\">\n<span data-kid=\"2-2-2-10-1\" data-name=\"portfolio label\">Portfolio</span><span data-kid=\"2-2-2-10-2\" data-name=\"date range label\">2022 — present</span>\n</div>\n</div>\n</div>\n</section>\n<section class=\"border-t border-[#EDEBF5]/10\" data-kid=\"3\" data-name=\"selected work section\" id=\"work\">\n<div class=\"mx-auto max-w-[1200px] px-7 py-12\" data-kid=\"3-1\" data-name=\"work section inner container\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"3-1-1\" data-name=\"section heading row\">\n<h2 class=\"uppercase text-[#EDEBF5]\" data-kid=\"3-1-1-1\" data-name=\"selected work heading\" style=\"font-family:'Chakra Petch', sans-serif; font-size:30px; font-weight:600; letter-spacing:0.02em\">Selected work</h2>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#8B87A3]\" data-kid=\"3-1-1-2\" data-name=\"project count counter\">03 projects</span>\n</div>\n<div class=\"mt-6 grid gap-3 md:grid-cols-2\" data-kid=\"3-1-2\" data-name=\"project cards grid\">\n<article class=\"plate relative flex min-h-[250px] flex-col justify-between p-6 md:row-span-2 md:min-h-[420px]\" data-kid=\"3-1-2-1\" data-name=\"featured project card - Kestrel\" style=\"clip-path:polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px))\">\n<div class=\"flex items-center justify-between\" data-kid=\"3-1-2-1-1\" data-name=\"card meta header row\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#D9FF4B]\" data-kid=\"3-1-2-1-1-1\" data-name=\"design system category tag\">Design system</span>\n<span class=\"font-mono text-[9px] text-[#8B87A3]\" data-kid=\"3-1-2-1-1-2\" data-name=\"2025 year tag\">2025</span>\n</div>\n<div class=\"my-auto\" data-kid=\"3-1-2-1-2\" data-name=\"card body content wrapper\">\n<h3 class=\"uppercase text-[#D9FF4B]\" data-dynamic=\"true\" data-kid=\"3-1-2-1-2-1\" data-name=\"project title with scramble effect\" data-reason=\"text temporarily scrambled and restored on pointerenter\" data-scramble=\"\" style=\"font-family:'Chakra Petch', sans-serif; font-size:44px; line-height:1; font-weight:700\">Kestrel</h3>\n<p class=\"mt-3 max-w-[46ch] text-[13px] leading-[1.75] text-[#EDEBF5]/75\" data-kid=\"3-1-2-1-2-2\" data-name=\"project description text\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n<a class=\"mt-4 inline-flex items-center gap-2 border-b border-[#D9FF4B] pb-0.5 font-mono text-[9px] uppercase tracking-[0.2em] text-[#D9FF4B]\" data-kid=\"3-1-2-1-2-3\" data-name=\"case study CTA link\" href=\"#work\">Read case study ↗</a>\n</div>\n</article>\n<article class=\"plate flex min-h-[200px] flex-col justify-between p-6\" data-kid=\"3-1-2-2\" data-name=\"project card - Tide and Timber\" style=\"clip-path:polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px))\">\n<div class=\"flex items-center justify-between\" data-kid=\"3-1-2-2-1\" data-name=\"card meta header row\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#8B87A3]\" data-kid=\"3-1-2-2-1-1\" data-name=\"booking app category tag\">Booking app</span>\n<span class=\"font-mono text-[9px] text-[#8B87A3]\" data-kid=\"3-1-2-2-1-2\" data-name=\"2024 year tag\">2024</span>\n</div>\n<div class=\"mt-8\" data-kid=\"3-1-2-2-2\" data-name=\"card body content wrapper\">\n<h3 class=\"uppercase text-[#EDEBF5]\" data-dynamic=\"true\" data-kid=\"3-1-2-2-2-1\" data-name=\"project title with scramble effect\" data-reason=\"text temporarily scrambled and restored on pointerenter\" data-scramble=\"\" style=\"font-family:'Chakra Petch', sans-serif; font-size:24px; font-weight:600\">Tide &amp; Timber</h3>\n<p class=\"mt-2 text-[12.5px] leading-[1.7] text-[#EDEBF5]/68\" data-kid=\"3-1-2-2-2-2\" data-name=\"project description text\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n</div>\n</article>\n<article class=\"plate flex min-h-[200px] flex-col justify-between p-6\" data-kid=\"3-1-2-3\" data-name=\"project card - Loom Audio\" style=\"clip-path:polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px))\">\n<div class=\"flex items-center justify-between\" data-kid=\"3-1-2-3-1\" data-name=\"card meta header row\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#8B87A3]\" data-kid=\"3-1-2-3-1-1\" data-name=\"editorial platform category tag\">Editorial platform</span>\n<span class=\"font-mono text-[9px] text-[#8B87A3]\" data-kid=\"3-1-2-3-1-2\" data-name=\"2023 year tag\">2023</span>\n</div>\n<div class=\"mt-8\" data-kid=\"3-1-2-3-2\" data-name=\"card body content wrapper\">\n<h3 class=\"uppercase text-[#EDEBF5]\" data-dynamic=\"true\" data-kid=\"3-1-2-3-2-1\" data-name=\"project title with scramble effect\" data-reason=\"text temporarily scrambled and restored on pointerenter\" data-scramble=\"\" style=\"font-family:'Chakra Petch', sans-serif; font-size:24px; font-weight:600\">Loom Audio</h3>\n<p class=\"mt-2 text-[12.5px] leading-[1.7] text-[#EDEBF5]/68\" data-kid=\"3-1-2-3-2-2\" data-name=\"project description text\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n</div>\n</article>\n</div>\n</div>\n</section>\n<section class=\"border-t border-[#EDEBF5]/10 bg-[#08080C]\" data-kid=\"4\" data-name=\"experience section\" id=\"experience\">\n<div class=\"mx-auto max-w-[1200px] px-7 py-12\" data-kid=\"4-1\" data-name=\"experience section inner container\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"4-1-1\" data-name=\"section heading row\">\n<h2 class=\"uppercase text-[#EDEBF5]\" data-kid=\"4-1-1-1\" data-name=\"experience section heading\" style=\"font-family:'Chakra Petch', sans-serif; font-size:28px; font-weight:600; letter-spacing:0.02em\">Experience</h2>\n<span class=\"font-mono text-[9px] uppercase tracking-[0.2em] text-[#8B87A3]\" data-kid=\"4-1-1-2\" data-name=\"role count counter\">03 roles</span>\n</div>\n<div class=\"mt-5\" data-kid=\"4-1-2\" data-name=\"experience rows container\">\n<div class=\"grid gap-2 border-b border-[#EDEBF5]/10 py-4 md:grid-cols-[130px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-2-1\" data-name=\"experience row - Fintrail\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.14em] text-[#D9FF4B]\" data-kid=\"4-1-2-1-1\" data-name=\"year range label\">2022 — present</span>\n<div data-kid=\"4-1-2-1-2\" data-name=\"role title and summary wrapper\"><p class=\"text-[16px] font-semibold text-[#EDEBF5]\" data-kid=\"4-1-2-1-2-1\" data-name=\"company name\">Fintrail</p><p class=\"text-[11.5px] text-[#8B87A3]\" data-kid=\"4-1-2-1-2-2\" data-name=\"role summary description\">Senior product designer — payments, onboarding and the design system.</p></div>\n<span class=\"h-1.5 w-1.5 bg-[#D9FF4B] md:justify-self-end\" data-kid=\"4-1-2-1-3\" data-name=\"current role indicator dot\"></span>\n</div>\n<div class=\"grid gap-2 border-b border-[#EDEBF5]/10 py-4 md:grid-cols-[130px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-2-2\" data-name=\"experience row - Sundial Studio\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.14em] text-[#D9FF4B]\" data-kid=\"4-1-2-2-1\" data-name=\"year range label\">2019 — 2022</span>\n<div data-kid=\"4-1-2-2-2\" data-name=\"role title and summary wrapper\"><p class=\"text-[16px] font-semibold text-[#EDEBF5]\" data-kid=\"4-1-2-2-2-1\" data-name=\"company name\">Sundial Studio</p><p class=\"text-[11.5px] text-[#8B87A3]\" data-kid=\"4-1-2-2-2-2\" data-name=\"role summary description\">Product designer — booking and travel products for three clients.</p></div>\n<span class=\"h-1.5 w-1.5 bg-[#5B48C7] md:justify-self-end\" data-kid=\"4-1-2-2-3\" data-name=\"past role indicator dot\"></span>\n</div>\n<div class=\"grid gap-2 border-b border-[#EDEBF5]/10 py-4 md:grid-cols-[130px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-2-3\" data-name=\"experience row - Pageturn Press\">\n<span class=\"font-mono text-[9px] uppercase tracking-[0.14em] text-[#D9FF4B]\" data-kid=\"4-1-2-3-1\" data-name=\"year range label\">2017 — 2019</span>\n<div data-kid=\"4-1-2-3-2\" data-name=\"role title and summary wrapper\"><p class=\"text-[16px] font-semibold text-[#EDEBF5]\" data-kid=\"4-1-2-3-2-1\" data-name=\"company name\">Pageturn Press</p><p class=\"text-[11.5px] text-[#8B87A3]\" data-kid=\"4-1-2-3-2-2\" data-name=\"role summary description\">Interface designer — digital editions of a 90-year-old imprint.</p></div>\n<span class=\"h-1.5 w-1.5 bg-[#5B48C7] md:justify-self-end\" data-kid=\"4-1-2-3-3\" data-name=\"past role indicator dot\"></span>\n</div>\n</div>\n</div>\n</section>\n<div class=\"grid md:grid-cols-2\" data-kid=\"5\" data-name=\"light band section with two columns\" style=\"background:#DCD6EE; color:#0B0B10\">\n<section class=\"px-7 py-10 md:pl-[max(28px,calc((100vw-1200px)/2+28px))]\" data-kid=\"5-1\" data-name=\"education section\" id=\"education\">\n<h2 class=\"uppercase\" data-kid=\"5-1-1\" data-name=\"education section heading\" style=\"font-family:'Chakra Petch', sans-serif; font-size:24px; font-weight:600; letter-spacing:0.02em\">Education</h2>\n<div class=\"mt-4 border-t border-[#0B0B10]/15\" data-kid=\"5-1-2\" data-name=\"education entries list\">\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#0B0B10]/12 py-3\" data-kid=\"5-1-2-1\" data-name=\"education entry - NID\">\n<div data-kid=\"5-1-2-1-1\" data-name=\"school name and field wrapper\"><p class=\"text-[13.5px] font-semibold\" data-kid=\"5-1-2-1-1-1\" data-name=\"institution name\">National Institute of Design</p><p class=\"text-[11.5px] opacity-65\" data-kid=\"5-1-2-1-1-2\" data-name=\"field of study\">Interaction design</p></div>\n<span class=\"font-mono text-[9px] opacity-65\" data-kid=\"5-1-2-1-2\" data-name=\"graduation year range\">2015 — 2017</span>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#0B0B10]/12 py-3\" data-kid=\"5-1-2-2\" data-name=\"education entry - Srishti\">\n<div data-kid=\"5-1-2-2-1\" data-name=\"school name and field wrapper\"><p class=\"text-[13.5px] font-semibold\" data-kid=\"5-1-2-2-1-1\" data-name=\"institution name\">Srishti Institute</p><p class=\"text-[11.5px] opacity-65\" data-kid=\"5-1-2-2-1-2\" data-name=\"field of study\">Foundation studies</p></div>\n<span class=\"font-mono text-[9px] opacity-65\" data-kid=\"5-1-2-2-2\" data-name=\"year range\">2013 — 2015</span>\n</div>\n</div>\n</section>\n<section class=\"px-7 py-10 md:pr-[max(28px,calc((100vw-1200px)/2+28px))]\" data-kid=\"5-2\" data-name=\"links section\" id=\"elsewhere\">\n<h2 class=\"uppercase\" data-kid=\"5-2-1\" data-name=\"links section heading\" style=\"font-family:'Chakra Petch', sans-serif; font-size:24px; font-weight:600; letter-spacing:0.02em\">Links</h2>\n<div class=\"mt-4 grid grid-cols-2 gap-2\" data-kid=\"5-2-2\" data-name=\"links grid container\">\n<a class=\"flex items-center justify-between border border-[#0B0B10]/20 px-3.5 py-2.5 font-mono text-[9px] uppercase tracking-[0.14em]\" data-kid=\"5-2-2-1\" data-name=\"external link card - GitHub\" href=\"#elsewhere\">GitHub <span class=\"text-[#5B48C7]\" data-kid=\"5-2-2-1-1\" data-name=\"clickable arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#0B0B10]/20 px-3.5 py-2.5 font-mono text-[9px] uppercase tracking-[0.14em]\" data-kid=\"5-2-2-2\" data-name=\"external link card - Dribbble\" href=\"#elsewhere\">Dribbble <span class=\"text-[#5B48C7]\" data-kid=\"5-2-2-2-1\" data-name=\"clickable arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#0B0B10]/20 px-3.5 py-2.5 font-mono text-[9px] uppercase tracking-[0.14em]\" data-kid=\"5-2-2-3\" data-name=\"external link card - LinkedIn\" href=\"#elsewhere\">LinkedIn <span class=\"text-[#5B48C7]\" data-kid=\"5-2-2-3-1\" data-name=\"clickable arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between border border-[#0B0B10]/20 px-3.5 py-2.5 font-mono text-[9px] uppercase tracking-[0.14em]\" data-kid=\"5-2-2-4\" data-name=\"external link card - Email\" href=\"#elsewhere\">Email <span class=\"text-[#5B48C7]\" data-kid=\"5-2-2-4-1\" data-name=\"clickable arrow icon\">↗</span></a>\n</div>\n</section>\n</div>\n<footer class=\"border-t border-[#EDEBF5]/10\" data-kid=\"6\" data-name=\"site footer\">\n<div class=\"mx-auto flex max-w-[1200px] items-center justify-between px-7 py-5 font-mono text-[9px] uppercase tracking-[0.22em] text-[#8B87A3]\" data-kid=\"6-1\" data-name=\"footer inner flex container\">\n<span data-kid=\"6-1-1\" data-name=\"footer signature text\">Aarav Menon — interface designer</span><a data-kid=\"6-1-2\" data-name=\"back-to-top link\" href=\"#top\">Back to top</a>\n</div>\n</footer>\n<script>\n    const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ#%&*';\n    document.querySelectorAll('[data-scramble]').forEach(function (node) {\n      const original = node.textContent || '';\n      let timer = 0;\n      node.style.cursor = 'default';\n      node.addEventListener('pointerenter', function () {\n        let step = 0;\n        clearInterval(timer);\n        timer = setInterval(function () {\n          step += 1;\n          const revealed = Math.floor((step / 12) * original.length);\n          node.textContent = original.split('').map(function (ch, i) {\n            return i < revealed || ch === ' ' ? ch : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];\n          }).join('');\n          if (step >= 12) { clearInterval(timer); node.textContent = original; }\n        }, 26);\n      });\n    });\n  </script>\n</body>",
