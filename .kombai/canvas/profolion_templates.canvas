      "html": "<body class=\"min-h-screen bg-[#F6EFDD] text-[#14100F] antialiased\">\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap');\n\n  body { font-family: 'Cormorant Garamond', Georgia, serif; }\n  .ow-display { font-family: 'Cinzel', Georgia, serif; }\n  .ow-mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }\n\n  .ow-paper {\n    background-image:\n      radial-gradient(circle at 14% 6%, rgba(122, 34, 48, 0.055), transparent 42%),\n      radial-gradient(circle at 88% 74%, rgba(176, 141, 63, 0.13), transparent 46%);\n  }\n  .ow-seal {\n    box-shadow: 0 0 0 1px rgba(122, 34, 48, 0.42), inset 0 0 0 6px rgba(246, 239, 221, 0.18), inset 0 0 0 7px rgba(246, 239, 221, 0.32);\n  }\n  .ow-hair { background-image: linear-gradient(to right, rgba(20, 16, 15, 0.28), rgba(20, 16, 15, 0.05)); }\n  .ow-postmark { border-style: dashed; }\n</style>\n<header class=\"sticky top-0 z-30 border-b border-[#14100F]/10 bg-[#F6EFDD]/95\" data-kid=\"1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[64px] max-w-[1180px] items-center justify-between px-6\" data-kid=\"1-1\" data-name=\"header content row\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"owner monogram home link\" href=\"#top\">\n<span class=\"ow-display grid h-9 w-9 place-items-center rounded-full bg-[#7A2230] text-[11px] font-semibold tracking-[0.06em] text-[#F6EFDD]\" data-kid=\"1-1-1-1\" data-name=\"AM monogram seal\">AM</span>\n<span class=\"ow-display hidden text-[12px] font-semibold uppercase tracking-[0.22em] text-[#14100F] sm:block\" data-kid=\"1-1-1-2\" data-name=\"owner name logotype\">Aarav Menon</span>\n</a>\n<nav class=\"ow-mono hidden items-center gap-7 text-[10px] uppercase tracking-[0.22em] text-[#7C7160] md:flex\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n<a class=\"hover:text-[#7A2230]\" data-kid=\"1-1-2-1\" data-name=\"work nav link\" href=\"#work\">Work</a>\n<a class=\"hover:text-[#7A2230]\" data-kid=\"1-1-2-2\" data-name=\"experience nav link\" href=\"#experience\">Experience</a>\n<a class=\"hover:text-[#7A2230]\" data-kid=\"1-1-2-3\" data-name=\"education nav link\" href=\"#education\">Education</a>\n<a class=\"hover:text-[#7A2230]\" data-kid=\"1-1-2-4\" data-name=\"elsewhere nav link\" href=\"#elsewhere\">Elsewhere</a>\n</nav>\n<a class=\"ow-mono border border-[#7A2230]/50 px-3 py-1.5 text-[10px] uppercase tracking-[0.2em] text-[#7A2230] hover:bg-[#7A2230] hover:text-[#F6EFDD]\" data-kid=\"1-1-3\" data-name=\"email action link\" href=\"mailto:hello@example.com\">Email</a>\n</div>\n</header>\n<section class=\"ow-paper border-b border-[#14100F]/10\" data-kid=\"2\" data-name=\"parchment letter hero\" id=\"top\">\n<div class=\"mx-auto grid max-w-[1180px] grid-cols-1 items-start gap-14 px-6 py-16 lg:grid-cols-[1fr_400px] lg:gap-16 lg:py-20\" data-kid=\"2-1\" data-name=\"hero two column grid\">\n<div class=\"max-w-[560px]\" data-kid=\"2-1-1\" data-name=\"hero name and introduction\">\n<div class=\"ow-mono flex items-center gap-3 text-[10px] uppercase tracking-[0.3em] text-[#7A2230]\" data-kid=\"2-1-1-1\" data-name=\"role eyebrow\">\n<span class=\"h-px w-9 bg-[#7A2230]/60\" data-kid=\"2-1-1-1-1\" data-name=\"eyebrow rule\"></span>\n        Interface designer\n      </div>\n<h1 class=\"ow-display mt-6 text-[52px] font-semibold uppercase leading-[0.94] tracking-[0.015em] sm:text-[66px]\" data-kid=\"2-1-1-2\" data-name=\"monumental owner name\">\n        Aarav\n        <span class=\"block text-[#7A2230]\" data-kid=\"2-1-1-2-1\" data-name=\"surname in seal red\">Menon</span>\n</h1>\n<p class=\"mt-6 max-w-[44ch] text-[17px] leading-[1.72] text-[#14100F]/80\" data-kid=\"2-1-1-3\" data-name=\"owner bio paragraph\">\n        I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n      </p>\n<div class=\"ow-mono mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 text-[10px] uppercase tracking-[0.2em]\" data-kid=\"2-1-1-4\" data-name=\"hero action links\">\n<a class=\"inline-flex items-center gap-2 text-[#14100F] hover:text-[#7A2230]\" data-kid=\"2-1-1-4-1\" data-name=\"github link\" href=\"https://github.com\">\n          GitHub\n          <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"2-1-1-4-1-1\" data-name=\"outdoor arrow link icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.2\"></path></svg>\n</a>\n<a class=\"inline-flex items-center gap-2 text-[#14100F] hover:text-[#7A2230]\" data-kid=\"2-1-1-4-2\" data-name=\"linkedin link\" href=\"https://linkedin.com\">\n          LinkedIn\n          <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"2-1-1-4-2-1\" data-name=\"outdoor arrow link icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.2\"></path></svg>\n</a>\n<a class=\"inline-flex items-center gap-2 text-[#7A2230]\" data-kid=\"2-1-1-4-3\" data-name=\"email address link\" href=\"mailto:hello@example.com\">\n          hello@example.com\n        </a>\n</div>\n</div>\n<div class=\"relative mx-auto w-full max-w-[400px]\" data-kid=\"2-1-2\" data-name=\"folded letter panel\">\n<div aria-hidden=\"true\" class=\"absolute inset-x-5 -bottom-3 h-full rounded-[2px] border border-[#14100F]/10 bg-[#EAE0CB]/70\" data-kid=\"2-1-2-1\" data-name=\"second sheet behind letter\"></div>\n<div class=\"relative border border-[#14100F]/20 bg-[#EAE0CB]\" data-kid=\"2-1-2-2\" data-name=\"letter sheet\">\n<div class=\"relative h-[92px] border-b border-[#14100F]/15 bg-[#EFE6D2]\" data-kid=\"2-1-2-2-1\" data-name=\"envelope flap fold\">\n<svg aria-hidden=\"true\" class=\"h-full w-full\" data-kid=\"2-1-2-2-1-2\" data-name=\"flap fold line icon\" preserveaspectratio=\"none\" viewbox=\"0 0 420 92\">\n<path d=\"M0 0 L210 84 L420 0\" fill=\"rgba(20,16,15,0.045)\" stroke=\"rgba(20,16,15,0.16)\" stroke-width=\"1\"></path>\n</svg>\n<span class=\"ow-seal ow-display absolute left-1/2 top-[86px] grid h-[58px] w-[58px] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-[#7A2230] text-[11px] tracking-[0.06em] text-[#F6EFDD]\" data-kid=\"2-1-2-2-1-1\" data-name=\"wax seal with initials\">AM</span>\n</div>\n<div class=\"px-7 pb-7 pt-12\" data-kid=\"2-1-2-2-2\" data-name=\"letter body\">\n<p class=\"ow-mono text-[10px] uppercase tracking-[0.28em] text-[#7C7160]\" data-kid=\"2-1-2-2-2-1\" data-name=\"skills label\">Skills</p>\n<ul class=\"mt-4 grid grid-cols-2 gap-x-6\" data-kid=\"2-1-2-2-2-2\" data-name=\"skills list\">\n<li class=\"ow-display border-b border-[#14100F]/10 py-2.5 text-[12.5px] tracking-[0.03em]\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"skill design systems\">Design systems</li>\n<li class=\"ow-display border-b border-[#14100F]/10 py-2.5 text-[12.5px] tracking-[0.03em]\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"skill interaction design\">Interaction design</li>\n<li class=\"ow-display border-b border-[#14100F]/10 py-2.5 text-[12.5px] tracking-[0.04em]\" data-kid=\"2-1-2-2-2-2-3\" data-name=\"skill prototyping\">Prototyping</li>\n<li class=\"ow-display border-b border-[#14100F]/10 py-2.5 text-[12.5px] tracking-[0.04em]\" data-kid=\"2-1-2-2-2-2-4\" data-name=\"skill motion\">Motion</li>\n<li class=\"ow-display py-2.5 text-[12.5px] tracking-[0.04em]\" data-kid=\"2-1-2-2-2-2-5\" data-name=\"skill type\">Type</li>\n<li class=\"ow-display py-2.5 text-[12.5px] tracking-[0.04em]\" data-kid=\"2-1-2-2-2-2-6\" data-name=\"skill research\">Research</li>\n</ul>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"border-b border-[#14100F]/10\" data-kid=\"3\" data-name=\"selected work section\" id=\"work\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-16\" data-kid=\"3-1\" data-name=\"work container\">\n<div class=\"inline-block\" data-kid=\"3-1-1\" data-name=\"work heading with drawn rule\" data-rune-host=\"\">\n<h2 class=\"ow-display text-[12px] font-semibold uppercase tracking-[0.34em] text-[#14100F]\" data-kid=\"3-1-1-1\" data-name=\"selected work heading\">Selected work</h2>\n<svg aria-hidden=\"true\" class=\"mt-3 h-[7px] w-[236px]\" data-kid=\"3-1-1-2\" data-name=\"hand-drawn underline flourish\" preserveaspectratio=\"none\" viewbox=\"0 0 240 7\">\n<path d=\"M1 4 C 34 1.4, 68 6.2, 104 4 S 176 1.2, 239 4.2\" data-rune=\"\" fill=\"none\" stroke=\"#7A2230\" stroke-linecap=\"round\" stroke-width=\"1.5\"></path>\n</svg>\n</div>\n<ol class=\"mt-10\" data-kid=\"3-1-2\" data-name=\"project list\">\n<li class=\"grid grid-cols-1 gap-x-10 gap-y-3 border-t border-[#14100F]/15 py-8 sm:grid-cols-[1fr_104px]\" data-kid=\"3-1-2-1\" data-name=\"project row kestrel\">\n<div data-kid=\"3-1-2-1-1\" data-name=\"project title and description block\">\n<h3 class=\"ow-display text-[26px] font-medium tracking-[0.02em] text-[#14100F]\" data-kid=\"3-1-3\" data-name=\"project title Kestrel\">Kestrel</h3>\n<p class=\"mt-2 max-w-[62ch] text-[16px] leading-[1.66] text-[#7C7160]\" data-kid=\"3-2\" data-name=\"project description\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n</div>\n<div class=\"ow-mono flex items-baseline justify-between gap-3 text-[10px] uppercase tracking-[0.2em] text-[#7C7160] sm:flex-col sm:items-end sm:gap-2\" data-kid=\"3-3\" data-name=\"project date gutter\">\n<span data-kid=\"3-4\" data-name=\"project year\">2025</span>\n<a class=\"text-[#7A2230] hover:underline hover:decoration-[#7A2230]/40 hover:underline-offset-4\" data-kid=\"3-5\" data-name=\"read case study link\" href=\"https://example.com\">Case study</a>\n</div>\n</li>\n<li class=\"grid grid-cols-1 gap-x-10 gap-y-3 border-t border-[#14100F]/15 py-8 sm:grid-cols-[1fr_104px]\" data-kid=\"3-6\" data-name=\"project row tide and timber\">\n<div data-kid=\"3-6-1\" data-name=\"project title and description block\">\n<h3 class=\"ow-display text-[26px] font-medium tracking-[0.02em] text-[#14100F]\" data-kid=\"3-7\" data-name=\"project title Tide and Timber\">Tide &amp; Timber</h3>\n<p class=\"mt-2 max-w-[62ch] text-[16px] leading-[1.66] text-[#7C7160]\" data-kid=\"3-8\" data-name=\"project description\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n</div>\n<div class=\"ow-mono flex items-baseline justify-between gap-3 text-[10px] uppercase tracking-[0.2em] text-[#7C7160] sm:flex-col sm:items-end sm:gap-2\" data-kid=\"3-9\" data-name=\"project date gutter\">\n<span data-kid=\"3-10\" data-name=\"project year\">2024</span>\n<a class=\"text-[#7A2230] hover:underline hover:decoration-[#7A2230]/40 hover:underline-offset-4\" data-kid=\"3-11\" data-name=\"read case study link\" href=\"https://example.com\">Case study</a>\n</div>\n</li>\n<li class=\"grid grid-cols-1 gap-x-10 gap-y-3 border-y border-[#14100F]/15 py-8 sm:grid-cols-[1fr_104px]\" data-kid=\"3-12\" data-name=\"project row loom audio\">\n<div data-kid=\"3-12-1\" data-name=\"project title and description block\">\n<h3 class=\"ow-display text-[26px] font-medium tracking-[0.02em] text-[#14100F]\" data-kid=\"3-13\" data-name=\"project title Loom Audio\">Loom Audio</h3>\n<p class=\"mt-2 max-w-[62ch] text-[16px] leading-[1.66] text-[#7C7160]\" data-kid=\"3-14\" data-name=\"project description\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n</div>\n<div class=\"ow-mono flex items-baseline justify-between gap-3 text-[10px] uppercase tracking-[0.2em] text-[#7C7160] sm:flex-col sm:items-end sm:gap-2\" data-kid=\"3-15\" data-name=\"project date gutter\">\n<span data-kid=\"3-16\" data-name=\"project year\">2023</span>\n<a class=\"text-[#7A2230] hover:underline hover:decoration-[#7A2230]/40 hover:underline-offset-4\" data-kid=\"3-17\" data-name=\"read case study link\" href=\"https://example.com\">Case study</a>\n</div>\n</li>\n</ol>\n</div>\n</section>\n<section class=\"bg-[#14100F] text-[#F6EFDD]\" data-kid=\"4\" data-name=\"experience band\" id=\"experience\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-16\" data-kid=\"4-1\" data-name=\"experience container\">\n<div class=\"inline-block\" data-kid=\"4-1-1\" data-name=\"experience heading with drawn rule\" data-rune-host=\"\">\n<h2 class=\"ow-display text-[12px] font-semibold uppercase tracking-[0.34em] text-[#B08D3F]\" data-kid=\"4-1-1-1\" data-name=\"experience heading\">Experience</h2>\n<svg aria-hidden=\"true\" class=\"mt-3 h-[7px] w-[236px]\" data-kid=\"4-1-1-2\" data-name=\"hand-drawn underline flourish\" preserveaspectratio=\"none\" viewbox=\"0 0 240 7\">\n<path d=\"M1 4 C 34 1.4, 68 6.2, 104 4 S 176 1.2, 239 4.2\" data-rune=\"\" fill=\"none\" stroke=\"#B08D3F\" stroke-linecap=\"round\" stroke-width=\"1.5\"></path>\n</svg>\n</div>\n<ul class=\"mt-9\" data-kid=\"4-1-2\" data-name=\"correspondence experience entries\">\n<li class=\"flex flex-wrap items-baseline justify-between gap-4 border-t border-[#F6EFDD]/15 py-6\" data-kid=\"4-1-2-1\" data-name=\"experience entry fintrail\">\n<div data-kid=\"4-1-2-1-1\" data-name=\"company and role block\">\n<p class=\"ow-display text-[21px] tracking-[0.03em] text-[#F6EFDD]\" data-kid=\"4-2\" data-name=\"company name fintrail\">Fintrail</p>\n<p class=\"mt-1 text-[15px] text-[#8B8071]\" data-kid=\"4-3\" data-name=\"role senior product designer\">Senior product designer</p>\n</div>\n<span class=\"ow-mono ow-postmark border border-[#B08D3F]/45 px-2.5 py-1 text-[10px] uppercase tracking-[0.16em] text-[#B08D3F]\" data-kid=\"4-4\" data-name=\"postmark date stub\">2022 — present</span>\n</li>\n<li class=\"flex flex-wrap items-baseline justify-between gap-4 border-t border-[#F6EFDD]/15 py-6\" data-kid=\"4-5\" data-name=\"experience entry sundial studio\">\n<div data-kid=\"4-5-1\" data-name=\"company and role block\">\n<p class=\"ow-display text-[21px] tracking-[0.03em] text-[#F6EFDD]\" data-kid=\"4-6\" data-name=\"company name sundial studio\">Sundial Studio</p>\n<p class=\"mt-1 text-[15px] text-[#8B8071]\" data-kid=\"4-7\" data-name=\"role product designer\">Product designer</p>\n</div>\n<span class=\"ow-mono ow-postmark border border-[#B08D3F]/45 px-2.5 py-1 text-[10px] uppercase tracking-[0.16em] text-[#B08D3F]\" data-kid=\"4-8\" data-name=\"postmark date stub\">2019 — 2022</span>\n</li>\n<li class=\"flex flex-wrap items-baseline justify-between gap-4 border-y border-[#F6EFDD]/15 py-6\" data-kid=\"4-9\" data-name=\"experience entry pageturn press\">\n<div data-kid=\"4-9-1\" data-name=\"company and role block\">\n<p class=\"ow-display text-[21px] tracking-[0.03em] text-[#F6EFDD]\" data-kid=\"4-10\" data-name=\"company name pageturn press\">Pageturn Press</p>\n<p class=\"mt-1 text-[15px] text-[#8B8071]\" data-kid=\"4-11\" data-name=\"role interface designer\">Interface designer</p>\n</div>\n<span class=\"ow-mono ow-postmark border border-[#B08D3F]/45 px-2.5 py-1 text-[10px] uppercase tracking-[0.16em] text-[#B08D3F]\" data-kid=\"4-12\" data-name=\"postmark date stub\">2017 — 2019</span>\n</li>\n</ul>\n</div>\n</section>\n<section class=\"border-b border-[#14100F]/10\" data-kid=\"5\" data-name=\"education section\" id=\"education\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-16\" data-kid=\"5-1\" data-name=\"education container\">\n<div class=\"inline-block\" data-kid=\"5-1-1\" data-name=\"education heading with drawn rule\" data-rune-host=\"\">\n<h2 class=\"ow-display text-[12px] font-semibold uppercase tracking-[0.34em] text-[#14100F]\" data-kid=\"5-1-1-1\" data-name=\"education heading\">Education</h2>\n<svg aria-hidden=\"true\" class=\"mt-3 h-[7px] w-[236px]\" data-kid=\"5-1-1-2\" data-name=\"hand-drawn underline flourish\" preserveaspectratio=\"none\" viewbox=\"0 0 240 7\">\n<path d=\"M1 4 C 34 1.4, 68 6.2, 104 4 S 176 1.2, 239 4.2\" data-rune=\"\" fill=\"none\" stroke=\"#7A2230\" stroke-linecap=\"round\" stroke-width=\"1.5\"></path>\n</svg>\n</div>\n<div class=\"mt-9 grid gap-x-12 gap-y-8 sm:grid-cols-2\" data-kid=\"5-1-2\" data-name=\"education entries grid\">\n<div class=\"border-t border-[#14100F]/25 pt-4\" data-kid=\"5-1-2-1\" data-name=\"education entry NID\">\n<p class=\"ow-mono text-[10px] uppercase tracking-[0.2em] text-[#7C7160]\" data-kid=\"5-2\" data-name=\"study dates\">2015 — 2017</p>\n<p class=\"ow-display mt-2 text-[19px] tracking-[0.02em] text-[#14100F]\" data-kid=\"5-3\" data-name=\"institution name NID\">National Institute of Design</p>\n<p class=\"text-[15px] text-[#7C7160]\" data-kid=\"5-4\" data-name=\"field of study\">Interaction design</p>\n</div>\n<div class=\"border-t border-[#14100F]/25 pt-4\" data-kid=\"5-1-2-2\" data-name=\"education entry srishti institute\">\n<p class=\"ow-mono text-[10px] uppercase tracking-[0.2em] text-[#7C7160]\" data-kid=\"5-5\" data-name=\"study dates\">2013 — 2015</p>\n<p class=\"ow-display mt-2 text-[19px] tracking-[0.02em] text-[#14100F]\" data-kid=\"5-6\" data-name=\"institution name Srishti\">Srishti Institute</p>\n<p class=\"text-[15px] text-[#7C7160]\" data-kid=\"5-7\" data-name=\"field of study\">Foundation studies</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"ow-paper\" data-kid=\"6\" data-name=\"elsewhere social links section\" id=\"elsewhere\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-14\" data-kid=\"6-1\" data-name=\"elsewhere container\">\n<div class=\"inline-block\" data-kid=\"6-1-1\" data-name=\"elsewhere heading with drawn rule\" data-rune-host=\"\">\n<h2 class=\"ow-display text-[12px] font-semibold uppercase tracking-[0.34em] text-[#14100F]\" data-kid=\"6-1-1-1\" data-name=\"elsewhere heading\">Elsewhere</h2>\n<svg aria-hidden=\"true\" class=\"mt-3 h-[7px] w-[236px]\" data-kid=\"6-1-1-2\" data-name=\"hand-drawn underline flourish\" preserveaspectratio=\"none\" viewbox=\"0 0 240 7\">\n<path d=\"M1 4 C 34 1.4, 68 6.2, 104 4 S 176 1.2, 239 4.2\" data-rune=\"\" fill=\"none\" stroke=\"#7A2230\" stroke-linecap=\"round\" stroke-width=\"1.5\"></path>\n</svg>\n</div>\n<div class=\"mt-8 flex flex-wrap items-center gap-x-10 gap-y-4\" data-kid=\"5-8\" data-name=\"social links row\">\n<a class=\"ow-mono inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-[#14100F] hover:text-[#7A2230]\" data-kid=\"5-9\" data-name=\"github platform link\" href=\"https://github.com\">\n        GitHub\n        <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"5-9-1\" data-name=\"outdoor arrow link icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.2\"></path></svg>\n</a>\n<a class=\"ow-mono inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-[#14100F] hover:text-[#7A2230]\" data-kid=\"5-10\" data-name=\"dribbble platform link\" href=\"https://dribbble.com\">\n        Dribbble\n        <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"5-10-1\" data-name=\"outdoor arrow link icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.2\"></path></svg>\n</a>\n<a class=\"ow-mono inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-[#14100F] hover:text-[#7A2230]\" data-kid=\"5-11\" data-name=\"linkedin platform link\" href=\"https://linkedin.com\">\n        LinkedIn\n        <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"5-11-1\" data-name=\"outdoor arrow link icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.2\"></path></svg>\n</a>\n<a class=\"ow-mono inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-[#7A2230]\" data-kid=\"5-12\" data-name=\"email address link\" href=\"mailto