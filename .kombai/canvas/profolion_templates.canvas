      "html": "<body class=\"min-h-screen bg-[#F6F0E6] text-[#14100E] antialiased\" data-motion=\"runeDraw\" data-template-root=\"\">\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  body { font-family: 'Cormorant Garamond', Georgia, serif; }\n  .display { font-family: 'Cinzel', Georgia, serif; }\n  .mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }\n  .rune-rule { fill: none; stroke: currentColor; stroke-width: 1; }\n  .crest { fill: none; stroke: #A8232F; }\n  .plate { transition: background-color 220ms ease; }\n  .plate:hover { background-color: #EBE0CE; }\n  .plate-rule { transition: background-color 220ms ease; }\n  .plate:hover .plate-rule { background-color: #A8232F; }\n</style>\n<header class=\"sticky top-0 z-30 border-b border-[#14100E]/12 bg-[#F6F0E6]/95 backdrop-blur-sm\" data-kid=\"1\" data-name=\"sticky site header bar\">\n<div class=\"mx-auto flex h-16 max-w-[1180px] items-center justify-between gap-4 px-5 md:px-10\" data-kid=\"1-1\" data-name=\"header inner layout row\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"site brand logo link\" href=\"#top\">\n<span class=\"relative grid h-8 w-8 place-items-center border border-[#A8232F]\" data-kid=\"1-1-1-1\" data-name=\"brand monogram badge mark\">\n<span class=\"mono text-[10px] tracking-[0.04em] text-[#A8232F]\" data-kid=\"1-1-1-1-1\" data-name=\"monogram initials text\">AM</span>\n<span class=\"pointer-events-none absolute -inset-[3px] rotate-45 border border-[#A8232F]/35\" data-kid=\"1-1-1-1-2\" data-name=\"rotated badge frame border\"></span>\n</span>\n<span class=\"display text-[12px] uppercase tracking-[0.26em]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">Aarav Menon</span>\n</a>\n<nav class=\"mono hidden items-center gap-7 text-[10px] uppercase tracking-[0.24em] text-[#7A6E62] lg:flex\" data-kid=\"1-1-2\" data-name=\"main navigation links\">\n<a class=\"hover:text-[#A8232F]\" data-kid=\"1-1-2-1\" data-name=\"nav link to skills\" href=\"#skills\">Skills</a>\n<a class=\"hover:text-[#A8232F]\" data-kid=\"1-1-2-2\" data-name=\"nav link to work\" href=\"#work\">Work</a>\n<a class=\"hover:text-[#A8232F]\" data-kid=\"1-1-2-3\" data-name=\"nav link to experience\" href=\"#experience\">Experience</a>\n<a class=\"hover:text-[#A8232F]\" data-kid=\"1-1-2-4\" data-name=\"nav link to education\" href=\"#education\">Education</a>\n<a class=\"hover:text-[#A8232F]\" data-kid=\"1-1-2-5\" data-name=\"nav link to elsewhere\" href=\"#elsewhere\">Elsewhere</a>\n</nav>\n<span class=\"mono hidden text-[10px] uppercase tracking-[0.22em] text-[#7A6E62] sm:block\" data-kid=\"1-1-3\" data-name=\"role tagline text\">Interface designer</span>\n</div>\n</header>\n<section class=\"relative overflow-hidden px-5 pt-14 pb-16 md:px-10 md:pt-20 md:pb-24\" data-kid=\"2\" data-name=\"hero section\" id=\"top\">\n<svg aria-hidden=\"true\" class=\"crest pointer-events-none absolute left-1/2 top-6 -translate-x-1/2 opacity-[0.12]\" data-kid=\"2-1\" data-name=\"large decorative crest symbol\" height=\"540\" viewbox=\"0 0 620 520\" width=\"640\">\n<g stroke-width=\"1.4\">\n<path d=\"M310 40 L462 260 L310 480 L158 260 Z\"></path>\n<path d=\"M310 104 L404 260 L310 416 L216 260 Z\"></path>\n<path d=\"M310 168 L356 260 L310 352 L264 260 Z\"></path>\n<path d=\"M150 260 H28 M170 186 H52 M170 334 H52 M470 186 H588 M470 334 H588 M490 260 H592\"></path>\n</g>\n</svg>\n<div class=\"relative mx-auto max-w-[1180px]\" data-kid=\"2-2\" data-name=\"hero content container\">\n<div class=\"border border-[#A8232F]/45 p-[6px]\" data-kid=\"2-2-1\" data-name=\"outer ornamental border frame\">\n<div class=\"border border-[#14100E]/18 p-1\" data-kid=\"2-2-1-1\" data-name=\"middle ornamental border frame\">\n<div class=\"border border-[#14100E]/10 px-5 py-11 md:px-12 md:py-14\" data-kid=\"2-2-1-1-1\" data-name=\"inner card content area\">\n<div class=\"flex items-center justify-center gap-4\" data-kid=\"2-2-1-1-1-1\" data-name=\"decorative divider with crest\">\n<span class=\"h-px w-10 bg-[#A8232F]/35 md:w-20\" data-kid=\"2-2-1-1-1-1-1\" data-name=\"short left divider line\"></span>\n<svg aria-hidden=\"true\" class=\"crest shrink-0\" data-kid=\"2-2-1-1-1-1-2\" data-name=\"small crest glyph icon\" height=\"34\" viewbox=\"0 0 48 48\" width=\"34\">\n<path d=\"M24 3 L42 24 L24 45 L6 24 Z\" stroke-width=\"1.4\"></path>\n<path d=\"M24 13 L33 24 L24 35 L15 24 Z\" stroke-width=\"1.2\"></path>\n<path d=\"M24 20 L27 24 L24 28 L21 24 Z\" fill=\"#A8232F\" stroke=\"none\"></path>\n</svg>\n<span class=\"h-px flex-1 bg-[#14100E]/15\" data-kid=\"2-2-1-1-1-1-3\" data-name=\"long divider line\"></span>\n<span class=\"h-px flex-1 bg-[#14100E]/15\" data-kid=\"2-2-1-1-1-1-4\" data-name=\"long divider line\"></span>\n<span class=\"h-px w-10 bg-[#A8232F]/35 md:w-20\" data-kid=\"2-2-1-1-1-1-5\" data-name=\"short right divider line\"></span>\n</div>\n<div class=\"mt-10 grid grid-cols-1 gap-10 md:mt-14 md:grid-cols-12 md:gap-12\" data-kid=\"2-2-1-1-1-2\" data-name=\"hero identity two-column grid\">\n<div class=\"md:col-span-6\" data-kid=\"2-2-1-1-1-2-1\" data-name=\"hero identity left column\">\n<div class=\"mono flex items-center gap-3 text-[10px] uppercase tracking-[0.3em] text-[#A8232F]\" data-kid=\"2-2-1-1-1-2-1-1\" data-name=\"role label row\">\n<span class=\"inline-block h-[6px] w-[6px] rotate-45 bg-[#A8232F]\" data-kid=\"2-2-1-1-1-2-1-1-1\" data-name=\"role label diamond icon\"></span>\n<span data-kid=\"2-2-1-1-1-2-1-1-2\" data-name=\"role label text\">Interface designer</span>\n</div>\n<h1 class=\"display mt-6 text-[62px] leading-[0.9] tracking-[0.01em] md:text-[104px]\" data-kid=\"2-2-1-1-1-2-1-2\" data-name=\"hero name headline\">\n<span class=\"block\" data-kid=\"2-2-1-1-1-2-1-2-1\" data-name=\"first name text\">Aarav</span>\n<span class=\"block text-[#A8232F]\" data-kid=\"2-2-1-1-1-2-1-2-2\" data-name=\"accented surname text\">Menon</span>\n</h1>\n<div class=\"mt-7 h-px w-24 bg-[#A8232F]\" data-kid=\"2-2-1-1-1-2-1-3\" data-name=\"short red underline rule\"></div>\n</div>\n<div class=\"md:col-span-5 md:col-start-8 md:border-l md:border-[#14100E]/12 md:pl-9\" data-kid=\"2-2-1-1-1-2-2\" data-name=\"hero description column\">\n<p class=\"text-[19px] leading-[1.72] text-[#14100E]/80 md:text-[21px]\" data-kid=\"2-2-1-1-1-2-2-1\" data-name=\"hero summary paragraph\">\n                I design booking, payment and publishing interfaces. Eight years in, most of it spent\n                making dense screens feel calm enough to use on a phone at a bus stop.\n              </p>\n</div>\n</div>\n<div class=\"mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-[#14100E]/12 pt-6 md:mt-12\" data-kid=\"2-2-1-1-1-3\" data-name=\"hero social links row\">\n<a class=\"mono group flex items-center gap-2.5 text-[10px] uppercase tracking-[0.24em] text-[#14100E]/75 hover:text-[#A8232F]\" data-kid=\"2-2-1-1-1-3-1\" data-name=\"GitHub quick link\" href=\"https://github.com\">\n<span class=\"inline-block h-[5px] w-[5px] rotate-45 border border-[#A8232F]\" data-kid=\"2-2-1-1-1-3-1-1\" data-name=\"link marker diamond\"></span>GitHub\n            </a>\n<a class=\"mono flex items-center gap-2.5 text-[10px] uppercase tracking-[0.24em] text-[#14100E]/75 hover:text-[#A8232F]\" data-kid=\"2-2-1-1-1-3-2\" data-name=\"Dribbble quick link\" href=\"https://dribbble.com\">\n<span class=\"inline-block h-[5px] w-[5px] rotate-45 border border-[#A8232F]\" data-kid=\"2-2-1-1-1-3-2-1\" data-name=\"link marker diamond\"></span>Dribbble\n            </a>\n<a class=\"mono flex items-center gap-2.5 text-[10px] uppercase tracking-[0.24em] text-[#14100E]/75 hover:text-[#A8232F]\" data-kid=\"2-2-1-1-1-3-3\" data-name=\"LinkedIn quick link\" href=\"https://linkedin.com\">\n<span class=\"inline-block h-[5px] w-[5px] rotate-45 border border-[#A8232F]\" data-kid=\"2-2-1-1-1-3-3-1\" data-name=\"link marker diamond\"></span>LinkedIn\n            </a>\n<a class=\"mono flex items-center gap-2.5 text-[10px] uppercase tracking-[0.24em] text-[#14100E]/75 hover:text-[#A8232F]\" data-kid=\"2-2-1-1-1-3-4\" data-name=\"Email quick link\" href=\"mailto:hello@example.com\">\n<span class=\"inline-block h-[5px] w-[5px] rotate-45 border border-[#A8232F]\" data-kid=\"2-2-1-1-1-3-4-1\" data-name=\"link marker diamond\"></span>Email\n            </a>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"px-5 pb-14 md:px-10 md:pb-20\" data-kid=\"3\" data-name=\"skills section\" id=\"skills\">\n<div class=\"mx-auto max-w-[1180px] border-t border-[#14100E]/15 pt-12 md:pt-16\" data-kid=\"3-1\" data-name=\"skills container\">\n<div class=\"flex flex-col gap-6 md:flex-row md:items-end md:justify-between\" data-kid=\"3-1-1\" data-name=\"skills header row\">\n<div class=\"inline-block\" data-kid=\"3-1-1-1\" data-name=\"skills heading group\" data-rune-host=\"\">\n<h2 class=\"display text-[11px] uppercase tracking-[0.36em] text-[#7A6E62]\" data-kid=\"3-1-1-1-1\" data-name=\"skills section heading\">Skills</h2>\n<svg aria-hidden=\"true\" class=\"mt-3 block text-[#A8232F]\" data-dynamic=\"true\" data-kid=\"3-1-1-1-2\" data-name=\"decorative rune rule under heading\" data-reason=\"path animated via rune draw stroke script\" height=\"8\" viewbox=\"0 0 230 8\" width=\"230\">\n<path class=\"rune-rule\" d=\"M0 4 H96 M112 4 H230\" data-rune=\"\"></path>\n</svg>\n</div>\n</div>\n<ul class=\"mt-8 grid grid-cols-1 gap-px border border-[#14100E]/10 bg-[#14100E]/10 sm:grid-cols-2 md:grid-cols-3\" data-kid=\"3-1-2\" data-name=\"skills grid list\">\n<li class=\"flex items-center gap-4 bg-[#F6F0E6] px-6 py-7\" data-kid=\"3-1-2-1\" data-name=\"skill item: design systems\">\n<span class=\"inline-block h-[7px] w-[7px] rotate-45 border border-[#A8232F]\" data-kid=\"3-1-2-1-1\" data-name=\"skill item diamond marker\"></span>\n<span class=\"display text-[14px] tracking-[0.06em]\" data-kid=\"3-1-2-1-2\" data-name=\"skill name text\">Design systems</span>\n</li>\n<li class=\"flex items-center gap-4 bg-[#F6F0E6] px-6 py-7\" data-kid=\"3-1-2-2\" data-name=\"skill item: interaction design\">\n<span class=\"inline-block h-[7px] w-[7px] rotate-45 border border-[#A8232F]\" data-kid=\"3-1-2-2-1\" data-name=\"skill item diamond marker\"></span>\n<span class=\"display text-[14px] tracking-[0.06em]\" data-kid=\"3-1-2-2-2\" data-name=\"skill name text\">Interaction design</span>\n</li>\n<li class=\"flex items-center gap-4 bg-[#F6F0E6] px-6 py-7\" data-kid=\"3-1-2-3\" data-name=\"skill item: prototyping\">\n<span class=\"inline-block h-[7px] w-[7px] rotate-45 border border-[#A8232F]\" data-kid=\"3-1-2-3-1\" data-name=\"skill item diamond marker\"></span>\n<span class=\"display text-[14px] tracking-[0.06em]\" data-kid=\"3-1-2-3-2\" data-name=\"skill name text\">Prototyping</span>\n</li>\n<li class=\"flex items-center gap-4 bg-[#F6F0E6] px-6 py-7\" data-kid=\"3-1-2-4\" data-name=\"skill item: motion\">\n<span class=\"inline-block h-[7px] w-[7px] rotate-45 border border-[#A8232F]\" data-kid=\"3-1-2-4-1\" data-name=\"skill item diamond marker\"></span>\n<span class=\"display text-[14px] tracking-[0.06em]\" data-kid=\"3-1-2-4-2\" data-name=\"skill name text\">Motion</span>\n</li>\n<li class=\"flex items-center gap-4 bg-[#F6F0E6] px-6 py-7\" data-kid=\"3-1-2-5\" data-name=\"skill item: type\">\n<span class=\"inline-block h-[7px] w-[7px] rotate-45 border border-[#A8232F]\" data-kid=\"3-1-2-5-1\" data-name=\"skill item diamond marker\"></span>\n<span class=\"display text-[14px] tracking-[0.06em]\" data-kid=\"3-1-2-5-2\" data-name=\"skill name text\">Type</span>\n</li>\n<li class=\"flex items-center gap-4 bg-[#F6F0E6] px-6 py-7\" data-kid=\"3-1-2-6\" data-name=\"skill item: research\">\n<span class=\"inline-block h-[7px] w-[7px] rotate-45 border border-[#A8232F]\" data-kid=\"3-1-2-6-1\" data-name=\"skill item diamond marker\"></span>\n<span class=\"display text-[14px] tracking-[0.06em]\" data-kid=\"3-1-2-6-2\" data-name=\"skill name text\">Research</span>\n</li>\n</ul>\n</div>\n</section>\n<section class=\"px-5 pb-16 md:px-10 md:pb-24\" data-kid=\"4\" data-name=\"work section\" id=\"work\">\n<div class=\"mx-auto max-w-[1180px]\" data-kid=\"4-1\" data-name=\"work container\">\n<div class=\"flex flex-col gap-6 md:flex-row md:items-end md:justify-between\" data-kid=\"4-1-1\" data-name=\"work header row\">\n<div class=\"inline-block\" data-kid=\"4-1-1-1\" data-name=\"work heading group\" data-rune-host=\"\">\n<h2 class=\"display text-[11px] uppercase tracking-[0.36em] text-[#7A6E62]\" data-kid=\"4-1-1-1-1\" data-name=\"work section heading\">Selected work</h2>\n<svg aria-hidden=\"true\" class=\"mt-3 block text-[#A8232F]\" data-dynamic=\"true\" data-kid=\"4-1-1-1-2\" data-name=\"decorative rune rule under heading\" data-reason=\"path animated via rune draw stroke script\" height=\"8\" viewbox=\"0 0 290 8\" width=\"290\">\n<path class=\"rune-rule\" d=\"M0 4 H124 M140 4 H290\" data-rune=\"\"></path>\n</svg>\n</div>\n<p class=\"mono text-[10px] uppercase tracking-[0.24em] text-[#7A6E62]\" data-kid=\"4-1-1-2\" data-name=\"work year range label\">2023 — 2025</p>\n</div>\n<ol class=\"mt-10 border-t border-[#14100E]/12\" data-kid=\"4-1-2\" data-name=\"work project list\">\n<li class=\"plate grid grid-cols-1 items-start gap-4 border-b border-[#14100E]/12 px-3 py-8 md:grid-cols-12 md:gap-6 md:px-6 md:py-10\" data-kid=\"4-1-2-1\" data-name=\"project row: Kestrel\">\n<div class=\"md:col-span-3\" data-kid=\"4-1-2-1-1\" data-name=\"project year column\">\n<span class=\"mono text-[11px] uppercase tracking-[0.22em] text-[#7A6E62]\" data-kid=\"4-1-2-1-1-1\" data-name=\"project year text\">2025</span>\n</div>\n<div class=\"md:col-span-8\" data-kid=\"4-1-2-1-2\" data-name=\"project details column\">\n<h3 class=\"display text-[25px] leading-[1.15] tracking-[0.02em] md:text-[31px]\" data-kid=\"4-1-2-1-2-1\" data-name=\"project title: Kestrel\">Kestrel</h3>\n<p class=\"mt-3 max-w-[56ch] text-[17px] leading-[1.65] text-[#14100E]/75 md:text-[18px]\" data-kid=\"4-1-2-1-2-2\" data-name=\"project description text\">\n            A 240-component library and the token pipeline behind it, adopted by four product teams.\n          </p>\n</div>\n<div class=\"flex md:col-span-1 md:justify-end\" data-kid=\"4-1-2-1-3\" data-name=\"project action column\">\n<span class=\"plate-rule block h-px w-10 bg-[#14100E]/25 md:mt-3 md:h-10 md:w-px\" data-kid=\"4-1-2-1-3-1\" data-name=\"project hover rule marker\"></span>\n</div>\n</li>\n<li class=\"plate grid grid-cols-1 items-start gap-4 border-b border-[#14100E]/12 px-3 py-8 md:grid-cols-12 md:gap-6 md:px-6 md:py-10\" data-kid=\"4-1-2-2\" data-name=\"project row: Tide and Timber\">\n<div class=\"md:col-span-3\" data-kid=\"4-1-2-2-1\" data-name=\"project year column\">\n<span class=\"mono text-[11px] uppercase tracking-[0.22em] text-[#7A6E62]\" data-kid=\"4-1-2-2-1-1\" data-name=\"project year text\">2024</span>\n</div>\n<div class=\"md:col-span-8\" data-kid=\"4-1-2-2-2\" data-name=\"project details column\">\n<h3 class=\"display text-[25px] leading-[1.15] tracking-[0.02em] md:text-[31px]\" data-kid=\"4-1-2-2-2-1\" data-name=\"project title: Tide and Timber\">Tide &amp; Timber</h3>\n<p class=\"mt-3 max-w-[56ch] text-[17px] leading-[1.65] text-[#14100E]/75 md:text-[18px]\" data-kid=\"4-1-2-2-2-2\" data-name=\"project description text\">\n            Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.\n          </p>\n</div>\n<div class=\"flex md:col-span-1 md:justify-end\" data-kid=\"4-1-2-2-3\" data-name=\"project action column\">\n<span class=\"plate-rule block h-px w-10 bg-[#14100E]/25 md:mt-3 md:h-10 md:w-px\" data-kid=\"4-1-2-2-3-1\" data-name=\"project hover rule marker\"></span>\n</div>\n</li>\n<li class=\"plate grid grid-cols-1 items-start gap-4 border-b border-[#14100E]/12 px-3 py-8 md:grid-cols-12 md:gap-6 md:px-6 md:py-10\" data-kid=\"4-1-2-3\" data-name=\"project row: Loom Audio\">\n<div class=\"md:col-span-3\" data-kid=\"4-1-2-3-1\" data-name=\"project year column\">\n<span class=\"mono text-[11px] uppercase tracking-[0.22em] text-[#7A6E62]\" data-kid=\"4-1-2-3-1-1\" data-name=\"project year text\">2023</span>\n</div>\n<div class=\"md:col-span-8\" data-kid=\"4-1-2-3-2\" data-name=\"project details column\">\n<h3 class=\"display text-[25px] leading-[1.15] tracking-[0.02em] md:text-[31px]\" data-kid=\"4-1-2-3-2-1\" data-name=\"project title: Loom Audio\">Loom Audio</h3>\n<p class=\"mt-3 max-w-[56ch] text-[17px] leading-[1.65] text-[#14100E]/75 md:text-[18px]\" data-kid=\"4-1-2-3-2-2\" data-name=\"project description text\">\n            A reading surface for long-form audio transcripts, built for one-handed use.\n          </p>\n</div>\n<div class=\"flex md:col-span-1 md:justify-end\" data-kid=\"4-1-2-3-3\" data-name=\"project action column\">\n<span class=\"plate-rule block h-px w-10 bg-[#14100E]/25 md:mt-3 md:h-10 md:w-px\" data-kid=\"4-1-2-3-3-1\" data-name=\"project hover rule marker\"></span>\n</div>\n</li>\n</ol>\n</div>\n</section>\n<section class=\"bg-[#14100E] px-5 py-16 text-[#C9A227] md:px-10 md:py-24\" data-kid=\"5\" data-name=\"experience section (dark)\" id=\"experience\">\n<div class=\"mx-auto max-w-[1180px]\" data-kid=\"5-1\" data-name=\"experience container\">\n<div class=\"flex flex-col gap-6 md:flex-row md:items-end md:justify-between\" data-kid=\"5-1-1\" data-name=\"experience header row\">\n<div class=\"inline-block\" data-kid=\"5-1-1-1\" data-name=\"experience heading group\" data-rune-host=\"\">\n<h2 class=\"display text-[11px] uppercase tracking-[0.36em] text-[#8E8175]\" data-kid=\"5-1-1-1-1\" data-name=\"experience section heading\">Experience</h2>\n<svg aria-hidden=\"true\" class=\"mt-3 block text-[#C9A227]\" data-dynamic=\"true\" data-kid=\"5-1-1-1-2\" data-name=\"decorative rune rule under heading\" data-reason=\"path animated via rune draw stroke script\" height=\"8\" viewbox=\"0 0 250 8\" width=\"250\">\n<path class=\"rune-rule\" d=\"M0 4 H106 M122 4 H250\" data-rune=\"\"></path>\n</svg>\n</div>\n<p class=\"mono text-[10px] uppercase tracking-[0.24em] text-[#8E8175]\" data-kid=\"5-1-1-2\" data-name=\"experience year range label\">2017 — 2026</p>\n</div>\n<ol class=\"mt-10\" data-kid=\"5-1-2\" data-name=\"experience list\">\n<li class=\"grid grid-cols-1 gap-2 border-t border-[#C9A227]/22 py-7 md:grid-cols-12 md:items-baseline\" data-kid=\"5-1-2-1\" data-name=\"experience row: Senior product designer\">\n<span class=\"mono text-[11px] uppercase tracking-[0.22em] text-[#8E8175] md:col-span-3\" data-kid=\"5-1-2-1-1\" data-name=\"role dates text\">2022 — present</span>\n<h3 class=\"display text-[21px] leading-tight text-[#C9A227] md:col-span-6 md:text-[25px]\" data-kid=\"5-1-2-1-2\" data-name=\"role title text\">Senior product designer</h3>\n<p class=\"text-[16px] tracking-[0.04em] text-[#8E8175] md:col-span-3 md:text-right\" data-kid=\"5-1-2-1-3\" data-name=\"company name text\">Fintrail</p>\n</li>\n<li class=\"grid grid-cols-1 gap-2 border-t border-[#C9A227]/22 py-7 md:grid-cols-12 md:items-baseline\" data-kid=\"5-1-2-2\" data-name=\"experience row: Product designer\">\n<span class=\"mono text-[11px] uppercase tracking-[0.22em] text-[#8E8175] md:col-span-3\" data-kid=\"5-1-2-2-1\" data-name=\"role dates text\">2019 — 2022</span>\n<h3 class=\"display text-[21px] leading-tight text-[#C9A227] md:col-span-6 md:text-[25px]\" data-kid=\"5-1-2-2-2\" data-name=\"role title text\">Product designer</h3>\n<p class=\"text-[16px] tracking-[0.04em] text-[#8E8175] md:col-span-3 md:text-right\" data-kid=\"5-1-2-2-3\" data-name=\"company name text\">Sundial Studio</p>\n</li>\n<li class=\"grid grid-cols-1 gap-2 border-y border-[#C9A227]/22 py-7 md:grid-cols-12 md:items-baseline\" data-kid=\"5-1-2-3\" data-name=\"experience row: Interface designer\">\n<span class=\"mono text-[11px] uppercase tracking-[0.22em] text-[#8E8175] md:col-span-3\" data-kid=\"5-1-2-3-1\" data-name=\"role dates text\">2017 — 2019</span>\n<h3 class=\"display text-[21px] leading-tight text-[#C9A227] md:col-span-6 md:text-[25px]\" data-kid=\"5-1-2-3-2\" data-name=\"role title text\">Interface designer</h3>\n<p class=\"text-[16px] tracking-[0.04em] text-[#8E8175] md:col-span-3 md:text-right\" data-kid=\"5-1-2-3-3\" data-name=\"company name text\">Pageturn Press</p>\n</li>\n</ol>\n</div>\n</section>\n<section class=\"px-5 py-16 md:px-10 md:py-20\" data-kid=\"6\" data-name=\"education and elsewhere section\">\n<div class=\"mx-auto grid max-w-[1180px] grid-cols-1 gap-12 md:grid-cols-2 md:gap-16\" data-kid=\"6-1\" data-name=\"two-column section container\">\n<div data-kid=\"6-1-1\" data-name=\"education column\" id=\"education\">\n<div class=\"inline-block\" data-kid=\"6-1-1-1\" data-name=\"education heading group\" data-rune-host=\"\">\n<h2 class=\"display text-[11px] uppercase tracking-[0.36em] text-[#7A6E62]\" data-kid=\"6-1-1-1-1\" data-name=\"education section heading\">Education</h2>\n<svg aria-hidden=\"true\" class=\"mt-3 block text-[#A8232F]\" data-dynamic=\"true\" data-kid=\"6-1-1-1-2\" data-name=\"decorative rune rule under heading\" data-reason=\"path animated via rune draw stroke script\" height=\"8\" viewbox=\"0 0 210 8\" width=\"210\">\n<path class=\"rune-rule\" d=\"M0 4 H88 M104 4 H210\" data-rune=\"\"></path>\n</svg>\n</div>\n<ol class=\"mt-8 space-y-8\" data-kid=\"6-1-1-2\" data-name=\"education list\">\n<li class=\"border-l border-[#A8232F]/45 pl-5\" data-kid=\"6-1-1-2-1\" data-name=\"education entry: NID\">\n<span class=\"mono text-[10px] uppercase tracking-[0.22em] text-[#7A6E62]\" data-kid=\"6-1-1-2-1-1\" data-name=\"education dates text\">2015 — 2017</span>\n<h3 class=\"display mt-2 text-[19px] leading-snug\" data-kid=\"6-1-1-2-1-2\" data-name=\"institution name text\">National Institute of Design</h3>\n<p class=\"mt-1 text-[17px] text-[#14100E]/70\" data-kid=\"6-1-1-2-1-3\" data-name=\"program text\">Interaction design</p>\n</li>\n<li class=\"border-l border-[#A8232F]/45 pl-5\" data-kid=\"6-1-1-2-2\" data-name=\"education entry: Srishti\">\n<span class=\"mono text-[10px] uppercase tracking-[0.22em] text-[#7A6E62]\" data-kid=\"6-1-1-2-2-1\" data-name=\"education dates text\">2013 — 2015</span>\n<h3 class=\"display mt-2 text-[19px] leading-snug\" data-kid=\"6-1-1-2-2-2\" data-name=\"institution name text\">Srishti Institute</h3>\n<p class=\"mt-1 text-[17px] text-[#14100E]/70\" data-kid=\"6-1-1-2-2-3\" data-name=\"program text\">Foundation studies</p>\n</li>\n</ol>\n</div>\n<div data-kid=\"6-1-2\" data-name=\"elsewhere column\" id=\"elsewhere\">\n<div class=\"inline-block\" data-kid=\"6-1-2-1\" data-name=\"elsewhere heading group\" data-rune-host=\"\">\n<h2 class=\"display text-[11px] uppercase tracking-[0.36em] text-[#7A6E62]\" data-kid=\"6-1-2-1-1\" data-name=\"elsewhere section heading\">Elsewhere</h2>\n<svg aria-hidden=\"true\" class=\"mt-3 block text-[#A8232F]\" data-dynamic=\"true\" data-kid=\"6-1-2-1-2\" data-name=\"decorative rune rule under heading\" data-reason=\"path animated via rune draw stroke script\" height=\"8\" viewbox=\"0 0 210 8\" width=\"210\">\n<path class=\"rune-rule\" d=\"M0 4 H88 M104 4 H210\" data-rune=\"\"></path>\n</svg>\n</div>\n<ul class=\"mt-8 border-t border-[#14100E]/12\" data-kid=\"6-1-2-2\" data-name=\"elsewhere links list\">\n<li class=\"border-b border-[#14100E]/12\" data-kid=\"6-1-2-2-1\" data-name=\"elsewhere link row: GitHub\">\n<a class=\"group flex items-center justify-between py-5 hover:text-[#A8232F]\" data-kid=\"6-1-2-2-1-1\" data-name=\"GitHub elsewhere link\" href=\"https://github.com\">\n<span class=\"mono text-[11px] uppercase tracking-[0.24em]\" data-kid=\"6-1-2-2-1-1-1\" data-name=\"link label text\">GitHub</span>\n<span class=\"plate-rule block h-px w-8 bg-[#14100E]/30 group-hover:bg-[#A8232F]\" data-kid=\"6-1-2-2-1-1-2\" data-name=\"link hover rule\"></span>\n</a>\n</li>\n<li class=\"border-b border-[#14100E]/12\" data-kid=\"6-1-2-2-2\" data-name=\"elsewhere link row: Dribbble\">\n<a class=\"group flex items-center justify-between py-5 hover:text-[#A8232F]\" data-kid=\"6-1-2-2-2-1\" data-name=\"Dribbble elsewhere link\" href=\"https://dribbble.com\">\n<span class=\"mono text-[11px] uppercase tracking-[0.24em]\" data-kid=\"6-1-2-2-2-1-1\" data-name=\"link label text\">Dribbble</span>\n<span class=\"plate-rule block h-px w-8 bg-[#14100E]/30 group-hover:bg-[#A8232F]\" data-kid=\"6-1-2-2-2-1-2\" data-name=\"link hover rule\"></span>\n</a>\n</li>\n<li class=\"border-b border-[#14100E]/12\" data-kid=\"6-1-2-2-3\" data-name=\"elsewhere link row: LinkedIn\">\n<a class=\"group flex items-center justify-between py-5 hover:text-[#A8232F]\" data-kid=\"6-1-2-2-3-1\" data-name=\"LinkedIn elsewhere link\" href=\"https://linkedin.com\">\n<span class=\"mono text-[11px] uppercase tracking-[0.24em]\" data-kid=\"6-1-2-2-3-1-1\" data-name=\"link label text\">LinkedIn</span>\n<span class=\"plate-rule block h-px w-8 bg-[#14100E]/30 group-hover:bg-[#A8232F]\" data-kid=\"6-1-2-2-3-1-2\" data-name=\"link hover rule\"></span>\n</a>\n</li>\n<li class=\"border-b border-[#14100E]/12\" data-kid=\"6-1-2-2-4\" data-name=\"elsewhere link row: Email\">\n<a class=\"group flex items-center justify-between py-5 hover:text-[#A8232F]\" data-kid=\"6-1-2-2-4-1\" data-name=\"Email elsewhere link\" href=\"mailto:hello@example.com\">\n<span class=\"mono text-[11px] uppercase tracking-[0.24em]\" data-kid=\"6-1-2-2-4-1-1\" data-name=\"link label text\">Email</span>\n<span class=\"plate-rule block h-px w-8 bg-[#14100E]/30 group-hover:bg-[#A8232F]\" data-kid=\"6-1-2-2-4-1-2\" data-name=\"link hover rule\"></span>\n</a>\n</li>\n</ul>\n</div>\n</div>\n</section>\n<footer class=\"border-t border-[#14100E]/15 bg-[#EBE0CE] px-5 py-10 md:px-10\" data-kid=\"7\" data-name=\"site footer\">\n<div class=\"mx-auto flex max-w-[1180px] flex-col gap-6 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"7-1\" data-name=\"footer inner row\">\n<div class=\"flex items-center gap-3\" data-kid=\"7-1-1\" data-name=\"footer brand lockup\">\n<svg aria-hidden=\"true\" class=\"crest shrink-0\" data-kid=\"7-1-1-1\" data-name=\"footer crest icon\" height=\"26\" viewbox=\"0 0 48 48\" width=\"26\">\n<path d=\"M24 3 L42 24 L24 45 L6 24 Z\" stroke-width=\"1.4\"></path>\n<path d=\"M24 13 L33 24 L24 35 L15 24 Z\" stroke-width=\"1.2\"></path>\n</svg>\n<span class=\"display text-[12px] uppercase tracking-[0.26em]\" data-kid=\"7-1-1-2\" data-name=\"footer brand name text\">Aarav Menon</span>\n</div>\n<a class=\"mono text-[10px] uppercase tracking-[0.24em] text-[#7A6E62] hover:text-[#A8232F]\" data-kid=\"7-1-2\" data-name=\"back to top link\" href=\"#top\">Back to top</a>\n</div>\n</footer>\n</body>",
