      },
      "html": "<body class=\"min-h-screen bg-[#F3F5F7] text-[#141A1F] antialiased\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n    body { font-family: 'Cormorant Garamond', Georgia, serif; }\n    .engraved { font-family: 'Cinzel', Georgia, serif; }\n    .micro { font-family: 'IBM Plex Mono', monospace; }\n    .rule-link { border-bottom: 1px solid currentColor; padding-bottom: 1px; }\n  </style>\n<header class=\"sticky top-0 z-30 border-b border-[#141A1F]/12 bg-[#F3F5F7]/94 backdrop-blur\" data-kid=\"1\" data-name=\"sticky site header\">\n<div class=\"mx-auto flex h-[58px] max-w-[1180px] items-center justify-between px-7\" data-kid=\"1-1\" data-name=\"header row with logo nav and role\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand logo link to top\" href=\"#top\">\n<span class=\"engraved grid h-7 w-7 place-items-center border border-[#141A1F]/30 text-[9px] tracking-[0.08em]\" data-kid=\"1-1-1-1\" data-name=\"AM monogram badge\">AM</span>\n<span class=\"micro text-[10px] uppercase tracking-[0.3em] text-[#141A1F]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">Aarav Menon</span>\n</a>\n<nav class=\"micro hidden items-center gap-7 text-[9px] uppercase tracking-[0.22em] text-[#7C8A93] md:flex\" data-kid=\"1-1-2\" data-name=\"main section navigation\">\n<a data-kid=\"1-1-2-1\" data-name=\"nav link to work section\" href=\"#work\">Work</a><a data-kid=\"1-1-2-2\" data-name=\"nav link to experience section\" href=\"#experience\">Experience</a><a data-kid=\"1-1-2-3\" data-name=\"nav link to education section\" href=\"#education\">Education</a><a data-kid=\"1-1-2-4\" data-name=\"nav link to elsewhere section\" href=\"#elsewhere\">Elsewhere</a>\n</nav>\n<span class=\"micro text-[9px] uppercase tracking-[0.22em] text-[#2F6F8F]\" data-kid=\"1-1-3\" data-name=\"role label in header\">Interface designer</span>\n</div>\n</header>\n<section class=\"relative overflow-hidden\" data-kid=\"2\" data-name=\"hero section with decorative shapes\" id=\"top\">\n<span aria-hidden=\"\" class=\"pointer-events-none absolute -right-24 -top-32 hidden h-[420px] w-[420px] rounded-full border border-[#141A1F]/10 md:block\" data-kid=\"2-1\" data-name=\"decorative outline circle\"></span>\n<span aria-hidden=\"\" class=\"pointer-events-none absolute right-24 top-6 hidden h-[300px] w-[300px] rounded-full border border-[#2F6F8F]/15 md:block\" data-kid=\"2-2\" data-name=\"decorative accent outline circle\"></span>\n<span aria-hidden=\"\" class=\"absolute left-0 top-0 hidden h-full w-px bg-[#141A1F]/12 md:block\" data-kid=\"2-3\" data-name=\"vertical side rule line\" style=\"left:max(28px,calc((100vw - 1180px)/2))\"></span>\n<div class=\"relative mx-auto max-w-[1180px] px-7 pb-14 pt-16 md:pb-16 md:pt-20\" data-kid=\"2-4\" data-name=\"hero content container\">\n<p class=\"micro text-[9px] uppercase tracking-[0.34em] text-[#7C8A93]\" data-kid=\"2-4-1\" data-name=\"location label text\">Bengaluru — portfolio</p>\n<h1 class=\"engraved mt-6 uppercase leading-[0.92]\" data-kid=\"2-4-2\" data-name=\"hero name headline\" style=\"font-size:clamp(3rem,7.6vw,6.2rem); letter-spacing:0.045em; font-weight:500\">\n        Aarav<br data-kid=\"2-4-2-1\" data-name=\"line break\"/>Menon\n      </h1>\n<div class=\"mt-8 grid gap-10 md:grid-cols-[1fr_1fr] md:items-start\" data-kid=\"2-4-3\" data-name=\"hero info grid\">\n<div class=\"flex items-start gap-5\" data-kid=\"2-4-3-1\" data-name=\"role and domain column\">\n<span aria-hidden=\"\" class=\"mt-2 block h-24 w-px bg-[#2F6F8F]\" data-kid=\"2-4-3-1-1\" data-name=\"vertical accent bar\"></span>\n<div data-kid=\"2-4-3-1-2\" data-name=\"role and domain text block\">\n<p class=\"micro text-[9px] uppercase tracking-[0.24em] text-[#2F6F8F]\" data-kid=\"2-4-3-1-2-1\" data-name=\"designed role label\">Interface designer</p>\n<p class=\"engraved mt-3 text-[20px] leading-[1.4] text-[#141A1F]\" data-kid=\"2-4-3-1-2-2\" data-name=\"design domain list\">Booking, payments,<br data-kid=\"2-4-3-1-2-2-1\" data-name=\"line break\"/>publishing</p>\n</div>\n</div>\n<div data-kid=\"2-4-3-2\" data-name=\"about and links block\">\n<p class=\"max-w-[46ch] text-[17px] leading-[1.85] text-[#141A1F]/75\" data-kid=\"2-4-3-2-1\" data-name=\"self-intro paragraph\">\n            I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n          </p>\n<div class=\"mt-6 flex items-center gap-4\" data-kid=\"2-4-3-2-2\" data-name=\"hero action links row\">\n<a class=\"micro rule-link text-[9px] uppercase tracking-[0.2em] text-[#141A1F]\" data-kid=\"2-4-3-2-2-1\" data-name=\"selected work link\" href=\"#work\">Selected work</a>\n<span class=\"h-px w-10 bg-[#141A1F]/25\" data-kid=\"2-4-3-2-2-2\" data-name=\"divider line\"></span>\n<a class=\"micro text-[9px] uppercase tracking-[0.2em] text-[#7C8A93]\" data-kid=\"2-4-3-2-2-3\" data-name=\"reach me contact link\" href=\"#elsewhere\">Reach me</a>\n</div>\n</div>\n</div>\n</div>\n</section>\n<div data-kid=\"3\" data-name=\"skills dark band\" style=\"background:#0E1116; color:#EAF2F7\">\n<div class=\"mx-auto flex max-w-[1180px] flex-wrap items-center gap-x-5 gap-y-2 px-7 py-4\" data-kid=\"3-1\" data-name=\"skills row with label and tags\">\n<span class=\"micro text-[9px] uppercase tracking-[0.26em] text-[#8FA1AC]\" data-kid=\"3-1-1\" data-name=\"skills section label\">Skills</span>\n<span class=\"text-[15px]\" data-kid=\"3-1-2\" data-name=\"skill tag: design systems\" style=\"font-family:'Cormorant Garamond', serif\">Design systems</span>\n<span class=\"h-3 w-px bg-[#EAF2F7]/20\" data-kid=\"3-1-3\" data-name=\"skill tag divider\"></span>\n<span class=\"text-[15px]\" data-kid=\"3-1-4\" data-name=\"skill tag: interaction design\" style=\"font-family:'Cormorant Garamond', serif\">Interaction design</span>\n<span class=\"h-3 w-px bg-[#EAF2F7]/20\" data-kid=\"3-1-5\" data-name=\"skill tag divider\"></span>\n<span class=\"text-[15px]\" data-kid=\"3-1-6\" data-name=\"skill tag: prototyping\" style=\"font-family:'Cormorant Garamond', serif\">Prototyping</span>\n<span class=\"h-3 w-px bg-[#EAF2F7]/20\" data-kid=\"3-1-7\" data-name=\"skill tag divider\"></span>\n<span class=\"text-[15px]\" data-kid=\"3-1-8\" data-name=\"skill tag: motion\" style=\"font-family:'Cormorant Garamond', serif\">Motion</span>\n<span class=\"h-3 w-px bg-[#EAF2F7]/20\" data-kid=\"3-1-9\" data-name=\"skill tag divider\"></span>\n<span class=\"text-[15px]\" data-kid=\"3-1-10\" data-name=\"skill tag: type\" style=\"font-family:'Cormorant Garamond', serif\">Type</span>\n<span class=\"h-3 w-px bg-[#EAF2F7]/20\" data-kid=\"3-1-11\" data-name=\"skill tag divider\"></span>\n<span class=\"text-[15px]\" data-kid=\"3-1-12\" data-name=\"skill tag: research\" style=\"font-family:'Cormorant Garamond', serif\">Research</span>\n</div>\n</div>\n<section class=\"mx-auto max-w-[1180px] px-7 py-14\" data-kid=\"4\" data-name=\"selected work section\" id=\"work\">\n<div class=\"flex items-end justify-between gap-6\" data-kid=\"4-1\" data-name=\"work section header\">\n<div class=\"relative pb-3\" data-kid=\"4-1-1\" data-name=\"work section heading with rune\" data-rune-host=\"\">\n<h2 class=\"engraved text-[30px] uppercase tracking-[0.1em]\" data-kid=\"4-1-1-1\" data-name=\"work section heading text\">Selected work</h2>\n<svg aria-hidden=\"\" class=\"absolute inset-x-0 bottom-0 w-full\" data-kid=\"4-1-1-2\" data-name=\"underline rune svg\" height=\"6\" preserveaspectratio=\"none\" viewbox=\"0 0 600 6\">\n<path d=\"M0 3 H600\" data-rune-path=\"\" fill=\"none\" stroke=\"#2F6F8F\" stroke-width=\"1\"></path>\n</svg>\n</div>\n<span class=\"micro pb-3 text-[9px] uppercase tracking-[0.2em] text-[#7C8A93]\" data-kid=\"4-1-2\" data-name=\"project count label\">03 projects</span>\n</div>\n<div class=\"mt-2 border-t border-[#141A1F]/12\" data-kid=\"4-2\" data-name=\"project list\">\n<article class=\"grid gap-6 border-b border-[#141A1F]/12 py-8 md:grid-cols-[0.9fr_1.1fr] md:items-start\" data-kid=\"4-2-1\" data-name=\"project card: Kestrel\">\n<div data-kid=\"4-2-1-1\" data-name=\"project title column\">\n<p class=\"micro text-[9px] uppercase tracking-[0.22em] text-[#2F6F8F]\" data-kid=\"4-2-1-1-1\" data-name=\"project category label\">Design system</p>\n<h3 class=\"engraved mt-3 text-[40px] uppercase leading-[1] tracking-[0.04em]\" data-kid=\"4-2-1-1-2\" data-name=\"project name heading\">Kestrel</h3>\n</div>\n<div data-kid=\"4-2-1-2\" data-name=\"project description column\">\n<p class=\"max-w-[52ch] text-[16px] leading-[1.85] text-[#141A1F]/75\" data-kid=\"4-2-1-2-1\" data-name=\"project summary text\">\n            A 240-component library and the token pipeline behind it, adopted by four product teams.\n          </p>\n<div class=\"mt-5 flex items-center justify-between\" data-kid=\"4-2-1-2-2\" data-name=\"project meta row\">\n<a class=\"micro rule-link text-[9px] uppercase tracking-[0.2em] text-[#141A1F]\" data-kid=\"4-2-1-2-2-1\" data-name=\"read case study link\" href=\"#work\">Read case study</a>\n<span class=\"micro text-[10px] text-[#7C8A93]\" data-kid=\"4-2-1-2-2-2\" data-name=\"project year\">2025</span>\n</div>\n</div>\n</article>\n<article class=\"grid gap-6 border-b border-[#141A1F]/12 py-8 md:grid-cols-[0.9fr_1.1fr] md:items-start\" data-kid=\"4-2-2\" data-name=\"project card: Tide &amp; Timber\">\n<div data-kid=\"4-2-2-1\" data-name=\"project title column\">\n<p class=\"micro text-[9px] uppercase tracking-[0.22em] text-[#2F6F8F]\" data-kid=\"4-2-2-1-1\" data-name=\"project category label\">Booking app</p>\n<h3 class=\"engraved mt-3 text-[32px] uppercase leading-[1] tracking-[0.04em]\" data-kid=\"4-2-2-1-2\" data-name=\"project name heading\">Tide &amp; Timber</h3>\n</div>\n<div data-kid=\"4-2-2-2\" data-name=\"project description column\">\n<p class=\"max-w-[52ch] text-[16px] leading-[1.85] text-[#141A1F]/75\" data-kid=\"4-2-2-2-1\" data-name=\"project summary text\">\n            Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.\n          </p>\n<div class=\"mt-5 flex items-center justify-between\" data-kid=\"4-2-2-2-2\" data-name=\"project meta row\">\n<a class=\"micro rule-link text-[9px] uppercase tracking-[0.2em] text-[#141A1F]\" data-kid=\"4-2-2-2-2-1\" data-name=\"read case study link\" href=\"#work\">Read case study</a>\n<span class=\"micro text-[10px] text-[#7C8A93]\" data-kid=\"4-2-2-2-2-2\" data-name=\"project year\">2024</span>\n</div>\n</div>\n</article>\n<article class=\"grid gap-6 border-b border-[#141A1F]/12 py-8 md:grid-cols-[0.9fr_1.1fr] md:items-start\" data-kid=\"4-2-3\" data-name=\"project card: Loom Audio\">\n<div data-kid=\"4-2-3-1\" data-name=\"project title column\">\n<p class=\"micro text-[9px] uppercase tracking-[0.22em] text-[#2F6F8F]\" data-kid=\"4-2-3-1-1\" data-name=\"project category label\">Editorial platform</p>\n<h3 class=\"engraved mt-3 text-[32px] uppercase leading-[1] tracking-[0.04em]\" data-kid=\"4-2-3-1-2\" data-name=\"project name heading\">Loom Audio</h3>\n</div>\n<div data-kid=\"4-2-3-2\" data-name=\"project description column\">\n<p class=\"max-w-[52ch] text-[16px] leading-[1.85] text-[#141A1F]/75\" data-kid=\"4-2-3-2-1\" data-name=\"project summary text\">\n            A reading surface for long-form audio transcripts, built for one-handed use.\n          </p>\n<div class=\"mt-5 flex items-center justify-between\" data-kid=\"4-2-3-2-2\" data-name=\"project meta row\">\n<a class=\"micro rule-link text-[9px] uppercase tracking-[0.2em] text-[#141A1F]\" data-kid=\"4-2-3-2-2-1\" data-name=\"read case study link\" href=\"#work\">Read case study</a>\n<span class=\"micro text-[10px] text-[#7C8A93]\" data-kid=\"4-2-3-2-2-2\" data-name=\"project year\">2023</span>\n</div>\n</div>\n</article>\n</div>\n</section>\n<section data-kid=\"5\" data-name=\"experience dark section\" id=\"experience\" style=\"background:#0E1116; color:#EAF2F7\">\n<div class=\"mx-auto max-w-[1180px] px-7 py-14\" data-kid=\"5-1\" data-name=\"experience content container\">\n<div class=\"flex items-end justify-between\" data-kid=\"5-1-1\" data-name=\"experience header\">\n<div class=\"relative pb-3\" data-kid=\"5-1-1-1\" data-name=\"experience heading with rune\" data-rune-host=\"\">\n<h2 class=\"engraved text-[28px] uppercase tracking-[0.1em]\" data-kid=\"5-1-1-1-1\" data-name=\"experience heading text\">Experience</h2>\n<svg aria-hidden=\"\" class=\"absolute inset-x-0 bottom-0 w-full\" data-kid=\"5-1-1-1-2\" data-name=\"underline rune svg\" height=\"6\" preserveaspectratio=\"none\" viewbox=\"0 0 600 6\">\n<path d=\"M0 3 H600\" data-rune-path=\"\" fill=\"none\" stroke=\"#8FA1AC\" stroke-width=\"1\"></path>\n</svg>\n</div>\n<span class=\"micro pb-3 text-[9px] uppercase tracking-[0.2em] text-[#8FA1AC]\" data-kid=\"5-1-1-2\" data-name=\"role count label\">03 roles</span>\n</div>\n<div class=\"mt-4\" data-kid=\"5-1-2\" data-name=\"job list\">\n<div class=\"grid gap-2 border-b border-[#EAF2F7]/12 py-5 md:grid-cols-[240px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"5-1-2-1\" data-name=\"job row: Fintrail\">\n<span class=\"engraved text-[19px] uppercase tracking-[0.05em]\" data-kid=\"5-1-2-1-1\" data-name=\"job company name\">Fintrail</span>\n<span class=\"text-[15px] leading-[1.7] text-[#EAF2F7]/72\" data-kid=\"5-1-2-1-2\" data-name=\"job role description\">Senior product designer — payments, onboarding and the design system.</span>\n<span class=\"micro text-[9px] uppercase tracking-[0.16em] text-[#8FA1AC]\" data-kid=\"5-1-2-1-3\" data-name=\"job date range\">2022 — present</span>\n</div>\n<div class=\"grid gap-2 border-b border-[#EAF2F7]/12 py-5 md:grid-cols-[240px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"5-1-2-2\" data-name=\"job row: Sundial Studio\">\n<span class=\"engraved text-[19px] uppercase tracking-[0.05em]\" data-kid=\"5-1-2-2-1\" data-name=\"job company name\">Sundial Studio</span>\n<span class=\"text-[15px] leading-[1.7] text-[#EAF2F7]/72\" data-kid=\"5-1-2-2-2\" data-name=\"job role description\">Product designer — booking and travel products for three clients.</span>\n<span class=\"micro text-[9px] uppercase tracking-[0.16em] text-[#8FA1AC]\" data-kid=\"5-1-2-2-3\" data-name=\"job date range\">2019 — 2022</span>\n</div>\n<div class=\"grid gap-2 border-b border-[#EAF2F7]/12 py-5 md:grid-cols-[240px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"5-1-2-3\" data-name=\"job row: Pageturn Press\">\n<span class=\"engraved text-[19px] uppercase tracking-[0.05em]\" data-kid=\"5-1-2-3-1\" data-name=\"job company name\">Pageturn Press</span>\n<span class=\"text-[15px] leading-[1.7] text-[#EAF2F7]/72\" data-kid=\"5-1-2-3-2\" data-name=\"job role description\">Interface designer — digital editions of a 90-year-old imprint.</span>\n<span class=\"micro text-[9px] uppercase tracking-[0.16em] text-[#8FA1AC]\" data-kid=\"5-1-2-3-3\" data-name=\"job date range\">2017 — 2019</span>\n</div>\n</div>\n</div>\n</section>\n<div class=\"mx-auto grid max-w-[1180px] gap-12 px-7 py-14 md:grid-cols-2\" data-kid=\"6\" data-name=\"education and elsewhere two-column grid\">\n<section data-kid=\"6-1\" data-name=\"education section\" id=\"education\">\n<div class=\"relative pb-3\" data-kid=\"6-1-1\" data-name=\"education heading with rune\" data-rune-host=\"\">\n<h2 class=\"engraved text-[22px] uppercase tracking-[0.1em]\" data-kid=\"6-1-1-1\" data-name=\"education heading text\">Education</h2>\n<svg aria-hidden=\"\" class=\"absolute inset-x-0 bottom-0 w-full\" data-kid=\"6-1-1-2\" data-name=\"underline rune svg\" height=\"6\" preserveaspectratio=\"none\" viewbox=\"0 0 600 6\">\n<path d=\"M0 3 H600\" data-rune-path=\"\" fill=\"none\" stroke=\"#2F6F8F\" stroke-width=\"1\"></path>\n</svg>\n</div>\n<div class=\"mt-3\" data-kid=\"6-1-2\" data-name=\"education list\">\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#141A1F]/10 py-3.5\" data-kid=\"6-1-2-1\" data-name=\"education entry: NID\">\n<div data-kid=\"6-1-2-1-1\" data-name=\"education institution block\">\n<p class=\"text-[16px] font-medium\" data-kid=\"6-1-2-1-1-1\" data-name=\"institution name\">National Institute of Design</p>\n<p class=\"text-[14px] text-[#7C8A93]\" data-kid=\"6-1-2-1-1-2\" data-name=\"institution program\">Interaction design</p>\n</div>\n<span class=\"micro text-[9px] text-[#7C8A93]\" data-kid=\"6-1-2-1-2\" data-name=\"education date range\">2015 — 2017</span>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#141A1F]/10 py-3.5\" data-kid=\"6-1-2-2\" data-name=\"education entry: Srishti\">\n<div data-kid=\"6-1-2-2-1\" data-name=\"education institution block\">\n<p class=\"text-[16px] font-medium\" data-kid=\"6-1-2-2-1-1\" data-name=\"institution name\">Srishti Institute</p>\n<p class=\"text-[14px] text-[#7C8A93]\" data-kid=\"6-1-2-2-1-2\" data-name=\"institution program\">Foundation studies</p>\n</div>\n<span class=\"micro text-[9px] text-[#7C8A93]\" data-kid=\"6-1-2-2-2\" data-name=\"education date range\">2013 — 2015</span>\n</div>\n</div>\n</section>\n<section data-kid=\"6-2\" data-name=\"elsewhere contacts section\" id=\"elsewhere\">\n<div class=\"relative pb-3\" data-kid=\"6-2-1\" data-name=\"elsewhere heading with rune\" data-rune-host=\"\">\n<h2 class=\"engraved text-[22px] uppercase tracking-[0.1em]\" data-kid=\"6-2-1-1\" data-name=\"elsewhere heading text\">Elsewhere</h2>\n<svg aria-hidden=\"\" class=\"absolute inset-x-0 bottom-0 w-full\" data-kid=\"6-2-1-2\" data-name=\"underline rune svg\" height=\"6\" preserveaspectratio=\"none\" viewbox=\"0 0 600 6\">\n<path d=\"M0 3 H600\" data-rune-path=\"\" fill=\"none\" stroke=\"#2F6F8F\" stroke-width=\"1\"></path>\n</svg>\n</div>\n<div class=\"mt-3\" data-kid=\"6-2-2\" data-name=\"external links list\">\n<a class=\"flex items-baseline justify-between gap-4 border-b border-[#141A1F]/10 py-3.5\" data-kid=\"6-2-2-1\" data-name=\"external link: GitHub\" href=\"#elsewhere\">\n<span class=\"text-[16px]\" data-kid=\"6-2-2-1-1\" data-name=\"link label: GitHub\">GitHub</span><span class=\"micro text-[9px] uppercase tracking-[0.18em] text-[#2F6F8F]\" data-kid=\"6-2-2-1-2\" data-name=\"link open state label\">Open</span>\n</a>\n<a class=\"flex items-baseline justify-between gap-4 border-b border-[#141A1F]/10 py-3.5\" data-kid=\"6-2-2-2\" data-name=\"external link: Dribbble\" href=\"#elsewhere\">\n<span class=\"text-[16px]\" data-kid=\"6-2-2-2-1\" data-name=\"link label: Dribbble\">Dribbble</span><span class=\"micro text-[9px] uppercase tracking-[0.18em] text-[#2F6F8F]\" data-kid=\"6-2-2-2-2\" data-name=\"link open state label\">Open</span>\n</a>\n<a class=\"flex items-baseline justify-between gap-4 border-b border-[#141A1F]/10 py-3.5\" data-kid=\"6-2-2-3\" data-name=\"external link: LinkedIn\" href=\"#elsewhere\">\n<div data-kid=\"6-2-2-3-1\" data-name=\"link label container\"><p class=\"text-[16px]\" data-kid=\"6-2-2-3-1-1\" data-name=\"link label: LinkedIn\">LinkedIn</p></div><span class=\"micro text-[9px] uppercase tracking-[0.18em] text-[#2F6F8F]\" data-kid=\"6-2-2-3-2\" data-name=\"link open state label\">Open</span>\n</a>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#141A1F]/10 py-3.5\" data-kid=\"6-2-2-4\" data-name=\"external link: email\">\n<a class=\"text-[16px]\" data-kid=\"6-2-2-4-1\" data-name=\"link label: Email\" href=\"#elsewhere\">Email</a><span class=\"micro text-[9px] uppercase tracking-[0.18em] text-[#2F6F8F]\" data-kid=\"6-2-2-4-2\" data-name=\"link write prompt label\">Write</span>\n</div>\n</div>\n</section>\n</div>\n<footer class=\"border-t border-[#141A1F]/12\" data-kid=\"7\" data-name=\"site footer\">\n<div class=\"mx-auto flex max-w-[1180px] items-center justify-between px-7 py-5\" data-kid=\"7-1\" data-name=\"footer row with tagline and back to top\">\n<span class=\"micro text-[9px] uppercase tracking-[0.24em] text-[#7C8A93]\" data-kid=\"7-1-1\" data-name=\"footer identity text\">Aarav Menon — interface designer</span>\n<a class=\"micro text-[9px] uppercase tracking-[0.24em] text-[#7C8A93]\" data-kid=\"7-1-2\" data-name=\"back to top link\" href=\"#top\">Back to top</a>\n</div>\n</footer>\n<script>\n    document.querySelectorAll('[data-rune-host]').forEach(function (host) {\n      const path = host.querySelector('[data-rune-path]');\n      if (!path) return;\n      const length = path.getTotalLength();\n      path.style.strokeDasharray = length;\n      path.style.strokeDashoffset = '0';\n      host.addEventListener('pointerenter', function () {\n        path.animate(\n          [{ strokeDashoffset: length }, { strokeDashoffset: 0 }],\n          { duration: 620, easing: 'cubic-bezier(.3,.9,.2,1)', fill: 'both' }\n        );\n      });\n    });\n  </script>\n</body>",
