      "html": "<body class=\"min-h-screen bg-[#f5f5ee] text-[#19352e] font-sans antialiased\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n    body { font-family: Arial, Helvetica, sans-serif; }\n    .spec { font-family: 'IBM Plex Mono', monospace; }\n    .serif { font-family: Georgia, \"Times New Roman\", serif; letter-spacing: -0.04em; }\n    tbody tr:hover { background: #f2f4ed; }\n  </style>\n<div class=\"mx-auto max-w-[1392px] px-7 py-8\" data-kid=\"1\">\n<div class=\"flex flex-wrap items-end justify-between gap-4 border-b border-[#dedfd5] pb-4\" data-kid=\"1-1\">\n<div data-kid=\"1-1-1\">\n<h1 class=\"serif text-[38px] leading-none\" data-kid=\"1-1-1-1\">Template library</h1>\n<p class=\"mt-2 text-[12.5px] text-[#68756c]\" data-kid=\"1-1-1-2\">Every template in <span class=\"spec text-[11.5px]\" data-kid=\"1-1-1-2-1\">src/lib/templates/registry.ts</span>, with its structural family, its signature interaction and its build state.</p>\n</div>\n<div class=\"flex items-center gap-5\" data-kid=\"1-1-2\">\n<div class=\"text-right\" data-kid=\"1-1-2-1\">\n<p class=\"spec text-[9px] uppercase tracking-[0.18em] text-[#93a094]\" data-kid=\"1-1-2-1-1\">Tools</p>\n<p class=\"text-[15px] font-semibold\" data-kid=\"1-1-2-1-2\">22</p>\n</div>\n<div class=\"text-right\" data-kid=\"1-1-2-2\">\n<p class=\"spec text-[9px] uppercase tracking-[0.18em] text-[#93a094]\" data-kid=\"1-1-2-2-1\">Designed</p>\n<p class=\"text-[15px] font-semibold\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2\" data-name=\"designed count value\" data-reason=\"text is templated from the table rows and reinitialized by the registry script\">22</p>\n</div>\n<div class=\"text-right\" data-kid=\"1-1-2-3\">\n<p class=\"spec text-[9px] uppercase tracking-[0.18em] text-[#93a094]\" data-kid=\"1-1-2-3-1\">Bespoke code</p>\n<p class=\"text-[15px] font-semibold\" data-dynamic=\"true\" data-kid=\"1-1-2-3-2\" data-name=\"all-bespoke count value\" data-reason=\"text is templated from the table rows and reinitialized by the registry script\">22</p>\n</div>\n<span class=\"rounded-full bg-[#d7ff70] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-[#19352e]\" data-kid=\"1-1-2-4\">Build passing</span>\n</div>\n</div>\n<table class=\"mt-5 w-full border-collapse\" data-kid=\"1-2\">\n<thead data-kid=\"1-2-1\">\n<tr class=\"spec text-[9px] uppercase tracking-[0.18em] text-[#93a094]\" data-kid=\"1-2-1-1\">\n<th class=\"w-[38px] border-b border-[#dedfd5] py-2 text-left font-medium\" data-kid=\"1-2-1-1-1\">#</th>\n<th class=\"border-b border-[#dedfd5] py-2 text-left font-medium\" data-kid=\"1-2-1-1-2\">Template / world</th>\n<th class=\"w-[120px] border-b border-[#dedfd5] py-2 text-left font-medium\" data-kid=\"1-2-1-1-3\">Layout</th>\n<th class=\"w-[130px] border-b border-[#dedfd5] py-2 text-left font-medium\" data-kid=\"1-2-1-1-4\">Motion</th>\n<th class=\"w-[96px] border-b border-[#dedfd5] py-2 text-left font-medium\" data-kid=\"1-2-1-1-5\">Palette</th>\n<th class=\"w-[210px] border-b border-[#dedfd5] py-2 text-left font-medium\" data-kid=\"1-2-1-1-6\">Structure</th>\n<th class=\"w-[150px] border-b border-[#dedfd5] py-2 text-left font-medium\" data-kid=\"1-2-1-1-7\">State</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-2-2\">\n<tr data-kid=\"1-2-2-1\"><td class=\"pt-5 pb-1 spec text-[9px] uppercase tracking-[0.22em] text-[#67815c]\" colspan=\"7\" data-kid=\"1-2-2-1-1\">Anime — 5</td></tr>\n<tr class=\"border-b border-[#eceae1]\" data-kid=\"1-2-2-2\">\n<td class=\"spec py-2.5 text-[10px] text-[#98a298]\" data-kid=\"1-2-2-2-1\">01</td>\n<td class=\"py-2.5\" data-kid=\"1-2-2-2-2\"><span class=\"text-[13.5px] font-semibold\" data-kid=\"1-2-2-2-2-1\">Konoha Ink</span><span class=\"ml-2 text-[11px] text-[#879186]\" data-kid=\"1-2-2-2-2-2\">Naruto</span></td>\n<td class=\"spec py-2.5 text-[11px]\" data-kid=\"1-2-2-2-3\">scroll</td>\n<td class=\"spec py-2.5 text-[11px]\" data-kid=\"1-2-2-2-4\">inkTrail</td>\n<td c