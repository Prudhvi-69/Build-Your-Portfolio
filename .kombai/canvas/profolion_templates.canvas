      "html": "<body class=\"bg-[#1A141A] text-[#F0ECEC] antialiased\" id=\"top\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap');\n    .deco { font-family: 'Cinzel', Georgia, serif; }\n    .serif { font-family: 'Cormorant Garamond', Georgia, serif; }\n    .notch { clip-path: polygon(0 16px,16px 16px,16px 0,calc(100% - 16px) 0,calc(100% - 16px) 16px,100% 16px,100% calc(100% - 16px),calc(100% - 16px) calc(100% - 16px),calc(100% - 16px) 100%,16px 100%,16px calc(100% - 16px),0 calc(100% - 16px)); }\n    .notch-sm { clip-path: polygon(0 9px,9px 9px,9px 0,calc(100% - 9px) 0,calc(100% - 9px) 9px,100% 9px,100% calc(100% - 9px),calc(100% - 9px) calc(100% - 9px),calc(100% - 9px) 100%,9px 100%,9px calc(100% - 9px),0 calc(100% - 9px)); }\n    .beam {\n      background: linear-gradient(180deg, rgba(207,171,1,.55) 0%, rgba(207,171,1,.18) 44%, rgba(207,171,1,0) 94%);\n      clip-path: polygon(47.4% 0, 52.6% 0, 100% 100%, 0 100%);\n      mix-blend-mode: screen;\n      filter: blur(3px);\n    }\n    .beam-core {\n      background: linear-gradient(180deg, rgba(240,236,236,.5) 0%, rgba(207,171,1,.1) 62%, transparent 100%);\n      clip-path: polygon(49.5% 0, 50.5% 0, 59% 100%, 41% 100%);\n      mix-blend-mode: screen;\n      filter: blur(.6px);\n      opacity: .5;\n    }\n    .dropcap::first-letter { float: left; font-family: 'Cinzel', Georgia, serif; font-size: 56px; line-height: .8; margin: 8px 14px 0 0; color: #CFAB01; }\n    .rail { scrollbar-width: none; }\n    .rail::-webkit-scrollbar { display: none; }\n    .grain::after {\n      content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .35;\n      background-image: radial-gradient(rgba(240,236,236,.06) 1px, transparent 1px);\n      background-size: 3px 3px;\n    }\n  </style>\n<nav class=\"sticky top-0 z-40 border-b border-[#CFAB01]/20 bg-[#1A141A]/93 backdrop-blur-md\" data-kid=\"1\" data-name=\"sticky navigation bar\">\n<div class=\"mx-auto flex h-[76px] max-w-[1180px] items-center justify-between px-10\" data-kid=\"1-1\" data-name=\"nav bar inner layout container\">\n<a class=\"flex items-center gap-4\" data-kid=\"1-1-1\" data-name=\"brand logo link with monogram\" href=\"#top\">\n<span class=\"deco grid h-9 w-9 place-items-center border border-[#CFAB01]/55 bg-[#CFAB01]/10 text-[11px] tracking-[0.08em] text-[#CFAB01]\" data-kid=\"1-1-1-1\" data-name=\"brand monogram badge\">AM</span>\n<span class=\"deco text-[12px] uppercase tracking-[0.34em]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">Aarav Menon</span>\n</a>\n<div class=\"hidden items-center gap-9 deco text-[10px] uppercase tracking-[0.26em] text-[#F0ECEC]/55 md:flex\" data-kid=\"1-1-2\" data-name=\"primary navigation links group\">\n<a class=\"hover:text-[#CFAB01]\" data-kid=\"1-1-2-1\" data-name=\"navigation link to work section\" href=\"#work\">Work</a>\n<a class=\"hover:text-[#CFAB01]\" data-kid=\"1-1-2-2\" data-name=\"navigation link to experience section\" href=\"#experience\">Experience</a>\n<a class=\"hover:text-[#CFAB01]\" data-kid=\"1-1-2-3\" data-name=\"navigation link to education section\" href=\"#education\">Education</a>\n<a class=\"hover:text-[#CFAB01]\" data-kid=\"1-1-2-4\" data-name=\"navigation link to elsewhere section\" href=\"#elsewhere\">Elsewhere</a>\n</div>\n<span class=\"deco text-[9px] uppercase tracking-[0.28em] text-[#F0ECEC]/40\" data-kid=\"1-1-3\" data-name=\"nav bar location text\">Bengaluru, India</span>\n</div>\n</nav>\n<header class=\"relative overflow-hidden border-b border-[#CFAB01]/15\" data-kid=\"2\" data-name=\"hero section\" id=\"hero\">\n<div class=\"pointer-events-none absolute inset-0 z-0\" data-kid=\"2-1\" data-name=\"hero background image container\">\n<img alt=\"Art-deco city towers at night with searchlight beams over the river\" class=\"h-full w-full object-cover\" data-kid=\"2-1-1\" data-name=\"hero background city photograph\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/fb7206cc03a34e3cb5b32d8ec7c9df70.jpg\" style=\"opacity:.34; filter:grayscale(0.55) brightness(.55) contrast(1.15)\"/>\n<div class=\"absolute inset-0\" data-kid=\"2-1-2\" data-name=\"hero gradient overlay\" style=\"background:linear-gradient(180deg, rgba(26,20,26,.62) 0%, rgba(26,20,26,.82) 55%, #1A141A 96%)\"></div>\n</div>\n<div class=\"pointer-events-none absolute inset-x-0 bottom-0 top-[4%] z-[5] overflow-hidden\" data-kid=\"2-2\" data-name=\"searchlight beam container\">\n<div class=\"absolute bottom-0 left-1/2 h-full w-[620px] -translate-x-1/2\" data-kid=\"2-2-1\" data-name=\"searchlight beam wrapper\">\n<div class=\"beam absolute inset-0 origin-bottom\" data-dynamic=\"true\" data-kid=\"2-2-1-1\" data-name=\"searchlight beam glow\" data-reason=\"rotation driven by pointer parallax script\" id=\"beam\"></div>\n<div class=\"beam-core absolute inset-0 origin-bottom\" data-dynamic=\"true\" data-kid=\"2-2-1-2\" data-name=\"searchlight beam core\" data-reason=\"rotation driven by pointer parallax script\" id=\"beamCore\"></div>\n</div>\n</div>\n<svg aria-hidden=\"true\" class=\"pointer-events-none absolute bottom-0 left-0 z-[2] w-full\" data-kid=\"2-3\" data-name=\"decorative art-deco skyline silhouette svg\" fill=\"none\" preserveaspectratio=\"none\" viewbox=\"0 0 1280 250\">\n<g fill=\"#0F0A0F\" stroke=\"#CFAB01\" stroke-opacity=\".14\" stroke-width=\"1\">\n<path d=\"M0 250V150h44v-22h26v-26h30v-22h34v22h30v26h26v22h46v100Z\"></path>\n<path d=\"M268 250V128h30v-26h22v-24h26v-20h28v20h26v24h22v26h32v122Z\"></path>\n<path d=\"M470 250V96h28V70h20V44h26V20h20V8h20v12h20v24h26v26h20v26h30v154Z\"></path>\n<path d=\"M700 250V132h32v-28h24v-26h26v-16h26v16h24v26h22v28h30v118Z\"></path>\n<path d=\"M912 250V160h40v-24h26v-22h30v-18h26v18h28v22h24v24h44v90Z\"></path>\n</g>\n<g fill=\"#CFAB01\" id=\"windows\" opacity=\"1\">\n<rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"60\" y=\"170\"></rect><rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"78\" y=\"170\"></rect><rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"96\" y=\"170\"></rect>\n<rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"60\" y=\"196\"></rect><rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"96\" y=\"196\"></rect><rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"130\" y=\"196\"></rect>\n<rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"78\" y=\"222\"></rect><rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"140\" y=\"170\"></rect>\n<rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"300\" y=\"150\"></rect><rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"318\" y=\"150\"></rect><rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"336\" y=\"176\"></rect>\n<rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"300\" y=\"200\"></rect><rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"336\" y=\"200\"></rect><rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"372\" y=\"176\"></rect>\n<rect class=\"win\" height=\"10\" opacity=\"0.08\" width=\"6\" x=\"372\" y=\"204\"></rect>\n<rect class=\"win\" height=\"12\" opacity=\"0.08\" width=\"6\" x=\"500\" y=\"118\"></rect><rect class=\"win\" height=\"12\" opacity=\"0.08\" width=\"6\" x=\"518\" y=\"118\"></rect><rect class=\"win\" height=\"12\" opacity=\"0.08\" width=\"6\" x=\"536\" y=\"118\"></rect>\n<rect class=\"win\" height=\"12\" opacity=\"0.08\" width=\"6\" x=\"500\" y=\"148\"></rect><rect class=\"win\" height=\"12\" opacity=\"0.08\" width=\"6\" x=\"536\" y=\"148\"></rect><rect class=\"win\" height=\"12\" opacity=\"0.08\" width=\"6\" x=\"554\" y=\"148\"></rect>\n<rect class=\"win\" height=\"12\" opacity=\"0.08\" width=\"6\" x=\"500\" y=\"180\"></rect><rect class=\"win\" height=\"12\" opacity=\"0.08\" width=\"6\" x=\"51