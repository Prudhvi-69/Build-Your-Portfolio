      "html": "<div class=\"min-h-screen overflow-x-hidden bg-[#F0ECE4] vl-body text-[#101519]\" data-kid=\"4\" data-name=\"vinland coast portfolio page root\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n    .vl-display { font-family: 'Bebas Neue', Impact, sans-serif; letter-spacing: 0.01em; }\n    .vl-body { font-family: 'Instrument Sans', 'Helvetica Neue', sans-serif; }\n    .vl-mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }\n    .vl-speckle { background-image: radial-gradient(#101519 1px, transparent 1.3px), radial-gradient(#101519 1px, transparent 1.1px); background-size: 13px 13px, 19px 19px; background-position: 0 0, 6px 8px; opacity: 0.07; }\n    .vl-axe { clip-path: polygon(0 0, 100% 0, 100% 52%, 88% 100%, 68% 48%, 44% 94%, 22% 46%, 0 82%); }\n    .vl-worn { height: 1px; background-image: repeating-linear-gradient(90deg, rgba(16, 21, 25, 0.55) 0 34px, transparent 34px 43px); }\n    .vl-worn-dark { height: 1px; background-image: repeating-linear-gradient(90deg, rgba(233, 223, 201, 0.5) 0 30px, transparent 30px 39px); }\n    .vl-lean { will-change: transform; }\n  </style>\n<header class=\"sticky top-0 z-30 border-b border-[#101519]/15 bg-[#F0ECE4]/95 backdrop-blur\" data-kid=\"1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[68px] max-w-[1180px] items-center justify-between px-6\" data-kid=\"1-1\" data-name=\"header content row\">\n<a class=\"flex items-center gap-3.5\" data-kid=\"1-1-1\" data-name=\"owner monogram home link\" href=\"#top\">\n<span class=\"grid h-9 w-9 place-items-center bg-[#C77B33] vl-display text-[15px] tracking-[0.06em] text-[#101519]\" data-kid=\"1-1-1-1\" data-name=\"AM monogram block\">AM</span>\n<span class=\"vl-display text-[24px] uppercase leading-none tracking-[0.08em] text-[#101519]\" data-kid=\"1-1-1-2\" data-name=\"owner name logo text\">Aarav Menon</span>\n</a>\n<nav class=\"hidden items-center gap-7 vl-mono text-[10px] uppercase tracking-[0.2em] text-[#6D7176] md:flex\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n<a class=\"hover:text-[#C77B33]\" data-kid=\"1-1-2-1\" data-name=\"work section nav link\" href=\"#work\">Work</a>\n<a class=\"hover:text-[#C77B33]\" data-kid=\"1-1-2-2\" data-name=\"experience section nav link\" href=\"#experience\">Experience</a>\n<a class=\"hover:text-[#C77B33]\" data-kid=\"1-1-2-3\" data-name=\"education section nav link\" href=\"#education\">Education</a>\n<a class=\"hover:text-[#C77B33]\" data-kid=\"1-1-2-4\" data-name=\"links section nav link\" href=\"#links\">Links</a>\n</nav>\n<span class=\"vl-mono text-[10px] uppercase tracking-[0.2em] text-[#6D7176]\" data-kid=\"1-1-3\" data-name=\"role label in header\">Interface designer</span>\n</div>\n</header>\n<main data-kid=\"2\" data-name=\"mass page main body\">\n<section class=\"relative overflow-hidden bg-[#E4DED3]\" data-kid=\"2-1\" data-name=\"rugged poster band hero\" id=\"top\">\n<div class=\"pointer-events-none absolute inset-0 vl-speckle\" data-kid=\"2-1-3\" data-name=\"weathered paper speckle overlay\"></div>\n<div class=\"relative mx-auto max-w-[1180px] px-6 pt-12\" data-kid=\"2-1-1\" data-name=\"poster band content\">\n<div class=\"flex items-start justify-between gap-6\" data-kid=\"2-1-1-1\" data-name=\"band top row\">\n<div class=\"flex items-center gap-3\" data-kid=\"2-1-1-1-1\" data-name=\"role marker row\">\n<span class=\"block h-[3px] w-11 bg-[#C77B33]\" data-kid=\"2-1-1-1-1-1\" data-name=\"ochre rule mark\"></span>\n<span class=\"vl-mono text-[10px] uppercase tracking-[0.24em] text-[#6D7176]\" data-kid=\"2-1-1-1-1-2\" data-name=\"role eyebrow label\">Interface designer</span>\n</div>\n<span class=\"vl-mono text-[10px] uppercase tracking-[0.24em] text-[#6D7176]\" data-kid=\"2-1-1-1-2\" data-name=\"monogram label\">AM</span>\n</div>\n<h1 class=\"vl-display mt-5 text-[76px] uppercase leading-[0.78] tracking-[0.005em] text-[#101519] md:text-[148px]\" data-kid=\"2-1-1-2\" data-name=\"owner name poster headline\">Aarav Menon</h1>\n<div class=\"mt-9 grid grid-cols-12 gap-x-8 gap-y-7 border-t border-[#101519]/25 pt-7\" data-kid=\"2-1-1-3\" data-name=\"poster band lower grid\">\n<div class=\"col-span-12 md:col-span-7\" data-kid=\"2-1-1-3-1\" data-name=\"bio column\">\n<p class=\"max-w-[54ch] text-[17px] leading-[1.7] text-[#101519]\" data-kid=\"2-1-1-3-1-1\" data-name=\"owner bio paragraph\">I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.</p>\n</div>\n<div class=\"col-span-12 md:col-span-5\" data-kid=\"2-1-1-3-2\" data-name=\"skills column\">\n<span class=\"vl-mono text-[10px] uppercase tracking-[0.24em] text-[#6D7176]\" data-kid=\"2-1-1-3-2-1\" data-name=\"skills section label\">Skills</span>\n<div class=\"mt-3 flex flex-wrap gap-2\" data-kid=\"2-1-1-3-2-2\" data-name=\"skills chip row\">\n<span class=\"vl-lean border border-[#101519]/55 bg-[#F0ECE4] px-2.5 py-1.5 vl-mono text-[10px] uppercase tracking-[0.14em] text-[#101519]\" data-kid=\"2-1-1-3-2-2-1\" data-magnet=\"\" data-name=\"design systems skill chip\">Design systems</span>\n<span class=\"vl-lean border border-[#101519]/55 bg-[#F0ECE4] px-2.5 py-1.5 vl-mono text-[10px] uppercase tracking-[0.14em] text-[#101519]\" data-kid=\"2-1-1-3-2-2-2\" data-magnet=\"\" data-name=\"interaction design skill chip\">Interaction design</span>\n<span class=\"vl-lean border border-[#101519]/55 bg-[#F0ECE4] px-2.5 py-1.5 vl-mono text-[10px] uppercase tracking-[0.14em] text-[#101519]\" data-kid=\"2-1-1-3-2-2-3\" data-magnet=\"\" data-name=\"prototyping skill chip\">Prototyping</span>\n<span class=\"vl-lean border border-[#101519]/55 bg-[#F0ECE4] px-2.5 py-1.5 vl-mono text-[10px] uppercase tracking-[0.14em] text-[#101519]\" data-kid=\"2-1-1-3-2-2-4\" data-magnet=\"\" data-name=\"motion skill chip\">Motion</span>\n<span class=\"vl-lean border border-[#101519]/55 bg-[#F0ECE4] px-2.5 py-1.5 vl-mono text-[10px] uppercase tracking-[0.14em] text-[#101519]\" data-kid=\"2-1-1-3-2-2-5\" data-magnet=\"\" data-name=\"type skill chip\">Type</span>\n<span class=\"vl-lean border border-[#101519]/55 bg-[#F0ECE4] px-2.5 py-1.5 vl-mono text-[10px] uppercase tracking-[0.14em] text-[#101519]\" data-kid=\"2-1-1-3-2-2-6\" data-magnet=\"\" data-name=\"research skill chip\">Research</span>\n</div>\n</div>\n</div>\n<div class=\"mt-7 flex flex-wrap items-center gap-x-9 gap-y-3 pb-12\" data-kid=\"2-1-1-4\" data-name=\"poster contact link row\">\n<a class=\"vl-mono text-[10px] uppercase tracking-[0.2em] text-[#101519] underline decoration-[#C77B33] decoration-2 underline-offset-[6px] hover:text-[#C77B33]\" data-kid=\"2-1-1-4-1\" data-name=\"github contact link\" href=\"https://github.com\">GitHub</a>\n<a class=\"vl-mono text-[10px] uppercase tracking-[0.2em] text-[#101519] underline decoration-[#C77B33] decoration-2 underline-offset-[6px] hover:text-[#C77B33]\" data-kid=\"2-1-1-4-2\" data-name=\"dribbble contact link\" href=\"https://dribbble.com\">Dribbble</a>\n<a class=\"vl-mono text-[10px] uppercase tracking-[0.2em] text-[#101519] underline decoration-[#C77B33] decoration-2 underline-offset-[6px] hover:text-[#C77B33]\" data-kid=\"2-1-1-4-3\" data-name=\"linkedin contact link\" href=\"https://linkedin.com\">LinkedIn</a>\n<a class=\"vl-mono text-[10px] uppercase tracking-[0.2em] text-[#101519] underline decoration-[#C77B33] decoration-2 underline-offset-[6px] hover:text-[#C77B33]\" data-kid=\"2-1-1-4-4\" data-name=\"email contact link\" href=\"mailto:hello@example.com\">Email</a>\n</div>\n</div>\n<div class=\"vl-axe h-16 w-full bg-[#101519]\" data-kid=\"2-1-2\" data-name=\"axe cut band edge\"></div>\n</section>\n<section class=\"mx-auto max-w-[1180px] px-6 pb-4 pt-12\" data-kid=\"2-2\" data-name=\"selected work section\" id=\"work\">\n<div class=\"flex items-end justify-between gap-6\" data-kid=\"2-2-1\" data-name=\"work section header row\">\n<h2 class=\"vl-display text-[44px] uppercase leading-none text-[#101519] md:text-[60px]\" data-kid=\"2-2-1-1\" data-name=\"selected work section heading\">Selected work</h2>\n<div class=\"mb-2 hidden flex-1 vl-worn md:block\" data-kid=\"2-2-1-2\" data-name=\"worn dividing rule\"></div>\n<span class=\"vl-mono text-[11px] uppercase tracking-[0.2em] text-[#6D7176]\" data-kid=\"2-2-1-3\" data-name=\"project count label\">03</span>\n</div>\n<div class=\"mt-4\" data-kid=\"2-2-2\" data-name=\"work project row list\">\n<article class=\"vl-lean group grid grid-cols-12 items-baseline gap-x-5 gap-y-2 border-b border-[#101519]/15 py-7\" data-kid=\"2-2-2-1\" data-magnet=\"\" data-name=\"kestrel project row\">\n<span class=\"col-span-2 vl-mono text-[11px] tracking-[0.14em] text-[#6D7176] md:col-span-1\" data-kid=\"2-2-2-1-1\" data-name=\"project index label\">01</span>\n<h3 class=\"col-span-10 vl-display text-[34px] uppercase leading-[0.95] text-[#101519] group-hover:text-[#C77B33] md:col-span-5 md:text-[46px]\" data-kid=\"2-2-2-1-2\" data-name=\"kestrel project title\">Kestrel</h3>\n<p class=\"col-span-12 text-[14px] leading-[1.6] text-[#6D7176] md:col-span-4\" data-kid=\"2-2-2-1-3\" data-name=\"kestrel project description\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n<span class=\"col-span-12 vl-mono text-[11px] tracking-[0.14em] text-[#101519] md:col-span-2 md:text-right\" data-kid=\"2-2-2-1-4\" data-name=\"kestrel project year label\">2025</span>\n</article>\n<article class=\"vl-lean group grid grid-cols-12 items-baseline gap-x-5 gap-y-2 border-b border-[#101519]/15 py-7 md:pl-12\" data-kid=\"2-2-2-2\" data-magnet=\"\" data-name=\"tide and timber project row\">\n<span class=\"col-span-2 vl-mono text-[11px] tracking-[0.14em] text-[#6D7176] md:col-span-1\" data-kid=\"2-2-2-2-1\" data-name=\"project index label\">02</span>\n<h3 class=\"col-span-10 vl-display text-[34px] uppercase leading-[0.95] text-[#101519] group-hover:text-[#C77B33] md:col-span-5 md:text-[46px]\" data-kid=\"2-2-2-2-2\" data-name=\"tide and timber project title\">Tide &amp; Timber</h3>\n<p class=\"col-span-12 text-[14px] leading-[1.6] text-[#6D7176] md:col-span-4\" data-kid=\"2-2-2-2-3\" data-name=\"tide and timber project description\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n<span class=\"col-span-12 vl-mono text-[11px] tracking-[0.14em] text-[#101519] md:col-span-2 md:text-right\" data-kid=\"2-2-2-2-4\" data-name=\"tide and timber project year label\">2024</span>\n</article>\n<article class=\"vl-lean group grid grid-cols-12 items-baseline gap-x-5 gap-y-2 border-b border-[#101519]/15 py-7 md:pr-12\" data-kid=\"2-2-2-3\" data-magnet=\"\" data-name=\"loom audio project row\">\n<span class=\"col-span-2 vl-mono text-[11px] tracking-[0.14em] text-[#6D7176] md:col-span-1\" data-kid=\"2-2-2-3-1\" data-name=\"project index label\">03</span>\n<h3 class=\"col-span-10 vl-display text-[34px] uppercase leading-[0.95] text-[#101519] group-hover:text-[#C77B33] md:col-span-5 md:text-[46px]\" data-kid=\"2-2-2-3-2\" data-name=\"loom audio project title\">Loom Audio</h3>\n<p class=\"col-span-12 text-[14px] leading-[1.6] text-[#6D7176] md:col-span-4\" data-kid=\"2-2-2-3-3\" data-name=\"loom audio project description\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n<span class=\"col-span-12 vl-mono text-[11px] tracking-[0.14em] text-[#101519] md:col-span-2 md:text-right\" data-kid=\"2-2-2-3-4\" data-name=\"loom audio project year label\">2023</span>\n</article>\n</div>\n</section>\n<section class=\"mt-14 bg-[#101519] py-16 text-[#E9DFC9]\" data-kid=\"2-3\" data-name=\"experience dark band section\" id=\"experience\">\n<div class=\"mx-auto max-w-[1180px] px-6\" data-kid=\"2-3-1\" data-name=\"experience band content\">\n<div class=\"mb-9 flex items-center gap-5\" data-kid=\"2-3-1-1\" data-name=\"horizon rule ornament\">\n<div class=\"h-[2px] flex-1 bg-[#E9DFC9]/35\" data-kid=\"2-3-1-1-1\" data-name=\"horizon rule left\"></div>\n<span class=\"block h-3 w-3 rotate-45 bg-[#C77B33]\" data-kid=\"2-3-1-1-2\" data-name=\"horizon notch mark\"></span>\n<div class=\"h-[2px] flex-1 bg-[#E9DFC9]/35\" data-kid=\"2-3-1-1-3\" data-name=\"horizon rule right\"></div>\n</div>\n<div class=\"flex items-end justify-between gap-6\" data-kid=\"2-3-1-2\" data-name=\"experience header row\">\n<h2 class=\"vl-display text-[40px] uppercase leading-none text-[#E9DFC9] md:text-[54px]\" data-kid=\"2-3-1-2-1\" data-name=\"experience section heading\">Experience</h2>\n<div class=\"mb-2 hidden flex-1 vl-worn-dark md:block\" data-kid=\"2-3-1-2-2\" data-name=\"worn dividing rule\"></div>\n<span class=\"vl-mono text-[10px] uppercase tracking-[0.22em] text-[#8A8D8F]\" data-kid=\"2-3-1-3\" data-name=\"experience roles label\">Roles</span>\n</div>\n<div class=\"mt-4 divide-y divide-[#E9DFC9]/15\" data-kid=\"2-3-2\" data-name=\"experience entry list\">\n<div class=\"grid grid-cols-12 items-baseline gap-x-5 gap-y-2 py-6\" data-kid=\"2-3-2-1\" data-name=\"fintrail experience row\">\n<span class=\"col-span-12 vl-mono text-[11px] tracking-[0.14em] text-[#8A8D8F] md:col-span-2\" data-kid=\"2-3-2-1-1\" data-name=\"experience date label\">2022 — present</span>\n<span class=\"col-span-12 vl-display text-[26px] uppercase leading-none text-[#E9DFC9] md:col-span-5 md:text-[32px]\" data-kid=\"2-3-2-1-2\" data-name=\"fintrail employer name\">Fintrail</span>\n<span class=\"col-span-12 text-[14px] text-[#8A8D8F] md:col-span-5\" data-kid=\"2-3-2-1-3\" data-name=\"fintrail role title\">Senior product designer</span>\n</div>\n<div class=\"grid grid-cols-12 items-baseline gap-x-5 gap-y-2 py-6\" data-kid=\"2-3-2-2\" data-name=\"sundial studio experience row\">\n<span class=\"col-span-2 vl-mono text-[11px] tracking-[0.14em] text-[#8A8D8F] md:col-span-2\" data-kid=\"2-3-2-2-1\" data-name=\"experience date label\">2019 — 2022</span>\n<span class=\"col-span-10 vl-display text-[30px] uppercase leading-none text-[#E9DFC9] md:col-span-5 md:text-[32px]\" data-kid=\"2-3-2-2-2\" data-name=\"sundial studio employer name\">Sundial Studio</span>\n<span class=\"col-span-12 text-[14px] text-[#8A8D8F] md:col-span-5\" data-kid=\"2-3-2-2-3\" data-name=\"sundial studio role title\">Product designer</span>\n</div>\n<div class=\"grid grid-cols-12 items-baseline gap-x-5 gap-y-2 py-6\" data-kid=\"2-3-2-3\" data-name=\"pageturn press experience row\">\n<span class=\"col-span-12 vl-mono text-[11px] tracking-[0.14em] text-[#8A8D8F] md:col-span-2\" data-kid=\"2-3-2-3-1\" data-name=\"experience date label\">2017 — 2019</span>\n<span class=\"col-span-12 vl-display text-[30px] uppercase leading-none text-[#E9DFC9] md:col-span-5 md:text-[32px]\" data-kid=\"2-3-2-3-2\" data-name=\"pageturn press employer name\">Pageturn Press</span>\n<span class=\"col-span-12 text-[14px] text-[#8A8D8F] md:col-span-5\" data-kid=\"2-3-2-3-3\" data-name=\"pageturn press role title\">Interface designer</span>\n</div>\n</div>\n</div>\n</section>\n<section class=\"mx-auto max-w-[1180px] px-6 pb-4 pt-14\" data-kid=\"2-4\" data-name=\"education section\" id=\"education\">\n<div class=\"flex items-end justify-between gap-6\" data-kid=\"2-4-1\" data-name=\"education header row\">\n<h2 class=\"vl-display text-[40px] uppercase leading-none text-[#101519] md:text-[54px]\" data-kid=\"2-4-1-1\" data-name=\"education section heading\">Education</h2>\n<div class=\"mb-2 hidden flex-1 vl-worn md:block\" data-kid=\"2-4-1-2\" data-name=\"worn dividing rule\"></div>\n<span class=\"vl-mono text-[11px] uppercase tracking-[0.2em] text-[#6D7176]\" data-kid=\"2-3-1-4\" data-name=\"education count label\">02</span>\n</div>\n<div class=\"mt-6 grid grid-cols-12 gap-x-8 gap-y-8 border-t border-[#101519]/15 pt-6\" data-kid=\"2-4-2\" data-name=\"education entry grid\">\n<div class=\"col-span-12 grid grid-cols-12 gap-x-4 md:col-span-6\" data-kid=\"2-4-2-1\" data-name=\"national institute of design entry\">\n<span class=\"col-span-2 vl-display text-[30px] leading-none text-[#C77B33]\" data-kid=\"2-4-2-1-1\" data-name=\"entry index numeral\">01</span>\n<div class=\"col-span-10\" data-kid=\"2-4-2-1-2\" data-name=\"entry detail column\">\n<h3 class=\"vl-display text-[26px] uppercase leading-tight text-[#101519]\" data-kid=\"2-4-2-1-2-1\" data-name=\"institution name\">National Institute of Design</h3>\n<p class=\"mt-1 text-[14px] text-[#6D7176]\" data-kid=\"2-4-2-1-2-2\" data-name=\"programme name\">Interaction design</p>\n<p class=\"mt-2 vl-mono text-[11px] uppercase tracking-[0.14em] text-[#6D7176]\" data-kid=\"2-4-2-1-2-3\" data-name=\"study period\">2015 — 2017</p>\n</div>\n</div>\n<div class=\"col-span-12 grid grid-cols-12 gap-x-4 md:col-span-6\" data-kid=\"2-4-2-2\" data-name=\"srishti institute entry\">\n<span class=\"col-span-2 vl-display text-[30px] leading-none text-[#C77B33]\" data-kid=\"2-4-2-2-1\" data-name=\"entry index numeral\">02</span>\n<div class=\"col-span-10\" data-kid=\"2-4-2-2-2\" data-name=\"entry detail column\">\n<h3 class=\"vl-display text-[26px] uppercase leading-tight text-[#101519]\" data-kid=\"2-4-2-2-2-1\" data-name=\"institution name\">Srishti Institute</h3>\n<p class=\"mt-1 text-[14px] text-[#6D7176]\" data-kid=\"2-4-2-2-2-2\" data-name=\"programme name\">Foundation studies</p>\n<p class=\"mt-2 vl-mono text-[11px] uppercase tracking-[0.14em] text-[#6D7176]\" data-kid=\"2-4-2-2-2-3\" data-name=\"study period\">2013 — 2015</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"mx-auto max-w-[1180px] px-6 pb-16 pt-14\" data-kid=\"2-5\" data-name=\"links section\" id=\"links\">\n<div class=\"flex items-end justify-between gap-6\" data-kid=\"2-5-1\" data-name=\"links header row\">\n<h2 class=\"vl-display text-[40px] uppercase leading-none text-[#101519] md:text-[54px]\" data-kid=\"2-5-1-1\" data-name=\"links section heading\">Links</h2>\n<div class=\"mb-2 hidden flex-1 vl-worn md:block\" data-kid=\"2-5-1-2\" data-name=\"worn dividing rule\"></div>\n<span class=\"vl-mono text-[11px] uppercase tracking-[0.2em] text-[#6D7176]\" data-kid=\"2-5-1-3\" data-name=\"links count label\">04</span>\n</div>\n<div class=\"mt-6 grid grid-cols-2 gap-3 md:grid-cols-4\" data-kid=\"2-4-1-3\" data-name=\"contact block grid\">\n<a class=\"flex items-center justify-between border border-[#101519]/50 bg-[#E4DED3] px-4 py-3.5 hover:bg-[#101519] hover:text-[#E9DFC9]\" data-kid=\"2-4-2-3\" data-name=\"github contact block\" href=\"https://github.com\">\n<span class=\"vl-mono text-[10px] uppercase tracking-[0.18em]\" data-kid=\"2-4-2-3-1\" data-name=\"github label text\">GitHub</span>\n<svg class=\"h-3 w-3\" data-kid=\"2-4-2-3-2\" data-name=\"external link arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 12 12\"><path d=\"M3 9 9 3M4.5 3H9v4.5\"></path></svg>\n</a>\n<a class=\"flex items-center justify-between border border-[#101519]/55 bg-[#E4DED3] px-4 py-3.5 text-[#101519] hover:bg-[#101519] hover:text-[#E9DFC9]\" data-kid=\"2-4-2-4\" data-name=\"dribbble contact link block\" href=\"https://dribbble.com\">\n<span class=\"vl-mono text-[10px] uppercase tracking-[0.18em]\" data-kid=\"2-4-2-4-1\" data-name=\"dribbble label text\">Dribbble</span>\n<svg class=\"h-3 w-3\" data-kid=\"2-4-2-4-2\" data-name=\"external link arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 12 12\"><path d=\"M3 9 9 3M4.5 3H9v4.5\"></path></svg>\n</a>\n<a class=\"flex items-center justify-between border border-[#101519]/55 bg-[#E4DED3] px-4 py-3.5 text-[#101519] hover:bg-[#101519] hover:text-[#E9DFC9]\" data-kid=\"2-4-2-5\" data-name=\"linkedin contact link block\" href=\"https://linkedin.com\">\n<span class=\"vl-mono text-[10px] uppercase tracking-[0.14em]\" data-kid=\"2-4-2-5-1\" data-name=\"linkedin label text\">LinkedIn</span>\n<svg class=\"h-3 w-3\" data-kid=\"2-4-2-5-2\" data-name=\"external link arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 