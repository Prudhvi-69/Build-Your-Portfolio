      "html": "<div class=\"al-root min-h-screen w-full bg-[#E6F2F2] text-[#04121A] antialiased\" data-kid=\"7\" data-name=\"page layout root container\">\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&family=Nunito:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  .al-root{font-family:'Nunito','Helvetica Neue',Arial,sans-serif;}\n  .al-display{font-family:'Fraunces',Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-0.01em;}\n  .al-mono{font-family:'IBM Plex Mono',ui-monospace,SFMono-Regular,monospace;}\n  .al-shaft{position:absolute;transform:skewX(-11deg);background:linear-gradient(180deg,rgba(255,255,255,0.5),rgba(255,255,255,0));}\n  .al-caustic{position:absolute;border-radius:9999px;background:radial-gradient(circle,rgba(230,242,242,0.32),rgba(230,242,242,0) 68%);}\n  .al-rail{scrollbar-width:none;cursor:grab;}\n  .al-rail::-webkit-scrollbar{display:none;}\n  .al-link{transition:color 180ms ease,border-color 180ms ease;}\n  @media (prefers-reduced-motion: reduce){ .al-link{transition:none;} }\n</style>\n<header class=\"sticky top-0 z-30 border-b border-[#04121A]/10 bg-[#E6F2F2]/95\" data-kid=\"1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[64px] max-w-[1180px] items-center justify-between px-5 md:px-7\" data-kid=\"1-1\" data-name=\"header inner flexbar\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#top\">\n<span class=\"al-mono grid h-8 w-8 place-items-center rounded-full border border-[#17888F] text-[10px] tracking-[0.06em] text-[#17888F]\" data-kid=\"1-1-1-1\" data-name=\"brand monogram badge\">AM</span>\n<span class=\"al-display text-[16px]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">Aarav Menon</span>\n</a>\n<nav class=\"al-mono hidden items-center gap-8 text-[10px] uppercase tracking-[0.26em] text-[#5C7378] md:flex\" data-kid=\"1-2\" data-name=\"section navigation menu\">\n<a class=\"al-link hover:text-[#17888F]\" data-kid=\"1-2-1\" data-name=\"navigation link Work\" href=\"#work\">Work</a>\n<a class=\"al-link hover:text-[#17888F]\" data-kid=\"1-2-2\" data-name=\"navigation link Experience\" href=\"#experience\">Experience</a>\n<a class=\"al-link hover:text-[#17888F]\" data-kid=\"1-2-3\" data-name=\"navigation link Education\" href=\"#education\">Education</a>\n<a class=\"al-link hover:text-[#17888F]\" data-kid=\"1-2-4\" data-name=\"navigation link Links\" href=\"#links\">Links</a>\n</nav>\n<a class=\"al-mono border-b border-[#17888F]/50 pb-1 text-[10px] uppercase tracking-[0.26em] text-[#17888F] md:hidden\" data-kid=\"1-1-3\" data-name=\"mobile nav Work link\" href=\"#work\">Work</a>\n</div>\n</header>\n<section class=\"relative overflow-hidden\" data-kid=\"2\" data-name=\"hero section with gradient background\" id=\"top\" style=\"background:linear-gradient(180deg,#E6F2F2 0%,#E6F2F2 22%,#D3E7E8 44%,#17888F 74%,#04121A 100%)\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\" data-kid=\"2-2\" data-name=\"hero decorative background layer\">\n<div class=\"al-shaft\" data-kid=\"2-2-1\" data-name=\"light shaft decoration\" style=\"left:4%;top:-16%;width:130px;height:900px;opacity:.45;\"></div>\n<div class=\"al-shaft\" data-kid=\"2-2-2\" data-name=\"light shaft decoration\" style=\"left:47%;top:-14%;width:62px;height:820px;opacity:.32;\"></div>\n<div class=\"al-shaft\" data-kid=\"2-2-3\" data-name=\"light shaft decoration\" style=\"left:76%;top:-10%;width:150px;height:860px;opacity:.26;\"></div>\n<div class=\"al-caustic\" data-kid=\"2-2-4\" data-name=\"caustic glow decoration\" style=\"left:6%;top:44%;width:560px;height:230px;\"></div>\n<div class=\"al-caustic\" data-kid=\"2-2-5\" data-name=\"caustic glow decoration\" style=\"left:52%;top:56%;width:420px;height:180px;\"></div>\n<div class=\"absolute inset-x-0\" data-kid=\"2-2-6\" data-name=\"horizon line pattern decoration\" style=\"top:54%;bottom:0;background:repeating-linear-gradient(180deg,rgba(230,242,242,0.13) 0 1px,transparent 1px 36px);\"></div>\n</div>\n<div class=\"relative mx-auto flex min-h-[748px] max-w-[1180px] flex-col px-5 pt-11 md:px-7 md:pt-16\" data-kid=\"2-1\" data-name=\"hero content column\">\n<div class=\"grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-8\" data-kid=\"2-1-1\" data-name=\"hero grid\">\n<div class=\"md:col-span-7\" data-kid=\"2-1-1-1\" data-name=\"identity column\">\n<div class=\"al-mono flex items-center gap-3 text-[10px] uppercase tracking-[0.3em] text-[#5C7378]\" data-kid=\"2-1-1-1-4\" data-name=\"role label with rule\">\n<span class=\"h-[1px] w-10 bg-[#17888F]\" data-kid=\"2-1-1-1-4-1\" data-name=\"decorative rule line\"></span>\n<span data-kid=\"2-1-1-1-4-2\" data-name=\"role label text\">Interface designer</span>\n</div>\n<h1 class=\"al-display mt-6 text-[62px] leading-[0.96] md:text-[112px]\" data-kid=\"2-1-1-1-1\" data-name=\"hero name headline\" style=\"font-weight:300;\">\n          Aarav<br data-kid=\"2-1-1-1-1-1\" data-name=\"line break\"/>Menon\n        </h1>\n<p class=\"mt-7 max-w-[52ch] text-[16px] leading-[1.72] text-[#04121A]/85\" data-kid=\"2-1-1-1-2\" data-name=\"owner bio paragraph\">\n          I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n        </p>\n<ul class=\"mt-8 flex flex-wrap gap-2\" data-kid=\"2-1-1-1-3\" data-name=\"skills pills list\">\n<li class=\"al-mono rounded-full border border-[#17888F]/35 bg-[#E6F2F2]/70 px-3 py-[6px] text-[10px] uppercase tracking-[0.14em] text-[#04121A]/80\" data-kid=\"2-1-1-1-3-1\" data-name=\"skill pill Design systems\">Design systems</li>\n<li class=\"al-mono rounded-full border border-[#17888F]/35 bg-[#E6F2F2]/70 px-3 py-[6px] text-[10px] uppercase tracking-[0.14em] text-[#04121A]/80\" data-kid=\"2-1-1-1-3-2\" data-name=\"skill pill Interaction design\">Interaction design</li>\n<li class=\"al-mono rounded-full border border-[#17888F]/35 bg-[#E6F2F2]/70 px-3 py-[6px] text-[10px] uppercase tracking-[0.14em] text-[#04121A]/80\" data-kid=\"2-1-1-1-3-3\" data-name=\"skill pill Prototyping\">Prototyping</li>\n<li class=\"al-mono rounded-full border border-[#17888F]/35 bg-[#E6F2F2]/70 px-3 py-[6px] text-[10px] uppercase tracking-[0.14em] text-[#04121A]/80\" data-kid=\"2-1-1-1-3-4\" data-name=\"skill pill Motion\">Motion</li>\n<li class=\"al-mono rounded-full border border-[#17888F]/35 bg-[#E6F2F2]/70 px-3 py-[6px] text-[10px] uppercase tracking-[0.14em] text-[#04121A]/80\" data-kid=\"2-1-1-1-3-5\" data-name=\"skill pill Type\">Type</li>\n<li class=\"al-mono rounded-full border border-[#17888F]/35 bg-[#E6F2F2]/70 px-3 py-[6px] text-[10px] uppercase tracking-[0.14em] text-[#04121A]/80\" data-kid=\"2-1-1-1-3-6\" data-name=\"skill pill Research\">Research</li>\n</ul>\n</div>\n<div class=\"md:col-span-5 md:pt-2\" data-kid=\"2-1-1-2\" data-name=\"links panel container\">\n<div class=\"rounded-[3px] border border-[#04121A]/12 bg-[#E6F2F2]/55 px-6 py-6\" data-kid=\"2-1-1-2-1\" data-name=\"links panel card\">\n<div class=\"al-mono text-[9px] uppercase tracking-[0.34em] text-[#5C7378]\" data-kid=\"2-1-1-2-1-1\" data-name=\"links panel heading\">Links</div>\n<ul class=\"mt-4\" data-kid=\"2-1-1-2-1-2\" data-name=\"links list\">\n<li class=\"border-b border-[#04121A]/10\" data-kid=\"2-1-1-2-1-2-1\" data-name=\"link row GitHub\">\n<a class=\"al-link flex items-center justify-between py-3 text-[14px] hover:text-[#17888F]\" data-kid=\"2-1-1-2-1-2-1-1\" data-name=\"GitHub link\" href=\"https://github.com\"><span data-kid=\"2-1-1-2-1-2-1-1-1\" data-name=\"GitHub link label\">GitHub</span><span aria-hidden=\"true\" class=\"text-[12px]\" data-kid=\"2-1-1-2-1-2-1-1-2\" data-name=\"external link arrow icon\">↗</span></a>\n</li>\n<li class=\"border-b border-[#04121A]/10\" data-kid=\"2-1-1-2-1-2-2\" data-name=\"link row Dribbble\">\n<a class=\"al-link flex items-center justify-between py-3 text-[14px] hover:text-[#17888F]\" data-kid=\"2-1-1-2-1-2-2-1\" data-name=\"Dribbble link\" href=\"https://dribbble.com\"><span data-kid=\"2-1-1-2-1-2-2-1-1\" data-name=\"Dribbble link label\">Dribbble</span><span aria-hidden=\"true\" class=\"text-[12px]\" data-kid=\"2-1-1-2-1-2-2-1-2\" data-name=\"external link arrow icon\">↗</span></a>\n</li>\n<li class=\"border-b border-[#04121A]/10\" data-kid=\"2-1-1-2-1-2-3\" data-name=\"link row LinkedIn\">\n<a class=\"al-link flex items-center justify-between py-3 text-[14px] hover:text-[#17888F]\" data-kid=\"2-1-1-2-1-2-3-1\" data-name=\"LinkedIn link\" href=\"https://linkedin.com\"><span data-kid=\"2-1-1-2-1-2-3-1-1\" data-name=\"LinkedIn link label\">LinkedIn</span><span aria-hidden=\"true\" class=\"text-[12px]\" data-kid=\"2-1-1-2-1-2-3-1-2\" data-name=\"external link arrow icon\">↗</span></a>\n</li>\n<li data-kid=\"2-1-1-2-1-2-4\" data-name=\"link row Email\">\n<a class=\"al-link flex items-center justify-between py-3 text-[14px] hover:text-[#17888F]\" data-kid=\"2-1-1-2-1-2-4-1\" data-name=\"Email link\" href=\"mailto:hello@example.com\"><span data-kid=\"2-1-1-2-1-2-4-1-1\" data-name=\"Email link label\">Email</span><span aria-hidden=\"true\" class=\"text-[12px]\" data-kid=\"2-1-1-2-1-2-4-1-2\" data-name=\"external link arrow icon\">↗</span></a>\n</li>\n</ul>\n</div>\n</div>\n</div>\n<div class=\"mt-auto grid grid-cols-2 pt-14 sm:grid-cols-4\" data-kid=\"2-1-2\" data-name=\"counts strip\">\n<div class=\"border-t border-[#4FD6C8]/30 py-6\" data-kid=\"2-1-2-1\">\n<div class=\"al-mono text-[22px] leading-none text-[#4FD6C8]\" data-kid=\"2-1-2-1-1\">03</div>\n<div class=\"al-mono mt-2 text-[9px] uppercase tracking-[0.3em] text-[#7C9599]\" data-kid=\"2-1-2-1-2\">Projects</div>\n</div>\n<div class=\"border-t border-[#4FD6C8]/30 py-6 sm:border-l sm:border-[#4FD6C8]/20 sm:pl-6\" data-kid=\"2-1-2-2\">\n<div class=\"al-mono text-[22px] leading-none text-[#4FD6C8]\" data-kid=\"2-1-2-2-1\">03</div>\n<div class=\"al-mono mt-2 text-[9px] uppercase tracking-[0.3em] text-[#7C9599]\" data-kid=\"2-1-2-2-2\">Experience</div>\n</div>\n<div class=\"border-t border-[#4FD6C8]/30 py-6 sm:border-l sm:border-[#4FD6C8]/20 sm:pl-6\" data-kid=\"2-1-2-3\">\n<div class=\"al-mono text-[22px] leading-none text-[#4FD6C8]\" data-kid=\"2-1-2-3-1\">02</div>\n<div class=\"al-mono mt-2 text-[9px] uppercase tracking-[0.3em] text-[#7C9599]\" data-kid=\"2-1-2-3-2\">Education</div>\n</div>\n<div class=\"border-t border-[#4FD6C8]/30 py-6 sm:border-l sm:border-[#4FD6C8]/20 sm:pl-6\" data-kid=\"2-1-2-4\">\n<div class=\"al-mono text-[22px] leading-none text-[#4FD6C8]\" data-kid=\"2-1-2-4-1\">04</div>\n<div class=\"al-mono mt-2 text-[9px] uppercase tracking-[0.3em] text-[#7C9599]\" data-kid=\"2-1-2-4-2\">Links</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"border-b border-[#04121A]/10 bg-[#E6F2F2]\" data-kid=\"3\" data-name=\"Selected work section\" id=\"work\">\n<div class=\"mx-auto max-w-[1180px] px-5 pt-14 md:px-7 md:pt-20\" data-kid=\"3-4\" data-name=\"work section inner container\">\n<div class=\"flex flex-wrap items-end justify-between gap-5\" data-kid=\"3-4-1\" data-name=\"section header row\">\n<div data-kid=\"3-4-1-1\" data-name=\"heading wrapper\">\n<h2 class=\"al-display text-[40px] leading-none md:text-[54px]\" data-kid=\"3-1\" data-name=\"work section heading\">Selected work</h2>\n<div class=\"al-mono mt-4 text-[10px] uppercase tracking-[0.28em] text-[#5C7378]\" data-kid=\"3-4-1-1-2\" data-name=\"project count label\">3 projects</div>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"3-2\" data-name=\"rail step button group\">\n<button aria-label=\"Previous projects\" class=\"grid h-10 w-10 place-items-center rounded-full border border-[#04121A]/20 text-[14px] text-[#04121A] hover:border-[#17888F] hover:text-[#17888F]\" data-kid=\"3-2-1\" data-name=\"previous project button\" data-rail-step=\"prev\" type=\"button\">←</button>\n<button aria-label=\"Next projects\" class=\"grid h-10 w-10 place-items-center rounded-full border border-[#04121A]/20 text-[14px] text-[#04121A] hover:border-[#17888F] hover:text-[#17888F]\" data-kid=\"3-2-2\" data-name=\"next project button\" data-rail-step=\"next\" type=\"button\">→</button>\n</div>\n</div>\n</div>\n<div class=\"relative mx-auto max-w-[1180px] px-5 pb-16 pt-8 md:px-7 md:pb-20 md:pt-10\" data-kid=\"3-5\" data-name=\"work rail wrapper\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-y-6 left-0 z-10 w-8 bg-gradient-to-r from-[#E6F2F2] to-transparent md:w-10\" data-kid=\"3-5-1\" data-name=\"left fade gradient\"></div>\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-y-6 right-0 z-10 w-8 bg-gradient-to-l from-[#E6F2F2] to-transparent md:w-10\" data-kid=\"3-5-2\" data-name=\"right fade gradient\"></div>\n<div class=\"al-rail flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2\" data-kid=\"3-3\" data-name=\"project scroll rail\" data-rail=\"\">\n<article class=\"w-[80vw] shrink-0 snap-start rounded-[3px] border-t-2 border-[#17888F] bg-[#D3E7E8] p-6 md:w-[372px] md:p-7\" data-kid=\"3-3-1\" data-name=\"project card Kestrel\">\n<div class=\"al-mono flex items-center justify-between text-[10px] uppercase tracking-[0.24em] text-[#5C7378]\" data-kid=\"3-3-1-1\" data-name=\"card meta row\"><span data-kid=\"3-3-1-1-1\" data-name=\"project number\">01</span><span data-kid=\"3-3-1-1-2\" data-name=\"project year\">2025</span></div>\n<h3 class=\"al-display mt-5 text-[27px] leading-tight md:text-[30px]\" data-kid=\"3-3-1-2\" data-name=\"project card Kestrel title\">Kestrel</h3>\n<p class=\"mt-3 text-[14px] leading-[1.65] text-[#5C7378]\" data-kid=\"3-3-1-3\" data-name=\"project card description\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n<a class=\"al-mono mt-6 inline-flex items-center gap-2 border-b border-[#17888F]/50 pb-1 text-[10px] uppercase tracking-[0.22em] text-[#17888F]\" data-kid=\"3-3-1-4\" data-name=\"read case study link\" href=\"#\">Read case study <span aria-hidden=\"true\" data-kid=\"3-3-1-4-1\" data-name=\"arrow icon\">→</span></a>\n</article>\n<article class=\"w-[80vw] shrink-0 snap-start rounded-[3px] border-t-2 border-[#17888F] bg-[#D3E7E8] p-6 md:w-[372px] md:p-7\" data-kid=\"3-3-2\" data-name=\"project card Tide &amp; Timber\">\n<div class=\"al-mono flex items-center justify-between text-[10px] uppercase tracking-[0.24em] text-[#5C7378]\" data-kid=\"3-3-2-1\" data-name=\"card meta row\"><span data-kid=\"3-3-2-1-1\" data-name=\"project number\">02</span><span data-kid=\"3-3-2-1-2\" data-name=\"project year\">2024</span></div>\n<h3 class=\"al-display mt-5 text-[27px] leading-tight md:text-[30px]\" data-kid=\"3-3-2-2\" data-name=\"project card title Tide &amp; Timber\">Tide &amp; Timber</h3>\n<p class=\"mt-3 text-[14px] leading-[1.65] text-[#5C7378]\" data-kid=\"3-3-2-3\" data-name=\"project card description\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n<a class=\"al-mono mt-6 inline-flex items-center gap-2 border-b border-[#17888F]/50 pb-1 text-[10px] uppercase tracking-[0.22em] text-[#17888F]\" data-kid=\"3-3-2-4\" data-name=\"read case study link\" href=\"#\">Read case study <span aria-hidden=\"true\" data-kid=\"3-3-2-4-1\" data-name=\"arrow icon\">→</span></a>\n</article>\n<article class=\"w-[80vw] shrink-0 snap-start rounded-[3px] border-t-2 border-[#17888F] bg-[#D3E7E8] p-6 md:w-[372px] md:p-7\" data-kid=\"3-3-3\" data-name=\"project card Loom Audio\">\n<div class=\"al-mono flex items-center justify-between text-[10px] uppercase tracking-[0.24em] text-[#5C7378]\" data-kid=\"3-3-3-1\" data-name=\"card meta row\"><span data-kid=\"3-3-3-1-1\" data-name=\"project number\">03</span><span data-kid=\"3-3-3-1-2\" data-name=\"project year\">2023</span></div>\n<h3 class=\"al-display mt-5 text-[27px] leading-tight md:text-[30px]\" data-kid=\"3-3-3-2\" data-name=\"project card title Loom Audio\">Loom Audio</h3>\n<p class=\"mt-3 text-[14px] leading-[1.65] text-[#5C7378]\" data-kid=\"3-3-3-3\" data-name=\"project card description\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n<a class=\"al-mono mt-6 inline-flex items-center gap-2 border-b border-[#17888F]/50 pb-1 text-[10px] uppercase tracking-[0.22em] text-[#17888F]\" data-kid=\"3-3-3-4\" data-name=\"read case study link\" href=\"#\">Read case study <span aria-hidden=\"true\" data-kid=\"3-3-3-4-1\" data-name=\"arrow icon\">→</span></a>\n</article>\n</div>\n</div>\n</section>\n<section class=\"relative overflow-hidden bg-[#04121A] text-[#4FD6C8]\" data-kid=\"4\" data-name=\"experience dark section\" id=\"experience\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\" data-kid=\"4-3\" data-name=\"experience background decorations\">\n<div class=\"al-caustic\" data-kid=\"4-3-1\" data-name=\"caustic glow decoration\" style=\"left:-6%;top:-10%;width:480px;height:220px;opacity:.35;\"></div>\n<div class=\"al-caustic\" data-kid=\"4-3-2\" data-name=\"caustic glow decoration\" style=\"left:62%;top:40%;width:520px;height:240px;opacity:.22;\"></div>\n</div>\n<div class=\"relative mx-auto max-w-[1180px] px-5 py-14 md:px-7 md:py-20\" data-kid=\"4-4\" data-name=\"experience content container\">\n<h2 class=\"al-display text-[40px] leading-none md:text-[54px]\" data-kid=\"4-1\" data-name=\"experience section heading\">Experience</h2>\n<ul class=\"mt-10\" data-kid=\"4-2\" data-name=\"experience list\">\n<li class=\"grid grid-cols-1 gap-2 border-t border-[#4FD6C8]/20 py-6 md:grid-cols-12 md:items-baseline md:gap-6\" data-kid=\"4-2-1\" data-name=\"experience row Fintrail\">\n<span class=\"al-mono text-[10px] uppercase tracking-[0.24em] text-[#7C9599] md:col-span-3\" data-kid=\"4-2-1-1\" data-name=\"experience date range\">2022 — present</span>\n<h3 class=\"al-display text-[26px] leading-none md:col-span-4 md:text-[30px]\" data-kid=\"4-2-1-2\" data-name=\"experience company Fintrail\">Fintrail</h3>\n<p class=\"text-[14px] text-[#7C9599] md:col-span-5 md:text-right\" data-kid=\"4-2-1-3\" data-name=\"experience role title\">Senior product designer</p>\n</li>\n<li class=\"grid grid-cols-1 gap-2 border-t border-[#4FD6C8]/20 py-6 md:grid-cols-12 md:items-baseline md:gap-6\" data-kid=\"4-2-2\" data-name=\"experience row Sundial Studio\">\n<span class=\"al-mono text-[10px] uppercase tracking-[0.24em] text-[#7C9599] md:col-span-3\" data-kid=\"4-2-2-1\" data-name=\"experience date range\">2019 — 2022</span>\n<h3 class=\"al-display text-[27px] leading-tight md:text-[30px] md:col-span-4\" data-kid=\"4-2-2-2\" data-name=\"experience company Sundial Studio\">Sundial Studio</h3>\n<p class=\"text-[14px] text-[#7C9599] md:col-span-5 md:text-right\" data-kid=\"4-2-2-3\" data-name=\"experience role title\">Product designer</p>\n</li>\n<li class=\"grid grid-cols-1 gap-2 border-y border-[#4FD6C8]/20 py-6 md:grid-cols-12 md:items-baseline md:gap-6\" data-kid=\"4-2-3\" data-name=\"experience row Pageturn Press\">\n<span class=\"al-mono text-[10px] uppercase tracking-[0.24em] text-[#7C9599] md:col-span-3\" data-kid=\"4-2-3-1\" data-name=\"experience date range\">2017 — 2019</span>\n<h3 class=\"al-display text-[27px] leading-tight md:text-[30px] md:col-span-4\" data-kid=\"4-2-3-2\" data-name=\"experience company Pageturn Press\">Pageturn Press</h3>\n<p class=\"text-[14px] text-[#7C9599] md:col-span-5 md:text-right\" data-kid=\"4-2-3-3\" data-name=\"experience role title\">Interface designer</p>\n</li>\n</ul>\n</div>\n</section>\n<section class=\"grid grid-cols-1 border-b border-[#04121A]/10 md:grid-cols-2\" data-kid=\"5\" data-name=\"education and links split section\">\n<div class=\"bg-[#E6F2F2] px-5 py-14 md:px-10 md:py-20\" data-kid=\"5-1\" data-name=\"education column\" id=\"education\">\n<h2 class=\"al-display text-[34px] leading-none md:text-[40px]\" data-kid=\"5-1-1\" data-name=\"education section heading\">Education</h2>\n<div class=\"mt-8 space-y-8\" data-kid=\"5-1-2\" data-name=\"education entries container\">\n<article 