      "html": "<body class=\"min-h-screen bg-[#F7EFE6] text-[#141014] antialiased\">\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Instrument+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n\n  body { font-family: 'Instrument Sans', 'Helvetica Neue', sans-serif; }\n  .bf-poster { font-family: 'Archivo Black', 'Helvetica Neue', sans-serif; }\n  .bf-mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }\n\n  .bf-streaks { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 1; }\n  .bf-flame-edge {\n    background-image: linear-gradient(to bottom, #D8462F 0%, rgba(216, 70, 47, 0.55) 34%, rgba(216, 70, 47, 0.1) 68%, rgba(216, 70, 47, 0) 100%);\n  }\n  .bf-ember-wash {\n    background-image:\n      radial-gradient(ellipse at 78% 8%, rgba(216, 70, 47, 0.14), transparent 58%),\n      radial-gradient(ellipse at 8% 92%, rgba(242, 199, 68, 0.12), transparent 52%);\n  }\n  .bf-rule { background-image: linear-gradient(to right, #D8462F 0 92px, #141014 92px 100%); }\n</style>\n<header class=\"sticky top-0 z-30 bg-[#141014]\" data-kid=\"1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[58px] max-w-[1240px] items-center justify-between px-6\" data-kid=\"1-1\" data-name=\"header content row\">\n<a class=\"bf-poster text-[12px] uppercase tracking-[0.14em] text-[#FFF6EC]\" data-kid=\"1-1-1\" data-name=\"owner name logotype\" href=\"#top\">Aarav Menon</a>\n<nav class=\"bf-mono hidden items-center gap-7 text-[10px] uppercase tracking-[0.22em] text-[#A29289] md:flex\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n<a class=\"hover:text-[#F2C744]\" data-kid=\"1-1-2-1\" data-name=\"work nav link\" href=\"#work\">Work</a>\n<a class=\"hover:text-[#F2C744]\" data-kid=\"1-1-2-2\" data-name=\"experience nav link\" href=\"#experience\">Experience</a>\n<a class=\"hover:text-[#F2C744]\" data-kid=\"1-1-2-3\" data-name=\"education nav link\" href=\"#education\">Education</a>\n<a class=\"hover:text-[#F2C744]\" data-kid=\"1-1-2-4\" data-name=\"links nav link\" href=\"#links\">Links</a>\n</nav>\n<span class=\"bf-mono text-[10px] uppercase tracking-[0.2em] text-[#F2C744]\" data-kid=\"1-1-3\" data-name=\"header role label\">Interface designer</span>\n</div>\n<div class=\"h-[3px] bg-[#D8462F]\" data-kid=\"1-2\" data-name=\"accent header rule\"></div>\n</header>\n<section class=\"bf-ember-wash relative overflow-hidden border-b border-[#141014]/15\" data-kid=\"2\" data-name=\"speed poster hero band\" data-streak-host=\"\" id=\"top\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\" data-kid=\"2-1\" data-name=\"ember diagonal decorative shapes\">\n<div class=\"absolute -right-24 -top-16 h-[420px] w-[520px] -rotate-[18deg] bg-[#D8462F]/10\" data-kid=\"2-1-1\" data-name=\"diagonal ember shape top-right\"></div>\n<div class=\"absolute right-14 top-24 h-[300px] w-[104px] -rotate-[18deg] bg-[#D8462F]/15\" data-kid=\"2-1-2\" data-name=\"diagonal ember shape narrow\"></div>\n<div class=\"absolute -left-24 -bottom-24 h-[240px] w-[420px] -rotate-[18deg] bg-[#F0E1D5]/80\" data-kid=\"2-1-3\" data-name=\"diagonal wash shape bottom-left\"></div>\n</div>\n<div aria-hidden=\"true\" class=\"bf-streaks\" data-dynamic=\"true\" data-kid=\"2-3\" data-name=\"animated streak layer\" data-reason=\"children injected by streak script on load\" data-streak-layer=\"1\"></div>\n<div class=\"relative z-10 mx-auto max-w-[1180px] px-6 pb-14 pt-12\" data-kid=\"2-2\" data-name=\"poster band content\">\n<span class=\"bf-mono inline-block -rotate-[1.5deg] border-2 border-[#141014] px-3 py-1 text-[10px] uppercase tracking-[0.24em] text-[#141014]\" data-kid=\"2-2-1\" data-name=\"role stamp badge\">Interface designer</span>\n<h1 class=\"bf-poster mt-7 whitespace-nowrap text-[10.6vw] leading-[0.86] tracking-[-0.02em] uppercase text-[#141014] sm:text-[92px] lg:text-[112px]\" data-kid=\"2-2-2\" data-name=\"poster owner name headline\">Aarav <span class=\"text-[#D8462F]\" data-kid=\"2-2-2-1\" data-name=\"accent surname\">Menon</span></h1>\n<div class=\"mt-9 grid gap-x-14 gap-y-8 border-t border-[#141014]/20 pt-7 md:grid-cols-[1.05fr_1fr]\" data-kid=\"2-2-3\" data-name=\"intro and skills split grid\">\n<p class=\"max-w-[52ch] text-[16px] leading-[1.65] text-[#7E7069]\" data-kid=\"2-2-3-1\" data-name=\"owner bio text\">I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.</p>\n<div data-kid=\"2-2-3-2\" data-name=\"skills rail and links\">\n<div class=\"grid grid-cols-2 gap-x-6 border-y border-[#141014]/20 py-1\" data-kid=\"2-2-3-2-1\" data-name=\"skills strip grid\">\n<span class=\"flex items-center gap-2 border-b border-[#141014]/10 py-2 text-[12px] font-semibold uppercase tracking-[0.07em] text-[#141014]\" data-kid=\"2-2-3-2-1-1\" data-name=\"skill item design systems\"><span aria-hidden=\"true\" class=\"h-[5px] w-[5px] shrink-0 rotate-45 bg-[#D8462F]\" data-kid=\"2-2-3-2-1-1-1\" data-name=\"skill diamond marker\"></span>Design systems</span>\n<span class=\"flex items-center gap-2 border-b border-[#141014]/10 py-2 text-[12px] font-medium tracking-[0.02em] text-[#141014]\" data-kid=\"2-2-3-2-1-2\" data-name=\"skill item interaction design\"><span aria-hidden=\"true\" class=\"h-[5px] w-[5px] shrink-0 rotate-45 bg-[#D8462F]\" data-kid=\"2-2-3-2-1-2-1\" data-name=\"skill diamond marker\"></span>Interaction design</span>\n<span class=\"flex items-center gap-2 border-b border-[#141014]/10 py-2 text-[12px] font-medium tracking-[0.02em] text-[#141014]\" data-kid=\"2-2-3-2-1-3\" data-name=\"skill item prototyping\"><span aria-hidden=\"true\" class=\"h-[5px] w-[5px] shrink-0 rotate-45 bg-[#D8462F]\" data-kid=\"2-2-3-2-1-3-1\" data-name=\"skill diamond marker\"></span>Prototyping</span>\n<span class=\"flex items-center gap-2 border-b border-[#141014]/10 py-2 text-[12px] font-medium tracking-[0.02em] text-[#141014]\" data-kid=\"2-2-3-2-1-4\" data-name=\"skill item motion\"><span aria-hidden=\"true\" class=\"h-[5px] w-[5px] shrink-0 rotate-45 bg-[#D8462F]\" data-kid=\"2-2-3-2-1-4-1\" data-name=\"skill diamond marker\"></span>Motion</span>\n<span class=\"flex items-center gap-2 py-2 text-[12px] font-medium tracking-[0.02em] text-[#141014]\" data-kid=\"2-2-3-2-1-5\" data-name=\"skill item type\"><span aria-hidden=\"true\" class=\"h-[5px] w-[5px] shrink-0 rotate-45 bg-[#D8462F]\" data-kid=\"2-2-3-2-1-5-1\" data-name=\"skill diamond marker\"></span>Type</span>\n<span class=\"flex items-center gap-2 py-2 text-[12px] font-medium tracking-[0.02em] text-[#141014]\" data-kid=\"2-2-3-2-1-6\" data-name=\"skill item research\"><span aria-hidden=\"true\" class=\"h-[5px] w-[5px] shrink-0 rotate-45 bg-[#D8462F]\" data-kid=\"2-2-3-2-1-6-1\" data-name=\"skill diamond marker\"></span>Research</span>\n</div>\n<div class=\"bf-mono mt-5 flex flex-wrap items-center gap-x-7 gap-y-3 text-[10px] uppercase tracking-[0.18em]\" data-kid=\"2-2-3-2-2\" data-name=\"hero action links row\">\n<a class=\"inline-flex items-center gap-1.5 text-[#141014] hover:text-[#D8462F]\" data-kid=\"2-2-3-2-2-1\" data-name=\"github link\" href=\"https://github.com\">\n            GitHub\n            <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"2-2-3-2-2-1-1\" data-name=\"external arrow icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg>\n</a>\n<a class=\"inline-flex items-center gap-2 text-[#141014] hover:text-[#D8462F]\" data-kid=\"2-2-3-2-2-2\" data-name=\"linkedin link\" href=\"https://linkedin.com\">\n            LinkedIn\n            <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"2-2-3-2-2-2-1\" data-name=\"external arrow icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.2\"></path></svg>\n</a>\n<a class=\"text-[#D8462F]\" data-kid=\"2-2-3-2-2-3\" data-name=\"email href link\" href=\"mailto:hello@example.com\">hello@example.com</a>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"border-b border-[#141014]/15\" data-kid=\"3\" data-name=\"selected work ledger section\" id=\"work\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-14\" data-kid=\"3-1\" data-name=\"work container\">\n<div class=\"flex flex-wrap items-baseline justify-between gap-3\" data-kid=\"3-1-1\" data-name=\"work heading row\">\n<h2 class=\"bf-poster text-[15px] uppercase tracking-[0.1em] text-[#141014]\" data-kid=\"3-1-1-1\" data-name=\"selected work heading\">Selected work</h2>\n<span class=\"bf-mono text-[10px] uppercase tracking-[0.2em] text-[#7E7069]\" data-kid=\"3-1-1-2\" data-name=\"work years label\">2023 — 2025</span>\n</div>\n<div class=\"bf-rule mt-4 h-[3px] w-full\" data-kid=\"3-1-2\" data-name=\"work header rule\"></div>\n<ol data-kid=\"3-1-3\" data-name=\"project ledger rows list\">\n<li class=\"grid grid-cols-[38px_1fr] gap-x-5 border-b border-[#141014]/15 py-7 md:grid-cols-[56px_1fr_120px]\" data-kid=\"3-2\" data-name=\"project row kestrel\">\n<span class=\"bf-mono pt-1.5 text-[11px] tracking-[0.12em] text-[#D8462F]\" data-kid=\"3-2-1\" data-name=\"project index number\">01</span>\n<div data-kid=\"3-2-6\" data-name=\"project content wrapper\">\n<h3 class=\"bf-poster text-[24px] uppercase leading-[1.05] tracking-[-0.005em] text-[#141014]\" data-kid=\"3-2-2\" data-name=\"project title Kestrel\">Kestrel</h3>\n<p class=\"mt-2 max-w-[64ch] text-[15px] leading-[1.6] text-[#7E7069]\" data-kid=\"3-2-3\" data-name=\"project description\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n<a class=\"bf-mono mt-3 inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.18em] text-[#141014] hover:text-[#D8462F]\" data-kid=\"3-2-4\" data-name=\"read case study link\" href=\"https://example.com\">\n            Case study\n            <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"3-2-4-1\" data-name=\"external arrow icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg>\n</a>\n</div>\n<span class=\"bf-mono col-start-2 mt-3 text-[11px] tracking-[0.14em] text-[#7E7069] md:col-start-3 md:mt-1.5 md:text-right\" data-kid=\"3-2-5\" data-name=\"project date\">2025</span>\n</li>\n<li class=\"grid grid-cols-[38px_1fr] gap-x-5 border-b border-[#141014]/15 py-7 md:grid-cols-[56px_1fr_120px]\" data-kid=\"3-3\" data-name=\"project row tide and timber\">\n<span class=\"bf-mono pt-1.5 text-[11px] tracking-[0.12em] text-[#D8462F]\" data-kid=\"3-3-1\" data-name=\"project index number\">02</span>\n<div data-kid=\"3-3-6\" data-name=\"project content wrapper\">\n<h3 class=\"bf-poster text-[24px] uppercase leading-[1.05] tracking-[-0.005em] text-[#141014]\" data-kid=\"3-3-2\" data-name=\"project title Tide and Timber\">Tide &amp; Timber</h3>\n<p class=\"mt-2 max-w-[64ch] text-[15px] leading-[1.6] text-[#7E7069]\" data-kid=\"3-3-3\" data-name=\"project description\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n<a class=\"bf-mono mt-3 inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.18em] text-[#141014] hover:text-[#D8462F]\" data-kid=\"3-3-4\" data-name=\"read case study link\" href=\"https://example.com\">\n            Case study\n            <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"3-3-4-1\" data-name=\"external arrow icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg>\n</a>\n</div>\n<span class=\"bf-mono col-start-2 mt-3 text-[11px] tracking-[0.14em] text-[#7E7069] md:col-start-3 md:mt-1.5 md:text-right\" data-kid=\"3-3-5\" data-name=\"project date\">2024</span>\n</li>\n<li class=\"grid grid-cols-[38px_1fr] gap-x-5 py-7 md:grid-cols-[56px_1fr_120px]\" data-kid=\"3-4\" data-name=\"project row loom audio\">\n<span class=\"bf-mono pt-1.5 text-[11px] tracking-[0.12em] text-[#D8462F]\" data-kid=\"3-4-1\" data-name=\"project index number\">03</span>\n<div data-kid=\"3-4-6\" data-name=\"project content wrapper\">\n<h3 class=\"bf-poster text-[24px] uppercase leading-[1.05] tracking-[-0.005em] text-[#141014]\" data-kid=\"3-4-2\" data-name=\"project title Loom Audio\">Loom Audio</h3>\n<p class=\"mt-2 max-w-[64ch] text-[15px] leading-[1.6] text-[#7E7069]\" data-kid=\"3-4-3\" data-name=\"project description\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n<a class=\"bf-mono mt-3 inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.18em] text-[#141014] hover:text-[#D8462F]\" data-kid=\"3-4-4\" data-name=\"read case study link\" href=\"https://example.com\">\n            Case study\n            <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"3-4-4-1\" data-name=\"external arrow icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg>\n</a>\n</div>\n<span class=\"bf-mono col-start-2 mt-3 text-[11px] tracking-[0.14em] text-[#7E7069] md:col-start-3 md:mt-1.5 md:text-right\" data-kid=\"3-4-5\" data-name=\"project date\">2023</span>\n</li>\n</ol>\n</div>\n</section>\n<section class=\"relative bg-[#141014] text-[#FFF6EC]\" data-kid=\"4\" data-name=\"experience dark band section\" id=\"experience\">\n<div aria-hidden=\"true\" class=\"bf-flame-edge absolute inset-y-0 left-0 w-[7px]\" data-kid=\"4-1\" data-name=\"flame gradient edge strip\"></div>\n<div class=\"mx-auto max-w-[1180px] px-6 py-14 pl-9\" data-kid=\"4-2\" data-name=\"experience container\">\n<h2 class=\"bf-poster text-[15px] uppercase tracking-[0.1em] text-[#F2C744]\" data-kid=\"4-2-1\" data-name=\"experience heading\">Experience</h2>\n<div class=\"mt-4 h-[1px] w-full bg-[#FFF6EC]/15\" data-kid=\"4-2-2\" data-name=\"experience divider rule\"></div>\n<ul data-kid=\"4-2-3\" data-name=\"experience entries list\">\n<li class=\"flex flex-wrap items-baseline justify-between gap-3 border-b border-[#FFF6EC]/15 py-5\" data-kid=\"4-3\" data-name=\"experience entry fintrail\">\n<div class=\"flex flex-wrap items-baseline gap-x-5 gap-y-1\" data-kid=\"4-3-4\" data-name=\"company and role row\">\n<span class=\"bf-poster text-[19px] uppercase tracking-[0.01em] text-[#FFF6EC]\" data-kid=\"4-3-1\" data-name=\"company name Fintrail\">Fintrail</span>\n<span class=\"text-[14px] text-[#A29289]\" data-kid=\"4-3-2\" data-name=\"role senior product designer\">Senior product designer</span>\n</div>\n<span class=\"bf-mono text-[11px] tracking-[0.14em] text-[#F2C744]\" data-kid=\"4-3-3\" data-name=\"employment dates\">2022 — present</span>\n</li>\n<li class=\"flex flex-wrap items-baseline justify-between gap-3 border-b border-[#FFF6EC]/15 py-5\" data-kid=\"4-4\" data-name=\"experience entry sundial studio\">\n<div class=\"flex flex-wrap items-baseline gap-x-5 gap-y-1\" data-kid=\"4-4-4\" data-name=\"company and role row\">\n<span class=\"bf-poster text-[19px] uppercase tracking-[0.01em] text-[#FFF6EC]\" data-kid=\"4-4-1\" data-name=\"company name Sundial Studio\">Sundial Studio</span>\n<span class=\"text-[14px] text-[#A29289]\" data-kid=\"4-4-2\" data-name=\"role product designer\">Product designer</span>\n</div>\n<span class=\"bf-mono text-[11px] tracking-[0.14em] text-[#F2C744]\" data-kid=\"4-4-3\" data-name=\"employment dates\">2019 — 2022</span>\n</li>\n<li class=\"flex flex-wrap items-baseline justify-between gap-3 py-5\" data-kid=\"4-5\" data-name=\"experience entry pageturn press\">\n<div class=\"flex flex-wrap items-baseline gap-x-5 gap-y-1\" data-kid=\"4-5-4\" data-name=\"company and role row\">\n<span class=\"bf-poster text-[19px] uppercase tracking-[0.01em] text-[#FFF6EC]\" data-kid=\"4-5-1\" data-name=\"company name Pageturn Press\">Pageturn Press</span>\n<span class=\"text-[14px] text-[#A29289]\" data-kid=\"4-5-2\" data-name=\"role interface designer\">Interface designer</span>\n</div>\n<span class=\"bf-mono text-[11px] tracking-[0.14em] text-[#F2C744]\" data-kid=\"4-5-3\" data-name=\"employment dates\">2017 — 2019</span>\n</li>\n</ul>\n</div>\n</section>\n<section class=\"border-b border-[#141014]/15\" data-kid=\"5\" data-name=\"education section\" id=\"education\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-14\" data-kid=\"5-1\" data-name=\"education container\">\n<h2 class=\"bf-poster text-[15px] uppercase tracking-[0.1em] text-[#141014]\" data-kid=\"5-1-1\" data-name=\"education heading\">Education</h2>\n<div class=\"mt-4 h-[1px] w-full bg-[#141014]/20\" data-kid=\"5-1-2\" data-name=\"education divider rule\"></div>\n<div class=\"mt-7 grid gap-4 sm:grid-cols-2\" data-kid=\"5-1-3\" data-name=\"education cards grid\">\n<div class=\"border-l-[3px] border-[#D8462F] bg-[#F0E1D5] px-6 py-5\" data-kid=\"5-2\" data-name=\"education card national institute of design\">\n<p class=\"bf-mono text-[10px] uppercase tracking-[0.18em] text-[#7E7069]\" data-kid=\"5-2-1\" data-name=\"study dates\">2015 — 2017</p>\n<p class=\"bf-poster mt-2 text-[16px] uppercase leading-[1.25] text-[#141014]\" data-kid=\"5-2-2\" data-name=\"institution name\">National Institute of Design</p>\n<p class=\"mt-1 text-[14px] text-[#7E7069]\" data-kid=\"5-2-3\" data-name=\"field of study\">Interaction design</p>\n</div>\n<div class=\"border-l-[3px] border-[#D8462F] bg-[#F0E1D5] px-6 py-5\" data-kid=\"5-3\" data-name=\"education card srishti institute\">\n<p class=\"bf-mono text-[10px] uppercase tracking-[0.18em] text-[#7E7069]\" data-kid=\"5-3-1\" data-name=\"study dates\">2013 — 2015</p>\n<p class=\"bf-poster mt-2 text-[16px] uppercase leading-[1.25] text-[#141014]\" data-kid=\"5-3-2\" data-name=\"institution name\">Srishti Institute</p>\n<p class=\"mt-1 text-[14px] text-[#7E7069]\" data-kid=\"5-3-3\" data-name=\"field of study\">Foundation studies</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"bg-[#F0E1D5]\" data-kid=\"6\" data-name=\"elsewhere links section\" id=\"links\">\n<div class=\"mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-5 px-6 py-9\" data-kid=\"6-1\" data-name=\"links row\">\n<h2 class=\"bf-poster text-[13px] uppercase tracking-[0.12em] text-[#141014]\" data-kid=\"6-1-1\" data-name=\"elsewhere heading\">Elsewhere</h2>\n<div class=\"bf-mono flex flex-wrap items-center gap-x-7 gap-y-3 text-[10px] uppercase tracking-[0.18em]\" data-kid=\"6-1-2\" data-name=\"social link list\">\n<a class=\"inline-flex items-center gap-1.5 text-[#141014] hover:text-[#D8462F]\" data-kid=\"6-2\" data-name=\"github link\" href=\"https://github.com\">\n        GitHub\n        <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"6-2-1\" data-name=\"external arrow icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg>\n</a>\n<a class=\"inline-flex items-center gap-1.5 text-[#141014] hover:text-[#D8462F]\" data-kid=\"6-3\" data-name=\"dribbble link\" href=\"https://dribbble.com\">\n        Dribbble\n        <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"6-3-1\" data-name=\"external arrow icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg>\n</a>\n<a class=\"inline-flex items-center gap-1.5 text-[#141014] hover:text-[#D8462F]\" data-kid=\"6-4\" data-name=\"linkedin link\" href=\"https://linkedin.com\">\n        LinkedIn\n        <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"6-4-1\" data-name=\"external arrow icon\" fill=\"none\" viewbox=\"0 0 12 12\"><path d=\"M3 9 L9 3 M9 3 H4.6 M9 3 V7.4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.2\"></path></svg>\n</a>\n<a class=\"text-[#D8462F]\" data-kid=\"6-5\" data-name=\"email href link\" href=\"mailto:hello@example.com\">hello@example.com</a>\n</div>\n</div>\n</section>\n<footer class=\"bg-[#141014]\" data-kid=\"7\" data-name=\"page footer\">\n<div class=\"mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-3 px-6 py-6\" data-kid=\"7-1\" data-name=\"footer content row\">\n<span class=\"bf-poster text-[11px] uppercase tracking-[0.14em] text-[#FFF6EC]\" data-kid=\"7-2\" data-name=\"footer owner name\">Aarav Menon</span>\n<span class=\"bf-mono text-[10px] uppercase tracking-[0.18em] text-[#A29289]\" data-kid=\"7-3\" data-name=\"footer role label\">Interface designer</span>\n</div>\n</footer>\n</body>",
