        "h": 0
      },
      "html": "<body class=\"min-h-screen bg-[#F0F2F7] text-[#05070F] antialiased\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Barlow:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n    body { font-family: 'Barlow', sans-serif; }\n    .sans { font-family: 'Chakra Petch', sans-serif; }\n    .mono { font-family: 'IBM Plex Mono', monospace; }\n    .layer { will-change: transform; transition: transform 320ms cubic-bezier(.2,.8,.2,1); }\n    .starfield-1 { background-image: radial-gradient(#BBD4FF 1px, transparent 1.2px); background-size: 140px 140px; opacity: .30; }\n    .starfield-2 { background-image: radial-gradient(#FFFFFF 0.9px, transparent 1.1px); background-size: 92px 92px; opacity: .45; }\n    .starfield-3 { background-image: radial-gradient(#7FB2FF 1.4px, transparent 1.6px); background-size: 210px 210px; opacity: .55; }\n  </style>\n<header class=\"sticky top-0 z-30 border-b border-[#7FB2FF]/18 bg-[#05070F]/94 backdrop-blur\" data-kid=\"1\" data-name=\"sticky site header bar\">\n<div class=\"mx-auto flex h-[58px] max-w-[1200px] items-center justify-between px-7\" data-kid=\"1-1\" data-name=\"header inner flex container\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#top\">\n<span class=\"sans grid h-7 w-7 place-items-center rounded-full border border-[#7FB2FF]/50 text-[10px] text-[#7FB2FF]\" data-kid=\"1-1-1-1\" data-name=\"circular initials monogram\">AM</span>\n<span class=\"mono text-[10px] uppercase tracking-[0.28em] text-[#EAF0FA]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">Aarav Menon</span>\n</a>\n<nav class=\"mono hidden items-center gap-7 text-[9px] uppercase tracking-[0.2em] text-[#7C869C] md:flex\" data-kid=\"1-1-2\" data-name=\"primary navigation menu\">\n<a data-kid=\"1-1-2-1\" data-name=\"Work nav link\" href=\"#work\">Work</a><a data-kid=\"1-1-2-2\" data-name=\"Experience nav link\" href=\"#experience\">Experience</a><a data-kid=\"1-1-2-3\" data-name=\"Education nav link\" href=\"#education\">Education</a><a data-kid=\"1-1-2-4\" data-name=\"Links nav link\" href=\"#elsewhere\">Links</a>\n</nav>\n<span class=\"mono hidden text-[9px] uppercase tracking-[0.2em] text-[#7C869C] sm:block\" data-kid=\"1-1-3\" data-name=\"role label tagline\">Interface designer</span>\n</div>\n</header>\n<section class=\"relative overflow-hidden bg-[#05070F] text-[#EAF0FA]\" data-kid=\"2\" data-name=\"hero section with dark starfield background\" id=\"top\">\n<div class=\"layer starfield-1 pointer-events-none absolute -inset-8\" data-dynamic=\"true\" data-kid=\"2-1\" data-name=\"decorative far starfield layer\" data-reason=\"transform set from mouse position by parallax script\" data-stars=\"\"></div>\n<div class=\"layer starfield-2 pointer-events-none absolute -inset-8\" data-dynamic=\"true\" data-kid=\"2-2\" data-name=\"decorative mid starfield layer\" data-reason=\"transform set from mouse position by parallax script\" data-stars=\"\"></div>\n<div class=\"layer starfield-3 pointer-events-none absolute -inset-8\" data-dynamic=\"true\" data-kid=\"2-3\" data-name=\"decorative near starfield layer\" data-reason=\"transform set from mouse position by parallax script\" data-stars=\"\"></div>\n<div aria-hidden=\"\" class=\"pointer-events-none absolute inset-0\" data-kid=\"2-4\" data-name=\"radial glow gradient background layer\" style=\"background-image:radial-gradient(58% 48% at 22% 6%, rgba(63,111,224,0.32), transparent 68%), radial-gradient(40% 36% at 88% 84%, rgba(127,178,255,0.14), transparent 72%)\"></div>\n<svg aria-hidden=\"\" class=\"pointer-events-none absolute -bottom-[300px] left-1/2 h-[760px] w-[1080px] -translate-x-1/2\" data-kid=\"2-5\" data-name=\"decorative concentric orbit circles SVG\" viewbox=\"0 0 1280 700\">\n<circle cx=\"640\" cy=\"700\" fill=\"none\" opacity=\"0.22\" r=\"560\" stroke=\"#7FB2FF\" stroke-width=\"1\"></circle>\n<circle cx=\"640\" cy=\"700\" fill=\"none\" opacity=\"0.5\" r=\"430\" stroke=\"#3F6FE0\" stroke-dasharray=\"3 9\" stroke-width=\"1\"></circle>\n<circle cx=\"640\" cy=\"700\" fill=\"none\" opacity=\"0.18\" r=\"300\" stroke=\"#7FB2FF\" stroke-width=\"0.8\"></circle>\n</svg>\n<div class=\"relative mx-auto max-w-[1200px] px-7 pb-16 pt-16 md:pb-20 md:pt-24\" data-kid=\"2-6\" data-name=\"hero content container\">\n<p class=\"mono text-[9px] uppercase tracking-[0.4em] text-[#7FB2FF]\" data-kid=\"2-6-1\" data-name=\"hero eyebrow role label\">Interface designer</p>\n<h1 class=\"sans mt-5 uppercase leading-[0.8]\" data-kid=\"2-6-2\" data-name=\"hero name headline\" style=\"font-size:clamp(3.6rem,11vw,8rem); font-weight:700; letter-spacing:-0.015em\">\n        Aarav<br data-kid=\"2-6-2-1\" data-name=\"line break between first and last name\"/><span class=\"text-[#7FB2FF]\" data-kid=\"2-6-2-2\" data-name=\"highlighted surname text\">Menon</span>\n</h1>\n<div class=\"mt-8 grid gap-8 md:grid-cols-[1.15fr_0.85fr] md:items-end\" data-kid=\"2-6-3\" data-name=\"hero lower split grid\">\n<p class=\"max-w-[46ch] text-[15.5px] leading-[1.8] text-[#EAF0FA]/72\" data-kid=\"2-6-3-1\" data-name=\"hero description paragraph\">\n          I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n        </p>\n<div class=\"flex flex-wrap gap-2 md:justify-end\" data-kid=\"2-6-3-2\" data-name=\"skill tags wrapper\">\n<span class=\"rounded-full border border-[#7FB2FF]/30 px-3 py-1.5 text-[10px] text-[#EAF0FA]/85\" data-kid=\"2-6-3-2-1\" data-name=\"Design systems skill pill\">Design systems</span>\n<span class=\"rounded-full border border-[#7FB2FF]/30 px-3 py-1.5 text-[10px] text-[#EAF0FA]/85\" data-kid=\"2-6-3-2-2\" data-name=\"Interaction design skill pill\">Interaction design</span>\n<span class=\"rounded-full border border-[#7FB2FF]/30 px-3 py-1.5 text-[10px] text-[#EAF0FA]/85\" data-kid=\"2-6-3-2-3\" data-name=\"Prototyping skill pill\">Prototyping</span>\n<span class=\"rounded-full border border-[#7FB2FF]/30 px-3 py-1.5 text-[10px] text-[#EAF0FA]/85\" data-kid=\"2-6-3-2-4\" data-name=\"Motion skill pill\">Motion</span>\n<span class=\"rounded-full border border-[#7FB2FF]/30 px-3 py-1.5 text-[10px] text-[#EAF0FA]/85\" data-kid=\"2-6-3-2-5\" data-name=\"Type skill pill\">Type</span>\n<span class=\"rounded-full border border-[#7FB2FF]/30 px-3 py-1.5 text-[10px] text-[#EAF0FA]/85\" data-kid=\"2-6-3-2-6\" data-name=\"Research skill pill\">Research</span>\n</div>\n</div>\n<div class=\"mt-11 grid gap-2 border-t border-[#7FB2FF]/20 pt-5 sm:grid-cols-3\" data-kid=\"2-6-4\" data-name=\"hero quick-facts strip\">\n<div class=\"flex items-baseline gap-3\" data-kid=\"2-6-4-1\" data-name=\"current studio fact item\">\n<span class=\"mono text-[8px] uppercase tracking-[0.2em] text-[#7C869C]\" data-kid=\"2-6-4-1-1\" data-name=\"Currently fact label\">Currently</span>\n<span class=\"text-[13px] font-medium\" data-kid=\"2-6-4-1-2\" data-name=\"current studio value\">Fintrail</span>\n</div>\n<div class=\"flex items-baseline gap-3\" data-kid=\"2-6-4-2\" data-name=\"projects count fact item\">\n<span class=\"mono text-[8px] uppercase tracking-[0.2em] text-[#7C869C]\" data-kid=\"2-6-4-2-1\" data-name=\"Projects fact label\">Projects</span>\n<span class=\"text-[13px] font-medium\" data-kid=\"2-6-4-2-2\" data-name=\"projects count value\">03</span>\n</div>\n<div class=\"flex items-baseline gap-3\" data-kid=\"2-6-4-3\" data-name=\"location fact item\">\n<span class=\"mono text-[8px] uppercase tracking-[0.2em] text-[#7C869C]\" data-kid=\"2-6-4-3-1\" data-name=\"Based in fact label\">Based in</span>\n<span class=\"text-[13px] font-medium\" data-kid=\"2-6-4-3-2\" data-name=\"location value\">Bengaluru</span>\n</div>\n</div>\n</div>\n</section>\n<section class=\"mx-auto max-w-[1200px] px-7 py-14\" data-kid=\"3\" data-name=\"selected work section\" id=\"work\">\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#05070F]/15 pb-3\" data-kid=\"3-1\" data-name=\"section header bar with count\">\n<h2 class=\"sans text-[30px] font-semibold uppercase tracking-[0.01em]\" data-kid=\"3-1-1\" data-name=\"Selected work section title\">Selected work</h2>\n<span class=\"mono text-[9px] uppercase tracking-[0.2em] text-[#6B7385]\" data-kid=\"3-1-2\" data-name=\"project count label\">03 projects</span>\n</div>\n<article class=\"mt-7 grid gap-8 rounded-[18px] bg-[#E1E5EE] p-8 md:grid-cols-[1.15fr_0.85fr] md:items-center\" data-kid=\"3-2\" data-name=\"featured project card (Kestrel)\">\n<div data-kid=\"3-2-1\" data-name=\"featured project text content\">\n<p class=\"mono text-[9px] uppercase tracking-[0.22em] text-[#3F6FE0]\" data-kid=\"3-2-1-1\" data-name=\"project category label\">Design system</p>\n<h3 class=\"sans mt-3 text-[38px] font-semibold uppercase leading-[1]\" data-kid=\"3-2-1-2\" data-name=\"project title\">Kestrel</h3>\n<p class=\"mt-3 max-w-[50ch] text-[13.5px] leading-[1.8] text-[#05070F]/70\" data-kid=\"3-2-1-3\" data-name=\"project description\">\n          A 240-component library and the token pipeline behind it, adopted by four product teams.\n        </p>\n<div class=\"mt-6 flex items-center gap-5\" data-kid=\"3-2-1-4\" data-name=\"project action row\">\n<a class=\"rounded-full bg-[#05070F] px-4 py-2.5 text-[11px] font-semibold text-[#EAF0FA]\" data-kid=\"3-2-1-4-1\" data-name=\"read case study button\" href=\"#work\">Read case study</a>\n<span class=\"mono text-[10px] text-[#6B7385]\" data-kid=\"3-2-1-4-2\" data-name=\"project year\">2025</span>\n</div>\n</div>\n<svg aria-hidden=\"\" class=\"w-full\" data-kid=\"3-2-2\" data-name=\"decorative orbital system SVG\" viewbox=\"0 0 320 200\">\n<circle cx=\"160\" cy=\"100\" fill=\"none\" opacity=\"0.18\" r=\"86\" stroke=\"#05070F\" stroke-width=\"0.8\"></circle>\n<ellipse cx=\"160\" cy=\"100\" fill=\"none\" opacity=\"0.75\" rx=\"86\" ry=\"34\" stroke=\"#3F6FE0\" stroke-width=\"1\" transform=\"rotate(-18 160 100)\"></ellipse>\n<ellipse cx=\"160\" cy=\"100\" fill=\"none\" opacity=\"0.34\" rx=\"62\" ry=\"62\" stroke=\"#05070F\" stroke-dasharray=\"2 6\" stroke-width=\"0.7\"></ellipse>\n<circle cx=\"160\" cy=\"100\" fill=\"#05070F\" r=\"12\"></circle>\n<circle cx=\"233\" cy=\"78\" fill=\"#3F6FE0\" r=\"4\"></circle>\n<circle cx=\"98\" cy=\"126\" fill=\"#05070F\" opacity=\"0.5\" r=\"2.5\"></circle>\n</svg>\n</article>\n<div class=\"mt-4 grid gap-4 md:grid-cols-2\" data-kid=\"3-3\" data-name=\"secondary projects grid\">\n<article class=\"rounded-[18px] border border-[#05070F]/12 p-6\" data-kid=\"3-3-1\" data-name=\"project card (Tide and Timber)\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"3-3-1-1\" data-name=\"card header row\">\n<p class=\"mono text-[9px] uppercase tracking-[0.2em] text-[#3F6FE0]\" data-kid=\"3-3-1-1-1\" data-name=\"project category label\">Booking app</p>\n<span class=\"mono text-[10px] text-[#6B7385]\" data-kid=\"3-3-1-1-2\" data-name=\"project year\">2024</span>\n</div>\n<h3 class=\"sans mt-3 text-[24px] font-semibold uppercase leading-[1.05]\" data-kid=\"3-3-1-2\" data-name=\"project title\">Tide &amp; Timber</h3>\n<p class=\"mt-2 max-w-[46ch] text-[13px] leading-[1.75] text-[#05070F]/68\" data-kid=\"3-3-1-3\" data-name=\"project description\">\n          Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.\n        </p>\n<a class=\"mono mt-4 inline-block text-[9px] uppercase tracking-[0.18em] text-[#05070F] underline decoration-[#3F6FE0] decoration-2 underline-offset-4\" data-kid=\"3-3-1-4\" data-name=\"read case study link\" href=\"#work\">Read case study</a>\n</article>\n<article class=\"rounded-[18px] border border-[#05070F]/12 p-6\" data-kid=\"3-3-2\" data-name=\"project card (Loom Audio)\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"3-3-2-1\" data-name=\"card header row\">\n<p class=\"mono text-[9px] uppercase tracking-[0.2em] text-[#3F6FE0]\" data-kid=\"3-3-2-1-1\" data-name=\"project category label\">Editorial platform</p>\n<span class=\"mono text-[10px] text-[#6B7385]\" data-kid=\"3-3-2-1-2\" data-name=\"project year\">2023</span>\n</div>\n<h3 class=\"sans mt-3 text-[24px] font-semibold uppercase leading-[1.05]\" data-kid=\"3-3-2-2\" data-name=\"project title\">Loom Audio</h3>\n<p class=\"mt-2 max-w-[46ch] text-[13px] leading-[1.75] text-[#05070F]/68\" data-kid=\"3-3-2-3\" data-name=\"project description\">\n          A reading surface for long-form audio transcripts, built for one-handed use.\n        </p>\n<a class=\"mono mt-4 inline-block text-[9px] uppercase tracking-[0.18em] text-[#05070F] underline decoration-[#3F6FE0] decoration-2 underline-offset-4\" data-kid=\"3-3-2-4\" data-name=\"read case study link\" href=\"#work\">Read case study</a>\n</article>\n</div>\n</section>\n<section class=\"bg-[#05070F] text-[#EAF0FA]\" data-kid=\"4\" data-name=\"experience section (dark)\" id=\"experience\">\n<div class=\"mx-auto max-w-[1200px] px-7 py-14\" data-kid=\"4-1\" data-name=\"experience section container\">\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#7FB2FF]/20 pb-3\" data-kid=\"4-1-1\" data-name=\"section header bar with count\">\n<h2 class=\"sans text-[28px] font-semibold uppercase tracking-[0.01em]\" data-kid=\"4-1-1-1\" data-name=\"Experience section title\">Experience</h2>\n<span class=\"mono text-[9px] uppercase tracking-[0.2em] text-[#7C869C]\" data-kid=\"4-1-1-2\" data-name=\"role count label\">03 roles</span>\n</div>\n<div class=\"mt-2\" data-kid=\"4-1-2\" data-name=\"experience list wrapper\">\n<div class=\"grid gap-2 border-b border-[#7FB2FF]/12 py-5 md:grid-cols-[150px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-2-1\" data-name=\"experience row (Fintrail)\">\n<span class=\"mono text-[9px] uppercase tracking-[0.16em] text-[#7FB2FF]\" data-kid=\"4-1-2-1-1\" data-name=\"role date range\">2022 — present</span>\n<div data-kid=\"4-1-2-1-2\" data-name=\"role details group\">\n<p class=\"sans text-[17px] font-medium\" data-kid=\"4-1-2-1-2-1\" data-name=\"company name\">Fintrail</p>\n<p class=\"text-[12.5px] text-[#EAF0FA]/62\" data-kid=\"4-1-2-1-2-2\" data-name=\"role summary\">Senior product designer — payments, onboarding and the design system.</p>\n</div>\n<span class=\"h-1.5 w-1.5 rounded-full bg-[#7FB2FF] md:justify-self-end\" data-kid=\"4-1-2-1-3\" data-name=\"active role status dot\"></span>\n</div>\n<div class=\"grid gap-2 border-b border-[#7FB2FF]/12 py-5 md:grid-cols-[150px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-2-2\" data-name=\"experience row (Sundial Studio)\">\n<span class=\"mono text-[9px] uppercase tracking-[0.16em] text-[#7FB2FF]\" data-kid=\"4-1-2-2-1\" data-name=\"role date range\">2019 — 2022</span>\n<div data-kid=\"4-1-2-2-2\" data-name=\"role details group\">\n<p class=\"sans text-[17px] font-medium\" data-kid=\"4-1-2-2-2-1\" data-name=\"company name\">Sundial Studio</p>\n<p class=\"text-[12.5px] text-[#EAF0FA]/62\" data-kid=\"4-1-2-2-2-2\" data-name=\"role summary\">Product designer — booking and travel products for three clients.</p>\n</div>\n<span class=\"h-1.5 w-1.5 rounded-full bg-[#7FB2FF]/40 md:justify-self-end\" data-kid=\"4-1-2-2-3\" data-name=\"role status dot\"></span>\n</div>\n<div class=\"grid gap-2 border-b border-[#7FB2FF]/12 py-5 md:grid-cols-[150px_1fr_auto] md:items-baseline md:gap-6\" data-kid=\"4-1-2-3\" data-name=\"experience row (Pageturn Press)\">\n<span class=\"mono text-[9px] uppercase tracking-[0.16em] text-[#7FB2FF]\" data-kid=\"4-1-2-3-1\" data-name=\"role date range\">2017 — 2019</span>\n<div data-kid=\"4-1-2-3-2\" data-name=\"role details group\">\n<p class=\"sans text-[17px] font-medium\" data-kid=\"4-1-2-3-2-1\" data-name=\"company name\">Pageturn Press</p>\n<p class=\"text-[12.5px] text-[#EAF0FA]/62\" data-kid=\"4-1-2-3-2-2\" data-name=\"role summary\">Interface designer — digital editions of a 90-year-old imprint.</p>\n</div>\n<span class=\"h-1.5 w-1.5 rounded-full bg-[#7FB2FF]/40 md:justify-self-end\" data-kid=\"4-1-2-3-3\" data-name=\"role status dot\"></span>\n</div>\n</div>\n</div>\n</section>\n<div class=\"mx-auto grid max-w-[1200px] gap-10 px-7 py-14 md:grid-cols-2\" data-kid=\"5\" data-name=\"lower two-column section grid\">\n<section data-kid=\"5-1\" data-name=\"education section\" id=\"education\">\n<h2 class=\"sans text-[22px] font-semibold uppercase\" data-kid=\"5-1-1\" data-name=\"Education section title\">Education</h2>\n<div class=\"mt-4 border-t border-[#05070F]/15\" data-kid=\"5-1-2\" data-name=\"education entry list\">\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#05070F]/12 py-3.5\" data-kid=\"5-1-2-1\" data-name=\"education row (NID)\">\n<div data-kid=\"5-1-2-1-1\" data-name=\"education details group\"><p class=\"text-[14px] font-semibold\" data-kid=\"5-1-2-1-1-1\" data-name=\"institution name\">National Institute of Design</p><p class=\"text-[12px] text-[#6B7385]\" data-kid=\"5-1-2-1-1-2\" data-name=\"degree/program\">Interaction design</p></div>\n<span class=\"mono text-[10px] text-[#6B7385]\" data-kid=\"5-1-2-1-2\" data-name=\"education date range\">2015 — 2017</span>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[#05070F]/12 py-3.5\" data-kid=\"5-1-2-2\" data-name=\"education row (Srishti)\">\n<div data-kid=\"5-1-2-2-1\" data-name=\"education details group\"><p class=\"text-[14px] font-semibold\" data-kid=\"5-1-2-2-1-1\" data-name=\"institution name\">Srishti Institute</p><p class=\"text-[12px] text-[#6B7385]\" data-kid=\"5-1-2-2-1-2\" data-name=\"degree/program\">Foundation studies</p></div>\n<span class=\"mono text-[10px] text-[#6B7385]\" data-kid=\"5-1-2-2-2\" data-name=\"education date range\">2013 — 2015</span>\n</div>\n</div>\n</section>\n<section data-kid=\"5-2\" data-name=\"links section\" id=\"elsewhere\">\n<h2 class=\"sans text-[22px] font-semibold uppercase\" data-kid=\"5-2-1\" data-name=\"Links section title\">Links</h2>\n<div class=\"mt-4 grid grid-cols-2 gap-2\" data-kid=\"5-2-2\" data-name=\"links grid\">\n<a class=\"flex items-center justify-between rounded-full border border-[#05070F]/15 px-4 py-2.5 text-[11px] font-semibold\" data-kid=\"5-2-2-1\" data-name=\"GitHub link with arrow\" href=\"#elsewhere\">GitHub <span class=\"text-[#3F6FE0]\" data-kid=\"5-2-2-1-1\" data-name=\"outbound arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between rounded-full border border-[#05070F]/15 px-4 py-2.5 text-[11px] font-semibold\" data-kid=\"5-2-2-2\" data-name=\"Dribbble link with arrow\" href=\"#elsewhere\">Dribbble <span class=\"text-[#3F6FE0]\" data-kid=\"5-2-2-2-1\" data-name=\"outbound arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between rounded-full border border-[#05070F]/15 px-4 py-2.5 text-[11px] font-semibold\" data-kid=\"5-2-2-3\" data-name=\"LinkedIn link with arrow\" href=\"#elsewhere\">LinkedIn <span class=\"text-[#3F6FE0]\" data-kid=\"5-2-2-3-1\" data-name=\"outbound arrow icon\">↗</span></a>\n<a class=\"flex items-center justify-between rounded-full border border-[#05070F]/15 px-4 py-2.5 text-[11px] font-semibold\" data-kid=\"5-2-2-4\" data-name=\"Email link with arrow\" href=\"#elsewhere\">Email <span class=\"text-[#3F6FE0]\" data-kid=\"5-2-2-4-1\" data-name=\"outbound arrow icon\">↗</span></a>\n</div>\n</section>\n</div>\n<footer class=\"border-t border-[#05070F]/15\" data-kid=\"6\" data-name=\"site footer\">\n<div class=\"mx-auto flex max-w-[1200px] items-center justify-between px-7 py-5\" data-kid=\"6-1\" data-name=\"footer inner row\">\n<span class=\"mono text-[9px] uppercase tracking-[0.22em] text-[#6B7385]\" data-kid=\"6-1-1\" data-name=\"footer signature text\">Aarav Menon — interface designer</span>\n<a class=\"mono text-[9px] uppercase tracking-[0.22em] text-[#6B7385]\" data-kid=\"6-1-2\" data-name=\"back to top link\" href=\"#top\">Back to top</a>\n</div>\n</footer>\n<script>\n    const layers = Array.from(document.querySelectorAll('[data-stars]'));\n    const hero = document.getElementById('top');\n    let frame = 0;\n    if (hero && layers.length) {\n      hero.addEventListener('pointermove', function (event) {\n        if (frame) return;\n        frame = requestAnimationFrame(function () {\n          frame = 0;\n          const rect = hero.getBoundingClientRect();\n          const px = (event.clientX - rect.left) / rect.width - 0.5;\n          const py = (event.clientY - rect.top) / rect.height - 0.5;\n          layers.forEach(function (layer, index) {\n            const depth = (index + 1) * 11;\n            layer.style.transform = 'translate3d(' + (px * depth).toFixed(2) + 'px,' + (py * depth).toFixed(2) + 'px,0)';\n          });\n        });\n      });\n    }\n  </script>\n</body>",
