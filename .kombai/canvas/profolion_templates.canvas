        "h": 0
      },
      "html": "<div class=\"min-h-screen overflow-x-hidden bg-[#F5F1E8] ws-body text-[#14161B]\" data-kid=\"4\" data-name=\"portfolio page layout container\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Instrument+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n    .ws-display { font-family: 'Archivo Black', 'Helvetica Neue', sans-serif; }\n    .ws-body { font-family: 'Instrument Sans', 'Helvetica Neue', sans-serif; }\n    .ws-mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }\n    .ws-halftone { background-image: radial-gradient(#14161B 1px, transparent 1.2px); background-size: 8px 8px; opacity: 0.09; }\n    .ws-halftone-accent { background-image: radial-gradient(#C4161C 1px, transparent 1.2px); background-size: 7px 7px; opacity: 0.18; }\n    .ws-cut-br { clip-path: polygon(0 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%); }\n    .ws-cut-tr { clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%); }\n    .ws-cut-tl { clip-path: polygon(20px 0, 100% 0, 100% 100%, 0 100%, 0 20px); }\n    .ws-misreg { text-shadow: 6px 5px 0 rgba(196, 22, 28, 0.85); }\n    .ws-panel { box-shadow: 9px 9px 0 0 #E9E2D4; }\n    .ws-sticker { box-shadow: 5px 5px 0 0 #14161B; }\n    .ws-sticker-accent { box-shadow: 7px 7px 0 0 #C4161C; }\n  </style>\n<header class=\"sticky top-0 z-30 border-b border-[#14161B]/15 bg-[#F5F1E8]/95 backdrop-blur\" data-kid=\"1\" data-name=\"sticky site header bar\">\n<div class=\"mx-auto flex h-16 max-w-[1180px] items-center justify-between px-6\" data-kid=\"1-1\" data-name=\"header content row\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"owner name logo home link\" href=\"#top\">\n<span class=\"grid h-9 w-9 place-items-center border-2 border-[#14161B] bg-[#C4161C] ws-mono text-[11px] font-semibold tracking-[0.06em] text-[#FFFDF6]\" data-kid=\"1-1-1-1\" data-name=\"AM monogram sticker badge\">AM</span>\n<span class=\"ws-body text-[15px] font-semibold tracking-[-0.01em] text-[#14161B]\" data-kid=\"1-1-1-2\" data-name=\"owner name logo text\">Aarav Menon</span>\n</a>\n<nav class=\"hidden items-center gap-6 ws-mono text-[10px] uppercase tracking-[0.2em] text-[#6F7278] md:flex\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n<a class=\"hover:text-[#C4161C]\" data-kid=\"1-1-2-1\" data-name=\"work section nav link\" href=\"#work\">Work</a>\n<a class=\"hover:text-[#C4161C]\" data-kid=\"1-1-2-2\" data-name=\"experience section nav link\" href=\"#experience\">Experience</a>\n<a class=\"hover:text-[#C4161C]\" data-kid=\"1-1-2-3\" data-name=\"education section nav link\" href=\"#education\">Education</a>\n<a class=\"hover:text-[#C4161C]\" data-kid=\"1-1-2-4\" data-name=\"links section nav link\" href=\"#links\">Links</a>\n</nav>\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.2em] text-[#6F7278]\" data-kid=\"1-1-3\" data-name=\"role label\">Interface designer</span>\n</div>\n</header>\n<main data-kid=\"2\" data-name=\"template page body\">\n<section class=\"relative overflow-hidden border-b border-[#14161B]/15\" data-kid=\"2-1\" data-name=\"sticker opening band\" id=\"top\">\n<div class=\"pointer-events-none absolute inset-0 ws-halftone\" data-kid=\"2-1-3\" data-name=\"halftone dot field\"></div>\n<svg class=\"pointer-events-none absolute -right-16 -top-20 h-[340px] w-[340px] opacity-[0.13]\" data-kid=\"2-1-1\" data-name=\"concentric thread corner ornament icon\" fill=\"none\" stroke=\"#14161B\" stroke-width=\"1\" viewbox=\"0 0 240 240\">\n<path d=\"M120 0V240M0 120H240M36 36L204 204M204 36L36 204\"></path>\n<ellipse cx=\"120\" cy=\"120\" rx=\"96\" ry=\"96\"></ellipse>\n<ellipse cx=\"120\" cy=\"120\" rx=\"64\" ry=\"64\"></ellipse>\n<ellipse cx=\"120\" cy=\"120\" rx=\"32\" ry=\"32\"></ellipse>\n</svg>\n<div class=\"relative mx-auto max-w-[1180px] px-6 pb-10 pt-12\" data-kid=\"2-1-2\" data-name=\"opening band content\">\n<div class=\"grid grid-cols-12 gap-5\" data-kid=\"2-1-2-1\" data-name=\"opening sticker grid\">\n<div class=\"col-span-12 md:col-span-7\" data-kid=\"2-1-2-1-1\" data-name=\"name sticker panel column\">\n<div class=\"ws-cut-br border-2 border-[#14161B] bg-[#F5F1E8] p-7 ws-panel\" data-kid=\"2-1-2-1-1-1\" data-name=\"name sticker panel\">\n<div class=\"flex items-start justify-between\" data-kid=\"2-1-2-1-1-1-1\" data-name=\"panel top row\">\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.22em] text-[#6F7278]\" data-kid=\"2-1-2-1-1-1-1-1\" data-name=\"role eyebrow\">Interface designer</span>\n<span class=\"grid h-5 w-5 place-items-center bg-[#C4161C]\" data-kid=\"2-1-2-1-1-1-1-2\" data-name=\"red ink square\"></span>\n</div>\n<h1 class=\"ws-display ws-misreg mt-7 text-[52px] uppercase leading-[0.86] tracking-[-0.035em] text-[#14161B] md:text-[84px]\" data-kid=\"2-1-2-1-1-1-2\" data-name=\"owner name display headline\">\n<span class=\"block\" data-kid=\"2-1-2-1-1-1-2-1\" data-name=\"last name display block\">Aarav</span>\n<span class=\"block\" data-kid=\"2-1-2-1-1-1-2-2\" data-name=\"first name display block\">Menon</span>\n</h1>\n<div class=\"mt-7 flex flex-wrap items-center justify-between gap-4 border-t-2 border-[#14161B] pt-4\" data-kid=\"2-1-2-1-1-1-3\" data-name=\"panel footer row\">\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.2em] text-[#6F7278]\" data-kid=\"2-1-2-1-1-1-3-1\" data-name=\"monogram label\">AM / Interface designer</span>\n<a class=\"inline-flex items-center gap-2 ws-mono text-[10px] uppercase tracking-[0.2em] text-[#14161B] hover:text-[#C4161C]\" data-kid=\"2-1-2-1-1-1-3-2\" data-name=\"selected work anchor link\" href=\"#work\">\nSelected work\n<svg class=\"h-3 w-3\" data-kid=\"2-1-2-1-1-1-3-2-1\" data-name=\"diagonal arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 12 12\"><path d=\"M3 9 9 3M4.5 3H9v4.5\"></path></svg>\n</a>\n</div>\n</div>\n</div>\n<div class=\"col-span-12 flex flex-col gap-5 md:col-span-5\" data-kid=\"2-1-2-1-2\" data-name=\"bio and links sticker column\">\n<div class=\"ws-cut-tr border-2 border-[#14161B] bg-[#E9E2D4] p-6\" data-kid=\"2-1-2-1-2-1\" data-name=\"bio sticker panel\">\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.22em] text-[#6F7278]\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"about label\">About</span>\n<p class=\"mt-4 text-[15px] leading-[1.65] text-[#14161B]\" data-kid=\"2-1-2-1-2-1-2\" data-name=\"owner bio paragraph\">I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.</p>\n</div>\n<div class=\"ws-cut-br border-2 border-[#14161B] bg-[#F5F1E8] p-6 ws-sticker\" data-kid=\"2-1-2-1-2-2\" data-name=\"links sticker panel\">\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.22em] text-[#6F7278]\" data-kid=\"2-1-2-1-2-2-1\" data-name=\"links label\">Links</span>\n<ul class=\"mt-3 divide-y divide-[#14161B]/12\" data-kid=\"2-1-2-1-2-2-2\" data-name=\"social link list\">\n<li data-kid=\"2-1-2-1-2-2-2-1\" data-name=\"github link row\"><a class=\"flex items-center justify-between py-2.5 text-[14px] font-medium text-[#14161B] hover:text-[#C4161C]\" data-kid=\"2-1-2-1-2-2-2-1-1\" data-name=\"github link\" href=\"https://github.com\"><span data-kid=\"2-1-2-1-2-2-2-1-1-1\" data-name=\"github label text\">GitHub</span><svg class=\"h-3 w-3\" data-kid=\"2-1-2-1-2-2-2-1-1-2\" data-name=\"diagonal arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 12 12\"><path d=\"M3 9 9 3M4.5 3H9v4.5\"></path></svg></a></li>\n<li data-kid=\"2-1-2-1-2-2-2-2\" data-name=\"dribbble link row\"><a class=\"flex items-center justify-between py-2.5 text-[14px] font-medium text-[#14161B] hover:text-[#C4161C]\" data-kid=\"2-1-2-1-2-2-2-2-1\" data-name=\"dribbble link\" href=\"https://dribbble.com\"><span data-kid=\"2-1-2-1-2-2-2-2-1-1\" data-name=\"dribbble label text\">Dribbble</span><svg class=\"h-3 w-3\" data-kid=\"2-1-2-1-2-2-2-2-1-2\" data-name=\"diagonal arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 12 12\"><path d=\"M3 9 9 3M4.5 3H9v4.5\"></path></svg></a></li>\n<li data-kid=\"2-1-2-1-2-2-2-3\" data-name=\"linkedin link row\"><a class=\"flex items-center justify-between py-2.5 text-[14px] font-medium text-[#14161B] hover:text-[#C4161C]\" data-kid=\"2-1-2-1-2-2-2-3-1\" data-name=\"linkedin link\" href=\"https://linkedin.com\"><span data-kid=\"2-1-2-1-2-2-2-3-1-1\" data-name=\"linkedin label text\">LinkedIn</span><svg class=\"h-3 w-3\" data-kid=\"2-1-2-1-2-2-2-3-1-2\" data-name=\"diagonal arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 12 12\"><path d=\"M3 9 9 3M4.5 3H9v4.5\"></path></svg></a></li>\n<li data-kid=\"2-1-2-1-2-2-2-4\" data-name=\"email link row\"><a class=\"flex items-center justify-between py-2.5 text-[14px] font-medium text-[#14161B] hover:text-[#C4161C]\" data-kid=\"2-1-2-1-2-2-2-4-1\" data-name=\"email link\" href=\"mailto:hello@example.com\"><span data-kid=\"2-1-2-1-2-2-2-4-1-1\" data-name=\"email label text\">Email</span><svg class=\"h-3 w-3\" data-kid=\"2-1-2-1-2-2-2-4-1-2\" data-name=\"diagonal arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 12 12\"><path d=\"M3 9 9 3M4.5 3H9v4.5\"></path></svg></a></li>\n</ul>\n</div>\n</div>\n<div class=\"col-span-12 mt-1 flex flex-wrap items-center gap-3\" data-kid=\"2-1-2-1-3\" data-name=\"skills sticker strip\">\n<span class=\"mr-1 ws-mono text-[10px] uppercase tracking-[0.22em] text-[#6F7278]\" data-kid=\"2-1-2-1-3-1\" data-name=\"skills label\">Skills</span>\n<span class=\"ws-cut-tr border-2 border-[#14161B] bg-[#F5F1E8] px-3 py-1.5 ws-mono text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-2-1-3-2\" data-name=\"design systems sticker chip\" style=\"transform: rotate(-1.4deg)\">Design systems</span>\n<span class=\"ws-cut-tr border-2 border-[#14161B] bg-[#E9E2D4] px-3 py-1.5 ws-mono text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-2-1-3-3\" data-name=\"interaction design sticker chip\" style=\"transform: rotate(0.9deg)\">Interaction design</span>\n<span class=\"ws-cut-tr border-2 border-[#14161B] bg-[#F5F1E8] px-3 py-1.5 ws-mono text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-2-1-3-4\" data-name=\"prototyping sticker chip\" style=\"transform: rotate(-0.6deg)\">Prototyping</span>\n<span class=\"ws-cut-tr border-2 border-[#14161B] bg-[#E9E2D4] px-3 py-1.5 ws-mono text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-2-1-3-5\" data-name=\"motion sticker chip\" style=\"transform: rotate(1.2deg)\">Motion</span>\n<span class=\"ws-cut-tr border-2 border-[#14161B] bg-[#F5F1E8] px-3 py-1.5 ws-mono text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-2-1-3-6\" data-name=\"type sticker chip\" style=\"transform: rotate(-1.1deg)\">Type</span>\n<span class=\"ws-cut-tr border-2 border-[#14161B] bg-[#E9E2D4] px-3 py-1.5 ws-mono text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-2-1-3-7\" data-name=\"research sticker chip\" style=\"transform: rotate(0.7deg)\">Research</span>\n</div>\n</div>\n</div>\n</section>\n<section class=\"relative mx-auto max-w-[1180px] px-6 pt-14\" data-kid=\"2-2\" data-name=\"selected work section\" id=\"work\">\n<div class=\"flex items-end justify-between border-b-2 border-[#14161B] pb-3\" data-kid=\"2-2-1\" data-name=\"work section header row\">\n<h2 class=\"ws-display text-[32px] uppercase leading-none tracking-[-0.03em] text-[#14161B] md:text-[44px]\" data-kid=\"2-2-1-1\" data-name=\"selected work section heading\">Selected work</h2>\n<span class=\"ws-mono text-[11px] uppercase tracking-[0.2em] text-[#6F7278]\" data-kid=\"2-2-1-2\" data-name=\"project count label\">03</span>\n</div>\n<div class=\"mt-7 grid grid-cols-12 gap-5\" data-kid=\"2-2-2\" data-name=\"work sticker card grid\">\n<article class=\"col-span-12 md:col-span-7\" data-kid=\"2-2-2-1\" data-name=\"kestrel project sticker card\">\n<div class=\"ws-cut-tl relative h-full border-2 border-[#14161B] bg-[#F5F1E8] p-7 ws-sticker-accent\" data-kid=\"2-2-2-1-1\" data-name=\"kestrel sticker card body\">\n<div class=\"pointer-events-none absolute right-0 top-0 h-24 w-24 ws-halftone-accent\" data-kid=\"2-2-2-1-1-5\" data-name=\"card halftone corner\"></div>\n<div class=\"flex items-start justify-between\" data-kid=\"2-2-2-1-1-1\" data-name=\"card top row\">\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.2em] text-[#6F7278]\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"project date label\">2025</span>\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.2em] text-[#C4161C]\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"project index label\">01</span>\n</div>\n<h3 class=\"ws-display mt-8 text-[38px] uppercase leading-[0.92] tracking-[-0.03em] text-[#14161B] md:text-[52px]\" data-kid=\"2-2-2-1-1-2\" data-name=\"kestrel project title\" data-scramble=\"\">Kestrel</h3>\n<p class=\"mt-5 max-w-[46ch] text-[15px] leading-[1.65] text-[#14161B]\" data-kid=\"2-2-2-1-1-3\" data-name=\"kestrel project description\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n<div class=\"mt-8 flex items-center justify-end border-t-2 border-[#14161B] pt-4\" data-kid=\"2-2-2-1-1-4\" data-name=\"card footer rule row\">\n<span class=\"h-2 w-2 bg-[#C4161C]\" data-kid=\"2-2-2-1-1-4-2\" data-name=\"card footer mark\"></span>\n</div>\n</div>\n</article>\n<article class=\"col-span-12 md:col-span-5\" data-kid=\"2-2-2-2\" data-name=\"tide and timber project sticker card\">\n<div class=\"ws-cut-tr relative flex h-full flex-col border-2 border-[#14161B] bg-[#E9E2D4] p-7\" data-kid=\"2-2-2-2-1\" data-name=\"tide and timber sticker card body\">\n<div class=\"flex items-start justify-between\" data-kid=\"2-2-2-2-1-1\" data-name=\"card top row\">\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.2em] text-[#6F7278]\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"project date label\">2024</span>\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.2em] text-[#C4161C]\" data-kid=\"2-2-2-2-1-1-2\" data-name=\"project index label\">02</span>\n</div>\n<h3 class=\"ws-display mt-8 text-[30px] uppercase leading-[0.95] tracking-[-0.03em] text-[#14161B] md:text-[36px]\" data-kid=\"2-2-2-2-1-2\" data-name=\"tide and timber project title\" data-scramble=\"\">Tide &amp; Timber</h3>\n<p class=\"mt-5 text-[14px] leading-[1.65] text-[#14161B]\" data-kid=\"2-2-2-2-1-3\" data-name=\"tide and timber project description\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n<div class=\"mt-auto flex items-center justify-end border-t-2 border-[#14161B] pt-4\" data-kid=\"2-2-2-2-1-4\" data-name=\"card footer rule row\">\n<span class=\"h-2 w-2 bg-[#14161B]\" data-kid=\"2-2-2-2-1-4-2\" data-name=\"card footer mark\"></span>\n</div>\n</div>\n</article>\n<article class=\"col-span-12\" data-kid=\"2-2-2-3\" data-name=\"loom audio project wide sticker card\">\n<div class=\"ws-cut-br relative grid grid-cols-12 items-end gap-6 border-2 border-[#14161B] bg-[#F5F1E8] p-7 ws-sticker\" data-kid=\"2-2-2-3-1\" data-name=\"loom audio sticker card body\">\n<div class=\"col-span-12 md:col-span-5\" data-kid=\"2-2-2-3-1-1\" data-name=\"wide card title column\">\n<div class=\"flex items-center gap-4\" data-kid=\"2-2-2-3-1-1-1\" data-name=\"wide card meta row\">\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.2em] text-[#6F7278]\" data-kid=\"2-2-2-3-1-1-1-1\" data-name=\"project date label\">2023</span>\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.2em] text-[#C4161C]\" data-kid=\"2-2-2-3-1-1-1-2\" data-name=\"project index label\">03</span>\n</div>\n<h3 class=\"ws-display mt-4 text-[32px] uppercase leading-[0.95] tracking-[-0.03em] text-[#14161B] md:text-[42px]\" data-kid=\"2-2-2-3-1-1-2\" data-name=\"loom audio project title\" data-scramble=\"\">Loom Audio</h3>\n</div>\n<div class=\"col-span-12 md:col-span-5\" data-kid=\"2-2-2-3-1-2\" data-name=\"wide card description column\">\n<p class=\"text-[15px] leading-[1.65] text-[#14161B]\" data-kid=\"2-2-2-3-1-2-1\" data-name=\"loom audio project description\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n</div>\n<div class=\"col-span-12 flex items-center justify-end md:col-span-2\" data-kid=\"2-2-2-3-1-3\" data-name=\"wide card mark column\">\n<span class=\"grid h-8 w-8 place-items-center border-2 border-[#14161B] bg-[#C4161C]\" data-kid=\"2-2-2-3-1-3-1\" data-name=\"red ink block mark\"></span>\n</div>\n</div>\n</article>\n</div>\n</section>\n<section class=\"mt-16 bg-[#1B4FA0] py-14 text-[#F5F1E8]\" data-kid=\"2-3\" data-name=\"experience dark band section\" id=\"experience\">\n<div class=\"mx-auto max-w-[1180px] px-6\" data-kid=\"2-3-1\" data-name=\"experience band content\">\n<div class=\"flex items-end justify-between border-b border-[#F5F1E8]/30 pb-3\" data-kid=\"2-3-1-1\" data-name=\"experience header row\">\n<h2 class=\"ws-display text-[30px] uppercase leading-none tracking-[-0.03em] text-[#F5F1E8] md:text-[42px]\" data-kid=\"2-3-1-1-1\" data-name=\"experience section heading\">Experience</h2>\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.22em] text-[#B9C5DD]\" data-kid=\"2-3-1-1-2\" data-name=\"experience section label\">Roles</span>\n</div>\n<div class=\"divide-y divide-[#F5F1E8]/20\" data-kid=\"2-3-1-2\" data-name=\"experience entry list\">\n<div class=\"grid grid-cols-12 items-baseline gap-4 py-6\" data-kid=\"2-3-1-2-1\" data-name=\"fintrail experience row\">\n<span class=\"col-span-3 ws-mono text-[11px] uppercase tracking-[0.14em] text-[#B9C5DD] md:col-span-2\" data-kid=\"2-3-1-2-1-1\" data-name=\"experience date label\">2022 — present</span>\n<span class=\"col-span-9 ws-body text-[19px] font-semibold tracking-[-0.01em] text-[#F5F1E8] md:col-span-4\" data-kid=\"2-3-1-2-1-2\" data-name=\"employer name\">Fintrail</span>\n<span class=\"col-span-9 col-start-4 text-[14px] text-[#B9C5DD] md:col-span-5 md:col-start-7\" data-kid=\"2-3-1-2-1-3\" data-name=\"role title\">Senior product designer</span>\n<span class=\"col-span-12 hidden justify-self-end md:col-span-1 md:block\" data-kid=\"2-3-1-2-1-4\" data-name=\"row accent mark\"><span class=\"block h-2 w-2 bg-[#C4161C]\" data-kid=\"2-3-1-2-1-4-1\" data-name=\"accent dot\"></span></span>\n</div>\n<div class=\"grid grid-cols-12 items-baseline gap-4 py-6\" data-kid=\"2-3-1-2-2\" data-name=\"sundial studio experience row\">\n<span class=\"col-span-3 ws-mono text-[11px] uppercase tracking-[0.14em] text-[#B9C5DD] md:col-span-2\" data-kid=\"2-3-1-2-2-1\" data-name=\"experience date label\">2019 — 2022</span>\n<span class=\"col-span-9 ws-body text-[19px] font-semibold tracking-[-0.01em] text-[#F5F1E8] md:col-span-4\" data-kid=\"2-3-1-2-2-2\" data-name=\"employer name\">Sundial Studio</span>\n<span class=\"col-span-9 col-start-4 text-[14px] text-[#B9C5DD] md:col-span-5 md:col-start-7\" data-kid=\"2-3-1-2-2-3\" data-name=\"role title\">Product designer</span>\n<span class=\"col-span-12 hidden justify-self-end md:col-span-1 md:block\" data-kid=\"2-3-1-2-2-4\" data-name=\"row accent mark\"><span class=\"block h-2 w-2 bg-[#C4161C]\" data-kid=\"2-3-1-2-2-4-1\" data-name=\"accent dot\"></span></span>\n</div>\n<div class=\"grid grid-cols-12 items-baseline gap-4 py-6\" data-kid=\"2-3-1-2-3\" data-name=\"pageturn press experience row\">\n<span class=\"col-span-3 ws-mono text-[11px] uppercase tracking-[0.14em] text-[#B9C5DD] md:col-span-2\" data-kid=\"2-3-1-2-3-1\" data-name=\"experience date label\">2017 — 2019</span>\n<span class=\"col-span-9 ws-body text-[19px] font-semibold tracking-[-0.01em] text-[#F5F1E8] md:col-span-4\" data-kid=\"2-3-1-2-3-2\" data-name=\"employer name\">Pageturn Press</span>\n<span class=\"col-span-9 col-start-4 text-[14px] text-[#B9C5DD] md:col-span-5 md:col-start-7\" data-kid=\"2-3-1-2-3-3\" data-name=\"role title\">Interface designer</span>\n<span class=\"col-span-12 hidden justify-self-end md:col-span-1 md:block\" data-kid=\"2-3-1-2-3-4\" data-name=\"row accent m