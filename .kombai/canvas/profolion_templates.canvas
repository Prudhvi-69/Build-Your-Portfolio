h-6 w-6 shrink-0 place-items-center border-2 border-[#14161B] ws-mono text-[10px] text-[#14161B]\" data-kid=\"2-4-2-2-1-1\" data-name=\"entry index badge\">02</span>\n<h3 class=\"ws-body text-[19px] font-semibold leading-snug tracking-[-0.01em] text-[#14161B]\" data-kid=\"2-4-2-2-1-2\" data-name=\"institution name\">Srishti Institute</h3>\n</div>\n<p class=\"ml-10 mt-2 text-[14px] text-[#6F7278]\" data-kid=\"2-4-2-2-2\" data-name=\"programme name\">Foundation studies</p>\n<p class=\"ml-10 mt-3 ws-mono text-[11px] uppercase tracking-[0.14em] text-[#6F7278]\" data-kid=\"2-4-2-2-3\" data-name=\"study period\">2013 — 2015</p>\n</div>\n</div>\n</section>\n<section class=\"mx-auto max-w-[1180px] px-6 pb-16 pt-14\" data-kid=\"2-5\" data-name=\"links section\" id=\"links\">\n<div class=\"flex items-end justify-between border-b-2 border-[#14161B] pb-3\" data-kid=\"2-5-1\" data-name=\"links header row\">\n<h2 class=\"ws-display text-[30px] uppercase leading-none tracking-[-0.03em] text-[#14161B] md:text-[42px]\" data-kid=\"2-5-1-1\" data-name=\"links section heading\">Links</h2>\n<span class=\"ws-mono text-[10px] uppercase tracking-[0.22em] text-[#6F7278]\" data-kid=\"2-5-1-2\" data-name=\"links section label\">04</span>\n</div>\n<div class=\"mt-8 grid grid-cols-2 gap-4 md:grid-cols-4\" data-kid=\"2-5-2\" data-name=\"links sticker grid\">\n<a class=\"flex items-center justify-between gap-3 border-2 border-[#14161B] bg-[#F5F1E8] px-4 py-4 ws-sticker hover:bg-[#E9E2D4]\" data-kid=\"2-5-2-1\" data-name=\"github sticker link\" href=\"https://github.com\">\n<span class=\"ws-body text-[15px] font-semibold text-[#14161B]\" data-kid=\"2-5-2-1-1\" data-name=\"github link label\">GitHub</span>\n<svg class=\"h-3.5 w-3.5 shrink-0 text-[#C4161C]\" data-kid=\"2-5-2-1-2\" data-name=\"diagonal arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 12 12\"><path d=\"M3 9 9 3M4.5 3H9v4.5\"></path></svg>\n</a>\n<a class=\"flex items-center justify-between gap-3 bo