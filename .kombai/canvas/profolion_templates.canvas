      "html": "<div class=\"min-h-screen bg-[#F1EDE3] text-[#12233A] antialiased\" data-kid=\"8\" data-name=\"page layout container\" id=\"top\">\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Barlow:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n    html { scroll-behavior: smooth; }\n    .deco { font-family: 'Cinzel', Georgia, serif; }\n    .sans { font-family: 'Barlow', 'Helvetica Neue', sans-serif; }\n    .mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }\n    .star { clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }\n    .step { padding: 9px; border: 1px solid rgba(18,35,58,.15); }\n    .step-inner { border: 1px solid rgba(18,35,58,.24); }\n    .hair { background: linear-gradient(90deg, transparent, rgba(18,35,58,.26) 16%, rgba(18,35,58,.26) 84%, transparent); }\n    .seal-cast { box-shadow: 0 12px 24px rgba(176,20,39,.22), inset 0 2px 0 rgba(255,255,255,.25), inset 0 -4px 0 rgba(0,0,0,.22); }\n    .rig { width: 760px; height: 760px; }\n    @media (max-width: 900px) { .rig { width: 560px; height: 560px; } }\n    @media (max-width: 560px) { .rig { width: 400px; height: 400px; } }\n  </style>\n<header class=\"relative z-20 border-b border-[#12233A]/15\" data-kid=\"1\" data-name=\"ceremonial masthead header\">\n<div class=\"mx-auto flex max-w-[1180px] flex-col items-center px-6 pt-7\" data-kid=\"1-1\" data-name=\"masthead top row container\">\n<a class=\"flex items-center gap-4\" data-kid=\"1-1-1\" data-name=\"site identity lockup link\" href=\"#top\">\n<span class=\"block h-px w-14 bg-[#12233A]/28\" data-kid=\"1-1-1-1\" data-name=\"left hairline rule\"></span>\n<span class=\"deco text-[12px] uppercase tracking-[0.42em]\" data-kid=\"1-1-1-2\" data-name=\"owner name in masthead\">Aarav Menon</span>\n<span class=\"h-px w-14 bg-[#12233A]/30\" data-kid=\"1-1-3\" data-name=\"right hairline rule\"></span>\n</a>\n<nav class=\"mono mt-5 flex w-full items-center justify-center divide-x divide-[#12233A]/15 border-t border-[#12233A]/12 py-3 text-[9px] uppercase tracking-[0.28em] text-[#6C7787]\" data-kid=\"1-2\" data-name=\"primary navigation link bar\">\n<a class=\"px-5 hover:text-[#B01427]\" data-kid=\"1-2-1\" data-name=\"about nav link\" href=\"#about\">About</a>\n<a class=\"px-5 hover:text-[#B01427]\" data-kid=\"1-2-2\" data-name=\"work nav link\" href=\"#work\">Work</a>\n<a class=\"px-5 hover:text-[#B01427]\" data-kid=\"1-2-3\" data-name=\"experience nav link\" href=\"#experience\">Experience</a>\n<a class=\"px-5 hover:text-[#B01427]\" data-kid=\"1-2-4\" data-name=\"education nav link\" href=\"#education\">Education</a>\n<a class=\"px-5 hover:text-[#B01427]\" data-kid=\"1-5\" data-name=\"elsewhere nav link\" href=\"#elsewhere\">Elsewhere</a>\n</nav>\n</div>\n</header>\n<section class=\"relative overflow-hidden border-b border-[#12233A]/15\" data-kid=\"2\" data-name=\"hero section with concentric motifs\" id=\"hero\">\n<div class=\"pointer-events-none absolute left-1/2 top-[44%] z-0 -translate-x-1/2 -translate-y-1/2\" data-kid=\"2-1\" data-name=\"decorative concentric ring rig\">\n<div class=\"rig relative\" data-kid=\"2-1-1\" data-name=\"ring rig square frame\">\n<div class=\"absolute inset-0 rounded-full border border-[#12233A]/12\" data-kid=\"2-1-1-1\" data-name=\"outermost ring\"></div>\n<div class=\"absolute inset-[9%] rounded-full border border-[#12233A]/16\" data-kid=\"2-1-1-2\" data-name=\"second ring\"></div>\n<div class=\"absolute inset-[18%] rounded-full border border-[#B01427]/18\" data-kid=\"2-1-1-3\" data-name=\"accent colored ring\"></div>\n<div class=\"absolute inset-[27%] rounded-full border border-dashed border-[#12233A]/12\" data-kid=\"2-1-1-4\" data-name=\"dashed inner ring\"></div>\n<span class=\"star absolute left-1/2 top-0 h-[9px] w-[9px] -translate-x-1/2 -translate-y-1/2 bg-[#B01427]/45\" data-kid=\"2-1-1-5\" data-name=\"north star marker\"></span>\n<span class=\"star absolute bottom-0 left-1/2 h-[9px] w-[9px] -translate-x-1/2 translate-y-1/2 bg-[#B01427]/45\" data-kid=\"2-1-1-6\" data-name=\"south star marker\"></span>\n<span class=\"star absolute left-0 top-1/2 h-[9px] w-[9px] -translate-x-1/2 -translate-y-1/2 bg-[#B01427]/45\" data-kid=\"2-1-1-7\" data-name=\"west star marker\"></span>\n<span class=\"star absolute right-0 top-1/2 h-[9px] w-[9px] -translate-y-1/2 translate-x-1/2 bg-[#B01427]/45\" data-kid=\"2-1-1-8\" data-name=\"east star marker\"></span>\n</div>\n</div>\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute left-1/2 top-[52%] z-[1] -translate-x-1/2 -translate-y-1/2 rotate-[-9deg]\" data-kid=\"2-2\" data-name=\"seal impression watermark\">\n<div class=\"grid\" data-kid=\"2-2-8\" data-name=\"imprint wrapper grid\" id=\"imprint\" style=\"opacity:0\">\n<div class=\"grid h-[600px] w-[560px] place-items-center rounded-full border-[10px] border-[#B01427]/30\" data-kid=\"2-1-2\" data-name=\"imprint outer ring band\">\n<div class=\"grid h-[420px] w-[430px] place-items-center rounded-full border-2 border-[#B01427]/30\" data-kid=\"2-1-4\" data-name=\"imprint inner ring band\">\n<span class=\"star block h-[210px] w-[210px] bg-[#B01427]/30\" data-kid=\"2-1-5\" data-name=\"imprint central star field\"></span>\n</div>\n</div>\n</div>\n</div>\n<div class=\"relative z-10 mx-auto max-w-[1180px] px-6 pb-16 pt-14 text-center\" data-kid=\"2-3\" data-name=\"hero content container\">\n<svg aria-hidden=\"true\" class=\"mx-auto h-[70px] w-[60px]\" data-kid=\"2-2-1\" data-name=\"shield emblem with star icon\" fill=\"none\" viewbox=\"0 0 72 84\">\n<path d=\"M36 3 L67 13 V40 C67 60 52 72 36 80 C20 72 5 60 5 40 V13 Z\" stroke=\"#12233A\" stroke-opacity=\".4\" stroke-width=\"1.2\"></path>\n<path d=\"M36 10 L61 18 V40 C61 56 48 67 36 74 C24 67 11 56 11 40 V18 Z\" stroke=\"#B01427\" stroke-opacity=\".45\" stroke-width=\"1\"></path>\n<path d=\"M36 26 L40.6 39.4 L54.6 39.4 L43.4 47.6 L47.6 61 L36 52.8 L24.4 61 L28.6 47.6 L17.4 39.4 L31.4 39.4 Z\" fill=\"#B01427\"></path>\n</svg>\n<h1 class=\"deco mt-8 text-[clamp(38px,8.2vw,98px)] uppercase leading-[0.94] tracking-[0.03em]\" data-kid=\"2-2-2\" data-name=\"hero owner name headline\">Aarav Menon</h1>\n<div class=\"mt-8 flex items-center justify-center gap-4\" data-kid=\"2-2-3\" data-name=\"rule-star-rule divider\">\n<span class=\"block h-px w-16 bg-[#12233A]/22 sm:w-28\" data-kid=\"2-2-3-1\" data-name=\"left role rule\"></span>\n<span class=\"star h-2 w-2 bg-[#B01427]\" data-kid=\"2-2-3-2\" data-name=\"centre star accent\"></span>\n<span class=\"block h-px w-16 bg-[#12233A]/22 sm:w-28\" data-kid=\"2-2-3-3\" data-name=\"right role rule\"></span>\n</div>\n<p class=\"mono mt-6 text-[10px] uppercase tracking-[0.46em] text-[#6C7787]\" data-kid=\"2-2-4\" data-name=\"role subtitle text\">Interface designer</p>\n<ul class=\"mx-auto mt-12 flex max-w-[760px] flex-wrap items-center justify-center gap-2.5\" data-kid=\"2-2-5\" data-name=\"skills chip list\">\n<li class=\"mono border border-[#12233A]/22 bg-[#E5DED0]/55 px-4 py-[7px] text-[9px] uppercase tracking-[0.24em] text-[#12233A]/80\" data-kid=\"2-2-5-1\" data-name=\"skill tag chip\">Design systems</li>\n<li class=\"mono border border-[#12233A]/22 bg-[#E5DED0]/55 px-4 py-[7px] text-[9px] uppercase tracking-[0.24em] text-[#12233A]/80\" data-kid=\"2-2-5-2\" data-name=\"skill tag chip\">Interaction design</li>\n<li class=\"mono border border-[#12233A]/22 bg-[#E5DED0]/55 px-4 py-[7px] text-[9px] uppercase tracking-[0.24em] text-[#12233A]/80\" data-kid=\"2-2-5-3\" data-name=\"skill tag chip\">Prototyping</li>\n<li class=\"mono border border-[#12233A]/22 bg-[#E5DED0]/55 px-4 py-[7px] text-[9px] uppercase tracking-[0.24em] text-[#12233A]/80\" data-kid=\"2-2-5-4\" data-name=\"skill tag chip\">Motion</li>\n<li class=\"mono border border-[#12233A]/22 bg-[#E5DED0]/55 px-4 py-[7px] text-[9px] uppercase tracking-[0.24em] text-[#12233A]/80\" data-kid=\"2-2-5-5\" data-name=\"skill tag chip\">Type</li>\n<li class=\"mono border border-[#12233A]/22 bg-[#E5DED0]/55 px-4 py-[7px] text-[9px] uppercase tracking-[0.24em] text-[#12233A]/80\" data-kid=\"2-2-5-6\" data-name=\"skill tag chip\">Research</li>\n</ul>\n<div class=\"mono mt-10 flex flex-wrap items-center justify-center divide-x divide-[#12233A]/15 text-[9px] uppercase tracking-[0.26em] text-[#6C7787]\" data-kid=\"2-2-6\" data-name=\"social links row\">\n<a class=\"px-5 py-1 hover:text-[#B01427]\" data-kid=\"2-2-6-1\" data-name=\"github social link\" href=\"https://github.com\" rel=\"noreferrer\" target=\"_blank\">GitHub</a>\n<a class=\"px-5 py-1 hover:text-[#B01427]\" data-kid=\"2-2-6-2\" data-name=\"dribbble social link\" href=\"https://dribbble.com\" rel=\"noreferrer\" target=\"_blank\">Dribbble</a>\n<a class=\"px-5 py-1 hover:text-[#B01427]\" data-kid=\"2-2-6-3\" data-name=\"linkedin social link\" href=\"https://linkedin.com\" rel=\"noreferrer\" target=\"_blank\">LinkedIn</a>\n<a class=\"px-5 py-1 hover:text-[#B01427]\" data-kid=\"2-2-6-4\" data-name=\"email contact link\" href=\"mailto:hello@example.com\">Email</a>\n</div>\n<div class=\"relative mt-14\" data-kid=\"2-2-7\" data-name=\"seal control row\">\n<div class=\"hair absolute inset-x-0 top-1/2 h-px\" data-kid=\"2-2-7-1\" data-name=\"hairline behind seal\"></div>\n<div class=\"relative mx-auto flex w-fit flex-col items-center gap-3 bg-[#F1EDE3] px-10 py-1\" data-kid=\"2-2-7-2\" data-name=\"seal control cluster\">\n<button aria-label=\"Seal\" aria-pressed=\"false\" class=\"seal-cast relative grid h-[76px] w-[76px] place-items-center rounded-full bg-[#B01427] text-[#FFFFFF]\" data-kid=\"2-2-7-2-1\" data-name=\"seal press button\" data-seal=\"\" id=\"seal\" type=\"button\">\n<span class=\"absolute inset-[7px] rounded-full border border-[#FFFFFF]/30\" data-kid=\"2-2-7-2-1-1\" data-name=\"seal inner ring band\"></span>\n<span class=\"absolute inset-[15px] rounded-full border border-dashed border-[#FFFFFF]/22\" data-kid=\"2-2-7-2-1-2\" data-name=\"seal dashed ring band\"></span>\n<span class=\"star relative block h-[24px] w-[24px] bg-[#FFFFFF]\" data-kid=\"2-2-7-2-1-4\" data-name=\"seal star glyph\"></span>\n</button>\n<div class=\"text-center\" data-kid=\"2-2-7-2-2\" data-name=\"seal state readout\">\n<span class=\"mono block text-[8px] uppercase tracking-[0.34em] text-[#6C7787]\" data-kid=\"2-2-7-2-2-1\" data-name=\"seal control label\">Seal</span>\n<span class=\"mono mt-1 block text-[11px] uppercase tracking-[0.24em] text-[#12233A]\" data-dynamic=\"true\" data-kid=\"2-2-7-2-2-2\" data-name=\"seal state text\" data-reason=\"text replaced between 'Unsealed' and 'Sealed' by the seal click handler\" id=\"sealState\">Unsealed</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"border-b border-[#12233A]/15 bg-[#E5DED0]/45\" data-kid=\"3\" data-name=\"about section\" id=\"about\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-20 text-center\" data-kid=\"3-1\" data-name=\"about content container\">\n<h2 class=\"deco text-[34px] uppercase tracking-[0.06em]\" data-kid=\"3-1-1\" data-name=\"about section heading\">About</h2>\n<div class=\"mt-6 flex items-center justify-center gap-4\" data-kid=\"3-1-2\" data-name=\"section rule divider with star\">\n<span class=\"block h-px w-20 bg-[#12233A]/25 sm:w-32\" data-kid=\"3-1-2-1\" data-name=\"left rule line\"></span>\n<span class=\"star h-[7px] w-[7px] bg-[#B01427]\" data-kid=\"3-1-2-2\" data-name=\"centre star accent\"></span>\n<span class=\"block h-px w-20 bg-[#12233A]/25 sm:w-32\" data-kid=\"3-1-2-3\" data-name=\"right rule line\"></span>\n</div>\n<p class=\"sans mx-auto mt-9 max-w-[62ch] text-[20px] leading-[1.78] text-[#12233A]/82\" data-kid=\"3-1-3\" data-name=\"biography paragraph\">I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.</p>\n<dl class=\"mono mt-12 grid grid-cols-3 divide-x divide-[#12233A]/12 border-y border-[#12233A]/15\" data-kid=\"3-1-4\" data-name=\"stats counts strip\">\n<div class=\"px-3 py-6\" data-kid=\"3-1-4-1\" data-name=\"projects stat cell\">\n<dt class=\"text-[9px] uppercase tracking-[0.26em] text-[#6C7787]\" data-kid=\"3-1-1-1\" data-name=\"projects stat label\">Projects</dt>\n<dd class=\"deco mt-2 text-[30px] leading-none tracking-[0.04em] text-[#12233A]\" data-kid=\"3-1-4-1-2\" data-name=\"projects stat value\">03</dd>\n</div>\n<div class=\"px-3 py-6\" data-kid=\"3-1-4-2\" data-name=\"roles stat cell\">\n<dt class=\"text-[9px] uppercase tracking-[0.26em] text-[#6C7787]\" data-kid=\"3-1-4-2-1\" data-name=\"roles stat label\">Roles</dt>\n<dd class=\"deco mt-2 text-[30px] leading-none tracking-[0.04em] text-[#12233A]\" data-kid=\"3-1-4-2-2\" data-name=\"roles stat value\">03</dd>\n</div>\n<div class=\"px-3 py-6\" data-kid=\"3-1-4-3\" data-name=\"schools stat cell\">\n<dt class=\"text-[9px] uppercase tracking-[0.26em] text-[#6C7787]\" data-kid=\"3-1-4-3-1\" data-name=\"schools stat label\">Schools</dt>\n<dd class=\"deco mt-2 text-[30px] leading-none tracking-[0.04em] text-[#12233A]\" data-kid=\"3-1-4-3-2\" data-name=\"schools stat value\">02</dd>\n</div>\n</dl>\n</div></section>\n<section class=\"border-b border-[#F1EDE3]/10 bg-[#F1EDE3]\" data-kid=\"4\" data-name=\"selected work section\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-20\" data-kid=\"4-1\" data-name=\"work section content wrapper\">\n<div class=\"text-center\" data-kid=\"4-2\" data-name=\"work heading block\">\n<h2 class=\"deco text-[38px] uppercase tracking-[0.04em]\" data-kid=\"4-2-1\" data-name=\"work section heading\" id=\"work\">Selected work</h2>\n</div>\n<div class=\"mt-4 flex items-center justify-center gap-4\" data-kid=\"4-1-2\" data-name=\"work heading rule divider\">\n<span class=\"h-px w-16 bg-[#12233A]/25\" data-kid=\"4-1-2-1\" data-name=\"left rule line\"></span><span class=\"h-1.5 w-1.5 rounded-full bg-[#B01427]\" data-kid=\"4-1-2-2\" data-name=\"centre dot accent\"></span><span class=\"h-px w-16 bg-[#12233A]/25\" data-kid=\"4-1-2-3\" data-name=\"right rule line\"></span>\n</div>\n</div>\n<div class=\"mx-auto mt-3 max-w-[900px] px-6 pb-20\" data-kid=\"4-3\" data-name=\"work plaque stack\">\n<article class=\"step bg-[#F1EDE3]\" data-kid=\"4-3-1\" data-name=\"project plaque for Kestrel\">\n<div class=\"step-inner bg-[#E5DED0]/40 px-8 py-10 text-center\" data-kid=\"4-3-1-1\" data-name=\"project plaque inner panel\">\n<div class=\"mono text-[10px] tracking-[0.32em] text-[#B01427]\" data-kid=\"4-3-1-1-1\" data-name=\"project year label\">2025</div>\n<h3 class=\"deco mt-4 text-[34px] leading-none tracking-[0.02em]\" data-kid=\"4-3-1-1-2\" data-name=\"project title heading\">Kestrel</h3>\n<p class=\"sans mx-auto mt-4 max-w-[52ch] text-[16px] leading-[1.68] text-[#12233A]/75\" data-kid=\"4-3-1-1-3\" data-name=\"project description text\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n<a class=\"mono mt-7 inline-flex items-center gap-2 border-b border-[#B01427]/40 pb-1 text-[9px] uppercase tracking-[0.28em] text-[#B01427]\" data-kid=\"4-3-1-4\" data-name=\"read case study link\" href=\"#\">Read case study<span aria-hidden=\"true\" data-kid=\"4-3-1-4-1\" data-name=\"right arrow glyph\">→</span></a>\n</div>\n</article>\n<div class=\"flex items-center justify-center gap-3 py-5\" data-kid=\"4-3-2\" data-name=\"plaque divider\">\n<span class=\"h-px w-12 bg-[#12233A]/18\" data-kid=\"4-3-2-1\" data-name=\"left rule line\"></span><span class=\"star h-[7px] w-[7px] bg-[#B01427]/70\" data-kid=\"4-3-2-2\" data-name=\"centre star accent\"></span><span class=\"h-px w-12 bg-[#12233A]/18\" data-kid=\"4-3-2-3\" data-name=\"right rule line\"></span>\n</div>\n<article class=\"step bg-[#F1EDE3]\" data-kid=\"4-3-3\" data-name=\"project plaque for Tide and Timber\">\n<div class=\"step-inner bg-[#E5DED0]/40 px-8 py-10 text-center\" data-kid=\"4-3-3-1\" data-name=\"project plaque inner panel\">\n<div class=\"mono text-[10px] tracking-[0.32em] text-[#B01427]\" data-kid=\"4-3-3-1-1\" data-name=\"project year label\">2024</div>\n<h3 class=\"deco mt-4 text-[34px] leading-none tracking-[0.02em]\" data-kid=\"4-3-3-1-2\" data-name=\"project title heading\">Tide &amp; Timber</h3>\n<p class=\"sans mx-auto mt-4 max-w-[52ch] text-[16px] leading-[1.68] text-[#12233A]/75\" data-kid=\"4-3-3-1-3\" data-name=\"project description text\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n<a class=\"mono mt-7 inline-flex items-center gap-2 border-b border-[#B01427]/40 px-0 py-0 text-[9px] uppercase tracking-[0.28em] text-[#B01427]\" data-kid=\"4-3-3-1-4\" data-name=\"read case study link\" href=\"#\">Read case study<span aria-hidden=\"true\" data-kid=\"4-3-3-1-4-1\" data-name=\"right arrow glyph\">→</span></a>\n</div>\n</article>\n<div class=\"flex items-center justify-center gap-4\" data-kid=\"1-1-4\" data-name=\"empty spacer spacer\"></div>\n<article class=\"mt-6 step bg-[#F1EDE3]\" data-kid=\"4-3-5\" data-name=\"project plaque for Loom Audio\">\n<div class=\"step-inner bg-[#E5DED0]/40 px-8 py-10 text-center\" data-kid=\"4-3-5-1\" data-name=\"project plaque inner panel\">\n<div class=\"mono text-[10px] tracking-[0.32em] text-[#B01427]\" data-kid=\"4-3-5-1-1\" data-name=\"project year label\">2023</div>\n<h3 class=\"deco mt-4 text-[34px] leading-none tracking-[0.02em]\" data-kid=\"4-3-5-1-2\" data-name=\"project title heading\">Loom Audio</h3>\n<p class=\"sans mx-auto mt-4 max-w-[52ch] text-[16px] leading-[1.68] text-[#12233A]/75\" data-kid=\"4-3-5-1-3\" data-name=\"project description text\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n<a class=\"mono mt-7 inline-flex items-center gap-2 border-b border-[#B01427]/40 pb-1 text-[9px] uppercase tracking-[0.28em] text-[#B01427]\" data-kid=\"4-3-5-1-4\" data-name=\"read case study link\" href=\"#\">Read case study<span aria-hidden=\"true\" data-kid=\"4-3-5-1-4-1\" data-name=\"right arrow glyph\">→</span></a>\n</div>\n</article>\n</div>\n</section>\n<section class=\"bg-[#12233A] text-[#F1EDE3]\" data-kid=\"5\" data-name=\"experience dark section\" id=\"experience\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-20\" data-kid=\"5-1\" data-name=\"experience content container\">\n<div class=\"text-center\" data-kid=\"5-2\" data-name=\"experience heading block\">\n<h2 class=\"deco text-[40px] uppercase tracking-[0.05em]\" data-kid=\"5-2-1\" data-name=\"experience section heading\">Experience</h2>\n<div class=\"mt-6 flex items-center justify-center gap-4\" data-kid=\"5-2-2\" data-name=\"heading rule divider with star\">\n<span class=\"h-px w-20 bg-[#F1EDE3]/25\" data-kid=\"5-2-2-1\" data-name=\"left rule line\"></span><span class=\"star h-[7px] w-[7px] bg-[#F1EDE3]/85\" data-kid=\"5-2-2-2\" data-name=\"centre star accent\"></span><span class=\"h-px w-20 bg-[#F1EDE3]/25\" data-kid=\"5-2-2-3\" data-name=\"right rule line\"></span>\n</div>\n</div>\n<div class=\"mx-auto mt-10 max-w-[880px]\" data-kid=\"5-3\" data-name=\"experience ledger\">\n<div class=\"border-t border-[#F1EDE3]/12 py-8 text-center\" data-kid=\"5-3-1\" data-name=\"Fintrail experience entry\">\n<div class=\"mono text-[10px] uppercase tracking-[0.3em] text-[#F1EDE3]/55\" data-kid=\"5-3-1-1\" data-name=\"role period label\">2022 — present</div>\n<h3 class=\"deco mt-3 text-[28px] leading-none\" data-kid=\"5-3-1-2\" data-name=\"company name heading\">Fintrail</h3>\n<p class=\"sans mt-2 text-[15px] tracking-[0.01em] text-[#93A1B0]\" data-kid=\"5-3-1-3\" data-name=\"job title text\">Senior product designer</p>\n</div>\n<div class=\"border-t border-[#F1EDE3]/12 py-8 text-center\" data-kid=\"5-3-2\" data-name=\"Sundial Studio experience entry\">\n<div class=\"mono text-[10px] uppercase tracking-[0.3em] text-[#F1EDE3]/55\" data-kid=\"5-3-2-1\" data-name=\"role period label\">2019 — 2022</div>\n<h3 class=\"deco mt-3 text-[28px] leading-none\" data-kid=\"5-3-2-2\" data-name=\"company name heading\">Sundial Studio</h3>\n<p class=\"sans mt-2 text-[15px] text-[#93A1B0]\" data-kid=\"5-3-2-3\" data-name=\"job title text\">Product designer</p>\n</div>\n<div class=\"border-y border-[#F1EDE3]/12 py-8 text-center\" data-kid=\"5-3-3\" data-name=\"Pageturn Press experience entry\">\n<div class=\"mono text-[10px] uppercase tracking-[0.3em] text-[#F1EDE3]/55\" data-kid=\"5-3-3-1\" data-name=\"role period label\">2017 — 2019</div>\n<h3 class=\"deco mt-3 text-[28px] leading-none\" data-kid=\"5-3-3-2\" data-name=\"company name heading\">Pageturn Press</h3>\n<p class=\"sans mt-2 text-[15px] text-[#93A1B0]\" data-kid=\"5-3-3-3\" data-name=\"job title text\">Interface designer</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"border-b border-[#12233A]/15\" data-kid=\"6\" data-name=\"education section\" id=\"education\">\n<div class=\"mx-auto max-w-[1180px] px-6 py-20\" data-kid=\"6-1\" data-name=\"education content container\">\n<div class=\"text-center\" data-kid=\"6-1-1\" data-name=\"education heading block\">\n<h2 class=\"deco text-[34px] uppercase tracking-[0.06em]\" data-kid=\"6-1-1-1\" data-name=\"education section heading\">Education</h2>\n<div class=\"mt-5 flex items-center justify-center gap-4\" data-kid=\"6-1-1-2\" data-name=\"heading rule divider with star\">\n<span class=\"h-px w-20 bg-[#12233A]/25\" data-kid=\"6-1-1-2-1\" data-name=\"left rule line\"></span><span class=\"star h-[7px] w-[7px] bg-[#B01427]\" data-kid=\"6-1-1-2-2\" data-name=\"centre star accent\"></span><span class=\"h-px w-20 bg-[#12233A]/25\" data-kid=\"6-1-1-2-3\" data-name=\"right rule line\"></span>\n</div>\n</div>\n<div class=\"mx-auto mt-10 grid max-w-[900px] gap-5 md:grid-cols-2\" data-kid=\"6-2\" data-name=\"education plaque grid\">\n<div class=\"step bg-[#F1EDE3]\" data-kid=\"6-2-1\" data-name=\"education plaque for NID\">\n<div class=\"step-inner bg-[#E5DED0]/40 px-7 py-8 text-center\" data-kid=\"6-2-1-1\" data-name=\"education plaque inner panel\">\n<div class=\"mono text-[9px] uppercase tracking-[0.28em] text-[#B01427]\" data-kid=\"6-2-1-1-1\" data-name=\"study period label\">2015 — 2017</div>\n<h3 class=\"deco mt-3 text-[20px] leading-tight\" data-kid=\"6-2-1-1-2\" data-name=\"institution name heading\">National Institute of Design</h3>\n<p class=\"sans mt-2 text-[15px] text-[#6C7787]\" data-kid=\"6-2-1-1-3\" data-name=\"field of study text\">Interaction design</p>\n</div>\n</div>\n<div class=\"step bg-[#F1EDE3]\" data-kid=\"6-2-2\" data-name=\"education plaque for Srishti\">\n<div class=\"step-inner bg-[#E5DED0]/40 px-7 py-8 text-center\" data-kid=\"6-2-2-1\" data-name=\"education plaque inner panel\">\n<div class=\"mono text-[9px] uppercase tracking-[0.28em] text-[#B01427]\" data-kid=\"6-2-2-1-1\" data-name=\"study period label\">2013 — 2015</div>\n<h3 class=\"deco mt-3 text-[20px] leading-tight\" data-kid=\"6-2-2-1-2\" data-name=\"institution name heading\">Srishti Institute</h3>\n<p class=\"sans mt-2 text-[15px] text-[#6C7787]\" data-kid=\"6-2-2-1-3\" data-name=\"field of study text\">Foundation studies</p>\n</div>\n</div>\n</div>\n<div class=\"hair mx-auto mt-16 h-px max-w-[900px]\" data-kid=\"6-3\" data-name=\"section divider hairline\"></div>\n<div class=\"mt-12 flex flex-col items-center gap-6\" data-kid=\"6-4\" data-name=\"elsewhere block\" id=\"elsewhere\">\n<h2 class=\"deco text-[28px] uppercase tracking-[0.08em]\" data-kid=\"6-4-1\" data-name=\"elsewhere section heading\">Elsewhere</h2>\n<div class=\"mono flex flex-wrap items-center justify-center divide-x divide-[#12233A]/15 text-[9px] uppercase tracking-[0.26em] text-[#6C7787]\" data-kid=\"6-4-2\" data-name=\"elsewhere social links row\">\n<a class=\"px-6 py-1 hover:text-[#B01427]\" data-kid=\"6-4-2-1\" data-name=\"github link\" href=\"https://github.com\" rel=\"noreferrer\" target=\"_blank\">GitHub</a>\n<a class=\"px-6 py-1 hover:text-[#B01427]\" data-kid=\"6-4-2-2\" data-name=\"dribbble link\" href=\"https://dribbble.com\" rel=\"noreferrer\" target=\"_blank\">Dribbble</a>\n<a class=\"px-6 py-1 hover:text-[#B01427]\" data-kid=\"6-4-2-3\" data-name=\"linkedin link\" href=\"https://linkedin.com\" rel=\"noreferrer\" target=\"_blank\">LinkedIn</a>\n<a class=\"px-6 py-1 hover:text-[#B01427]\" data-kid=\"6-4-2-4\" data-name=\"email link\" href=\"mailto:hello@example.com\">Email</a>\n</div>\n</div>\n</div>\n</section>\n<footer class=\"border-t border-[#12233A]/15\" data-kid=\"7\" data-name=\"site footer\">\n<div class=\"mx-auto flex max-w-[1180px] flex-col items-center gap-4 px-6 py-9\" data-kid=\"7-1\" data-name=\"footer content container\">\n<div class=\"flex items-center gap-4\" data-kid=\"7-1-3\" data-name=\"footer decorative rule divider\">\n<span class=\"h-px w-10 bg-[#12233A]/22\" data-kid=\"7-1-3-1\" data-name=\"left rule line\"></span><span class=\"star h-[6px] w-[6px] bg-[#B01427]\" data-kid=\"7-1-3-2\" data-name=\"centre star accent\"></span><span class=\"h-px w-10 bg-[#12233A]/22\" data-kid=\"7-1-3-3\" data-name=\"right rule line\"></span>\n</div>\n<span class=\"deco text-[10px] uppercase tracking-[0.4em]\" data-kid=\"7-1-1\" data-name=\"footer owner name\">Aarav Menon</span>\n<a class=\"mono text-[9px] uppercase tracking-[0.3em] text-[#B01427]\" data-kid=\"7-1-2\" data-name=\"back to top link\" href=\"#top\">Back to top</a>\n</div>\n</footer>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\n    (function () {\n      if (!window.gsap) return;\n      var gsap = window.gsap;\n      var seal = document.getElementById('seal');\n      var sealState = document.getElementById('sealState');\n      var imprint = document.getElementById('imprint');\n      var latched = false;\n\n      seal.addEventListener('pointerdown', function () {\n        gsap.to(seal, { scale: 0.9, rotate: -4, duration: 0.16, ease: 'power2.out' });\n      });\n      ['pointerup', 'pointerleave', 'pointercancel'].forEach(function (evt) {\n        seal.addEventListener(evt, function () {\n          if (latched) return;\n          gsap.to(seal, { scale: 1, rotate: 0, duration: 0.3, ease: 'power3.out' });\n        });\n      });\n\n      seal.addEventListener('click', function () {\n        latched = !latched;\n        seal.setAttribute('aria-pressed', latched ? 'true' : 'false');\n        sealState.textContent = latched ? 'Sealed' : 'Unsealed';\n        if (latched) {\n          gsap.to(seal, { scale: 1, rotate: -9, duration: 0.42, ease: 'back.out(2.4)' });\n          gsap.fromTo(imprint, { opacity: 0, scale: 1.22 }, { opacity: 0.5, scale: 1, duration: 0.5, ease: 'power2.out' });\n        } else {\n          gsap.to(seal, { rotate: 0, duration: 0.34, ease: 'power3.out' });\n          gsap.to(imprint, { opacity: 0, scale: 1.06, duration: 0.3, ease: 'power2.in' });\n        }\n      });\n    })();\n  </script>\n</div>\n",
