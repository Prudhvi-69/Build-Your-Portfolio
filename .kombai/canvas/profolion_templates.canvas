      "html": "<div class=\"ss-root min-h-screen w-full bg-[#F7F2E9] text-[#B3121C] antialiased\" data-kid=\"8\" data-name=\"page layout container\">\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  .ss-root{font-family:'Space Grotesk','Helvetica Neue',Arial,sans-serif;}\n  .ss-display{font-family:'Bebas Neue',Impact,'Arial Narrow',sans-serif;letter-spacing:0.01em;}\n  .ss-mono{font-family:'IBM Plex Mono',ui-monospace,SFMono-Regular,monospace;}\n  .ss-band{position:absolute;transform:skewY(-13deg) rotate(-1.5deg);}\n  .ss-streak{position:absolute;height:2px;background:#B3121C;}\n  .ss-ticks{background:repeating-conic-gradient(from 0deg,#F5C518 0 1.4deg,transparent 1.4deg 8deg);}\n  .ss-charge-fill{transform-origin:left center;transform:scaleX(0);}\n  .ss-arrow{display:inline-block;transition:transform 220ms cubic-bezier(.2,.8,.2,1);}\n  .ss-row:hover .ss-arrow{transform:translateX(6px);}\n  @media (prefers-reduced-motion: reduce){ .ss-arrow{transition:none;} }\n</style>\n<header class=\"sticky top-0 z-30 border-b-2 border-[#B3121C] bg-[#F7F2E9]/95\" data-kid=\"1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[60px] max-w-[1180px] items-center justify-between px-5 md:px-7\" data-kid=\"1-1\" data-name=\"header row\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#top\">\n<span class=\"ss-mono grid h-8 w-8 place-items-center bg-[#F5C518] text-[11px] font-semibold\" data-kid=\"1-1-1-1\" data-name=\"monogram badge icon\">AM</span>\n<span class=\"ss-mono text-[11px] uppercase tracking-[0.26em]\" data-kid=\"1-1-1-2\" data-name=\"logo wordmark name\">Aarav Menon</span>\n</a>\n<nav class=\"ss-mono hidden items-center gap-7 text-[10px] uppercase tracking-[0.24em] md:flex\" data-kid=\"1-2\" data-name=\"section nav\">\n<a class=\"border-b-2 border-transparent pb-1 hover:border-[#B3121C]\" data-kid=\"1-2-1\" data-name=\"nav link to work\" href=\"#work\">Work</a>\n<a class=\"border-b-2 border-transparent pb-1 hover:border-[#B3121C]\" data-kid=\"1-2-2\" data-name=\"nav link to experience\" href=\"#experience\">Experience</a>\n<a class=\"border-b-2 border-transparent pb-1 hover:border-[#B3121C]\" data-kid=\"1-2-3\" data-name=\"nav link to education\" href=\"#education\">Education</a>\n<a class=\"border-b-2 border-transparent pb-1 hover:border-[#B3121C]\" data-kid=\"1-2-4\" data-name=\"nav link to links\" href=\"#links\">Links</a>\n</nav>\n<a class=\"ss-mono border-b-2 border-[#B3121C] pb-1 text-[10px] uppercase tracking-[0.24em] md:hidden\" data-kid=\"1-1-3\" data-name=\"mobile nav link to work\" href=\"#work\">Work</a>\n</div>\n</header>\n<section class=\"relative overflow-hidden border-b-2 border-[#B3121C]\" data-kid=\"2\" data-name=\"speed band hero\" id=\"top\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\" data-kid=\"2-2\" data-name=\"hero decorative decoration layer\">\n<div class=\"ss-band\" data-kid=\"2-2-1\" data-name=\"decorative cream speed band\" style=\"left:58%;top:-14%;width:12%;height:1100px;background:#EFE3D4;\"></div>\n<div class=\"ss-band\" data-kid=\"2-2-2\" data-name=\"decorative yellow speed band\" style=\"left:74%;top:-14%;width:5%;height:1100px;background:#F5C518;\"></div>\n<div class=\"ss-band\" data-kid=\"2-2-3\" data-name=\"decorative red speed band\" style=\"left:84%;top:-14%;width:22%;height:1100px;background:#B3121C;opacity:.05;\"></div>\n<div class=\"ss-band\" data-kid=\"2-2-4\" data-name=\"decorative bottom yellow band\" style=\"left:-6%;top:97%;width:34%;height:14px;background:#F5C518;\"></div>\n<div class=\"ss-streak\" data-kid=\"2-2-5\" data-name=\"decorative speed streak\" style=\"left:6%;top:64%;width:180px;opacity:.22;\"></div>\n<div class=\"ss-streak\" data-kid=\"2-2-6\" data-name=\"decorative speed streak\" style=\"left:14%;top:68%;width:96px;opacity:.14;\"></div>\n<div class=\"ss-streak\" data-kid=\"2-2-7\" data-name=\"decorative speed streak\" style=\"left:2%;top:72%;width:240px;opacity:.1;\"></div>\n</div>\n<div class=\"relative mx-auto grid max-w-[1180px] grid-cols-1 gap-12 px-5 pb-16 pt-12 md:grid-cols-12 md:items-start md:gap-8 md:px-7 md:pb-24 md:pt-16\" data-kid=\"2-1\" data-name=\"hero grid container\">\n<div class=\"md:col-span-7\" data-kid=\"2-1-1\" data-name=\"hero identity column\">\n<div class=\"ss-mono flex items-center gap-3 text-[10px] uppercase tracking-[0.3em]\" data-kid=\"2-1-1-5\" data-name=\"eyebrow label row\">\n<span class=\"h-[2px] w-9 bg-[#B3121C]\" data-kid=\"2-1-1-5-1\" data-name=\"eyebrow accent bar\"></span>\n<span data-kid=\"2-1-1-5-2\" data-name=\"role eyebrow text\">Interface designer</span>\n</div>\n<h1 class=\"ss-display mt-6 text-[78px] leading-[0.82] md:text-[142px]\" data-kid=\"2-1-1-1\" data-name=\"hero name poster headline\">\n        AARAV<br data-kid=\"2-1-1-1-1\" data-name=\"line break in headline\"/>\n<span class=\"relative inline-block\" data-kid=\"2-1-1-1-2\" data-name=\"highlighted name word group\">\n<span class=\"absolute inset-x-[-10px] inset-y-[12px] -skew-y-[3deg] bg-[#F5C518]\" data-kid=\"2-1-1-1-2-1\" data-name=\"highlighter background bar\"></span>\n<span class=\"relative\" data-kid=\"2-1-1-1-2-2\" data-name=\"name word text\">MENON</span>\n</span>\n</h1>\n<p class=\"mt-8 max-w-[48ch] text-[15px] leading-[1.62] md:text-[16px]\" data-kid=\"2-1-1-2\" data-name=\"owner bio paragraph\">\n        I design booking, payment and publishing interfaces. Eight years in, most of it spent making dense screens feel calm enough to use on a phone at a bus stop.\n      </p>\n<ul class=\"mt-8 flex flex-wrap gap-2\" data-kid=\"2-1-1-3\" data-name=\"skills chips list\">\n<li class=\"ss-mono border border-[#B3121C]/30 px-2.5 py-[6px] text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-1-3-1\" data-name=\"skill chip: design systems\">Design systems</li>\n<li class=\"ss-mono border border-[#B3121C]/30 px-2.5 py-[6px] text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-1-3-2\" data-name=\"skill chip: interaction design\">Interaction design</li>\n<li class=\"ss-mono border border-[#B3121C]/30 px-2.5 py-[6px] text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-1-3-3\" data-name=\"skill chip: prototyping\">Prototyping</li>\n<li class=\"ss-mono border border-[#B3121C]/30 px-2.5 py-[6px] text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-1-3-4\" data-name=\"skill chip: motion\">Motion</li>\n<li class=\"ss-mono border border-[#B3121C]/30 px-2.5 py-[6px] text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-1-3-5\" data-name=\"skill chip: type\">Type</li>\n<li class=\"ss-mono border border-[#B3121C]/30 px-2.5 py-[6px] text-[10px] uppercase tracking-[0.16em]\" data-kid=\"2-1-1-3-6\" data-name=\"skill chip: research\">Research</li>\n</ul>\n<div class=\"mt-10 flex flex-wrap gap-x-7 gap-y-3\" data-kid=\"2-1-1-4\" data-name=\"social links row\">\n<a class=\"ss-mono inline-flex items-center gap-2 border-b border-[#B3121C]/35 pb-1 text-[10px] uppercase tracking-[0.24em]\" data-kid=\"2-1-1-4-1\" data-name=\"GitHub link\" href=\"https://github.com\">GitHub <span aria-hidden=\"true\" data-kid=\"2-1-1-4-1-1\" data-name=\"external arrow icon\">↗</span></a>\n<a class=\"ss-mono inline-flex items-center gap-2 border-b border-[#B3121C]/35 pb-1 text-[10px] uppercase tracking-[0.24em]\" data-kid=\"2-1-1-4-2\" data-name=\"Dribbble link\" href=\"https://dribbble.com\">Dribbble <span aria-hidden=\"true\" data-kid=\"2-1-1-4-2-1\" data-name=\"external arrow icon\">↗</span></a>\n<a class=\"ss-mono inline-flex items-center gap-2 border-b border-[#B3121C]/35 pb-1 text-[10px] uppercase tracking-[0.24em]\" data-kid=\"2-1-1-4-3\" data-name=\"LinkedIn link\" href=\"https://linkedin.com\">LinkedIn <span aria-hidden=\"true\" data-kid=\"2-1-1-4-3-1\" data-name=\"external arrow icon\">↗</span></a>\n<a class=\"ss-mono inline-flex items-center gap-2 border-b border-[#B3121C]/35 pb-1 text-[10px] uppercase tracking-[0.24em]\" data-kid=\"2-1-1-4-4\" data-name=\"email link\" href=\"mailto:hello@example.com\">Email <span aria-hidden=\"true\" data-kid=\"2-1-1-4-4-1\" data-name=\"external arrow icon\">↗</span></a>\n</div>\n</div>\n<div class=\"md:col-span-5 md:pl-4\" data-kid=\"2-1-2\" data-name=\"charge control column\">\n<div class=\"relative\" data-kid=\"2-1-2-1\" data-name=\"charge card stack\">\n<div aria-hidden=\"true\" class=\"absolute inset-0 translate-x-3 translate-y-3 bg-[#F5C518]\" data-kid=\"2-1-2-1-1\" data-name=\"hard offset drop shadow\"></div>\n<div class=\"relative bg-[#B3121C] px-6 py-9 md:px-7 md:py-10\" data-kid=\"2-1-2-1-2\" data-name=\"charge card panel\">\n<button aria-label=\"Hold to jump to selected work\" class=\"relative mx-auto flex h-[228px] w-[228px] flex-col items-center justify-center rounded-full border-2 border-[#F5C518] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#F5C518]\" data-charge=\"\" data-charge-done=\"Charged\" data-charge-target=\"#work\" data-dynamic=\"true\" data-kid=\"2-1-2-1-2-1\" data-name=\"hold-and-release charge button\" data-reason=\"label and fill replaced/animated by charge (hold) interaction script\" type=\"button\">\n<span aria-hidden=\"true\" class=\"pointer-events-none absolute -inset-[9px] rounded-full border-2 border-dashed border-[#F5C518]/45\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"dashed decorative ring\"></span>\n<span aria-hidden=\"true\" class=\"pointer-events-none absolute inset-[16px] rounded-full border border-[#F5C518]/30\" data-kid=\"2-1-2-1-2-1-2\" data-name=\"inner decorative ring\"></span>\n<span class=\"ss-display text-[56px] leading-none text-[#F5C518]\" data-kid=\"2-1-2-1-2-1-3\" data-name=\"charge button label\"><span data-charge-label=\"\" data-dynamic=\"true\" data-kid=\"2-1-2-1-2-1-3-1\" data-name=\"charge state label text\" data-reason=\"text state rewritten by hold-to-charge interaction script\">Hold</span></span>\n<span class=\"mt-5 block h-[6px] w-[126px] overflow-hidden bg-[#F0C9BC]/25\" data-kid=\"2-1-2-1-2-1-4\" data-name=\"charge progress track\">\n<span class=\"ss-charge-fill block h-full w-full bg-[#F5C518]\" data-charge-fill=\"\" data-dynamic=\"true\" data-kid=\"2-1-2-1-2-1-4-1\" data-name=\"charge progress fill\" data-reason=\"scaleX fill driven by hold-to-charge interaction script\"></span>\n</span>\n</button>\n<div class=\"ss-mono mt-7 flex items-center justify-between text-[10px] uppercase tracking-[0.22em] text-[#F0C9BC]\" data-kid=\"2-1-2-1-2-2\" data-name=\"charge card footer row\">\n<span data-kid=\"2-1-2-1-2-2-1\" data-name=\"project count text\">3 projects</span>\n<a class=\"text-[#F5C518]\" data-kid=\"2-1-2-1-2-2-2\" data-name=\"see work link\" href=\"#work\">Work →</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"relative border-b-2 border-[#B3121C]\" data-kid=\"3\" data-name=\"selected work ledger\" id=\"work\">\n<div class=\"mx-auto max-w-[1180px] px-5 py-14 md:px-7 md:py-20\" data-kid=\"3-3\" data-name=\"work section container\">\n<div class=\"flex items-end justify-between border-b-2 border-[#B3121C] pb-5\" data-kid=\"3-1\" data-name=\"work section heading row\">\n<h2 class=\"ss-display text-[46px] leading-none md:text-[68px]\" data-kid=\"3-1-1\" data-name=\"selected work heading\">SELECTED WORK</h2>\n<span class=\"ss-mono pb-1 text-[10px] uppercase tracking-[0.24em]\" data-kid=\"3-1-2\" data-name=\"project count label\">3 projects</span>\n</div>\n<ol data-kid=\"3-2\" data-name=\"project rows list\">\n<li class=\"ss-row grid grid-cols-1 gap-3 border-b border-[#B3121C]/25 py-7 md:grid-cols-12 md:items-start md:gap-6\" data-kid=\"3-2-1\" data-name=\"project row: Kestrel\">\n<span class=\"ss-display col-span-1 text-[30px] leading-none opacity-35 md:text-[38px]\" data-kid=\"3-2-1-1\" data-name=\"project index number\">01</span>\n<div class=\"md:col-span-7\" data-kid=\"3-2-1-2\" data-name=\"project detail block\">\n<h3 class=\"ss-display text-[34px] leading-none md:text-[42px]\" data-kid=\"3-2-1-2-1\" data-name=\"project name\">Kestrel</h3>\n<p class=\"mt-2 max-w-[54ch] text-[14px] leading-relaxed text-[#7E6A63] md:text-[15px]\" data-kid=\"3-2-1-2-2\" data-name=\"project description\">A 240-component library and the token pipeline behind it, adopted by four product teams.</p>\n</div>\n<div class=\"ss-mono text-[10px] uppercase tracking-[0.24em] md:col-span-2 md:pt-2\" data-kid=\"3-2-1-3\" data-name=\"project year\">2025</div>\n<div class=\"md:col-span-2 md:pt-1 md:text-right\" data-kid=\"3-2-1-4\" data-name=\"project case study column\">\n<a class=\"ss-mono inline-flex items-center gap-2 border-b-2 border-[#B3121C] pb-1 text-[10px] uppercase tracking-[0.2em]\" data-kid=\"3-2-1-4-1\" data-name=\"read case study link\" href=\"#\">Read case study <span aria-hidden=\"true\" class=\"ss-arrow\" data-kid=\"3-2-1-4-1-1\" data-name=\"arrow icon\">→</span></a>\n</div>\n</li>\n<li class=\"ss-row grid grid-cols-1 gap-3 border-b border-[#B3121C]/25 py-7 md:grid-cols-12 md:items-start md:gap-6\" data-kid=\"3-2-2\" data-name=\"project row: Tide and Timber\">\n<span class=\"ss-display col-span-1 text-[30px] leading-none opacity-35 md:text-[38px]\" data-kid=\"3-2-2-1\" data-name=\"project index number\">02</span>\n<div class=\"md:col-span-7\" data-kid=\"3-2-2-2\" data-name=\"project detail block\">\n<h3 class=\"ss-display text-[34px] leading-none md:text-[42px]\" data-kid=\"3-2-2-2-1\" data-name=\"project name\">Tide &amp; Timber</h3>\n<p class=\"mt-2 max-w-[54ch] text-[14px] leading-relaxed text-[#7E6A63] md:text-[15px]\" data-kid=\"3-2-2-2-2\" data-name=\"project description\">Seat, cabin and ferry availability in one calendar. Cut booking drop-off by a third.</p>\n</div>\n<div class=\"ss-mono text-[10px] uppercase tracking-[0.24em] md:col-span-2 md:pt-2\" data-kid=\"3-2-2-3\" data-name=\"project year\">2024</div>\n<div class=\"md:col-span-2 md:pt-1 md:text-right\" data-kid=\"3-2-2-4\" data-name=\"project case study column\">\n<a class=\"ss-mono inline-flex items-center gap-2 border-b-2 border-[#B3121C] pb-1 text-[10px] uppercase tracking-[0.2em]\" data-kid=\"3-2-2-4-1\" data-name=\"read case study link\" href=\"#\">Read case study <span aria-hidden=\"true\" class=\"ss-arrow\" data-kid=\"3-2-2-4-1-1\" data-name=\"arrow icon\">→</span></a>\n</div>\n</li>\n<li class=\"ss-row grid grid-cols-1 gap-3 border-b border-[#B3121C]/25 py-7 md:grid-cols-12 md:items-start md:gap-6\" data-kid=\"3-2-3\" data-name=\"project row: Loom Audio\">\n<span class=\"ss-display col-span-1 text-[30px] leading-none opacity-35 md:text-[38px]\" data-kid=\"3-2-3-1\" data-name=\"project index number\">03</span>\n<div class=\"md:col-span-7\" data-kid=\"3-2-3-2\" data-name=\"project detail block\">\n<h3 class=\"ss-display text-[34px] leading-none md:text-[42px]\" data-kid=\"3-2-3-2-1\" data-name=\"project name\">Loom Audio</h3>\n<p class=\"mt-2 max-w-[54ch] text-[14px] leading-relaxed text-[#7E6A63] md:text-[15px]\" data-kid=\"3-2-3-2-2\" data-name=\"project description\">A reading surface for long-form audio transcripts, built for one-handed use.</p>\n</div>\n<div class=\"ss-mono text-[10px] uppercase tracking-[0.24em] md:col-span-2 md:pt-2\" data-kid=\"3-2-3-3\" data-name=\"project year\">2023</div>\n<div class=\"md:col-span-2 md:pt-1 md:text-right\" data-kid=\"3-2-3-4\" data-name=\"project case study column\">\n<a class=\"ss-mono inline-flex items-center gap-2 border-b-2 border-[#B3121C] pb-1 text-[10px] uppercase tracking-[0.2em]\" data-kid=\"3-2-3-4-1\" data-name=\"read case study link\" href=\"#\">Read case study <span aria-hidden=\"true\" class=\"ss-arrow\" data-kid=\"3-2-3-4-1-1\" data-name=\"arrow icon\">→</span></a>\n</div>\n</li>\n</ol>\n</div>\n</section>\n<section class=\"relative overflow-hidden bg-[#B3121C] text-[#F5C518]\" data-kid=\"4\" data-name=\"experience dark band\" id=\"experience\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 opacity-[0.14]\" data-kid=\"4-3\" data-name=\"decorative diagonal line overlay\" style=\"background:repeating-linear-gradient(115deg,#F5C518 0 2px,transparent 2px 30px)\"></div>\n<div class=\"relative mx-auto max-w-[1180px] px-5 py-14 md:px-7 md:py-20\" data-kid=\"4-4\" data-name=\"experience section container\">\n<h2 class=\"ss-display text-[46px] leading-none md:text-[68px]\" data-kid=\"4-1\" data-name=\"experience heading\">EXPERIENCE</h2>\n<ul class=\"mt-8 border-t border-[#F5C518]/30\" data-kid=\"4-2\" data-name=\"experience rows list\">\n<li class=\"grid grid-cols-1 gap-2 border-b border-[#F5C518]/30 py-6 md:grid-cols-12 md:items-baseline md:gap-6\" data-kid=\"4-2-1\" data-name=\"experience row: Fintrail\">\n<span class=\"ss-mono text-[10px] uppercase tracking-[0.24em] text-[#F0C9BC] md:col-span-3\" data-kid=\"4-2-1-1\" data-name=\"experience date range\">2022 — present</span>\n<h3 class=\"ss-display text-[32px] leading-none md:col-span-4 md:text-[38px]\" data-kid=\"4-2-1-2\" data-name=\"company name\">Fintrail</h3>\n<p class=\"text-[14px] text-[#F0C9BC] md:col-span-5 md:text-right\" data-kid=\"4-2-1-3\" data-name=\"job title\">Senior product designer</p>\n</li>\n<li class=\"grid grid-cols-1 gap-2 border-b border-[#F5C518]/30 py-6 md:grid-cols-12 md:items-baseline md:gap-6\" data-kid=\"4-2-2\" data-name=\"experience row: Sundial Studio\">\n<span class=\"ss-mono text-[10px] uppercase tracking-[0.24em] text-[#F0C9BC] md:col-span-3\" data-kid=\"4-2-2-1\" data-name=\"experience date range\">2019 — 2022</span>\n<h3 class=\"ss-display text-[32px] leading-none md:col-span-4 md:text-[38px]\" data-kid=\"4-2-2-2\" data-name=\"company name\">Sundial Studio</h3>\n<p class=\"text-[14px] text-[#F0C9BC] md:col-span-5 md:text-right\" data-kid=\"4-2-2-3\" data-name=\"job title\">Product designer</p>\n</li>\n<li class=\"grid grid-cols-1 gap-2 border-b border-[#F5C518]/30 py-6 md:grid-cols-12 md:items-baseline md:gap-6\" data-kid=\"4-2-3\" data-name=\"experience row: Pageturn Press\">\n<span class=\"ss-mono text-[10px] uppercase tracking-[0.24em] text-[#F0C9BC] md:col-span-3\" data-kid=\"4-2-3-1\" data-name=\"experience date range\">2017 — 2019</span>\n<h3 class=\"ss-display text-[32px] leading-none md:col-span-4 md:text-[38px]\" data-kid=\"4-2-3-2\" data-name=\"company name\">Pageturn Press</h3>\n<p class=\"text-[14px] text-[#F0C9BC] md:col-span-5 md:text-right\" data-kid=\"4-2-3-3\" data-name=\"job title\">Interface designer</p>\n</li>\n</ul>\n</div>\n</section>\n<section class=\"border-b-2 border-[#B3121C]\" data-kid=\"5\" data-name=\"education section\" id=\"education\">\n<div class=\"mx-auto max-w-[1180px] px-5 py-14 md:px-7 md:py-20\" data-kid=\"5-1\" data-name=\"education section container\">\n<div class=\"flex items-end justify-between border-b-2 border-[#B3121C] pb-5\" data-kid=\"5-1-1\" data-name=\"education heading row\">\n<h2 class=\"ss-display text-[46px] leading-none md:text-[68px]\" data-kid=\"5-1-1-1\" data-name=\"education heading\">EDUCATION</h2>\n<span class=\"ss-mono pb-1 text-[10px] uppercase tracking-[0.24em]\" data-kid=\"5-1-1-2\" data-name=\"school count label\">2 schools</span>\n</div>\n<div class=\"mt-8 grid grid-cols-1 gap-5 md:grid-cols-2\" data-kid=\"5-1-2\" data-name=\"education cards grid\">\n<article class=\"border-l-[6px] border-[#F5C518] bg-[#EFE3D4] px-6 py-7\" data-kid=\"5-1-2-1\" data-name=\"education card: NID\">\n<div class=\"ss-mono text-[10px] uppercase tracking-[0.24em] text-[#7E6A63]\" data-kid=\"5-1-2-1-1\" data-name=\"education date range\">2015 — 2017</div>\n<h3 class=\"ss-display mt-3 text-[30px] leading-none md:text-[34px]\" data-kid=\"5-1-2-1-2\" data-name=\"school name\">National Institute of Design</h3>\n<p class=\"mt-2 text-[14px] text-[#7E6A63]\" data-kid=\"5-1-2-1-3\" data-name=\"major field of study\">Interaction design</p>\n</article>\n<article class=\"border-l-[6px] border-[#F5C518] bg-[#EFE3D4] px-6 py-7\" data-kid=\"5-1-2-2\" data-name=\"education card: Srishti\">\n<div class=\"ss-mono text-[10px] uppercase tracking-[0.