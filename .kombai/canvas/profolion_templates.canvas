ist diamond marker\" style=\"clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)\"></span><span class=\"serif text-[17px] text-[#F0ECEC]/80\" data-kid=\"7-1-2-1-1-2-5-2\" data-name=\"skill list item text\">Type</span></li>\n<li class=\"flex items-center gap-3\" data-kid=\"7-1-2-1-1-2-6\" data-name=\"skill list item\"><span class=\"inline-block h-[6px] w-[6px] shrink-0 bg-[#CFAB01]\" data-kid=\"7-1-2-1-1-2-6-1\" data-name=\"skill list diamond marker\" style=\"clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)\"></span><span class=\"serif text-[17px] text-[#F0ECEC]/80\" data-kid=\"7-1-2-1-1-2-6-2\" data-name=\"skill list item text\">Research</span></li>\n</ul>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"border-t border-[#CFAB01]/20\" data-kid=\"8\" data-name=\"elsewhere section\" id=\"elsewhere\">\n<div class=\"mx-auto max-w-[1180px] px-10 py-20\" data-kid=\"8-1\" data-name=\"elsewhere section content\">\n<div class=\"flex flex-wrap items-end justify-between gap-6\" data-kid=\"8-1-1\" data-name=\"elsewhere section header row\">\n<h2 class=\"deco text-[30px] leading-none\" data-kid=\"8-1-1-1\" data-name=\"elsewhere section heading\">Elsewhere</h2>\n<span class=\"deco text-[10px] uppercase tracking-[0.3em] text-[#F0ECEC]/45\" data-kid=\"8-1-1-2\" data-name=\"links count text\">04 links</span>\n</div>\n<div class=\"mt-9 grid grid-cols-2 gap-4 md:grid-cols-4\" data-kid=\"8-1-2\" data-name=\"social links grid\">\n<a class=\"soc relative flex items-center gap-4 border border-[#CFAB01]/22 px-5 py-6 hover:border-[#CFAB01]/55\" data-kid=\"8-1-2-1\" data-name=\"GitHub link card\" href=\"https://github.com\" rel=\"noreferrer\" target=\"_blank\">\n<span class=\"deco text-[17px] tracking-[0.04em] text-[#CFAB01]\" data-kid=\"8-1-2-1-1\" data-name=\"GitHub monogram\">GH</span>\n<span class=\"deco text-[9px] uppercase tracking-[0.26em] text-[#F0ECEC]/60\" data-kid=\"8-1-2-1-2\" data-name=\"GitHub label\">GitHub</span>\n<span class=\"soc-line absolute bottom-0 left-0 block h-px w-full origin-left bg-[#CFAB01]\" data-kid=\"8-1-2-1-3\" data-name=\"GitHub hover underline\"></span>\n</a>\n<a class=\"soc relative flex items-center gap-4 border border-[#CFAB01]/22 px-5 py-6 hover:border-[#CFAB01]/55\" data-kid=\"8-1-2-2\" data-name=\"Dribbble link card\" href=\"https://dribbble.com\" rel=\"noreferrer\" target=\"_blank\">\n<span class=\"deco text-[17px] tracking-[0.04em] text-[#CFAB01]\" data-kid=\"8-1-2-2-1\" data-name=\"Dribbble monogram\">DR</span>\n<span class=\"deco text-[9px] uppercase tracking-[0.26em] text-[#F0ECEC]/60\" data-kid=\"8-1-2-2-2\" data-name=\"Dribbble label\">Dribbble</span>\n<span class=\"soc-line absolute bottom-0 left-0 block h-px w-full origin-left bg-[#CFAB01]\" data-kid=\"8-1-2-2-3\" data-name=\"Dribbble hover underline\"></span>\n</a>\n<a class=\"soc relative flex items-center gap-4 border border-[#CFAB01]/22 px-5 py-6 hover:border-[#CFAB01]/55\" data-kid=\"8-1-2-3\" data-name=\"LinkedIn link card\" href=\"https://linkedin.com\" rel=\"noreferrer\" target=\"_blank\">\n<span class=\"deco text-[17px] tracking-[0.04em] text-[#CFAB01]\" data-kid=\"8-1-2-3-1\" data-name=\"LinkedIn monogram\">LI</span>\n<span class=\"deco text-[9px] uppercase tracking-[0.26em] text-[#F0ECEC]/60\" data-kid=\"8-1-2-3-2\" data-name=\"LinkedIn label\">LinkedIn</span>\n<span class=\"soc-line absolute bottom-0 left-0 block h-px w-full origin-left bg-[#CFAB01]\" data-kid=\"8-1-2-3-3\" data-name=\"LinkedIn hover underline\"></span>\n</a>\n<a class=\"soc relative flex items-center gap-4 border border-[#CFAB01]/22 px-5 py-6 hover:border-[#CFAB01]/55\" data-kid=\"8-1-2-4\" data-name=\"email link card\" href=\"mailto:aarav@example.com\">\n<span class=\"deco text-[17px] tracking-[0.04em] text-[#CFAB01]\" data-kid=\"8-1-2-4-1\" data-name=\"email monogram\">@</span>\n<span class=\"deco text-[9px] uppercase tracking-[0.26em] text-[#F0ECEC]/60\" data-kid=\"8-1-2-4-2\" data-name=\"email label\">Email</span>\n<span class=\"soc-line absolute bottom-0 left-0 block h-px w-full origin-left bg-[#CFAB01]\" data-kid=\"8-1-2-4-3\" data-name=\"email hover underline\"></span>\n</a>\n</div>\n<div class=\"mt-5 h-px w-full bg-[#CFAB01]/22\" data-kid=\"8-1-3\" data-name=\"elsewhere section divider line\"></div>\n</div>\n</section>\n<footer class=\"border-t border-[#CFAB01]/20\" data-kid=\"9\" data-name=\"footer bar\">\n<div class=\"mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-4 px-10 py-8\" data-kid=\"9-1\" data-name=\"footer inner container\">\n<span class=\"deco text-[9px] uppercase tracking-[0.3em] text-[#F0ECEC]/40\" data-kid=\"9-1-1\" data-name=\"footer copyright text\">Aarav Menon — Bengaluru, India</span>\n<a class=\"deco text-[9px] uppercase tracking-[0.3em] text-[#CFAB01]/80\" data-kid=\"9-1-2\" data-name=\"back to top link\" href=\"#top\">Back to top ↑</a>\n</div>\n</footer>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n    const hero = document.getElementById('hero');\n    const beam = document.getElementById('beam');\n    const beamCore = document.getElementById('beamCore');\n    const rotBeam = gsap.quickTo(beam, 'rotation', { duration: 0.7, ease: 'power3' });\n    const rotCore = gsap.quickTo(beamCore, 'rotation', { duration: 0.7, ease: 'power3' });\n    let locked = false;\n\n    hero.addEventListener('pointermove', (e) => {\n      if (locked) return;\n      const r = hero.getBoundingClientRect();\n      const nx = (e.clientX - r.left) / r.width - 0.5;\n      rotBeam(nx * 30);\n      rotCore(nx * 30);\n    });\n    hero.addEventListener('pointerleave', () => {\n      if (locked) return;\n      gsap.to([beam, beamCore], { rotation: 4, duration: 1, ease: 'power3.out' });\n    });\n\n    const signalBtn = document.getElementById('signal');\n    const signalBar = document.getElementById('signalBar');\n    const signalState = document.getElementById('signalState');\n    let signalOn = false;\n    signalBtn.addEventListener('click', () => {\n      signalOn = !signalOn;\n      signalBtn.setAttribute('aria-pressed', signalOn ? 'true' : 'false');\n      signalState.textContent = signalOn ? 'On' : 'Off';\n      if (signalOn) {\n        locked = true;\n        gsap.to([beam, beamCore], { rotation: 0, duration: 0.9, ease: 'power3.inOut' });\n        gsap.to(signalBar, { x: 27, duration: 0.4, ease: 'power3.out' });\n        gsap.to(signalBtn, { borderColor: '#CFAB01', duration: 0.3 });\n        gsap.to('.win', { opacity: 1, duration: 0.35, stagger: { each: 0.007, from: 'random' }, ease: 'none' });\n      } else {\n        locked = false;\n        gsap.to(signalBar, { x: 0, duration: 0.4, ease: 'power3.out' });\n        gsap.to(signalBtn, { borderColor: 'rgba(207,171,1,0.35)', duration: 0.3 });\n        gsap.to('.win', { opacity: 0.08, duration: 0.3 });\n      }\n    });\n\n    gsap.to('#dash', { strokeDashoffset: -160, duration: 7, repeat: -1, ease: 'none' });\n\n    gsap.fromTo('#bandText', { x: 60 }, {\n      x: -140,\n      ease: 'none',\n      scrollTrigger: { trigger: '#band', start: 'top bottom', end: 'bottom top', scrub: true }\n    });\n\n    gsap.utils.toArray('.draw').forEach((el) => {\n      gsap.fromTo(el, { scaleX: 0 }, {\n        scaleX: 1,\n        transformOrigin: 'left center',\n        duration: 1.1,\n        ease: 'power3.inOut',\n        scrollTrigger: { trigger: el, start: 'top 94%', once: true }\n      });\n    });\n\n    const tiles = Array.from(document.querySelectorAll('.tile'));\n    const REST = 'rgba(240,236,236,0.22)';\n    function selectTile(tile, animate) {\n      tiles.forEach((t) => {\n        const plate = t.querySelector('.plate');\n        if (t === tile) return;\n        t.setAttribute('aria-selected', 'false');\n        if (animate) gsap.to(plate, { y: 0, borderColor: REST, duration: 0.35, ease: 'power2.out' });\n        else gsap.set(plate, { y: 0, borderColor: REST });\n      });\n      tile.setAttribute('aria-selected', 'true');\n      const plate = tile.querySelector('.plate');\n      if (animate) gsap.to(plate, { y: -10, borderColor: '#CFAB01', duration: 0.4, ease: 'power2.out' });\n      else gsap.set(plate, { y: -10, borderColor: '#CFAB01' });\n    }\n    tiles.forEach((tile) => {\n      tile.addEventListener('click', () => selectTile(tile, true));\n      tile.addEventListener('keydown', (e) => {\n        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectTile(tile, true); }\n      });\n    });\n    if (tiles.length) selectTile(tiles[0], false);\n\n    document.querySelectorAll('.soc').forEach((soc) => {\n      const line = soc.querySelector('.soc-line');\n      gsap.set(line, { scaleX: 0 });\n      soc.addEventListener('mouseenter', () => gsap.to(line, { scaleX: 1, duration: 0.3, ease: 'power2.out' }));\n      soc.addEventListener('mouseleave', () => gsap.to(line, { scaleX: 0, duration: 0.25, ease: 'power2.in' }));\n    });\n  </script>\n</body>",
      "comments": [],
      "created": "2026-10-28T17:19:22.881179+00:00",
